From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: elkir0 <elkir0@users.noreply.github.com>
Date: Sat, 31 Oct 2026 12:00:00 +0000
Subject: [PATCH 1/2] ARM: dts: gts28ltexx: the GPS's UART

UART0 with the stock pulls: the BCM4752 sits behind it, powered by GPS_PWR_EN
on gpg2-0. Nothing claims that line here, Samsung's gpsd drives it. No child
under the UART: serdev would take the tty.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../samsung/exynos5433-gts28ltexx-gps.dtsi    | 35 +++++++++++++++++++
 .../dts/samsung/exynos5433-gts28ltexx.dts     |  3 ++
 2 files changed, 38 insertions(+)
 create mode 100644 arch/arm/boot/dts/samsung/exynos5433-gts28ltexx-gps.dtsi

diff --git a/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx-gps.dtsi b/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx-gps.dtsi
new file mode 100644
index 000000000..c210150ef
--- /dev/null
+++ b/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx-gps.dtsi
@@ -0,0 +1,35 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * GPS of the SM-T715: a Broadcom BCM4752 on UART0, powered by GPS_PWR_EN.
+ *
+ * Stock serial@14C10000 (live_fdt.dts:4778-4786) = mainline serial_0 =
+ * ttySAC0, with the stock pull of each pin (uart0-rts, -cts, -tx, -rx);
+ * stock gps node, gpios = <&gpg2 0 1> (live_fdt.dts:1244-1247).  Mainline's
+ * uart0_bus has no pull: these groups replace it.
+ */
+
+/ {
+	aliases {
+		serial0 = &serial_0;
+	};
+};
+
+&pinctrl_peric {
+	gps_uart_flow_pins: gps-uart-flow-pins {
+		samsung,pins = "gpd0-3", "gpd0-2";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
+	};
+
+	gps_uart_data_pins: gps-uart-data-pins {
+		samsung,pins = "gpd0-1", "gpd0-0";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
+	};
+};
+
+&serial_0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&gps_uart_flow_pins>, <&gps_uart_data_pins>;
+	status = "okay";
+};
diff --git a/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx.dts b/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx.dts
index e20db146f..8be9e0769 100644
--- a/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx.dts
+++ b/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx.dts
@@ -913,6 +913,9 @@ &framebuffer {
 /* The cameras (exynos5433-gts28ltexx-camera.dtsi): t715-camera.ko, no ISP. */
 #include "exynos5433-gts28ltexx-camera.dtsi"
 
+/* The GPS's UART (exynos5433-gts28ltexx-gps.dtsi). */
+#include "exynos5433-gts28ltexx-gps.dtsi"
+
 /* ==================================================================== */
 /* 17. Battery fuel gauge (SM5703 on HSI2C7)                            */
 /* ==================================================================== */
