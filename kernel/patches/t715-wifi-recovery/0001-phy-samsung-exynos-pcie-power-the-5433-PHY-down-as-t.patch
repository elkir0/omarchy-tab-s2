From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: elkir0 <elkir0@users.noreply.github.com>
Date: Mon, 9 Nov 2026 12:00:00 +0000
Subject: [PATCH 1/4] phy: samsung: exynos-pcie: power the 5433 PHY down, as
 the vendor does

Mainline never powers the Exynos5433's PCIe PHY down.  The vendor
kernel does at every Wi-Fi off/on: exynos_pcie_poweroff() sets bit 3 of
PHY register 0x55 and bit 4 of 0x21, and exynos_pcie_poweron() clears
them 100 us apart before the PHY's reset sequence.

Without it, a link whose device failed to start stays unusable until the
SoC resets: on the SM-T715 every bind of the PCIe host after a failed
Wi-Fi start took about 5 min 20 s and ended in config reads of all ones
("BAR 0/2: error updating", then brcmfmac's "MMIO read failed:
0xffffffff").  With the PHY powered down in its exit and up at the start
of its init, the next power cycle brings the link back within seconds
(2026-11-09).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/phy/samsung/phy-exynos-pcie.c | 26 ++++++++++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/drivers/phy/samsung/phy-exynos-pcie.c b/drivers/phy/samsung/phy-exynos-pcie.c
index 53c9230c2..089b588f7 100644
--- a/drivers/phy/samsung/phy-exynos-pcie.c
+++ b/drivers/phy/samsung/phy-exynos-pcie.c
@@ -8,6 +8,7 @@
  * Jaehoon Chung <jh80.chung@samsung.com>
  */
 
+#include <linux/delay.h>
 #include <linux/io.h>
 #include <linux/mfd/syscon.h>
 #include <linux/of_platform.h>
@@ -46,6 +47,29 @@ static void exynos_pcie_phy_writel(void __iomem *base, u32 val, u32 offset)
 	writel(val, base + offset);
 }
 
+/*
+ * The PHY's own power-down, as the vendor kernel drives it around every
+ * Wi-Fi off/on (exynos_pcie_poweroff() sets bit 3 of PHY register 0x55 and
+ * bit 4 of 0x21, exynos_pcie_poweron() clears them 100 us apart before the
+ * PHY's reset sequence).  Without it a link that failed stays unusable until
+ * the SoC resets: the next bind enumerates nothing but all-ones reads
+ * (SM-T715, 2026-11-09).
+ */
+static void exynos5433_pcie_phy_power(struct exynos_pcie_phy *ep, bool on)
+{
+	void __iomem *r55 = ep->base + PCIE_PHY_OFFSET(0x55);
+	void __iomem *r21 = ep->base + PCIE_PHY_OFFSET(0x21);
+
+	if (on) {
+		writel(readl(r55) & ~BIT(3), r55);
+		udelay(100);
+		writel(readl(r21) & ~BIT(4), r21);
+	} else {
+		writel(readl(r55) | BIT(3), r55);
+		writel(readl(r21) | BIT(4), r21);
+	}
+}
+
 /* Exynos5433 specific functions */
 static int exynos5433_pcie_phy_init(struct phy *phy)
 {
@@ -53,6 +77,7 @@ static int exynos5433_pcie_phy_init(struct phy *phy)
 
 	regmap_update_bits(ep->pmureg, EXYNOS5433_PMU_PCIE_PHY_OFFSET,
 			   BIT(0), 1);
+	exynos5433_pcie_phy_power(ep, true);
 	regmap_update_bits(ep->fsysreg, PCIE_EXYNOS5433_PHY_GLOBAL_RESET,
 			   PCIE_APP_REQ_EXIT_L1_MODE, 0);
 	regmap_update_bits(ep->fsysreg, PCIE_EXYNOS5433_PHY_L1SUB_CM_CON,
@@ -120,6 +145,7 @@ static int exynos5433_pcie_phy_exit(struct phy *phy)
 {
 	struct exynos_pcie_phy *ep = phy_get_drvdata(phy);
 
+	exynos5433_pcie_phy_power(ep, false);
 	regmap_update_bits(ep->fsysreg, PCIE_EXYNOS5433_PHY_L1SUB_CM_CON,
 			   PCIE_REFCLK_GATING_EN, PCIE_REFCLK_GATING_EN);
 	regmap_update_bits(ep->pmureg, EXYNOS5433_PMU_PCIE_PHY_OFFSET,
-- 
