From: elkir0 <elkir0@users.noreply.github.com>
Date: Sat, 31 Oct 2026 12:00:00 +0000
Subject: [PATCH 3/6] ARM: dts: gts28ltexx: touch keys and vibration motor

TC350K on HSI2C9 with its interrupt on gpa3-2 (not gpf2-2: phandle 0x4c of the stock
tree is the gpa3 bank), and the ISA1000A on timer 0.  Modules only.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../samsung/exynos5433-gts28ltexx-keys.dtsi   | 58 +++++++++++++++++++
 .../dts/samsung/exynos5433-gts28ltexx.dts     |  6 ++
 arch/arm/configs/gts28ltexx_defconfig         |  4 ++
 3 files changed, 68 insertions(+)
 create mode 100644 arch/arm/boot/dts/samsung/exynos5433-gts28ltexx-keys.dtsi

diff --git a/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx-keys.dtsi b/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx-keys.dtsi
new file mode 100644
index 000000000..b21f6f082
--- /dev/null
+++ b/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx-keys.dtsi
@@ -0,0 +1,58 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Back and Recent touch keys, and the vibration motor.
+ *
+ * Keys: Coreriver TC350K on HSI2C9, stock node at live_fdt.dts:1883-1905.  The
+ * interrupt is gpa3-2 (phandle 0x4c is the gpa3 bank), and the rails are LDO32
+ * for the chip and LDO33 for its LEDs.  KEY_SCALE stands for the Recent key:
+ * mainline has no such key code, and only t715-keys reads it.  tc300k.ko has
+ * no firmware path, on purpose.
+ *
+ * Motor: ISA1000A driven by timer 0 on gpd2-4, enable on gpc0-1, LDO35, stock
+ * node at live_fdt.dts:4749-4761 (33238 ns, full drive at 24872 ns).  It is a
+ * bidirectional driver, so half the period is rest: see the ISA1000A note in
+ * pwm-vibra.c.
+ */
+#include <dt-bindings/input/linux-event-codes.h>
+
+/ {
+	vibrator: vibrator {
+		compatible = "pwm-vibrator";
+		pwms = <&pwm 0 33238 0>;
+		pwm-names = "enable";
+		vcc-supply = <&ldo35_reg>;
+		enable-gpios = <&gpc0 1 GPIO_ACTIVE_HIGH>;
+		rest-duty-cycle-ns = <16619>;
+		full-duty-cycle-ns = <24872>;
+	};
+};
+
+&hsi2c_9 {
+	status = "okay";
+
+	touchkey@20 {
+		compatible = "coreriver,tc300-keypad";
+		reg = <0x20>;
+		interrupts-extended = <&gpa3 2 IRQ_TYPE_EDGE_FALLING>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&touchkey_irq>;
+		vdd-supply = <&ldo32_reg>;
+		vled-supply = <&ldo33_reg>;
+		linux,keycodes = <KEY_SCALE KEY_BACK>;
+	};
+};
+
+&pinctrl_alive {
+	touchkey_irq: touchkey-irq-pins {
+		samsung,pins = "gpa3-2";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
+	};
+};
+
+&pwm {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pwm0_out>;
+	status = "okay";
+};
