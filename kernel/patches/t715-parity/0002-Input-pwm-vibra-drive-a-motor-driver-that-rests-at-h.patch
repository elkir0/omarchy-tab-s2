From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: elkir0 <elkir0@users.noreply.github.com>
Date: Sat, 31 Oct 2026 12:00:00 +0000
Subject: [PATCH 2/6] Input: pwm-vibra: drive a motor driver that rests at half
 the period

An ISA1000A is bidirectional: half the period is rest, and more is drive.  Spread the
level between rest-duty-cycle-ns and full-duty-cycle-ns, so that the low levels
feedbackd asks for still move the motor.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/input/misc/pwm-vibra.c | 17 ++++++++++++++++-
 1 file changed, 16 insertions(+), 1 deletion(-)

diff --git a/drivers/input/misc/pwm-vibra.c b/drivers/input/misc/pwm-vibra.c
index 3e5ed685e..3a856bf68 100644
--- a/drivers/input/misc/pwm-vibra.c
+++ b/drivers/input/misc/pwm-vibra.c
@@ -14,6 +14,7 @@
 #include <linux/gpio/consumer.h>
 #include <linux/input.h>
 #include <linux/kernel.h>
+#include <linux/math64.h>
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/platform_device.h>
@@ -32,6 +33,8 @@ struct pwm_vibrator {
 	struct work_struct play_work;
 	u16 level;
 	u32 direction_duty_cycle;
+	u32 rest_duty_cycle;
+	u32 full_duty_cycle;
 	bool vcc_on;
 };
 
@@ -53,7 +56,16 @@ static int pwm_vibrator_start(struct pwm_vibrator *vibrator)
 	gpiod_set_value_cansleep(vibrator->enable_gpio, 1);
 
 	pwm_get_state(vibrator->pwm, &state);
-	pwm_set_relative_duty_cycle(&state, vibrator->level, 0xffff);
+	if (vibrator->full_duty_cycle)
+		/*
+		 * A bidirectional driver such as the ISA1000A rests at half the
+		 * period, so a low level on the whole range would move nothing.
+		 */
+		state.duty_cycle = vibrator->rest_duty_cycle +
+			div_u64((u64)(vibrator->full_duty_cycle - vibrator->rest_duty_cycle) *
+				vibrator->level, 0xffff);
+	else
+		pwm_set_relative_duty_cycle(&state, vibrator->level, 0xffff);
 	state.enabled = true;
 
 	err = pwm_apply_might_sleep(vibrator->pwm, &state);
@@ -144,6 +156,9 @@ static int pwm_vibrator_probe(struct platform_device *pdev)
 		return dev_err_probe(&pdev->dev, PTR_ERR(vibrator->vcc),
 				     "Failed to request regulator\n");
 
+	device_property_read_u32(&pdev->dev, "rest-duty-cycle-ns", &vibrator->rest_duty_cycle);
+	device_property_read_u32(&pdev->dev, "full-duty-cycle-ns", &vibrator->full_duty_cycle);
+
 	vibrator->enable_gpio = devm_gpiod_get_optional(&pdev->dev, "enable",
 							GPIOD_OUT_LOW);
 	if (IS_ERR(vibrator->enable_gpio))
