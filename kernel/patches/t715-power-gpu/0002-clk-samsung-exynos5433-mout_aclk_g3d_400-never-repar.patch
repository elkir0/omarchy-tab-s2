From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: elkir0 <elkir0@users.noreply.github.com>
Date: Sat, 7 Nov 2026 12:00:00 +0000
Subject: [PATCH 2/3] clk: samsung: exynos5433: mout_aclk_g3d_400 never
 reparents on a rate request

Its first parent is the G3D PLL, which the framework picks for any rate
the PLL can give exactly.  A board that runs the GPU from aclk_g3d_400
(gts28ltexx, since the 2026-11-04 runtime-suspend hang) must stay there
when panfrost devfreq changes the GPU rate.
---
 drivers/clk/samsung/clk-exynos5433.c | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/drivers/clk/samsung/clk-exynos5433.c b/drivers/clk/samsung/clk-exynos5433.c
index f895c436e..c88d35169 100644
--- a/drivers/clk/samsung/clk-exynos5433.c
+++ b/drivers/clk/samsung/clk-exynos5433.c
@@ -3365,8 +3365,16 @@ static const struct samsung_pll_clock g3d_pll_clks[] __initconst = {
 
 static const struct samsung_mux_clock g3d_mux_clks[] __initconst = {
 	/* MUX_SEL_G3D */
+	/*
+	 * Never reparented by a rate request: its first parent is the G3D
+	 * PLL, which the framework would pick for any rate the PLL can give
+	 * exactly.  A board that runs the GPU from aclk_g3d_400 must stay
+	 * there, since gating the GPU clock would then stop that PLL under
+	 * CMU_G3D's register clock.  The parent is chosen by assigned-clocks.
+	 */
 	MUX_F(CLK_MOUT_ACLK_G3D_400, "mout_aclk_g3d_400", mout_aclk_g3d_400_p,
-			MUX_SEL_G3D, 8, 1, CLK_SET_RATE_PARENT, 0),
+			MUX_SEL_G3D, 8, 1,
+			CLK_SET_RATE_PARENT | CLK_SET_RATE_NO_REPARENT, 0),
 	MUX_F(CLK_MOUT_G3D_PLL, "mout_g3d_pll", mout_g3d_pll_p,
 			MUX_SEL_G3D, 0, 1, CLK_SET_RATE_PARENT, 0),
 };
