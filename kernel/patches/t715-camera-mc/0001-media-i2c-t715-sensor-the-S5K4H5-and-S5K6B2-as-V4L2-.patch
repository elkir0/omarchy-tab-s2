+/* ------------------------------------------------------------------
+ * Probe and remove.
+ * ------------------------------------------------------------------
+ */
+
+static const char * const t715_rear_supplies[] = { "avdd", "dvdd", "af", "iovdd" };
+static const char * const t715_front_supplies[] = { "avdd", "iovdd" };
+
+static const struct t715_variant t715_variants[] = {
+	{
+		.name = "s5k4h5",
+		.model_id = 0x485b,
+		.supplies = t715_rear_supplies,
+		.num_supplies = 4,
+		.coarse_margin = 5,
+		.vblank_min = 38,
+		.native_width = 3280,
+		.native_height = 2464,
+		.lanes = 4,
+		.has_standby = false,
+		.has_motor = true,
+	}, {
+		.name = "s5k6b2",
+		.model_id = 0x6b20,
+		.supplies = t715_front_supplies,
+		.num_supplies = 2,
+		.coarse_margin = 6,
+		.vblank_min = 20,
+		.native_width = 1936,
+		.native_height = 1096,
+		.lanes = 1,
+		.has_standby = true,
+		.has_motor = false,
+	},
+};
