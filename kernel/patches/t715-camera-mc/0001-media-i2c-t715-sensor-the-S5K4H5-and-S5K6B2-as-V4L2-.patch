+/*
+ * A phandle to a bit-banged bus plus an address: a dummy client to talk
+ * through, as t715-camera.c does.  No phandle means no device there.
+ */
+static struct i2c_client *t715_i2c_dummy(struct device *dev,
+					 const char *bus_prop,
+					 const char *addr_prop,
+					 u16 addr_default)
+{
+	struct device_node *bus_np;
+	struct i2c_adapter *bus;
+	struct i2c_client *client;
+	u32 addr = addr_default;
+
+	bus_np = of_parse_phandle(dev->of_node, bus_prop, 0);
+	if (!bus_np)
+		return NULL;
+
+	bus = of_get_i2c_adapter_by_node(bus_np);
+	of_node_put(bus_np);
+	if (!bus)
+		return ERR_PTR(-EPROBE_DEFER);
+
+	of_property_read_u32(dev->of_node, addr_prop, &addr);
+
+	client = devm_i2c_new_dummy_device(dev, bus, addr);
+	i2c_put_adapter(bus);
+	return client;
+}
+
+static int t715_check_hwcfg(struct t715_sensor *sensor)
+{
+	struct device *dev = &sensor->client->dev;
+	struct fwnode_handle *endpoint;
+	struct v4l2_fwnode_endpoint ep = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	int ret = -EINVAL;
+
+	endpoint = fwnode_graph_get_next_endpoint(dev_fwnode(dev), NULL);
+	if (!endpoint)
+		return dev_err_probe(dev, -EINVAL, "endpoint node not found\n");
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &ep);
+	if (ret) {
+		dev_err_probe(dev, ret, "could not parse endpoint\n");
+		goto error_out;
+	}
+
+	if (ep.bus.mipi_csi2.num_data_lanes != sensor->variant->lanes) {
+		dev_err_probe(dev, -EINVAL, "expected %u data lanes, found %u\n",
+			      sensor->variant->lanes,
+			      ep.bus.mipi_csi2.num_data_lanes);
+		ret = -EINVAL;
+		goto error_out;
+	}
+
+	if (!ep.nr_of_link_frequencies) {
+		dev_err_probe(dev, -EINVAL, "no link-frequencies property\n");
+		ret = -EINVAL;
+		goto error_out;
+	}
+
+	sensor->link_frequency = ep.link_frequencies[0];
+	ret = 0;
+
+error_out:
+	v4l2_fwnode_endpoint_free(&ep);
+	fwnode_handle_put(endpoint);
+	return ret;
+}
+
+static int t715_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct t715_sensor *sensor;
+	u32 af_default = 0;
+	u64 model_id;
+	unsigned int i;
+	int ret;
+
+	sensor = devm_kzalloc(dev, sizeof(*sensor), GFP_KERNEL);
+	if (!sensor)
+		return -ENOMEM;
+
+	sensor->client = client;
+	sensor->variant = i2c_get_match_data(client);
+	if (!sensor->variant)
+		return -ENODEV;
+	sensor->focus_pos = -1;
+
+	sensor->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(sensor->regmap))
+		return dev_err_probe(dev, PTR_ERR(sensor->regmap),
+				     "failed to initialize CCI\n");
+
+	/* Everything the device tree gives, in the order of the binding. */
+	for (i = 0; i < sensor->variant->num_supplies; i++)
+		sensor->supplies[i].supply = sensor->variant->supplies[i];
+	ret = devm_regulator_bulk_get(dev, sensor->variant->num_supplies,
+				      sensor->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "no supplies\n");
+
+	sensor->reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(sensor->reset))
+		return dev_err_probe(dev, PTR_ERR(sensor->reset), "no reset\n");
+
+	if (sensor->variant->has_standby) {
+		sensor->standby = devm_gpiod_get_optional(dev, "standby",
+							  GPIOD_OUT_LOW);
+		if (IS_ERR(sensor->standby))
+			return dev_err_probe(dev, PTR_ERR(sensor->standby),
+					     "no standby\n");
+	}
+
+	sensor->mclk = devm_clk_get(dev, "mclk");
+	if (IS_ERR(sensor->mclk))
+		return dev_err_probe(dev, PTR_ERR(sensor->mclk), "no mclk\n");
+
+	sensor->pins = devm_pinctrl_get(dev);
+	if (IS_ERR(sensor->pins))
+		return dev_err_probe(dev, PTR_ERR(sensor->pins), "no pins\n");
+	sensor->pins_off = pinctrl_lookup_state(sensor->pins,
+						PINCTRL_STATE_DEFAULT);
+	if (IS_ERR(sensor->pins_off))
+		return dev_err_probe(dev, PTR_ERR(sensor->pins_off),
+				     "no default pinctrl state\n");
+	sensor->pins_on = pinctrl_lookup_state(sensor->pins, "active");
+	if (IS_ERR(sensor->pins_on))
+		return dev_err_probe(dev, PTR_ERR(sensor->pins_on),
+				     "no active pinctrl state\n");
+
+	ret = t715_check_hwcfg(sensor);
+	if (ret)
+		return ret;
+
+	/* The motor's bus is claimed before anything is powered. */
+	if (sensor->variant->has_motor) {
+		sensor->af_client = t715_i2c_dummy(dev, "t715,af-bus",
+						   "t715,af-addr", 0x0c);
+		if (IS_ERR(sensor->af_client))
+			return dev_err_probe(dev,
+					     PTR_ERR(sensor->af_client),
+					     "no focus motor bus\n");
+	}
+
+	ret = t715_load_modes(sensor);
+	if (ret)
+		return ret;
+
+	/*
+	 * Identify: power on and read the model id.  The sensor stays on: runtime
+	 * PM takes it over as active below and suspends it a second later.
+	 */
+	ret = t715_sensor_power_on(sensor);
+	if (ret)
+		goto free_modes;
+
+	ret = cci_read(sensor->regmap, T715_REG_MODEL_ID, &model_id, NULL);
+	if (ret)
+		goto power_off;
+
+	if (model_id != sensor->variant->model_id) {
+		dev_err(dev, "model id mismatch: expected %04x, read %04llx\n",
+			sensor->variant->model_id, model_id);
+		ret = -ENODEV;
+		goto power_off;
+	}
+
+	/* The sensor subdev. */
+	v4l2_i2c_subdev_init(&sensor->sd, client, &t715_sensor_ops);
+	sensor->sd.internal_ops = &t715_sensor_internal_ops;
+	v4l2_i2c_subdev_set_name(&sensor->sd, client, sensor->variant->name,
+				 NULL);
+
+	sensor->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE |
+			    V4L2_SUBDEV_FL_HAS_EVENTS;
+	sensor->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	sensor->pad.flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&sensor->sd.entity, 1, &sensor->pad);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to init entity pads\n");
+		goto power_off;
+	}
+
+	ret = t715_init_controls(sensor);
+	if (ret)
+		goto free_pads;
+
+	/* The lens subdev, registered with the sensor when it binds. */
+	if (sensor->af_client) {
+		of_property_read_u32(dev->of_node, "t715,af-default",
+				     &af_default);
+		af_default = clamp_t(u32, af_default, 0, VCM_MAX_POS);
+
+		ret = v4l2_ctrl_handler_init(&sensor->lens_ctrls, 1);
+		if (ret)
+			goto free_ctrls;
+
+		sensor->focus = v4l2_ctrl_new_std(&sensor->lens_ctrls,
+						  &t715_lens_ctrl_ops,
+						  V4L2_CID_FOCUS_ABSOLUTE,
+						  0, VCM_MAX_POS, 1,
+						  af_default);
+		if (sensor->lens_ctrls.error) {
+			ret = sensor->lens_ctrls.error;
+			goto free_lens;
+		}
+		sensor->lens_sd.ctrl_handler = &sensor->lens_ctrls;
+
+		v4l2_subdev_init(&sensor->lens_sd, &t715_lens_ops);
+		sensor->lens_sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+		sensor->lens_sd.entity.function = MEDIA_ENT_F_LENS;
+		snprintf(sensor->lens_sd.name, sizeof(sensor->lens_sd.name),
+			 "dw9807 %s", dev_name(&sensor->af_client->dev));
+		sensor->lens_sd.owner = THIS_MODULE;
+		sensor->lens_sd.dev = &sensor->af_client->dev;
+		v4l2_set_subdevdata(&sensor->lens_sd, sensor->af_client);
+		ret = media_entity_pads_init(&sensor->lens_sd.entity, 0, NULL);
+		if (ret) {
+			dev_err_probe(dev, ret, "failed to init lens pads\n");
+			goto free_lens;
+		}
+	}
+
+	sensor->sd.state_lock = sensor->sd.ctrl_handler->lock;
+	ret = v4l2_subdev_init_finalize(&sensor->sd);
+	if (ret) {
+		dev_err_probe(dev, ret, "subdev init error\n");
+		goto free_lens;
+	}
+
+	/*
+	 * As imx290.c: the device is active because it was just identified,
+	 * so enable runtime PM with autosuspend and drop the reference after
+	 * registering; it suspends a second later.
+	 */
+	pm_runtime_set_active(dev);
+	pm_runtime_get_noresume(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&sensor->sd);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to register sensor subdev\n");
+		goto error_pm;
+	}
+
+	pm_runtime_mark_last_busy(dev);
+	pm_runtime_put_autosuspend(dev);
+
+	return 0;
+
+error_pm:
+	pm_runtime_disable(dev);
+	pm_runtime_put_noidle(dev);
+	pm_runtime_set_suspended(dev);
+	v4l2_subdev_cleanup(&sensor->sd);
+free_lens:
+	if (sensor->af_client)
+		v4l2_ctrl_handler_free(&sensor->lens_ctrls);
+free_ctrls:
+	v4l2_ctrl_handler_free(&sensor->ctrls);
+free_pads:
+	media_entity_cleanup(&sensor->sd.entity);
+power_off:
+	t715_sensor_power_off(sensor);
+free_modes:
+	t715_free_modes(sensor);
+	return ret;
+}
+
+static void t715_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct t715_sensor *sensor = to_t715_sensor(sd);
+
+	v4l2_async_unregister_subdev(sd);
+
+	/* Before the controls go: powering off parks the lens through them. */
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev)) {
+		t715_power_off(&client->dev);
+		pm_runtime_set_suspended(&client->dev);
+	}
+
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+
+	if (sensor->af_client)
+		v4l2_ctrl_handler_free(&sensor->lens_ctrls);
+	v4l2_ctrl_handler_free(&sensor->ctrls);
+
+	t715_free_modes(sensor);
+}
+
+static const struct of_device_id t715_sensor_of_match[] = {
+	{ .compatible = "samsung,s5k4h5", .data = &t715_variants[0] },
+	{ .compatible = "samsung,s5k6b2", .data = &t715_variants[1] },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, t715_sensor_of_match);
+
+static struct i2c_driver t715_sensor_driver = {
+	.driver = {
+		.name = "t715-sensor",
+		.of_match_table = t715_sensor_of_match,
+		.pm = &t715_pm_ops,
+	},
+	.probe = t715_probe,
+	.remove = t715_remove,
+};
+module_i2c_driver(t715_sensor_driver);
+
+MODULE_DESCRIPTION("SM-T715 S5K4H5 and S5K6B2 camera sensors");
+MODULE_LICENSE("GPL");
