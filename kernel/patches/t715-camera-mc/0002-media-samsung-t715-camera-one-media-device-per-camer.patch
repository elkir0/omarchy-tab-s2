-/* fimc-is-device-6b2.c:609-627 */
-static int t715_front_on(struct t715_cam *c)
-{
-	int ret;
-
-	gpiod_set_value_cansleep(c->standby, 0);
-	ret = regulator_enable(c->supplies[0].consumer);
-	if (ret)
-		return ret;
-	ret = regulator_enable(c->supplies[1].consumer);
-	if (ret)
-		goto a;
-	usleep_range(1000, 2000);
-	gpiod_set_value_cansleep(c->reset, 0);
-	ret = pinctrl_select_state(c->pins, c->st_on);
-	if (ret)
-		goto b;
-	usleep_range(10000, 11000);
-	return 0;
-b:
-	gpiod_set_value_cansleep(c->reset, 1);
-	regulator_disable(c->supplies[1].consumer);
-a:
-	regulator_disable(c->supplies[0].consumer);
-	return ret;
-}
