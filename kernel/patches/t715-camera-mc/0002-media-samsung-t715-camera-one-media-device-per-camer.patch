-static int t715_sensor_write(struct t715_cam *c, u16 reg, u32 val, unsigned int width)
-{
-	u8 buf[6] = { reg >> 8, reg };
-	int ret;
-
-	if (width == 2) {
-		buf[2] = val >> 8;
-		buf[3] = val;
-	} else {
-		buf[2] = val;
-	}
-	ret = i2c_master_send(c->sensor, buf, 2 + width);
-	return ret < 0 ? ret : 0;
-}
-
-static int t715_sensor_load(struct t715_cam *c)
-{
-	const struct firmware *fw;
-	const __le16 *p;
-	size_t i;
-	int ret;
-
-	ret = request_firmware(&fw, c->fw_name, c->dev);
-	if (ret) {
-		dev_err(c->dev, "no sensor table %s: extract it from your ISP firmware\n", c->fw_name);
-		return ret;
-	}
-	if (!fw->size || fw->size % 8) {
-		release_firmware(fw);
-		return -EINVAL;
-	}
-	for (i = 0; i < fw->size; i += 8) {
-		p = (const __le16 *)(fw->data + i);
-		ret = t715_sensor_write(c, le16_to_cpu(p[0]), le16_to_cpu(p[2]), le16_to_cpu(p[1]));
-		if (ret)
-			break;
-	}
-	release_firmware(fw);
-	return ret;
-}
