--- a/drivers/media/platform/samsung/Kconfig
+++ b/drivers/media/platform/samsung/Kconfig
@@ -4,13 +4,18 @@ comment "Samsung media platform drivers"
 
 config VIDEO_T715_CAMERA
 	tristate "SM-T715 cameras, raw Bayer through CSIS and FIMC-LITE"
-	depends on V4L_PLATFORM_DRIVERS && VIDEO_DEV && ARCH_EXYNOS && I2C && OF && PM
+	depends on V4L_PLATFORM_DRIVERS && VIDEO_DEV && ARCH_EXYNOS && OF && PM
 	depends on GENERIC_PHY
+	select MEDIA_CONTROLLER
+	select VIDEO_V4L2_SUBDEV_API
+	select V4L2_FWNODE
 	select VIDEOBUF2_DMA_CONTIG
 	help
-	  The two cameras of the Galaxy Tab S2, with no ISP.  Needs the sensors'
-	  register tables as firmware files, which only the owner's copy of
-	  Samsung's ISP firmware holds.
+	  The capture side of the Galaxy Tab S2's two cameras, with no ISP:
+	  one media device per camera, the MIPI CSIS receiver and FIMC-LITE
+	  DMA feeding a video node, the sensor reached through the device
+	  tree graph.  The sensors themselves, their power and mode tables
+	  and the rear focus motor are driven by VIDEO_T715_SENSOR.
 
 
