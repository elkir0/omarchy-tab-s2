From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: elkir0 <elkir0@users.noreply.github.com>
Date: Tue, 3 Nov 2026 12:00:00 +0000
Subject: [PATCH 4/4] ARM: configs: gts28ltexx: t715-sensor, and dma-buf heaps
 for libcamera

VIDEO_T715_SENSOR as a module, and the system and CMA dma-buf heaps,
from which libcamera's software ISP allocates its buffers.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm/configs/gts28ltexx_defconfig | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/arch/arm/configs/gts28ltexx_defconfig b/arch/arm/configs/gts28ltexx_defconfig
index 15155793a..8bea54e67 100644
--- a/arch/arm/configs/gts28ltexx_defconfig
+++ b/arch/arm/configs/gts28ltexx_defconfig
@@ -97,6 +97,7 @@ CONFIG_MEDIA_PLATFORM_SUPPORT=y
 CONFIG_MEDIA_PLATFORM_DRIVERS=y
 CONFIG_V4L_PLATFORM_DRIVERS=y
 CONFIG_VIDEO_T715_CAMERA=m
+CONFIG_VIDEO_T715_SENSOR=m
 CONFIG_REGULATOR_S2MPS11=y
 CONFIG_DRM=y
 CONFIG_DRM_FBDEV_EMULATION=y
@@ -160,6 +161,10 @@ CONFIG_PHY_EXYNOS_MIPI_VIDEO=y
 CONFIG_CMA=y
 CONFIG_DMA_CMA=y
 CONFIG_CMA_SIZE_MBYTES=256
+# libcamera's software ISP allocates its buffers from a dma-buf heap.
+CONFIG_DMABUF_HEAPS=y
+CONFIG_DMABUF_HEAPS_SYSTEM=y
+CONFIG_DMABUF_HEAPS_CMA=y
 
 # Real-time clock of the S2MPS13 PMIC (kept by Android): without it the
 # system starts in 1970 and PAM reports passwords "changed in future".
-- 
2.52.0

