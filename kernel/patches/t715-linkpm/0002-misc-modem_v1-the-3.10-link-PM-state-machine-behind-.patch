index 000000000..8d0035070
--- /dev/null
+++ b/drivers/misc/modem_v1/link_device_pm.c
@@ -0,0 +1,936 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Exynos MIPI-LLI link PM state machine
+ *
+ * Copyright (C) 2013 Samsung Electronics Co.Ltd
+ * Author: Yulgon Kim <yulgon.kim@samsung.com>
+ *
+ * 6.12 port of the 3.10 link_device_pm.c (kernel_universal5433), used only
+ * with pm_mode=fsm (link_device_lli.c; omarchy-tab-s2
+ * research/modem/LINK-PM.md, SYNTHESIS.md D2 fallback F2).  run_pm_fsm(),
+ * its transitions, CP_HOLD_TIME and the 500 ms watchdogs are stock's.
+ * Changed for the port:
+ *  - GPIO descriptors; every AP2CP write goes through mif_gpio_set_value(),
+ *    so it is refused unless allow_hw=1;
+ *  - the CP2AP interrupts are not requested or re-typed here: the locked-on
+ *    PM's edge-both handlers (link_device_lli.c) read the level and call
+ *    link_pm_cp2ap_wakeup/status() while the FSM is active;
+ *  - timer_setup(), a WQ_UNBOUND | WQ_HIGHPRI workqueue (every workqueue is
+ *    non-reentrant since 3.7), the modem_wakelock.h wakeup source;
+ *  - transitions at pr_debug and counted (debugfs ss333/status) instead of
+ *    one pr_info line each; failures at pr_err;
+ *  - no panic() on AP_FAIL (stock did so only with SEC_MODEM_DEBUG);
+ *  - stop_link_pm() also cancels the watchdog and the CP_FREE work and
+ *    releases the wake lock, which stock left held after a stop in ACTIVE;
+ *  - the MIPI-LLI callbacks run only while pm_svc->active;
+ *  - ACTIVATING -> UNMOUNTING arms the UNMOUNTING watchdog, as CP_FREE ->
+ *    UNMOUNTING does: 3.10 armed none there, so a lost unmount left the
+ *    FSM in UNMOUNTING for good and the next stop_pm_wdog() logged an
+ *    illegal state on a normal path;
+ *  - an LLI unmount handled before the CP2AP_STATUS low edge, in CP_FREE or
+ *    ACTIVATING, takes the FSM down as UNMOUNTING's would (link_down()):
+ *    3.10 ignored it there, then waited in UNMOUNTING for an unmount that
+ *    had already come, and the watchdog ended the CP session (once in about
+ *    a hundred cycles on the tablet, 2026-11-05).
+ */
+
+#include <linux/delay.h>
+#include <linux/err.h>
+#include <linux/interrupt.h>
+#include <linux/jiffies.h>
+#include <linux/sched/clock.h>
+#include <linux/seq_file.h>
+
+#include "modem_prj.h"
+#include "modem_utils.h"
+#include "link_device_memory.h"
+#include "link_device_pm.h"
+
+static unsigned long cp_hold_time = CP_HOLD_TIME;
+module_param(cp_hold_time, ulong, 0644);
+MODULE_PARM_DESC(cp_hold_time, "modem_v1 pm cp_hold_time (ms, link PM FSM)");
+
+static const char * const pm_state_string[PM_STATE_NUM] = {
+	[PM_STATE_UNMOUNTED] = "UNMOUNTED",
+	[PM_STATE_SUSPENDED] = "SUSPENDED",
+	[PM_STATE_HOLDING] = "HOLDING",
+	[PM_STATE_RESETTING] = "RESETTING",
+	[PM_STATE_MOUNTING] = "MOUNTING",
+	[PM_STATE_ACTIVE] = "ACTIVE",
+	[PM_STATE_AP_FREE] = "AP_FREE",
+	[PM_STATE_CP_FREE] = "CP_FREE",
+	[PM_STATE_ACTIVATING] = "ACTIVATING",
+	[PM_STATE_UNMOUNTING] = "UNMOUNTING",
+	[PM_STATE_CP_BOOTING] = "CP_BOOTING",
+	[PM_STATE_LOCKED_ON] = "LOCKED_ON",
+	[PM_STATE_WDOG_TIMEOUT] = "WDOG_TIMEOUT",
+	[PM_STATE_CP_FAIL] = "CP_FAIL",
+	[PM_STATE_AP_FAIL] = "AP_FAIL",
+};
+
+static const char * const pm_event_string[PM_EVENT_NUM] = {
+	[PM_EVENT_NO_EVENT] = "NO_EVENT",
+	[PM_EVENT_LOCK_ON] = "LOCK_ON",
+	[PM_EVENT_CP_BOOTING] = "CP_BOOTING",
+	[PM_EVENT_CP2AP_WAKEUP_LOW] = "CP2AP_WAKEUP_LOW",
+	[PM_EVENT_CP2AP_WAKEUP_HIGH] = "CP2AP_WAKEUP_HIGH",
+	[PM_EVENT_CP2AP_STATUS_LOW] = "CP2AP_STATUS_LOW",
+	[PM_EVENT_CP2AP_STATUS_HIGH] = "CP2AP_STATUS_HIGH",
+	[PM_EVENT_CP_HOLD_REQUEST] = "CP_HOLD_REQUEST",
+	[PM_EVENT_CP_HOLD_TIMEOUT] = "CP_HOLD_TIMEOUT",
+	[PM_EVENT_LINK_RESET] = "LINK_RESET",
+	[PM_EVENT_LINK_UNMOUNTED] = "LINK_UNMOUNTED",
+	[PM_EVENT_LINK_SUSPENDED] = "LINK_SUSPENDED",
+	[PM_EVENT_LINK_RESUMED] = "LINK_RESUMED",
+	[PM_EVENT_LINK_MOUNTED] = "LINK_MOUNTED",
+	[PM_EVENT_LINK_ERROR] = "LINK_ERROR",
+	[PM_EVENT_WDOG_TIMEOUT] = "WDOG_TIMEOUT",
+	[PM_EVENT_STOP_PM] = "STOP_PM",
+};
+
+const char *pm_state2str(enum pm_state state)
+{
+	if (unlikely(state >= PM_STATE_NUM))
+		return "INVALID";
+	return pm_state_string[state];
+}
+
+const char *pm_event2str(enum pm_event event)
+{
+	if (unlikely(event >= PM_EVENT_NUM))
+		return "INVALID";
+	return pm_event_string[event];
+}
+
+static inline struct link_device *pm_to_link_device(struct modem_link_pm *pm)
+{
+	return pm->ld;
+}
+
+/*
+ * PM {cp2ap_wakeup:ap2cp_wakeup:cp2ap_status:ap2cp_status}
+ *    {event:current_state->next_state}
+ */
+static inline void print_pm_fsm(struct modem_link_pm *pm)
+{
+	pr_debug("mif: %s: PM {%d:%d:%d:%d}{%s:%s->%s}\n", pm->link_name,
+		 mif_gpio_get_value(pm->gpio_cp2ap_wakeup),
+		 mif_gpio_get_value(pm->gpio_ap2cp_wakeup),
+		 mif_gpio_get_value(pm->gpio_cp2ap_status),
+		 mif_gpio_get_value(pm->gpio_ap2cp_status),
+		 pm_event2str(pm->fsm.event), pm_state2str(pm->fsm.prev_state),
+		 pm_state2str(pm->fsm.state));
+}
+
+static inline void release_ap2cp_wakeup(struct modem_link_pm *pm)
+{
+	mif_gpio_set_value(pm->gpio_ap2cp_wakeup, 0);
+}
+
+static inline void assert_ap2cp_wakeup(struct modem_link_pm *pm)
+{
+	mif_gpio_set_value(pm->gpio_ap2cp_wakeup, 1);
+}
+
+static inline void release_ap2cp_status(struct modem_link_pm *pm)
+{
+	mif_gpio_set_value(pm->gpio_ap2cp_status, 0);
+}
+
+static inline void assert_ap2cp_status(struct modem_link_pm *pm)
+{
+	mif_gpio_set_value(pm->gpio_ap2cp_status, 1);
+}
+
+static inline void schedule_cp_free(struct modem_link_pm *pm)
+{
+	/* Hold gpio_ap2cp_wakeup for CP_HOLD_TIME */
+	if (work_pending(&pm->cp_free_dwork.work))
+		return;
+
+	queue_delayed_work(pm->wq, &pm->cp_free_dwork,
+			   msecs_to_jiffies(READ_ONCE(cp_hold_time)));
+}
+
+static inline void cancel_cp_free(struct modem_link_pm *pm)
+{
+	if (work_pending(&pm->cp_free_dwork.work))
+		cancel_delayed_work(&pm->cp_free_dwork);
+}
+
+static inline void start_pm_wdog(struct modem_link_pm *pm, enum pm_state state,
+				 enum pm_state w_state, enum pm_event w_event,
+				 unsigned long ms)
+{
+	struct pm_wdog *wdog = &pm->wdog;
+
+	wdog->state = state;
+	wdog->w_state = w_state;
+	wdog->w_event = w_event;
+
+	mif_add_timer(&wdog->timer, msecs_to_jiffies(ms));
+}
+
+static inline void stop_pm_wdog(struct modem_link_pm *pm, enum pm_state state,
+				enum pm_event event)
+{
+	struct pm_wdog *wdog = &pm->wdog;
+
+	if (state == wdog->state) {
+		if (timer_pending(&wdog->timer))
+			del_timer(&wdog->timer);
+
+		pr_debug("mif: %s: PM WDOG kicked by {%s@%s}\n",
+			 pm->link_name, pm_event2str(event),
+			 pm_state2str(state));
+	} else {
+		pr_err("mif: %s: ERR! PM WDOG illegal state {%s@%s}\n",
+		       pm->link_name, pm_event2str(event),
+		       pm_state2str(state));
+	}
+}
+
+static inline bool link_suspended(struct modem_link_pm *pm)
+{
+	struct link_device *ld = pm_to_link_device(pm);
+
+	return ld->suspended ? ld->suspended(ld) : false;
+}
+
+static inline void forbid_link_suspend(struct modem_link_pm *pm)
+{
+	struct link_pm_svc *pm_svc = pm->pm_svc;
+
+	if (pm_svc && pm_svc->lock_link)
+		pm_svc->lock_link(pm);
+}
+
+static inline void reload_link(struct modem_link_pm *pm)
+{
+	struct link_device *ld = pm_to_link_device(pm);
+
+	if (ld->reload)
+		ld->reload(ld);
+}
+
+static inline void handle_pm_fail(struct modem_link_pm *pm)
+{
+	pm->stats.fails++;
+	if (pm->fail_handler)
+		pm->fail_handler(pm);
+}
+
+static inline void handle_cp_fail(struct modem_link_pm *pm)
+{
+	pm->stats.fails++;
+	if (pm->cp_fail_handler)
+		pm->cp_fail_handler(pm);
+}
+
+static inline void handle_wdog_timeout(struct modem_link_pm *pm)
+{
+	if (mif_gpio_get_value(pm->gpio_cp2ap_status))
+		handle_pm_fail(pm);
+	else
+		handle_cp_fail(pm);
+}
+
+static inline void lock_pm_wake(struct modem_link_pm *pm)
+{
+	if (!wake_lock_active(&pm->wlock))
+		wake_lock(&pm->wlock);
+}
+
+static inline void unlock_pm_wake(struct modem_link_pm *pm)
+{
+	if (wake_lock_active(&pm->wlock))
+		wake_unlock(&pm->wlock);
+}
+
+static inline void prepare_mount(struct modem_link_pm *pm)
+{
+	lock_pm_wake(pm);
+	forbid_link_suspend(pm);
+}
+
+static inline void unmounted_to_resetting(struct modem_link_pm *pm)
+{
+	reload_link(pm);
+	assert_ap2cp_wakeup(pm);
+	start_pm_wdog(pm, PM_STATE_RESETTING, PM_STATE_MOUNTING,
+		      PM_EVENT_LINK_RESET, 500);
+}
+
+static inline void unmounted_to_holding(struct modem_link_pm *pm)
+{
+	assert_ap2cp_wakeup(pm);
+	start_pm_wdog(pm, PM_STATE_HOLDING, PM_STATE_RESETTING,
+		      PM_EVENT_CP2AP_WAKEUP_HIGH, 500);
+}
+
+static inline void holding_to_resetting(struct modem_link_pm *pm)
+{
+	stop_pm_wdog(pm, PM_STATE_HOLDING, PM_EVENT_CP2AP_WAKEUP_HIGH);
+	reload_link(pm);
+	start_pm_wdog(pm, PM_STATE_RESETTING, PM_STATE_MOUNTING,
+		      PM_EVENT_LINK_RESET, 500);
+}
+
+static inline enum pm_state next_state_from_resume(struct modem_link_pm *pm)
+{
+	if (mif_gpio_get_value(pm->gpio_cp2ap_wakeup)) {
+		pm->hold_requested = false;
+		return PM_STATE_RESETTING;
+	}
+
+	if (pm->hold_requested) {
+		pm->hold_requested = false;
+		return PM_STATE_HOLDING;
+	}
+
+	return PM_STATE_UNMOUNTED;
+}
+
+/*
+ * The link is down (an LLI unmount): UNMOUNTED, or HOLDING when a send asked
+ * for the link meanwhile (3.10's UNMOUNTING branch).  The caller has stopped
+ * its state's watchdog: unmounted_to_holding() arms a new one.
+ */
+static enum pm_state link_down(struct modem_link_pm *pm, struct modem_ctl *mc)
+{
+	enum pm_state n_state;
+
+	if (pm->hold_requested) {
+		if (cp_online(mc))
+			n_state = PM_STATE_HOLDING;
+		else
+			n_state = PM_STATE_UNMOUNTED;
+		pm->hold_requested = false;
+	} else {
+		n_state = PM_STATE_UNMOUNTED;
+	}
+	release_ap2cp_status(pm);
+	if (n_state == PM_STATE_HOLDING) {
+		prepare_mount(pm);
+		unmounted_to_holding(pm);
+	}
+	return n_state;
+}
+
+static inline bool fsm_locked(enum pm_state state)
+{
+	return state == PM_STATE_LOCKED_ON ||
+	       state == PM_STATE_WDOG_TIMEOUT ||
+	       state == PM_STATE_CP_FAIL;
+}
+
+static inline bool hold_possible(enum pm_state state)
+{
+	return state == PM_STATE_UNMOUNTED ||
+	       state == PM_STATE_AP_FREE ||
+	       state == PM_STATE_CP_FREE;
+}
+
+static inline void set_pm_fsm(struct modem_link_pm *pm, enum pm_state c_state,
+			      enum pm_state n_state, enum pm_event event)
+{
+	struct pm_fsm *fsm = &pm->fsm;
+
+	fsm->prev_state = c_state;
+	fsm->event = event;
+	fsm->state = n_state;
+
+	if (n_state != c_state && n_state < PM_STATE_NUM) {
+		pm->stats.entered[n_state]++;
+		pm->stats.last_change_ns = local_clock();
+	}
+}
+
+static inline void decide_pm_wake(struct modem_link_pm *pm,
+				  enum pm_state c_state,
+				  enum pm_state n_state)
+{
+	if (n_state == c_state)
+		return;
+
+	switch (n_state) {
+	case PM_STATE_UNMOUNTED:
+		unlock_pm_wake(pm);
+		break;
+
+	case PM_STATE_ACTIVE:
+		lock_pm_wake(pm);
+		break;
+
+	default:
+		break;
+	}
+}
+
+static inline void check_pm_fail(struct modem_link_pm *pm,
+				 enum pm_state c_state,
+				 enum pm_state n_state)
+{
+	if (n_state == c_state)
+		return;
+
+	switch (n_state) {
+	case PM_STATE_WDOG_TIMEOUT:
+		pr_err("mif: %s: PM WDOG timeout {%s@%s}\n", pm->link_name,
+		       pm_event2str(pm->wdog.w_event),
+		       pm_state2str(pm->wdog.state));
+		handle_wdog_timeout(pm);
+		break;
+
+	case PM_STATE_CP_FAIL:
+		pr_err("mif: %s: PM CP_FAIL from %s\n", pm->link_name,
+		       pm_state2str(c_state));
+		handle_cp_fail(pm);
+		break;
+
+	case PM_STATE_AP_FAIL:
+		/* 3.10 panicked here with SEC_MODEM_DEBUG */
+		pr_err("mif: %s: PM AP_FAIL from %s\n", pm->link_name,
+		       pm_state2str(c_state));
+		handle_cp_fail(pm);
+		break;
+
+	default:
+		break;
+	}
+}
+
+static void run_pm_fsm(struct modem_link_pm *pm, enum pm_event event)
+{
+	struct link_device *ld = pm_to_link_device(pm);
+	struct modem_ctl *mc = ld->mc;
+	struct pm_fsm *fsm = &pm->fsm;
+	enum pm_state c_state;
+	enum pm_state n_state;
+	unsigned long flags;
+
+	spin_lock_irqsave(&pm->lock, flags);
+
+	c_state = fsm->state;
+	n_state = fsm->state;
+
+	if (!pm->active) {
+		release_ap2cp_wakeup(pm);
+		if (event == PM_EVENT_LINK_ERROR)
+			n_state = PM_STATE_CP_FAIL;
+		goto exit;
+	}
+
+	if (fsm_locked(c_state))
+		goto exit;
+
+	if (event == PM_EVENT_CP_HOLD_REQUEST) {
+		if (!cp_online(mc))
+			goto exit;
+
+		pm->hold_requested = true;
+		pm->stats.hold_requests++;
+
+		if (!hold_possible(c_state))
+			goto exit;
+	}
+
+	switch (c_state) {
+	case PM_STATE_UNMOUNTED:
+		if (event == PM_EVENT_LINK_SUSPENDED) {
+			n_state = PM_STATE_SUSPENDED;
+		} else if (event == PM_EVENT_CP2AP_WAKEUP_HIGH ||
+			   event == PM_EVENT_CP_HOLD_REQUEST) {
+			if (link_suspended(pm)) {
+				n_state = PM_STATE_SUSPENDED;
+				prepare_mount(pm);
+			} else {
+				n_state = next_state_from_resume(pm);
+				if (n_state == PM_STATE_RESETTING) {
+					prepare_mount(pm);
+					unmounted_to_resetting(pm);
+				} else if (n_state == PM_STATE_HOLDING) {
+					prepare_mount(pm);
+					unmounted_to_holding(pm);
+				}
+			}
+		}
+		break;
+
+	case PM_STATE_SUSPENDED:
+		if (event == PM_EVENT_LINK_RESUMED) {
+			n_state = next_state_from_resume(pm);
+			if (n_state == PM_STATE_RESETTING) {
+				prepare_mount(pm);
+				unmounted_to_resetting(pm);
+			} else if (n_state == PM_STATE_HOLDING) {
+				prepare_mount(pm);
+				unmounted_to_holding(pm);
+			}
+		} else if (event == PM_EVENT_CP2AP_WAKEUP_HIGH ||
+			   event == PM_EVENT_CP_HOLD_REQUEST) {
+			n_state = PM_STATE_SUSPENDED;
+			prepare_mount(pm);
+		}
+		break;
+
+	case PM_STATE_HOLDING:
+		if (event == PM_EVENT_CP2AP_WAKEUP_HIGH) {
+			n_state = PM_STATE_RESETTING;
+			holding_to_resetting(pm);
+		} else if (event == PM_EVENT_WDOG_TIMEOUT) {
+			/*
+			 * It is not guaranteed for FSM to succeed in getting
+			 * GPIO interrupt events or for stop_pm_wdog() to
+			 * succeed in deleting the WDOG timer always.  So,
+			 * gpio_cp2ap_wakeup and gpio_cp2ap_status must always
+			 * be checked before state transition.
+			 */
+			if (mif_gpio_get_value(pm->gpio_cp2ap_wakeup)) {
+				n_state = PM_STATE_RESETTING;
+				holding_to_resetting(pm);
+			} else {
+				n_state = PM_STATE_WDOG_TIMEOUT;
+			}
+		}
+		break;
+
+	case PM_STATE_RESETTING:
+		if (event == PM_EVENT_LINK_RESET) {
+			n_state = PM_STATE_MOUNTING;
+			stop_pm_wdog(pm, c_state, event);
+			assert_ap2cp_status(pm);
+			start_pm_wdog(pm, n_state, PM_STATE_ACTIVE,
+				      PM_EVENT_LINK_MOUNTED, 500);
+		} else if (event == PM_EVENT_WDOG_TIMEOUT) {
+			n_state = PM_STATE_AP_FAIL;
+		} else if (event == PM_EVENT_CP2AP_WAKEUP_LOW) {
+			n_state = PM_STATE_CP_FAIL;
+		}
+		break;
+
+	case PM_STATE_MOUNTING:
+		if (event == PM_EVENT_LINK_MOUNTED ||
+		    event == PM_EVENT_CP2AP_STATUS_HIGH) {
+			n_state = PM_STATE_ACTIVE;
+			stop_pm_wdog(pm, c_state, event);
+		} else if (event == PM_EVENT_WDOG_TIMEOUT) {
+			n_state = PM_STATE_WDOG_TIMEOUT;
+		} else if (event == PM_EVENT_CP2AP_WAKEUP_LOW) {
+			n_state = PM_STATE_CP_FAIL;
+		}
+		break;
+
+	case PM_STATE_ACTIVE:
+		if (event == PM_EVENT_CP2AP_WAKEUP_LOW) {
+			n_state = PM_STATE_AP_FREE;
+			schedule_cp_free(pm);
+		} else if (event == PM_EVENT_CP2AP_STATUS_LOW) {
+			n_state = PM_STATE_CP_FAIL;
+		} else if (event == PM_EVENT_CP_HOLD_TIMEOUT) {
+			if (!mif_gpio_get_value(pm->gpio_cp2ap_wakeup)) {
+				cancel_cp_free(pm);
+				n_state = PM_STATE_AP_FREE;
+				schedule_cp_free(pm);
+			}
+		}
+		break;
+
+	case PM_STATE_AP_FREE:
+		if (event == PM_EVENT_CP2AP_WAKEUP_HIGH) {
+			n_state = PM_STATE_ACTIVE;
+			cancel_cp_free(pm);
+			assert_ap2cp_wakeup(pm);
+		} else if (event == PM_EVENT_CP_HOLD_REQUEST) {
+			n_state = PM_STATE_ACTIVE;
+			cancel_cp_free(pm);
+			assert_ap2cp_wakeup(pm);
+		} else if (event == PM_EVENT_CP_HOLD_TIMEOUT) {
+			/*
+			 * It is not guaranteed for cancel_cp_free() to succeed
+			 * in canceling the cp_free_dwork always.  So,
+			 * cp2ap_wakeup must always be checked before state
+			 * transition.
+			 */
+			if (!mif_gpio_get_value(pm->gpio_cp2ap_wakeup) &&
+			    !atomic_read(&pm->ref_cnt)) {
+				n_state = PM_STATE_CP_FREE;
+				pm->hold_requested = false;
+				release_ap2cp_wakeup(pm);
+			} else {
+				n_state = PM_STATE_ACTIVE;
+				cancel_cp_free(pm);
+				assert_ap2cp_wakeup(pm);
+			}
+		} else if (event == PM_EVENT_CP2AP_STATUS_LOW) {
+			n_state = PM_STATE_CP_FAIL;
+		}
+		break;
+
+	case PM_STATE_CP_FREE:
+		if (event == PM_EVENT_CP2AP_STATUS_LOW) {
+			n_state = PM_STATE_UNMOUNTING;
+			start_pm_wdog(pm, n_state, PM_STATE_UNMOUNTED,
+				      PM_EVENT_LINK_UNMOUNTED, 500);
+		} else if (event == PM_EVENT_LINK_UNMOUNTED) {
+			/* 6.12 port: the unmount before the STATUS low edge */
+			pm->stats.early_unmounts++;
+			n_state = link_down(pm, mc);
+		} else if (event == PM_EVENT_CP2AP_WAKEUP_HIGH) {
+			n_state = PM_STATE_ACTIVE;
+			assert_ap2cp_wakeup(pm);
+		} else if (event == PM_EVENT_CP_HOLD_REQUEST) {
+			n_state = PM_STATE_ACTIVATING;
+			assert_ap2cp_wakeup(pm);
+			start_pm_wdog(pm, n_state, PM_STATE_ACTIVE,
+				      PM_EVENT_CP2AP_WAKEUP_HIGH, 500);
+		}
+		break;
+
+	case PM_STATE_ACTIVATING:
+		if (event == PM_EVENT_LINK_UNMOUNTED) {
+			/* 6.12 port: the unmount before the STATUS low edge */
+			pm->stats.early_unmounts++;
+			stop_pm_wdog(pm, c_state, event);
+			n_state = link_down(pm, mc);
+		} else if (event == PM_EVENT_CP2AP_WAKEUP_HIGH) {
+			n_state = PM_STATE_ACTIVE;
+			stop_pm_wdog(pm, c_state, event);
+			assert_ap2cp_wakeup(pm);
+		} else if (event == PM_EVENT_CP2AP_STATUS_LOW) {
+			n_state = PM_STATE_UNMOUNTING;
+			stop_pm_wdog(pm, c_state, event);
+			release_ap2cp_wakeup(pm);
+			/* 6.12 port: as CP_FREE -> UNMOUNTING */
+			start_pm_wdog(pm, n_state, PM_STATE_UNMOUNTED,
+				      PM_EVENT_LINK_UNMOUNTED, 500);
+		} else if (event == PM_EVENT_WDOG_TIMEOUT) {
+			/*
+			 * It is not guaranteed for FSM to succeed in getting
+			 * GPIO interrupt events or for stop_pm_wdog() to
+			 * succeed in deleting the WDOG timer always.  So,
+			 * gpio_cp2ap_wakeup and gpio_cp2ap_status must always
+			 * be checked before state transition.
+			 */
+			if (mif_gpio_get_value(pm->gpio_cp2ap_wakeup)) {
+				n_state = PM_STATE_ACTIVE;
+			} else if (!mif_gpio_get_value(pm->gpio_cp2ap_status)) {
+				n_state = PM_STATE_UNMOUNTING;
+				/* 6.12 port: as CP_FREE -> UNMOUNTING */
+				start_pm_wdog(pm, n_state, PM_STATE_UNMOUNTED,
+					      PM_EVENT_LINK_UNMOUNTED, 500);
+			} else {
+				n_state = PM_STATE_WDOG_TIMEOUT;
+			}
+		}
+		break;
+
+	case PM_STATE_UNMOUNTING:
+		if (event == PM_EVENT_LINK_UNMOUNTED) {
+			stop_pm_wdog(pm, c_state, event);
+			n_state = link_down(pm, mc);
+		} else if (event == PM_EVENT_WDOG_TIMEOUT) {
+			n_state = PM_STATE_WDOG_TIMEOUT;
+		}
+		break;
+
+	case PM_STATE_CP_BOOTING:
+		if (event == PM_EVENT_CP2AP_WAKEUP_HIGH) {
+			n_state = PM_STATE_ACTIVE;
+			assert_ap2cp_wakeup(pm);
+		} else if (event == PM_EVENT_LINK_ERROR) {
+			n_state = PM_STATE_CP_FAIL;
+		}
+		break;
+
+	default:
+		break;
+	}
+
+	set_pm_fsm(pm, c_state, n_state, event);
+
+	print_pm_fsm(pm);
+
+	decide_pm_wake(pm, c_state, n_state);
+
+exit:
+	spin_unlock_irqrestore(&pm->lock, flags);
+
+	check_pm_fail(pm, c_state, n_state);
+}
+
+/* the CP2AP interrupt handlers of link_device_lli.c, with the level read */
+void link_pm_cp2ap_wakeup(struct modem_link_pm *pm, int level)
+{
+	run_pm_fsm(pm, level ? PM_EVENT_CP2AP_WAKEUP_HIGH :
+			       PM_EVENT_CP2AP_WAKEUP_LOW);
+}
+
+void link_pm_cp2ap_status(struct modem_link_pm *pm, int level)
+{
+	run_pm_fsm(pm, level ? PM_EVENT_CP2AP_STATUS_HIGH :
+			       PM_EVENT_CP2AP_STATUS_LOW);
+}
+
+static void cp_free_work_func(struct work_struct *ws)
+{
+	struct modem_link_pm *pm;
+
+	pm = container_of(ws, struct modem_link_pm, cp_free_dwork.work);
+
+	run_pm_fsm(pm, PM_EVENT_CP_HOLD_TIMEOUT);
+}
+
+static void pm_wdog_bark(struct timer_list *t)
+{
+	struct pm_wdog *wdog = from_timer(wdog, t, timer);
+	struct modem_link_pm *pm = container_of(wdog, struct modem_link_pm, wdog);
+	struct pm_fsm *fsm = &pm->fsm;
+	enum pm_state c_state;
+	unsigned long flags;
+
+	spin_lock_irqsave(&pm->lock, flags);
+	c_state = fsm->state;
+	spin_unlock_irqrestore(&pm->lock, flags);
+
+	if (wdog->w_state == c_state) {
+		pm->stats.wdog_lost++;
+		pr_err("mif: %s: PM WDOG lost event {%s@%s}\n", pm->link_name,
+		       pm_event2str(wdog->w_event), pm_state2str(wdog->state));
+		return;
+	}
+
+	pm->stats.wdog_barks++;
+	run_pm_fsm(pm, PM_EVENT_WDOG_TIMEOUT);
+}
+
+void link_pm_request_hold(struct modem_link_pm *pm)
+{
+	run_pm_fsm(pm, PM_EVENT_CP_HOLD_REQUEST);
+}
+
+/* MIPI-LLI callbacks (pm_svc), called only while pm_svc->active */
+static void link_reset_cb(void *owner)
+{
+	struct modem_link_pm *pm = (struct modem_link_pm *)owner;
+
+	run_pm_fsm(pm, PM_EVENT_LINK_RESET);
+}
+
+static void link_unmount_cb(void *owner)
+{
+	struct modem_link_pm *pm = (struct modem_link_pm *)owner;
+
+	run_pm_fsm(pm, PM_EVENT_LINK_UNMOUNTED);
+}
+
+static void link_mount_cb(void *owner)
+{
+	struct modem_link_pm *pm = (struct modem_link_pm *)owner;
+	struct link_device *ld = pm_to_link_device(pm);
+	struct mem_link_device *mld = ld_to_mem_link_device(ld);
+
+	run_pm_fsm(pm, PM_EVENT_LINK_MOUNTED);
+
+	wake_up_all(&mld->wq);
+}
+
+bool link_pm_active(struct modem_link_pm *pm)
+{
+	struct pm_fsm *fsm = &pm->fsm;
+	unsigned long flags;
+	bool ret;
+
+	spin_lock_irqsave(&pm->lock, flags);
+
+	ret = fsm->state == PM_STATE_LOCKED_ON ||
+	      fsm->state == PM_STATE_ACTIVE ||
+	      fsm->state == PM_STATE_AP_FREE;
+
+	spin_unlock_irqrestore(&pm->lock, flags);
+
+	return ret;
+}
+
+/*
+ * From CP PHONE_START.  The CP2AP interrupts are already enabled
+ * (link_device_lli.c's start_monitor): they reach the FSM once it is active.
+ */
+void start_link_pm(struct modem_link_pm *pm, enum pm_event event)
+{
+	enum pm_state state;
+	unsigned long flags;
+
+	spin_lock_irqsave(&pm->lock, flags);
+
+	if (pm->active) {
+		pr_err("mif: %s: PM is already ACTIVE\n", pm->link_name);
+		goto exit;
+	}
+
+	lock_pm_wake(pm);
+
+	if (event == PM_EVENT_LOCK_ON) {
+		state = PM_STATE_LOCKED_ON;
+		assert_ap2cp_wakeup(pm);
+		assert_ap2cp_status(pm);
+	} else if (event == PM_EVENT_CP_BOOTING) {
+		state = PM_STATE_CP_BOOTING;
+		assert_ap2cp_wakeup(pm);
+		assert_ap2cp_status(pm);
+	} else {
+		state = PM_STATE_UNMOUNTED;
+		release_ap2cp_wakeup(pm);
+		release_ap2cp_status(pm);
+	}
+
+	set_pm_fsm(pm, PM_STATE_UNMOUNTED, state, event);
+
+	pm->hold_requested = false;
+	atomic_set(&pm->ref_cnt, 0);
+
+	pm->active = true;
+
+	/* the MIPI-LLI driver calls the FSM from now on */
+	WRITE_ONCE(pm->pm_svc->active, true);
+
+	print_pm_fsm(pm);
+
+	pr_info("mif: %s: PM state machine started (%s)\n", pm->link_name,
+		pm_state2str(state));
+
+exit:
+	spin_unlock_irqrestore(&pm->lock, flags);
+}
+
+/*
+ * From stop_pm (ld->off), after the CP2AP interrupts are disabled.  May run
+ * in atomic context (ss333_force_crash_exit): no sync cancel; a late timer,
+ * work or callback finds !active and only lowers AP2CP_WAKEUP.
+ */
+void stop_link_pm(struct modem_link_pm *pm)
+{
+	unsigned long flags;
+	enum pm_state state;
+
+	spin_lock_irqsave(&pm->lock, flags);
+
+	if (!pm->active)
+		goto exit;
+
+	pm->active = false;
+
+	/* the MIPI-LLI driver re-arms after an unmount again */
+	WRITE_ONCE(pm->pm_svc->active, false);
+
+	del_timer(&pm->wdog.timer);
+	cancel_delayed_work(&pm->cp_free_dwork);
+
+	state = pm->fsm.state;
+	set_pm_fsm(pm, state, PM_STATE_UNMOUNTED, PM_EVENT_STOP_PM);
+	print_pm_fsm(pm);
+
+	unlock_pm_wake(pm);
+
+	pr_info("mif: %s: PM state machine stopped (was %s)\n", pm->link_name,
+		pm_state2str(state));
+
+exit:
+	spin_unlock_irqrestore(&pm->lock, flags);
+}
+
+void link_pm_status_show(struct modem_link_pm *pm, struct seq_file *s)
+{
+	struct pm_stats st;
+	enum pm_state state;
+	unsigned long flags;
+	bool active;
+	int i;
+
+	spin_lock_irqsave(&pm->lock, flags);
+	st = pm->stats;
+	state = pm->fsm.state;
+	active = pm->active;
+	spin_unlock_irqrestore(&pm->lock, flags);
+
+	seq_printf(s, "  fsm: %s, state %s, ref_cnt %d, wake lock %d\n",
+		   active ? "active" : "stopped", pm_state2str(state),
+		   atomic_read(&pm->ref_cnt), wake_lock_active(&pm->wlock));
+	seq_printf(s, "  fsm: holds %lu, wdog barks %lu, wdog lost %lu, fails %lu, early unmounts %lu, last change %llu ns\n",
+		   st.hold_requests, st.wdog_barks, st.wdog_lost, st.fails,
+		   st.early_unmounts, st.last_change_ns);
+	seq_puts(s, "  fsm entries:");
+	for (i = 0; i < PM_STATE_NUM; i++)
+		if (st.entered[i])
+			seq_printf(s, " %s %lu", pm_state2str(i), st.entered[i]);
+	seq_puts(s, "\n");
+}
+
+static inline void init_pm_fsm(struct modem_link_pm *pm)
+{
+	set_pm_fsm(pm, PM_STATE_UNMOUNTED, PM_STATE_UNMOUNTED,
+		   PM_EVENT_NO_EVENT);
+}
+
+/*
+ * From init_pm (probe).  Nothing is driven and no interrupt is requested:
+ * the FSM runs only between start_link_pm and stop_link_pm.
+ */
+int init_link_device_pm(struct link_device *ld, struct modem_link_pm *pm,
+			struct link_pm_svc *pm_svc,
+			struct gpio_desc *cp2ap_wakeup,
+			struct gpio_desc *ap2cp_wakeup,
+			struct gpio_desc *cp2ap_status,
+			struct gpio_desc *ap2cp_status,
+			void (*fail_fn)(struct modem_link_pm *),
+			void (*cp_fail_fn)(struct modem_link_pm *))
+{
+	if (!pm_svc)
+		return -ENOSYS;
+
+	pm->ld = ld;
+	pm->link_name = ld->name;
+	pm->fail_handler = fail_fn;
+	pm->cp_fail_handler = cp_fail_fn;
+
+	pm->gpio_cp2ap_wakeup = cp2ap_wakeup;
+	pm->gpio_ap2cp_wakeup = ap2cp_wakeup;
+	pm->gpio_cp2ap_status = cp2ap_status;
+	pm->gpio_ap2cp_status = ap2cp_status;
+
+	spin_lock_init(&pm->lock);
+	pm->active = false;
+	atomic_set(&pm->ref_cnt, 0);
+
+	snprintf(pm->wlock_name, MAX_NAME_LEN, "%s_pm_wlock", pm->link_name);
+	wake_lock_init(&pm->wlock, WAKE_LOCK_SUSPEND, pm->wlock_name);
+
+	snprintf(pm->wq_name, MAX_NAME_LEN, "%s_pm_wq", pm->link_name);
+	pm->wq = alloc_workqueue("%s", WQ_UNBOUND | WQ_HIGHPRI, 1, pm->wq_name);
+	if (!pm->wq) {
+		pr_err("mif: %s: ERR! fail to create %s\n",
+		       pm->link_name, pm->wq_name);
+		return -ENOMEM;
+	}
+
+	INIT_DELAYED_WORK(&pm->cp_free_dwork, cp_free_work_func);
+	timer_setup(&pm->wdog.timer, pm_wdog_bark, 0);
+
+	init_pm_fsm(pm);
+	memset(&pm->stats, 0, sizeof(pm->stats));
+
+	/*
+	 * Callbacks invoked by the MIPI-LLI driver after the link is reset,
+	 * mounted and unmounted, while pm_svc->active (start_link_pm).
+	 */
+	pm_svc->owner = pm;
+	pm_svc->lock = &pm->lock;
+	pm_svc->reset_cb = link_reset_cb;
+	pm_svc->mount_cb = link_mount_cb;
+	pm_svc->unmount_cb = link_unmount_cb;
+	WRITE_ONCE(pm_svc->active, false);
+
+	pm->pm_svc = pm_svc;
+
+	return 0;
+}
diff --git a/drivers/misc/modem_v1/link_device_pm.h b/drivers/misc/modem_v1/link_device_pm.h
new file mode 100644
index 000000000..04876a497
--- /dev/null
+++ b/drivers/misc/modem_v1/link_device_pm.h
@@ -0,0 +1,162 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Copyright (C) 2012 Samsung Electronics.
+ *
+ * 6.12 port of the 3.10 modem_pm.h: the MIPI-LLI link PM state machine of
+ * link_device_pm.c, used only with pm_mode=fsm (link_device_lli.c; design:
+ * omarchy-tab-s2 research/modem/LINK-PM.md).  The states, events and timings
+ * are stock's; the GPIOs are descriptors, written through the allow_hw gate
+ * (mif_gpio_set_value), and the CP2AP interrupts stay link_device_lli.c's.
+ */
+
+#ifndef __LINK_DEVICE_PM_H__
+#define __LINK_DEVICE_PM_H__
+
+#include <linux/atomic.h>
+#include <linux/gpio/consumer.h>
+#include <linux/mipi-lli.h>
+#include <linux/spinlock.h>
+#include <linux/timer.h>
+#include <linux/types.h>
+#include <linux/workqueue.h>
+
+#include "include/modem_v1.h"
+#include "include/modem_wakelock.h"
+
+struct link_device;
+struct seq_file;
+
+enum pm_state {
+	PM_STATE_UNMOUNTED,
+	PM_STATE_SUSPENDED,
+	PM_STATE_HOLDING,
+	PM_STATE_RESETTING,
+	PM_STATE_MOUNTING,
+	PM_STATE_ACTIVE,
+	PM_STATE_AP_FREE,
+	PM_STATE_CP_FREE,
+	PM_STATE_ACTIVATING,
+	PM_STATE_UNMOUNTING,
+	PM_STATE_CP_BOOTING,
+	PM_STATE_LOCKED_ON,
+	PM_STATE_WDOG_TIMEOUT,
+	PM_STATE_CP_FAIL,
+	PM_STATE_AP_FAIL,
+	PM_STATE_NUM
+};
+
+enum pm_event {
+	PM_EVENT_NO_EVENT,
+	PM_EVENT_LOCK_ON,
+	PM_EVENT_CP_BOOTING,
+	PM_EVENT_CP2AP_WAKEUP_LOW,
+	PM_EVENT_CP2AP_WAKEUP_HIGH,
+	PM_EVENT_CP2AP_STATUS_LOW,
+	PM_EVENT_CP2AP_STATUS_HIGH,
+	PM_EVENT_CP_HOLD_REQUEST,
+	PM_EVENT_CP_HOLD_TIMEOUT,
+	PM_EVENT_LINK_RESET,
+	PM_EVENT_LINK_UNMOUNTED,
+	PM_EVENT_LINK_SUSPENDED,
+	PM_EVENT_LINK_RESUMED,
+	PM_EVENT_LINK_MOUNTED,
+	PM_EVENT_LINK_ERROR,
+	PM_EVENT_WDOG_TIMEOUT,
+	PM_EVENT_STOP_PM,
+	PM_EVENT_NUM
+};
+
+struct pm_fsm {
+	enum pm_state prev_state;
+	enum pm_event event;
+	enum pm_state state;
+};
+
+struct pm_wdog {
+	struct timer_list timer;
+
+	/* the FSM state in which the WDOG waits for $w_event */
+	enum pm_state state;
+
+	/* the state the FSM must reach before the WDOG barks */
+	enum pm_state w_state;
+
+	/* the event that takes the FSM to $w_state */
+	enum pm_event w_event;
+};
+
+#define CP_HOLD_TIME		100	/* ms */
+
+/* 6.12 port: counters for debugfs ss333/status (3.10 printed every step) */
+struct pm_stats {
+	unsigned long entered[PM_STATE_NUM];	/* transitions into each state */
+	unsigned long hold_requests;
+	unsigned long wdog_barks;		/* barks that ran the FSM */
+	unsigned long wdog_lost;		/* barks after their event came */
+	unsigned long fails;			/* fail handlers called */
+	unsigned long early_unmounts;		/* unmounts before STATUS low */
+	u64 last_change_ns;
+};
+
+struct modem_link_pm {
+	/* PM service of the MIPI-LLI driver */
+	struct link_pm_svc *pm_svc;
+
+	/* 6.12 port: the link device, instead of container_of from struct link_device */
+	struct link_device *ld;
+
+	char *link_name;
+	void (*fail_handler)(struct modem_link_pm *pm);
+	void (*cp_fail_handler)(struct modem_link_pm *pm);
+
+	/* GPIO pins for PM (the CP2AP IRQs are link_device_lli.c's) */
+	struct gpio_desc *gpio_cp2ap_wakeup;
+	struct gpio_desc *gpio_ap2cp_wakeup;
+	struct gpio_desc *gpio_cp2ap_status;
+	struct gpio_desc *gpio_ap2cp_status;
+
+	spinlock_t lock;
+
+	bool active;
+
+	struct pm_fsm fsm;
+	atomic_t ref_cnt;
+
+	struct wake_lock wlock;
+	char wlock_name[MAX_NAME_LEN];
+
+	struct workqueue_struct *wq;
+	char wq_name[MAX_NAME_LEN];
+
+	struct delayed_work cp_free_dwork;	/* to hold ap2cp_wakeup */
+	bool hold_requested;
+
+	struct pm_wdog wdog;
+
+	struct pm_stats stats;
+};
+
+const char *pm_state2str(enum pm_state state);
+const char *pm_event2str(enum pm_event event);
+
+int init_link_device_pm(struct link_device *ld, struct modem_link_pm *pm,
+			struct link_pm_svc *pm_svc,
+			struct gpio_desc *cp2ap_wakeup,
+			struct gpio_desc *ap2cp_wakeup,
+			struct gpio_desc *cp2ap_status,
+			struct gpio_desc *ap2cp_status,
+			void (*fail_fn)(struct modem_link_pm *),
+			void (*cp_fail_fn)(struct modem_link_pm *));
+
+void start_link_pm(struct modem_link_pm *pm, enum pm_event event);
+void stop_link_pm(struct modem_link_pm *pm);
+void link_pm_request_hold(struct modem_link_pm *pm);
+bool link_pm_active(struct modem_link_pm *pm);
+
+/* the CP2AP interrupts, with the level the handler read */
+void link_pm_cp2ap_wakeup(struct modem_link_pm *pm, int level);
+void link_pm_cp2ap_status(struct modem_link_pm *pm, int level);
+
+void link_pm_status_show(struct modem_link_pm *pm, struct seq_file *s);
+
+#endif
