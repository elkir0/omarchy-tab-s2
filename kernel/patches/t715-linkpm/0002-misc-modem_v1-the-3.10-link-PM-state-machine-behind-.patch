@@ -103,14 +156,52 @@ static bool check_link_status(struct mem_link_device *mld)
 	- forbid/permit_cp_sleep keep only the reference count: the lines are
 	  already held.  The 3.10 non-FSM doorbell handler raised AP2CP_WAKEUP
 	  on every CP doorbell; the FSM build did not, nor does this one.
+
+	pm_mode=fsm (mld->pm_fsm for the CP session): start_pm, stop_pm,
+	forbid/permit_cp_sleep and check_link_status are the 3.10 FSM build's
+	(3.10 link_device_lli.c:106-258), over link_device_pm.c; the CP2AP
+	handlers below give the line's level to the FSM; a CP2AP storm also
+	raises MDM_CRASH_PM_FAIL, since the FSM would no longer hear the CP; a
+	send waiting LPM_TX_STALL_MS for the link raises it too.
 \*============================================================================*/
+static void pm_fail_cb(struct modem_link_pm *pm);
+
 static void forbid_cp_sleep(struct mem_link_device *mld, int flag)
 {
+	struct modem_link_pm *pm = &mld->lpm;
+
+	if (mld->pm_fsm) {
+		/* 3.10 FSM build: one hold request until permit_cp_sleep */
+		if (atomic_read(&pm->ref_cnt) >= 1) {
+			/* the SBD timer comes back while the send waits */
+			if (!mld->lpm_stalled && !check_link_status(mld) &&
+			    time_after(jiffies, mld->lpm_hold_since +
+				       msecs_to_jiffies(LPM_TX_STALL_MS))) {
+				mld->lpm_stalled = true;
+				mif_err("%s: link PM: a send waited %d ms for the link (FSM %s): CP session ends\n",
+					mld->link_dev.name, LPM_TX_STALL_MS,
+					pm_state2str(pm->fsm.state));
+				pm_fail_cb(pm);
+			}
+			return;
+		}
+		mld->lpm_hold_since = jiffies;
+		atomic_or(flag, &pm->ref_cnt);
+		link_pm_request_hold(pm);
+		return;
+	}
+
 	atomic_or(flag, &mld->ref_cnt);
 }
 
 static void permit_cp_sleep(struct mem_link_device *mld, int flag)
 {
+	if (mld->pm_fsm) {
+		/* 3.10 release_hold is empty: AP_FREE checks ref_cnt */
+		atomic_andnot(flag, &mld->lpm.ref_cnt);
+		return;
+	}
+
 	atomic_andnot(flag, &mld->ref_cnt);
 }
 
