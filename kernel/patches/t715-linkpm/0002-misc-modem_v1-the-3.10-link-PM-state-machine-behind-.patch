 	int n = atomic_inc_return(&mc->irq_stats.cp2ap_status);
 
 	mc->irq_stats.last_cp2ap_status_ns = now;
-	pr_info_ratelimited("mif: lli: CP2AP_STATUS %s #%d t=%llu ns\n",
-			    level ? "HIGH" : "LOW", n, now);
+	if (mld->pm_fsm)
+		pr_debug("mif: lli: CP2AP_STATUS %s #%d t=%llu ns\n",
+			 level ? "HIGH" : "LOW", n, now);
+	else
+		pr_info_ratelimited("mif: lli: CP2AP_STATUS %s #%d t=%llu ns\n",
+				    level ? "HIGH" : "LOW", n, now);
 
-	cp2ap_storm_guard(mld);
+	if (!cp2ap_storm_guard(mld) && mld->pm_fsm)
