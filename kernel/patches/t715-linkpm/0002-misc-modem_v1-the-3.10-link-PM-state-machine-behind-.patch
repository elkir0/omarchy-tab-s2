 /* more CP2AP edges than this within 1 s disable both CP2AP IRQs */
 #define CP2AP_STORM_EDGES	1000
 
+/*
+ * pm_mode=fsm: a send that has waited this long for the link ends the CP
+ * session (MDM_CRASH_PM_FAIL, then the loader's silent reset).  Covers what
+ * no FSM watchdog sees: a mount that failed after CP2AP_STATUS went high
