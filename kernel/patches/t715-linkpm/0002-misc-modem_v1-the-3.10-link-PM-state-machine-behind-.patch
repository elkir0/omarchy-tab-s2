+	else
+		mif_info("%s: PM %s <%ps>\n", ld->name, FUNC, CALLER);
 	if (!lli_hw_ok())
 		return;
 	mipi_lli_reload();
@@ -379,8 +600,6 @@ static void lli_irq_handler(void *data, u32 intr)
 	mem_irq_handler(mld, msb);
 }
 
