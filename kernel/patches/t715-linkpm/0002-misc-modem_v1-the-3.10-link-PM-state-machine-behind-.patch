+/*
+ * pm_mode=fsm: 3.10 FSM build's start_pm with pm_enable=1.  Only with both
+ * CP2AP IRQs live: after a storm before PHONE_START the FSM would be deaf,
+ * so the session keeps the locked-on PM (false).
+ */
+static bool start_pm_fsm(struct mem_link_device *mld)
+{
+	struct modem_ctl *mc = mld->link_dev.mc;
+
+	if ((mc && mc->irq_stats.cp2ap_storm) || !mld->irq_ap_wakeup.active ||
+	    !mld->irq_cp_status.active) {
+		mif_err("%s: link PM: CP2AP IRQs not live at PHONE_START: this session stays locked on\n",
+			mld->link_dev.name);
+		return false;
+	}
+
+	mld->lpm_stalled = false;
+	mld->pm_fsm = true;
+	start_link_pm(&mld->lpm, PM_EVENT_CP_BOOTING);
+	print_pm_status(mld);
+	return true;
+}
+
 static void start_pm(struct mem_link_device *mld)
 {
 	unsigned long flags;
 	bool first = false;
 
+	if (READ_ONCE(pm_mode_fsm) && mld->lpm_ready && start_pm_fsm(mld))
+		return;
+
 	spin_lock_irqsave(&mld->pm_lock, flags);
 
 	if (!mld->pm_locked_on) {
@@ -268,6 +401,12 @@ static void stop_pm(struct mem_link_device *mld)
 	/* CP2AP IRQs off before any CP_RESET/CP_ON change (review D2-b) */
 	lli_stop_monitor(&mld->link_dev);
 
+	/* pm_mode=fsm: the FSM first, then the lines low as in lockon */
+	if (mld->pm_fsm) {
+		stop_link_pm(&mld->lpm);
+		mld->pm_fsm = false;
+	}
+
 	spin_lock_irqsave(&mld->pm_lock, flags);
 
 	mif_gpio_set_value(mld->gpio_cp_wakeup, 0);
@@ -283,8 +422,57 @@ static void stop_pm(struct mem_link_device *mld)
 	print_pm_status(mld);
 }
 
+/*
+ * The FSM's fail handlers act only on a CP that is ONLINE, or BOOTING
+ * between PHONE_START and BOOT_DONE.  OFFLINE: a power-off is under way
+ * (__ss333_off sets OFFLINE, then waits up to 3 s before ld->off stops the
+ * FSM); a crash then would arm crash_ack_timer on a CP being switched off.
+ * CRASH_EXIT/RESET: the crash path already runs.
+ */
+static bool pm_fail_wanted(struct modem_ctl *mc)
+{
+	unsigned long flags;
+	bool want;
+
+	spin_lock_irqsave(&mc->lock, flags);
+	want = cp_online(mc) || cp_booting(mc);
+	spin_unlock_irqrestore(&mc->lock, flags);
+
+	return want;
+}
+
+static void pm_fail_cb(struct modem_link_pm *pm)
+{
+	if (!pm_fail_wanted(pm->ld->mc))
+		return;
+
+	modemctl_notify_event(MDM_CRASH_PM_FAIL);
+}
+
+/*
+ * 3.10 pm_cp_fail_cb: stop the FSM, then the crash.  The 3.10 CP_BOOTING
+ * branch (OFFLINE, then a reload) is the loader's here: it sees the crash
+ * and powers the CP off.
+ */
+static void pm_cp_fail_cb(struct modem_link_pm *pm)
+{
+	struct link_device *ld = pm->ld;
+	struct mem_link_device *mld = ld_to_mem_link_device(ld);
+
+	if (!pm_fail_wanted(ld->mc))
+		return;
+
+	if (mld->stop_pm)
+		mld->stop_pm(mld);
+
+	modemctl_notify_event(MDM_CRASH_PM_CP_FAIL);
+}
+
 static int init_pm(struct mem_link_device *mld)
 {
+	struct link_device *ld = &mld->link_dev;
+	int err;
+
 	mif_info("CP2AP_WAKEUP, AP2CP_WAKEUP, CP2AP_STATUS, AP2CP_STATUS: GPIO descriptors, IRQs at allow_hw 0->1\n");
 
 	wake_lock_init(&mld->ap_wlock, WAKE_LOCK_SUSPEND, "lli_ap_wlock");
@@ -294,9 +482,38 @@ static int init_pm(struct mem_link_device *mld)
 	atomic_set(&mld->ref_cnt, 0);
 	mld->pm_locked_on = false;
 
+	/* pm_mode=fsm: set up, idle until a PHONE_START in that mode */
+	mld->pm_fsm = false;
+	err = init_link_device_pm(ld, &mld->lpm, mipi_lli_get_pm_svc(),
+				  mld->gpio_ap_wakeup, mld->gpio_cp_wakeup,
+				  mld->gpio_cp_status, mld->gpio_ap_status,
+				  pm_fail_cb, pm_cp_fail_cb);
+	if (err)
+		mif_err("%s: link PM FSM unavailable (%d): pm_mode=fsm acts as lockon\n",
+			ld->name, err);
+	else
+		mld->lpm_ready = true;
+
 	return 0;
 }
 
+/* debugfs ss333/status (modem_ctrl_ss333.c) */
+void lli_pm_status_show(struct link_device *ld, struct seq_file *s)
+{
+	struct mem_link_device *mld;
+
+	if (!ld)
+		return;
+	mld = ld_to_mem_link_device(ld);
+
+	seq_printf(s, "link pm: next session %s, this session %s, locked on %d, send stall %d\n",
+		   READ_ONCE(pm_mode_fsm) ? "fsm" : "lockon",
+		   mld->pm_fsm ? "fsm" : "lockon", mld->pm_locked_on,
+		   mld->lpm_stalled);
+	if (mld->lpm_ready)
+		link_pm_status_show(&mld->lpm, s);
+}
