 only)

---
 .../samsung/exynos5433-gts28ltexx-camera.dtsi | 52 ++++++++++++
 drivers/clk/samsung/clk-exynos5433.c          |  2 +-
 drivers/misc/t715-cam-capture.c               | 79 +++++++++++++------
 3 files changed, 109 insertions(+), 24 deletions(-)

diff --git a/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx-camera.dtsi b/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx-camera.dtsi
