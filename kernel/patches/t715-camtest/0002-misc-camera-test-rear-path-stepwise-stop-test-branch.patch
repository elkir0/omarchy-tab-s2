 		reg = <0x12130000 0x1000>, <0x12110000 0x1000>, <0x12160000 0x1000>;
 		phys = <&mipi_phy 2>;
 		phy-names = "csis";
@@ -148,4 +153,51 @@ cam-capture@12130000 {
 		assigned-clock-rates = <0>, <0>, <0>, <0>, <0>, <0>,
 				       <400000000>, <400000000>, <200000000>;
 	};
+
+	/* Rear: CSIS0 to FIMC-LITE A, 4 lanes, on the 400 MHz branch. */
+	cam-capture@12120000 {
+		compatible = "samsung,t715-cam-capture";
+		label = "rear";
+		t715,lanes = <4>;
+		t715,settle = <15>;
+		t715,width = <1640>;
+		t715,height = <1228>;
+		reg = <0x12120000 0x1000>, <0x12100000 0x1000>, <0x12150000 0x1000>;
+		phys = <&mipi_phy 0>;
+		phy-names = "csis";
+		power-domains = <&pd_cam0>;
+
+		clocks = <&cmu_cam0 CLK_ACLK_CSIS0>, <&cmu_cam0 CLK_PCLK_CSIS0>,
+			 <&cmu_cam0 CLK_ACLK_LITE_A>, <&cmu_cam0 CLK_PCLK_LITE_A>,
+			 <&cmu_cam0 CLK_ACLK_AXIUS_LITE_A>,
+			 <&cmu_cam0 CLK_ACLK_ASYNCAPBM_LITE_A>, <&cmu_cam0 CLK_ACLK_ASYNCAPBS_LITE_A>,
+			 <&cmu_cam0 CLK_ACLK_ASYNCAXIM_LITE_A>, <&cmu_cam0 CLK_ACLK_ASYNCAXIS_LITE_A>,
+			 <&cmu_cam0 CLK_ACLK_SMMU_LITE_A>, <&cmu_cam0 CLK_PCLK_SMMU_LITE_A>,
+			 <&cmu_cam0 CLK_ACLK_BTS_LITE_A>, <&cmu_cam0 CLK_PCLK_BTS_LITE_A>,
+			 <&cmu_cam0 CLK_PCLK_ASYNCAXI_LITE_A>,
+			 <&cmu_cam0 CLK_ACLK_XIU_IS0X>, <&cmu_cam0 CLK_ACLK_XIU_ISP0EX>,
+			 <&cmu_cam0 CLK_ACLK_CAM0ND_400>, <&cmu_cam0 CLK_ACLK_CAM0NP_276>,
+			 <&cmu_cam0 CLK_ACLK_AHBSYNCDN>, <&cmu_cam0 CLK_PCLK_SYSREG_CAM0>,
+			 <&cmu_cam0 CLK_PCLK_PMU_CAM0>,
+			 <&cmu_cam0 CLK_PHYCLK_RXBYTECLKHS0_S4>;
+
+		assigned-clocks = <&cmu_cam0 CLK_MOUT_ACLK_CAM0_400_USER>,
+				  <&cmu_cam0 CLK_MOUT_PHYCLK_RXBYTECLKHS0_S4_USER>,
+				  <&cmu_cam0 CLK_MOUT_ACLK_CSIS0_A>,
+				  <&cmu_cam0 CLK_MOUT_ACLK_CSIS0_B>,
+				  <&cmu_cam0 CLK_MOUT_ACLK_LITE_A_A>,
+				  <&cmu_cam0 CLK_MOUT_ACLK_LITE_A_B>,
+				  <&cmu_cam0 CLK_DIV_ACLK_CSIS0>,
+				  <&cmu_cam0 CLK_DIV_ACLK_LITE_A>,
+				  <&cmu_cam0 CLK_DIV_PCLK_LITE_A>;
+		assigned-clock-parents = <&cmu_top CLK_ACLK_CAM0_400>,
+					 <&cmu_cam0 CLK_PHYCLK_RXBYTEECLKHS0_S4_PHY>,
+					 <&cmu_cam0 CLK_MOUT_ACLK_CAM0_400_USER>,
+					 <&cmu_cam0 CLK_MOUT_ACLK_CSIS0_A>,
+					 <&cmu_cam0 CLK_MOUT_ACLK_CAM0_400_USER>,
+					 <&cmu_cam0 CLK_MOUT_ACLK_LITE_A_A>,
+					 <0>, <0>, <0>;
+		assigned-clock-rates = <0>, <0>, <0>, <0>, <0>, <0>,
+				       <400000000>, <400000000>, <200000000>;
+	};
 };
diff --git a/drivers/clk/samsung/clk-exynos5433.c b/drivers/clk/samsung/clk-exynos5433.c
