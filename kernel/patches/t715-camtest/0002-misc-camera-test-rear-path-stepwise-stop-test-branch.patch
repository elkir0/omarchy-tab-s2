@@ -109,6 +109,11 @@ t715_cam2_mclk_off: t715-cam2-mclk-off-pins {
 &soc {
 	cam-capture@12130000 {
 		compatible = "samsung,t715-cam-capture";
+		label = "front";
+		t715,lanes = <1>;
+		t715,settle = <16>;
