@@ -0,0 +1,151 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Camera stage (a). See docs/hardware/CAMERA.md. */
+
+/ {
+	aliases {
+		i2c4 = &hsi2c_4;
+		i2c21 = &i2c_cam_rear;
+		i2c22 = &i2c_cam_front;
+	};
+
+	/* Stock: live_fdt.dts:6057 pins; bit-banging ch0 is not proven by stock. */
+	i2c_cam_rear: i2c-cam-rear {
+		compatible = "i2c-gpio";
+		sda-gpios = <&gpc2 0 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		scl-gpios = <&gpc2 1 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		i2c-gpio,delay-us = <2>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+	};
+
+	/* Stock i2c@35: live_fdt.dts:3329-3335. */
+	i2c_cam_front: i2c-cam-front {
+		compatible = "i2c-gpio";
+		sda-gpios = <&gpc2 4 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		scl-gpios = <&gpc2 5 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		i2c-gpio,delay-us = <2>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+	};
+
+	cam-probe {
+		compatible = "samsung,t715-cam-probe";
+		power-domains = <&pd_cam0>;
+
+		a28-supply = <&ldo29_reg>;	/* CAM_SEN_A2.8V_AP */
+		core-supply = <&ldo23_reg>;	/* 1.30 V, as stock */
+		af-supply = <&ldo26_reg>;	/* CAM_AF_2.8V_AP */
+		io-supply = <&ldo22_reg>;	/* CAM_IO_1.8V_AP */
+		vt28-supply = <&ldo27_reg>;	/* VT_CAM_2.8V */
+		vt18-supply = <&ldo21_reg>;	/* VT_CAM_1.8V */
+
+		rear-reset-gpios = <&gpc0 4 GPIO_ACTIVE_LOW>;
+		front-reset-gpios = <&gpc0 3 GPIO_ACTIVE_LOW>;
+		front-stby-gpios = <&gpc0 0 GPIO_ACTIVE_HIGH>;
+
+		clocks = <&cmu_top CLK_SCLK_ISP_SENSOR0>,
+			 <&cmu_top CLK_SCLK_ISP_SENSOR2>;
+		clock-names = "mclk0", "mclk2";
+		assigned-clocks = <&cmu_top CLK_MOUT_SCLK_ISP_SENSOR0>,
+				  <&cmu_top CLK_DIV_SCLK_ISP_SENSOR0_A>,
+				  <&cmu_top CLK_DIV_SCLK_ISP_SENSOR0_B>,
+				  <&cmu_top CLK_MOUT_SCLK_ISP_SENSOR2>,
+				  <&cmu_top CLK_DIV_SCLK_ISP_SENSOR2_A>,
+				  <&cmu_top CLK_DIV_SCLK_ISP_SENSOR2_B>;
+		assigned-clock-parents = <&xxti>, <0>, <0>, <&xxti>, <0>, <0>;
+		assigned-clock-rates = <0>, <24000000>, <24000000>,
+				       <0>, <24000000>, <24000000>;
+
+		pinctrl-names = "default", "rear", "front";
+		pinctrl-0 = <&t715_cam0_mclk_off &t715_cam2_mclk_off>;
+		pinctrl-1 = <&t715_cam0_mclk &t715_cam2_mclk_off>;
+		pinctrl-2 = <&t715_cam0_mclk_off &t715_cam2_mclk>;
+	};
+};
+
+&hsi2c_4 {
+	status = "okay";
+};
+
+/* Stock pin-pud = 0, live_fdt.dts:5277-5284. */
+&hs_i2c4_bus {
+	samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+};
+
+&pinctrl_peric {
+	/* Raw drive strengths from live_fdt.dts:5892, 6923. */
+	t715_cam0_mclk: t715-cam0-mclk-pins {
+		samsung,pins = "gpd7-0";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <1>;
+	};
+
+	t715_cam0_mclk_off: t715-cam0-mclk-off-pins {
+		samsung,pins = "gpd7-0";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
+		samsung,pin-drv = <0>;
+		samsung,pin-val = <0>;
+	};
+
+	t715_cam2_mclk: t715-cam2-mclk-pins {
+		samsung,pins = "gpd7-2";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <2>;
+	};
+
+	t715_cam2_mclk_off: t715-cam2-mclk-off-pins {
+		samsung,pins = "gpd7-2";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
+		samsung,pin-drv = <0>;
+		samsung,pin-val = <0>;
+	};
+};
+
+/* Stages (b) and (c): t715-cam-capture.ko, front sensor, CSIS1 to FIMC-LITE B. */
+&soc {
+	cam-capture@12130000 {
+		compatible = "samsung,t715-cam-capture";
+		reg = <0x12130000 0x1000>, <0x12110000 0x1000>, <0x12160000 0x1000>;
+		phys = <&mipi_phy 2>;
+		phy-names = "csis";
+		power-domains = <&pd_cam0>;
+
+		clocks = <&cmu_cam0 CLK_ACLK_CSIS1>, <&cmu_cam0 CLK_PCLK_CSIS1>,
+			 <&cmu_cam0 CLK_ACLK_LITE_B>, <&cmu_cam0 CLK_PCLK_LITE_B>,
+			 <&cmu_cam0 CLK_ACLK_AXIUS_LITE_B>,
+			 <&cmu_cam0 CLK_ACLK_ASYNCAPBM_LITE_B>, <&cmu_cam0 CLK_ACLK_ASYNCAPBS_LITE_B>,
+			 <&cmu_cam0 CLK_ACLK_ASYNCAXIM_LITE_B>, <&cmu_cam0 CLK_ACLK_ASYNCAXIS_LITE_B>,
+			 <&cmu_cam0 CLK_ACLK_SMMU_LITE_B>, <&cmu_cam0 CLK_PCLK_SMMU_LITE_B>,
+			 <&cmu_cam0 CLK_ACLK_BTS_LITE_B>, <&cmu_cam0 CLK_PCLK_BTS_LITE_B>,
+			 <&cmu_cam0 CLK_PCLK_ASYNCAXI_LITE_B>,
+			 <&cmu_cam0 CLK_ACLK_XIU_IS0X>, <&cmu_cam0 CLK_ACLK_XIU_ISP0EX>,
+			 <&cmu_cam0 CLK_ACLK_CAM0ND_400>, <&cmu_cam0 CLK_ACLK_CAM0NP_276>,
+			 <&cmu_cam0 CLK_ACLK_AHBSYNCDN>, <&cmu_cam0 CLK_PCLK_SYSREG_CAM0>,
+			 <&cmu_cam0 CLK_PCLK_PMU_CAM0>,
+			 <&cmu_cam0 CLK_PHYCLK_RXBYTECLKHS0_S2A>;
+
+		/* setup-fimc-is-sensor.c, channel 1. */
+		assigned-clocks = <&cmu_cam0 CLK_MOUT_ACLK_CAM0_400_USER>,
+				  <&cmu_cam0 CLK_MOUT_PHYCLK_RXBYTECLKHS0_S2A_USER>,
+				  <&cmu_cam0 CLK_MOUT_ACLK_CSIS1_A>,
+				  <&cmu_cam0 CLK_MOUT_ACLK_CSIS1_B>,
+				  <&cmu_cam0 CLK_MOUT_ACLK_LITE_B_A>,
+				  <&cmu_cam0 CLK_MOUT_ACLK_LITE_B_B>,
+				  <&cmu_cam0 CLK_DIV_ACLK_CSIS1>,
+				  <&cmu_cam0 CLK_DIV_ACLK_LITE_B>,
+				  <&cmu_cam0 CLK_DIV_PCLK_LITE_B>;
+		assigned-clock-parents = <&cmu_top CLK_ACLK_CAM0_400>,
+					 <&cmu_cam0 CLK_PHYCLK_RXBYTEECLKHS0_S2A_PHY>,
+					 <&cmu_cam0 CLK_MOUT_ACLK_CAM0_400_USER>,
+					 <&cmu_cam0 CLK_MOUT_ACLK_CSIS1_A>,
+					 <&cmu_cam0 CLK_MOUT_ACLK_CAM0_400_USER>,
+					 <&cmu_cam0 CLK_MOUT_ACLK_LITE_B_A>,
+					 <0>, <0>, <0>;
+		assigned-clock-rates = <0>, <0>, <0>, <0>, <0>, <0>,
+				       <400000000>, <400000000>, <200000000>;
+	};
+};
