index 000000000..81e5f5b60
--- /dev/null
+++ b/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx-bt.dtsi
@@ -0,0 +1,124 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Samsung Galaxy Tab S2 8.0 LTE (SM-T715), Exynos5433 - Bluetooth
+ *
+ * Broadcom BCM4358 Bluetooth on UART3 (hci_bcm over serdev), validated on
+ * the tablet on 2026-10-28 (patched firmware 0144, scan OK).  UART3 lives
+ * inside the LPASS block; its device appears once the exynos-lpass MFD
+ * driver is bound, and that driver keeps LPASS runtime-active while the
+ * UART is enabled (a suspended LPASS masks the UART interrupt).
+ *
+ * BT_EN (gpd4-0) has a single writer: hci_bcm's shutdown-gpios.  No
+ * vbat/vddio supplies are given to hci_bcm: the binding makes them
+ * optional and the live tree does not name those rails.
+ *
+ * Pins, GPIOs, IRQ and UART come from the device's live device tree
+ * (01_dumps/live_fdt.dts); see docs/WIFI_BT_M5.md (sections 2.2 and 7.4).
+ */
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/clock/samsung,s2mps11.h>
+
+/ {
+	aliases {
+		serial3 = &serial_3;
+	};
+};
+
+/*
+ * Stock groups cfg-hostwake (live_fdt.dts:438-444), cfg-btwake
+ * (3496-3501) and cfg-en (6196-6201), without the power-down cells.
+ */
+&pinctrl_alive {
+	bt_host_wake_pins: bt-host-wake-pins {
+		samsung,pins = "gpa2-2";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+	};
+};
+
+&pinctrl_fsys {
+	bt_wake_pins: bt-wake-pins {
+		samsung,pins = "gpr3-7";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+	};
+};
+
+&pinctrl_peric {
+	bt_en_pins: bt-en-pins {
+		samsung,pins = "gpd4-0";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
+	};
+};
+
+/*
+ * Bluetooth: stock serial@11460000 (live_fdt.dts:3988-4001) = mainline
+ * serial_3 = ttySAC3 (getprop.txt:240 ro.bluetooth.tty=ttySAC3), with
+ * the stock "broadcom,bcm4358" child (live_fdt.dts:4198-4203).  TM2
+ * wires the same three control pins on the same UART
+ * (exynos5433-tm2-common.dtsi &serial_3 bluetooth node).
+ */
+&serial_3 {
+	status = "okay";
+
+	bluetooth {
+		/*
+		 * No bcm4358 entry in hci_bcm's of_match table
+		 * (hci_bcm.c:1597-1612); brcm,bcm43540-bt carries
+		 * bcm4354_device_data with .no_early_set_baudrate = true,
+		 * matching the stock fixed-baud attach flow: the vendor
+		 * stack opens ttySAC3 at 921600 and loads the .hcd at
+		 * that speed.
+		 *
+		 * No brcm,requires-autobaud-mode: the stock flow never
+		 * autobauds.
+		 */
+		compatible = "brcm,bcm43540-bt";
+
+		/* BT_EN: stock gpio 0 / cfg-en, gpd4-0 (live_fdt.dts:4198
+		 * -4203, 6196-6201). */
+		shutdown-gpios = <&gpd4 0 GPIO_ACTIVE_HIGH>;
+		/* BT_WAKE: stock gpio 1 / cfg-btwake, gpr3-7. */
+		device-wakeup-gpios = <&gpr3 7 GPIO_ACTIVE_HIGH>;
+		/*
+		 * HOST_WAKE: stock gpio 2 / cfg-hostwake, gpa2-2.
+		 * interrupt-names "host-wakeup" is what hci_bcm looks up
+		 * (hci_bcm.c:1245, of_irq_get_byname(node,
+		 * "host-wakeup")); rising edge matches the downstream
+		 * IRQF_TRIGGER_RISING request (bcm4358.c).  interrupts
+		 * rather than the deprecated host-wakeup-gpios.
+		 */
+		interrupt-parent = <&gpa2>;
+		interrupts = <2 IRQ_TYPE_EDGE_RISING>;
+		interrupt-names = "host-wakeup";
+
+		/*
+		 * 32.768 kHz BT clock from the PMIC: s2mps13_osc output 2
+		 * ("s2mps13_bt", exynos5433-gts28ltexx.dts, PMIC section;
+		 * S2MPS11_CLK_BT = 2 in samsung,s2mps11.h).  "extclk" is
+		 * the deprecated spelling of "txco" but resolves through
+		 * bcm_get_txco's fallback (hci_bcm.c:1067-1082) and is
+		 * what TM2 uses; the stock BT node carries no clocks
+		 * property, the source follows the TM2 wiring for the
+		 * same chip family.
+		 */
+		clocks = <&s2mps13_osc S2MPS11_CLK_BT>;
+		clock-names = "extclk";
+
+		/*
+		 * Stock runs 921600 (libbt_vndcfg.txt UART_TARGET_BAUD_RATE),
+		 * but UART3 is clocked at 24 MHz here (sclk_aud_uart from
+		 * oscclk), which gives UBRDIV = 0 at 921600: after the baud
+		 * switch the controller no longer answers (seen on the
+		 * device, 2026-10-28).  460800 gives UBRDIV = 2 (0.16 %
+		 * error) and works.
+		 */
+		max-speed = <460800>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&bt_host_wake_pins &bt_wake_pins &bt_en_pins>;
+	};
+};
