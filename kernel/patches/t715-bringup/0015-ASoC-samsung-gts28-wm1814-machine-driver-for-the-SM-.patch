+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/samsung,gts28-wm1814.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung Galaxy Tab S2 8.0 (SM-T715) audio complex with WM1814 codec
+
+maintainers:
+  - elkir0 <elkir0@users.noreply.github.com>
+
+description:
+  Sound card of the Samsung Galaxy Tab S2 8.0 LTE (SM-T715, Exynos5433),
+  linking the Exynos5433 I2S0 controller to the Cirrus Logic/Wolfson
+  WM1814 codec AIF1. The codec provides the bit and frame clocks; its MCLK1
+  is the 24 MHz PMU CLKOUT.
+
+properties:
+  compatible:
+    const: samsung,gts28-wm1814
+
+  clocks:
+    maxItems: 1
+    description:
+      The codec MCLK1 clock (PMU CLKOUT). It is kept enabled while the
+      codec FLL1 runs.
+
+  clock-names:
+    items:
+      - const: mclk
+
+  samsung,audio-codec:
+    description: Phandle to the WM1814 audio codec.
+    $ref: /schemas/types.yaml#/definitions/phandle
+
+  samsung,audio-cpu:
+    description: Phandle to the Exynos5433 I2S0 controller.
+    $ref: /schemas/types.yaml#/definitions/phandle
+
+  samsung,model:
+    description: The user-visible name of this sound complex.
+    $ref: /schemas/types.yaml#/definitions/string
+
+required:
+  - compatible
+  - samsung,audio-codec
+  - samsung,audio-cpu
+  - samsung,model
+
+dependencies:
+  clock-names: [ clocks ]
+
+additionalProperties: false
+
+examples:
+  - |
+    sound {
+        compatible = "samsung,gts28-wm1814";
+        samsung,model = "wm1814";
+        samsung,audio-cpu = <&i2s0>;
+        samsung,audio-codec = <&wm1814>;
+        clocks = <&pmu_system_controller 0>;
+        clock-names = "mclk";
+    };
