-# dma-bufs, e.g. panfrost buffers for a compositor's direct scanout.
-# EXYNOS_IOMMU is a bool (built in); its probe only reads the version
-# register of a powered, clocked System MMU.  It selects IOMMU_API and,
-# on arm32, ARM_DMA_USE_IOMMU (drivers/iommu/Kconfig:256-262).
-CONFIG_IOMMU_SUPPORT=y
-CONFIG_EXYNOS_IOMMU=y
