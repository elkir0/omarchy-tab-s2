index 1071ffff3..000000000
--- a/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx-iommu.dtsi
+++ /dev/null
@@ -1,117 +0,0 @@
-// SPDX-License-Identifier: GPL-2.0
-/*
- * Samsung Galaxy Tab S2 8.0 LTE (SM-T715), Exynos5433 - DECON System MMU.
- *
- * Lets exynos-drm translate DECON's DMA through its two System MMUs, so
- * that it can import non-contiguous dma-bufs (panfrost client buffers)
- * and scan them out.
- * (CONFIG_EXYNOS_IOMMU=y in gts28ltexx_defconfig).  Analysis, risks and
- * test plan: docs/IOMMU.md.  Included by the board file (section 10).
- *
- * DECON (exynos5433.dtsi decon@13800000) already lists both System MMUs:
- *	iommus = <&sysmmu_decon0x>, <&sysmmu_decon1x>;
- * Its five windows are split between the two AXI ports: M0 behind
- * sysmmu@13a00000 serves windows 0-2 (stock "winmap = <0x07>"), M1
- * behind sysmmu@13a10000 serves windows 3-4 ("winmap = <0x18>",
- * 01_dumps/live_fdt.dts:1482-1491 and 1527-1536).  exynos-drm uses
- * window 2 as the primary plane and window 4 as the cursor plane
- * (exynos5433_drm_decon.c PRIMARY_WIN/CURSON_WIN), so both are needed.
- * Both sit in the DISP power domain and are clocked from cmu_disp, like
- * DECON itself.
- */
-
-&sysmmu_decon0x {
-	status = "okay";
-};
-
-&sysmmu_decon1x {
-	status = "okay";
-};
-
-/*
- * Every other System MMU of the SoC dtsi has no status, hence is enabled,
- * and would probe as soon as CONFIG_EXYNOS_IOMMU=y: the driver powers its
- * domain, enables its clocks and reads its version register at probe.
- * None of their masters has a driver in this kernel (no MEDIA_SUPPORT,
- * no DRM_EXYNOS_GSC/SCALER) and none of these register accesses has ever
- * run on this board, so they are not probed at all.
- *
- * The masters are disabled together with their System MMUs: a master
- * whose System MMU is disabled runs without IOMMU, and the exynos-drm GSC
- * and scaler drivers ignore the result of exynos_drm_register_dma()
- * (exynos_drm_gsc.c:1178, exynos_drm_scaler.c:457), so enabling one of
- * them later would let it DMA to DECON's IO virtual addresses as if they
- * were physical.  Re-enable a master only together with its System MMU.
- */
-
-/* decon_tv (HDMI path) is already disabled in the SoC dtsi. */
-&sysmmu_tv0x {
-	status = "disabled";
-};
-
-&sysmmu_tv1x {
-	status = "disabled";
-};
-
-/* GSCALER 0-2, pd_gscl. */
-&gsc_0 {
-	status = "disabled";
-};
-
-&gsc_1 {
-	status = "disabled";
-};
-
-&gsc_2 {
-	status = "disabled";
-};
-
-&sysmmu_gscl0 {
-	status = "disabled";
-};
-
-&sysmmu_gscl1 {
-	status = "disabled";
-};
-
-&sysmmu_gscl2 {
-	status = "disabled";
-};
-
-/* M2M scalers and JPEG, pd_mscl. */
-&scaler_0 {
-	status = "disabled";
-};
-
-&scaler_1 {
-	status = "disabled";
-};
-
-&jpeg {
-	status = "disabled";
-};
-
-&sysmmu_scaler_0 {
-	status = "disabled";
-};
-
-&sysmmu_scaler_1 {
-	status = "disabled";
-};
-
-&sysmmu_jpeg {
-	status = "disabled";
-};
-
-/* MFC video codec, pd_mfc. */
-&mfc {
-	status = "disabled";
-};
-
-&sysmmu_mfc_0 {
-	status = "disabled";
-};
-
-&sysmmu_mfc_1 {
-	status = "disabled";
-};
