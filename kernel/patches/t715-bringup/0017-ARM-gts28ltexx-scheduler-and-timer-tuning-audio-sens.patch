+CONFIG_SND=m
+CONFIG_SND_SOC=m
+CONFIG_SND_SOC_SAMSUNG=m
+CONFIG_SND_SAMSUNG_I2S=m
+CONFIG_MFD_ARIZONA_I2C=m
