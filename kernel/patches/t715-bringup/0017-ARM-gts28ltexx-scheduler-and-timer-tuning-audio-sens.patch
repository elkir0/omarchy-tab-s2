+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Samsung Galaxy Tab S2 8.0 LTE (SM-T715): SM5703 fuel gauge.
+ *
+ * From the stock device tree read from the device (01_dumps/live_fdt.dts):
+ *   lines 1617-1643: hsi2c@14EF0000 (mainline hsi2c_7, i2c@14ef0000),
+ *     pins gpd2-7/gpd2-6 function 4 (same as mainline hs_i2c7_bus),
+ *     no clock-frequency (100 kHz), child sm5703-fuelgauge@71,
+ *     compatible "samsung,sm5703-fuelgauge".
+ *   line 1638: fuelgauge,fuel_int = <&gpa1 4 0> (pins in "fuel-irq",
+ *     lines 350-357).  Not wired here: the mainline driver polls.
+ *   lines 1636-1641: capacity_calculation_type 0x0c, capacity_max 990,
+ *     capacity_max_margin 60, capacity_min 0.  The driver uses the
+ *     990/0 pair as constants (see docs/BATTERY.md).
+ *
+ * The driver is read-only: the gauge keeps the battery model the stock
+ * Android driver loaded into it.
+ */
+
+&hsi2c_7 {
+	status = "okay";
+
+	fuel-gauge@71 {
+		compatible = "siliconmitus,sm5703-fuel-gauge";
+		reg = <0x71>;
+	};
+};
