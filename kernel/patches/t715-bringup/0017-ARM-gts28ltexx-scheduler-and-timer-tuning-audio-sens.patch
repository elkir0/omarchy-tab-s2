+CONFIG_REGULATOR_ARIZONA_MICSUPP=m
+CONFIG_GPIO_ARIZONA=m
+CONFIG_DMADEVICES=y
+CONFIG_PL330_DMA=m
+CONFIG_SND_SOC_SAMSUNG_GTS28_WM1814=m
