+ * All values are transcribed from the device's live device tree
+ * (01_dumps/live_fdt.dts) and mapped onto the mainline bindings; see
+ * docs/AUDIO_M6.md for the value-by-value source table, the
+ * machine-driver specification and the 6b notes.
  */
 
 #include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/interrupt-controller/irq.h>
 #include <dt-bindings/mfd/arizona.h>
 
+/*
+ * Sound card: I2S0 <-> WM1814 AIF1.  Stock node: live_fdt.dts:5344-5352
+ * (compatible "samsung,pacific-arizona", clocks = CLKOUT as "mclk",
+ * samsung,audio-cpu = I2S0, samsung,audio-codec = the WM1814 once per
+ * downstream DAI link).  Only the primary link exists in mainline, so
+ * the codec is listed once.  The model string follows the TM2 precedent
+ * (model = "wm5110", exynos5433-tm2-common.dtsi:126).
+ */
+/ {
+	sound {
+		compatible = "samsung,gts28-wm1814";
+		samsung,model = "wm1814";
+		samsung,audio-cpu = <&i2s0>;
+		samsung,audio-codec = <&wm1814>;
+		clocks = <&pmu_system_controller 0>;
+		clock-names = "mclk";
+	};
+};
+
