+static void exynos5433_core_power_up(unsigned int idx)
+{
+	unsigned int i;
+	u32 val;
+
+	val = pmu_raw_readl(EXYNOS_ARM_CORE_OPTION(idx));
+	val &= ~EXYNOS5_USE_SC_FEEDBACK;		/* stock :100-102, "~(0x2)" */
+	pmu_raw_writel(val, EXYNOS_ARM_CORE_OPTION(idx));
+
+	for (i = 0; i < 4; i++) {			/* stock :104-122 */
+		val = pmu_raw_readl(EXYNOS5433_CORE_DURATION(idx, i));
+		val &= ~EXYNOS5433_DUR_FEEDBACK_MASK;
+		val |= EXYNOS5433_DUR_FEEDBACK_VALUE;
+		pmu_raw_writel(val, EXYNOS5433_CORE_DURATION(idx, i));
+	}
+
+	/* pen value and entry point reach memory before the core runs */
+	wmb();
+
+	val = pmu_raw_readl(EXYNOS_ARM_CORE_CONFIGURATION(idx));
+	val |= EXYNOS5433_CORE_PWR_EN;			/* stock :125-127 */
+	pmu_raw_writel(val, EXYNOS_ARM_CORE_CONFIGURATION(idx));
+}
