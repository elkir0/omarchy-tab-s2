+static int exynos5433_boot_secondary(unsigned int cpu)
+{
+	unsigned long boot_addr = __pa_symbol(exynos4_secondary_startup);
+	u32 mpidr = cpu_logical_map(cpu);
+	u32 core = MPIDR_AFFINITY_LEVEL(mpidr, 0);
+	u32 cluster = MPIDR_AFFINITY_LEVEL(mpidr, 1);
+	unsigned long timeout;
+	unsigned int idx, ms = 0;
+	u32 status;
+	int ret;
+
+	if (!exynos5433_smp_ready)
+		return -ENODEV;
+
+	if (exynos5433_smp_failed) {
+		pr_err("EXYNOS5433: CPU%u: not started: an earlier secondary CPU failed to start\n",
+		       cpu);
+		return -EIO;
+	}
+
+	if (core >= EXYNOS5433_CORES_PER_CLUSTER ||
+	    cluster >= EXYNOS5433_NR_CLUSTERS ||
+	    MPIDR_AFFINITY_LEVEL(mpidr, 2)) {
+		pr_err("EXYNOS5433: CPU%u: unexpected MPIDR 0x%x\n", cpu, mpidr);
+		return -EINVAL;
+	}
+	idx = exynos5433_pmu_core(mpidr);
+
+	ret = exynos5433_check_pen_twin(cpu, mpidr);
+	if (ret)
+		return ret;
+
+	/* entry point in place before the core is powered, as in stock */
+	ret = call_firmware_op(set_cpu_boot_addr, mpidr, boot_addr);
+	if (ret)
+		return ret;
+
+	spin_lock(&boot_lock);
+
+	/* MPIDR[3:0], see exynos5433_check_pen_twin() */
+	exynos_write_pen_release(core);
+
+	/* stock exynos_power_up_cpu(), platsmp.c:102-128 */
+	status = pmu_raw_readl(EXYNOS_ARM_CORE_STATUS(idx));
+	if (exynos5433_core_powered(idx)) {
+		pr_warn("EXYNOS5433: CPU%u: core power already enabled (STATUS 0x%08x)\n",
+			cpu, status);
+	} else {
+		exynos5433_core_power_up(idx);
+
+		/* wait max 10 ms, 1 ms steps: stock platsmp.c:114-127 */
+		while (!exynos5433_core_powered(idx) && ms < 10) {
+			mdelay(1);
+			ms++;
+		}
+		if (!exynos5433_core_powered(idx)) {
+			pr_err("EXYNOS5433: CPU%u: core power-up timed out\n",
+			       cpu);
+			ret = -ETIMEDOUT;
+			goto fail;
+		}
+	}
+	pr_info("EXYNOS5433: CPU%u: MPIDR 0x%03x, PMU core %u powered (STATUS 0x%08x -> 0x%08x, %u ms)\n",
+		cpu, mpidr, idx, status,
+		pmu_raw_readl(EXYNOS_ARM_CORE_STATUS(idx)), ms);
+
+	/*
+	 * Release loop of stock platsmp.c:206-232 for this SoC: rewrite the
+	 * entry point and send an event, for up to 1 s.  No
+	 * call_firmware_op(cpu_boot) (SMC_CMD_CPU1BOOT) and no wake-up IPI:
+	 * the vendor kernel uses neither on Exynos5433 (:221-226).
+	 */
+	timeout = jiffies + (1 * HZ);
+	while (time_before(jiffies, timeout)) {
+		smp_rmb();
+
+		call_firmware_op(set_cpu_boot_addr, mpidr, boot_addr);
+		dsb_sev();
+
+		if (exynos_pen_release == -1)
+			break;
+
+		udelay(10);
+	}
+
+	if (exynos_pen_release != -1) {
+		pr_err("EXYNOS5433: CPU%u: did not leave the holding pen within 1 s\n",
+		       cpu);
+		ret = -ETIMEDOUT;
+		goto fail;
+	}
+
+	spin_unlock(&boot_lock);
+	return 0;
+
+fail:
+	/*
+	 * Unlike stock, park the pen at -1 so that this core, if it shows
+	 * up late, keeps spinning instead of starting with a stale
+	 * secondary_data, and start no further core (its pen value could
+	 * release this one).
+	 */
+	exynos_write_pen_release(-1);
+	exynos5433_smp_failed = true;
+	exynos5433_show_core("failed", idx);
+	spin_unlock(&boot_lock);
+	return ret;
+}
