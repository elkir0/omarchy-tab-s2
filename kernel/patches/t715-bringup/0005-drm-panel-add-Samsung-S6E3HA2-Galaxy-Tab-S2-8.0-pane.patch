+	for (iv = TABS2_IV_MAX - 1; iv > 0; iv--) {
+		v_cnt = tabs2_index_voltage[iv] - tabs2_index_voltage[iv - 1];
+		v_idx = tabs2_index_voltage[iv];
+
+		for (c = 0; c < TABS2_CI_MAX; c++) {
+			v[c] = w->point_voltages[iv][c];
+			v_diff[c] = w->point_voltages[iv - 1][c] -
+				    w->point_voltages[iv][c];
+		}
+
+		if (iv == 1)
+			for (c = 0; c < TABS2_CI_MAX; c++)
+				v_diff[c] = TABS2_VREG - w->point_voltages[iv][c];
+
+		for (i = 0; i < v_cnt; i++, v_idx--) {
+			for (c = 0; c < TABS2_CI_MAX; c++)
+				w->output_voltages[v_idx][c] =
+					v[c] + v_diff[c] * i / v_cnt;
+		}
+	}
+
+	for (c = 0; c < TABS2_CI_MAX; c++)
+		w->output_voltages[0][c] = TABS2_VREG;
+}
+
+/*
+ * init_l_lookup_table(), dynamic_aid.c:189-206; ibr_top is the nit of the
+ * last level, index_brightness_table[IBRIGHTNESS_MAX - 1] (dynamic_aid.c:439)
+ */
+static void tabs2_init_l_lookup_table(struct tabs2_daid_work *w)
+{
+	int ibr_top = tabs2_index_brightness[TABS2_IBR_MAX - 1];
+	int iv;
+
+	for (iv = 0; iv <= TABS2_IV_TOP; iv++)
+		w->l_lookup_table[iv] =
+			TABS2_DIV_100(ibr_top * tabs2_gamma_curve_lut[iv]);
+}
+
+/* min_diff_gray(), dynamic_aid.c:208-229 */
+static int tabs2_min_diff_gray(int in, const int *table, int table_cnt)
+{
+	int ret, i, min, temp;
+
+	ret = min = table[table_cnt] + 1;
+
+	for (i = 0; i <= table_cnt; i++) {
+		temp = table[i] - in;
+		if (temp < 0)
+			temp = -temp;
+
+		if (temp <= min) {
+			min = temp;
+			ret = i;
+		}
+
+		if (i && (in >= table[i - 1]) && (in <= table[i]))
+			break;
+	}
+
+	return ret;
+}
+
+/* calc_l_values(), dynamic_aid.c:231-258 */
+static void tabs2_calc_l_values(struct tabs2_daid_work *w, int ibr)
+{
+	const int *gamma_curve = tabs2_gamma_curve_tables[ibr];
+	int br_base = tabs2_brightness_base[ibr];
+	int iv;
+
+	for (iv = TABS2_IV_MAX - 1; iv >= 0; iv--) {
+		if (iv == TABS2_IV_MAX - 1)
+			w->l_value[iv] = TABS2_MUL_10000(br_base);
+		else
+			w->l_value[iv] = TABS2_DIV_100(br_base *
+					 gamma_curve[tabs2_index_voltage[iv]]);
+	}
+}
+
+/* calc_m_gray_values(), dynamic_aid.c:260-289 */
+static void tabs2_calc_m_gray_values(struct tabs2_daid_work *w, int ibr)
+{
+	int iv;
+
+	for (iv = TABS2_IV_MAX - 1; iv >= 0; iv--) {
+		w->m_gray[iv] = tabs2_min_diff_gray(w->l_value[iv],
+						    w->l_lookup_table,
+						    TABS2_IV_TOP);
+		w->m_gray[iv] += tabs2_offset_gradation[ibr][iv];
+	}
+}
+
+/* calc_m_rgb_voltages(), dynamic_aid.c:291-326 */
+static int tabs2_calc_m_rgb_voltages(struct tabs2_daid_work *w)
+{
+	int iv, c;
+
+	for (iv = TABS2_IV_MAX - 1; iv > 0; iv--) {
+		/* stock indexes output_voltages[] without a bounds check */
+		if (w->m_gray[iv] < 0 || w->m_gray[iv] > TABS2_IV_TOP)
+			return -ERANGE;
+
+		for (c = 0; c < TABS2_CI_MAX; c++)
+			w->m_voltage[iv][c] =
+				w->output_voltages[w->m_gray[iv]][c];
+	}
+
+	/* iv == 0 */
+	for (c = 0; c < TABS2_CI_MAX; c++)
+		w->m_voltage[0][c] = w->point_voltages[0][c];
+
+	return 0;
+}
+
+/* calc_gamma(), dynamic_aid.c:328-389, into w->gamma[] */
+static int tabs2_calc_gamma(struct tabs2_daid_work *w, int ibr)
+{
+	s64 (*mv)[TABS2_CI_MAX] = w->m_voltage;
+	int numerator, denominator;
+	int *res, *mtp;
+	s64 t1, t2;
+	int iv, c;
+
+	for (iv = TABS2_IV_MAX - 1; iv > 0; iv--) {
+		mtp = &w->mtp[iv * TABS2_CI_MAX];
+		res = &w->gamma[iv * TABS2_CI_MAX];
+		numerator = tabs2_gamma_formula[iv][0];
+		denominator = tabs2_gamma_formula[iv][1];
+
+		for (c = 0; c < TABS2_CI_MAX; c++) {
+			if (iv == 1) {
+				t1 = TABS2_VREG - mv[iv][c];
+				t2 = TABS2_VREG - mv[iv + 1][c];
+			} else if (iv == TABS2_IV_MAX - 1) {
+				t1 = TABS2_VREG - mv[iv][c];
+				t2 = TABS2_VREG - TABS2_VREF_H;
+			} else {
+				t1 = mv[0][c] - mv[iv][c];
+				t2 = mv[0][c] - mv[iv + 1][c];
+			}
+			/* stock divides without checking */
+			if (!t2)
+				return -EDOM;
+
+			res[c] = div64_s64((t1 + 1) * denominator, t2) - numerator;
+			res[c] -= mtp[c];
+			res[c] += tabs2_offset_color[ibr][iv * TABS2_CI_MAX + c];
+
+			res[c] = (res[c] < 0) ? 0 : res[c];
+
+			if ((res[c] > 255) && (iv != TABS2_IV_MAX - 1))
+				res[c] = 255;
+		}
+	}
+
+	/* iv == 0 */
+	for (c = 0; c < TABS2_CI_MAX; c++)
+		w->gamma[c] = tabs2_gamma_default[c];
+
+	return 0;
+}
+
+/*
+ * "relocate gamma order", init_gamma_table() lcd.c:880 and 896-914: 0xCA,
+ * then V255 R,G,B as (bit 8, low byte) pairs, then V203 .. V3 and VT one
+ * byte per colour.  The last two bytes stay 0 (kzalloc, lcd.c:874).
+ */
+static void tabs2_gamma_to_payload(const int gamma[TABS2_IV_MAX * TABS2_CI_MAX],
+				   u8 out[TABS2_GAMMA_PARAM_SIZE])
+{
+	const int *pgamma;
+	int c, j, v;
+
+	for (j = 0; j < TABS2_GAMMA_PARAM_SIZE; j++)
+		out[j] = 0;
+	out[0] = 0xca;
+
+	v = TABS2_IV_MAX - 1;
+	pgamma = &gamma[v * TABS2_CI_MAX];
+	for (c = 0, j = 1; c < TABS2_CI_MAX; c++, pgamma++) {
+		if (*pgamma & 0x100)
+			out[j++] = 1;
+		else
+			out[j++] = 0;
+
+		out[j++] = *pgamma & 0xff;
+	}
+
+	for (v = TABS2_IV_MAX - 2; v >= 0; v--) {
+		pgamma = &gamma[v * TABS2_CI_MAX];
+		for (c = 0; c < TABS2_CI_MAX; c++, pgamma++)
+			out[j++] = *pgamma;
+	}
+}
+
+/*
+ * init_gamma_table() + dynamic_aid() (lcd.c:841-919, dynamic_aid.c:424-503):
+ * build the 0xCA payload of every level from the raw 0xC8 read-back.
+ * Returns 0, or -ERANGE / -EDOM where stock would index out of bounds /
+ * divide by zero (table is then left partially filled; do not use it).
+ */
+static int tabs2_calc_gamma_table(const u8 mtp_raw[TABS2_MTP_LEN],
+				  u8 table[TABS2_IBR_MAX][TABS2_GAMMA_PARAM_SIZE],
+				  struct tabs2_daid_work *w)
+{
+	int ibr, ret;
+
+	tabs2_decode_mtp(mtp_raw, w->mtp);
+
+	/* calc_voltage_table(), dynamic_aid.c:174-187 */
+	ret = tabs2_calc_point_voltages(w);
+	if (ret)
+		return ret;
+	tabs2_calc_output_voltages(w);
+
+	/* calc_gamma_table(), dynamic_aid.c:391-422 */
+	tabs2_init_l_lookup_table(w);
+	for (ibr = 0; ibr < TABS2_IBR_MAX; ibr++) {
+		tabs2_calc_l_values(w, ibr);
+		tabs2_calc_m_gray_values(w, ibr);
+		ret = tabs2_calc_m_rgb_voltages(w);
+		if (ret)
+			return ret;
+		ret = tabs2_calc_gamma(w, ibr);
+		if (ret)
+			return ret;
+		tabs2_gamma_to_payload(w->gamma, table[ibr]);
+	}
+
+	return 0;
+}
+
+#endif /* _PANEL_SAMSUNG_S6E3HA2_TABS2_DIMMING_H */
diff --git a/drivers/gpu/drm/panel/panel-samsung-s6e3ha2-tabs2.c b/drivers/gpu/drm/panel/panel-samsung-s6e3ha2-tabs2.c
new file mode 100644
index 000000000..aec2a33bf
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-samsung-s6e3ha2-tabs2.c
@@ -0,0 +1,954 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MIPI-DSI AMOLED panel driver for the Samsung S6E3HA2 in the
+ * Galaxy Tab S2 8.0 (SM-T715, Exynos5433, board "gts28").
+ *
+ * Every DCS sequence, delay, register read and brightness byte is
+ * transcribed from Samsung's downstream panel driver:
+ *   02_sources/kernel_universal5433/drivers/video/exynos/panels/
+ *     s6e3ha2_tabs2_mipi_lcd.c        (ldi_init/enable/disable order,
+ *                                      probe-time reads, update_brightness)
+ *     s6e3ha2_tabs2_param.h           (SEQ_* command arrays)
+ *     dynamic_aid.c                   (gamma computation)
+ *     dynamic_aid_s6e3ha2_tabs2.h     (brightness -> nit/AID/gamma tables)
+ *   02_sources/kernel_universal5433/drivers/video/exynos/decon_display/
+ *     decon_pm_exynos5430.c           (power/reset sequencing)
+ *     decon_mipi_dsi.c                (DSI read protocol)
+ * The init sequence differs from the TM2 "samsung,s6e3ha2" variant
+ * (panel-samsung-s6e3ha2.c) in several commands (TSP hsync 0xbd first
+ * parameter, Pentile 0xc0 second parameter, PCD 0xcc value, column/page
+ * window), so this is a separate driver rather than an extension.
+ *
+ * Brightness follows the stock "dynamic AID" scheme: the panel's MTP
+ * (factory trim, register 0xC8), ELVSS (0xB6) and TSET (0xB8) are read
+ * back once, the per-level gamma (0xCA) is computed from the MTP with the
+ * stock integer algorithm (panel-samsung-s6e3ha2-tabs2-dimming.h), and
+ * every brightness change is sent with the stock update_brightness()
+ * order: gamma, AID, ELVSS, VINT, gamma-update strobe, ACL, TSET, HBM.
+ */
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+#include <linux/slab.h>
+
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+
+#include "panel-samsung-s6e3ha2-tabs2-dimming.h"
+
+/*
+ * Stock power sequencing, decon_board_gts28 "enable_display_driver_power"
+ * / "reset_display_driver_panel" / "disable_display_driver_power"
+ * (live_fdt.dts:1063-1085, run from decon_pm_exynos5430.c):
+ * enable VDD3_1.8V -> VDDR_1.6V -> VCI_3.0V, wait 10-11 ms, then reset
+ * GPIO gpg0-0: high 5-6 ms, low 5-6 ms, high 5-6 ms (active low in DT).
+ */
+#define TABS2_POWER_ON_DELAY_US_MIN	10000
+#define TABS2_POWER_ON_DELAY_US_MAX	11000
+#define TABS2_RESET_DELAY_US_MIN		5000
+#define TABS2_RESET_DELAY_US_MAX		6000
+
+/* s6e3ha2_tabs2_mipi_lcd.c:1124-1133 (ldi_init) and :1201-1208 (ldi_disable) */
+#define TABS2_SLEEP_OUT_DELAY_US_MIN	5000
+#define TABS2_SLEEP_OUT_DELAY_US_MAX	6000
+#define TABS2_INTERFACE_DELAY_MS		120
+#define TABS2_SLEEP_IN_DELAY_MS		120
+
+/*
+ * Registers read back by the stock driver (s6e3ha2_tabs2_mipi_lcd.c:60-73);
+ * the MTP (0xC8, TABS2_MTP_LEN = 44) and ELVSS (0xB6, TABS2_ELVSS_LEN = 22)
+ * lengths live in the dimming header.
+ */
+#define TABS2_LDI_ID_REG		0x04
+#define TABS2_LDI_ID_LEN		3
+#define TABS2_LDI_CODE_REG		0xd6
+#define TABS2_LDI_CODE_LEN		5
+#define TABS2_LDI_MTP_REG		0xc8
+#define TABS2_LDI_TSET_REG		0xb8
+#define TABS2_LDI_TSET_LEN		8	/* TSET: Global para 8th */
+#define TABS2_TSET_PARAM_SIZE		(TABS2_LDI_TSET_LEN + 1)
+#define TABS2_LDI_ELVSS_REG		0xb6
+#define TABS2_LDI_COORDINATE_REG	0xa1
+#define TABS2_LDI_COORDINATE_LEN	4
+
+/* s6e3ha2_read() tries a read up to 5 times (s6e3ha2_tabs2_mipi_lcd.c:433) */
+#define TABS2_READ_RETRY		5
+
+/*
+ * lcd->temperature = NORMAL_TEMPERATURE = 25 (s6e3ha2_tabs2_mipi_lcd.c:51,
+ * 1684); stock only changes it from a sysfs node written by Android.
+ * > -20 degrees selects TEMP_ABOVE_MINUS_20_DEGREE = 0 (param.h:223-227,
+ * s6e3ha2_set_elvss() :692) and TSET byte = 25 (s6e3ha2_set_tset() :721).
+ */
+#define TABS2_TEMPERATURE		25
+#define TABS2_TEMP_ABOVE_MINUS_20	0
+
+struct s6e3ha2_tabs2 {
+	struct device *dev;
+	struct drm_panel panel;
+	struct backlight_device *bl_dev;
+
+	struct regulator_bulk_data supplies[3];
+	struct gpio_desc *reset_gpio;
+
+	/* Serialises prepare/enable/disable with backlight updates */
+	struct mutex lock;
+	/* lcd->ldi_enable: set between display on and display off */
+	bool ldi_enable;
+
+	/* Values read back from the panel (stock s6e3ha2_probe(), :1734-1741) */
+	u8 id[TABS2_LDI_ID_LEN];
+	u8 code[TABS2_LDI_CODE_LEN];
+	u8 coordinate[TABS2_LDI_COORDINATE_LEN];
+	u8 mtp[TABS2_MTP_LEN];
+	u8 elvss[TABS2_ELVSS_LEN];
+	u8 tset_table[TABS2_TSET_PARAM_SIZE];	/* 0xB8 + 8 read bytes */
+	bool info_read;
+	bool mtp_read;
+	bool elvss_read;
+	bool tset_read;
+
+	/* lcd->gamma_table: one 0xCA command per level, from the MTP */
+	u8 gamma_table[TABS2_IBR_MAX][TABS2_GAMMA_PARAM_SIZE];
+	bool gamma_valid;
+	bool gamma_logged;
+
+	/* update_brightness() state (struct lcd_info, :95-147) */
+	unsigned int brightness;
+	unsigned int bl;
+	unsigned int current_brightness;
+	unsigned int current_bl;
+	u32 current_elvss;
+	u8 current_vint;
+	u8 current_acl;
+	u8 current_hbm;
+};
+
+static int s6e3ha2_tabs2_dcs_write(struct s6e3ha2_tabs2 *ctx,
+				   const void *data, size_t len)
+{
+	struct mipi_dsi_device *dsi = to_mipi_dsi_device(ctx->dev);
+	ssize_t ret;
+
+	/*
+	 * Same packet types as stock s6e3ha2_write() (:388-396): DCS long
+	 * write for > 2 bytes, short write with parameter for 2, short
+	 * write for 1.
+	 */
+	ret = mipi_dsi_dcs_write_buffer(dsi, data, len);
+
+	return ret < 0 ? ret : 0;
+}
+
+#define s6e3ha2_tabs2_dcs_write_seq(ctx, seq...) do {		\
+	static const u8 d[] = { seq };			\
+	int ret;					\
+	ret = s6e3ha2_tabs2_dcs_write(ctx, d, ARRAY_SIZE(d));	\
+	if (ret < 0)					\
+		return ret;				\
+} while (0)
+
+#define s6e3ha2_tabs2_call_write_func(ret, func) do {	\
+	ret = (func);				\
+	if (ret < 0)				\
+		return ret;			\
+} while (0)
+
+/* SEQ_TEST_KEY_ON_F0 / SEQ_TEST_KEY_OFF_F0, param.h:34-42 */
+static int s6e3ha2_tabs2_test_key_on_f0(struct s6e3ha2_tabs2 *ctx)
+{
+	s6e3ha2_tabs2_dcs_write_seq(ctx, 0xf0, 0x5a, 0x5a);
+	return 0;
+}
+
+static int s6e3ha2_tabs2_test_key_off_f0(struct s6e3ha2_tabs2 *ctx)
+{
+	s6e3ha2_tabs2_dcs_write_seq(ctx, 0xf0, 0xa5, 0xa5);
+	return 0;
+}
+
+/* SEQ_TEST_KEY_ON_FC / SEQ_TEST_KEY_OFF_FC, param.h:54-62 */
+static int s6e3ha2_tabs2_test_key_on_fc(struct s6e3ha2_tabs2 *ctx)
+{
+	s6e3ha2_tabs2_dcs_write_seq(ctx, 0xfc, 0x5a, 0x5a);
+	return 0;
+}
+
+static int s6e3ha2_tabs2_test_key_off_fc(struct s6e3ha2_tabs2 *ctx)
+{
+	s6e3ha2_tabs2_dcs_write_seq(ctx, 0xfc, 0xa5, 0xa5);
+	return 0;
+}
+
+/* ------------------------------------------------------------------------
+ * Register read-back
+ */
+
+/*
+ * s6e3ha2_read() (:413-450) on top of s5p_mipi_dsi_rd_data()
+ * (decon_display/decon_mipi_dsi.c:349-354): set the maximum return packet
+ * size to the expected length, send a DCS read (all stock reads are > 2
+ * bytes, so MIPI_DSI_DCS_READ, :423-424), retry up to 5 times until
+ * exactly len bytes come back.
+ */
+static int s6e3ha2_tabs2_read(struct s6e3ha2_tabs2 *ctx, u8 reg, u8 *buf,
+			      size_t len)
+{
+	struct mipi_dsi_device *dsi = to_mipi_dsi_device(ctx->dev);
+	ssize_t ret = -EIO;
+	int retry;
+
+	for (retry = 0; retry < TABS2_READ_RETRY; retry++) {
+		ret = mipi_dsi_set_maximum_return_packet_size(dsi, len);
+		if (ret >= 0)
+			ret = mipi_dsi_dcs_read(dsi, reg, buf, len);
+		if (ret == (ssize_t)len)
+			return 0;
+		dev_dbg(ctx->dev, "read %02xh: %zd, retrying\n", reg, ret);
+	}
+
+	dev_err(ctx->dev, "read %02xh (%zu bytes) failed: %zd\n", reg, len, ret);
+
+	return ret < 0 ? ret : -EIO;
+}
+
+/* init_gamma_table() (:841-944): dynamic AID over all levels */
+static void s6e3ha2_tabs2_init_gamma_table(struct s6e3ha2_tabs2 *ctx)
+{
+	struct tabs2_daid_work *w;
+	int ret, iv, i;
+
+	ctx->gamma_valid = false;
+
+	w = kzalloc(sizeof(*w), GFP_KERNEL);
+	if (!w)
+		return;
+
+	ret = tabs2_calc_gamma_table(ctx->mtp, ctx->gamma_table, w);
+	if (ret) {
+		dev_err(ctx->dev,
+			"dynamic AID: MTP outside the stock tables (%d), keeping the panel gamma\n",
+			ret);
+		goto out;
+	}
+
+	for (iv = 0; iv < TABS2_IV_MAX; iv++)
+		dev_dbg(ctx->dev, "MTP offset V%d: %d %d %d\n",
+			tabs2_index_voltage[iv],
+			w->mtp[iv * TABS2_CI_MAX + TABS2_CI_RED],
+			w->mtp[iv * TABS2_CI_MAX + TABS2_CI_GREEN],
+			w->mtp[iv * TABS2_CI_MAX + TABS2_CI_BLUE]);
+
+	for (i = 0; i < TABS2_IBR_MAX; i++)
+		dev_dbg(ctx->dev, "gamma level %d (%d nit): %*ph\n", i,
+			tabs2_index_brightness[i], TABS2_GAMMA_PARAM_SIZE,
+			ctx->gamma_table[i]);
+
+	ctx->gamma_valid = true;
+out:
+	kfree(w);
+}
+
+/*
+ * Stock reads ID, code, coordinate, MTP, ELVSS and TSET once at probe,
+ * with only test key F0 open, from a panel the bootloader had already
+ * initialised (s6e3ha2_probe(), :1734-1741).  Under DRM the DSI link is
+ * first usable in prepare, so the same reads (same registers, lengths and
+ * order) run at ldi_init step 11 "Module Information READ" (:1146-1147),
+ * where stock itself re-reads the ID on every power-on and where keys F0
+ * and FC are open.  Each value is kept from the first successful read,
+ * taken right after a reset, before this driver writes 0xB6 or 0xB8.
+ */
+static void s6e3ha2_tabs2_read_panel_info(struct s6e3ha2_tabs2 *ctx)
+{
+	struct device *dev = ctx->dev;
+	bool first = !ctx->info_read;
+
+	/* s6e3ha2_read_id() (:511-523): a failure means no panel/link */
+	if (s6e3ha2_tabs2_read(ctx, TABS2_LDI_ID_REG, ctx->id,
+			       TABS2_LDI_ID_LEN)) {
+		dev_err(dev, "panel is not connected well, skipping reads\n");
+		return;
+	}
+
+	if (first) {
+		dev_info(dev, "ID: %x, %x, %x\n",
+			 ctx->id[0], ctx->id[1], ctx->id[2]);
+
+		/* s6e3ha2_read_code() (:525-535), informational */
+		if (!s6e3ha2_tabs2_read(ctx, TABS2_LDI_CODE_REG, ctx->code,
+					TABS2_LDI_CODE_LEN))
+			dev_info(dev, "code (D6h): %*ph\n",
+				 TABS2_LDI_CODE_LEN, ctx->code);
+
+		/* s6e3ha2_read_coordinate() (:495-509), informational */
+		if (!s6e3ha2_tabs2_read(ctx, TABS2_LDI_COORDINATE_REG,
+					ctx->coordinate,
+					TABS2_LDI_COORDINATE_LEN))
+			dev_info(dev, "coordinate (A1h): %*ph\n",
+				 TABS2_LDI_COORDINATE_LEN, ctx->coordinate);
+
+		ctx->info_read = true;
+	}
+
+	/* s6e3ha2_read_mtp() (:537-557) */
+	if (!ctx->mtp_read &&
+	    !s6e3ha2_tabs2_read(ctx, TABS2_LDI_MTP_REG, ctx->mtp,
+				TABS2_MTP_LEN)) {
+		ctx->mtp_read = true;
+		dev_info(dev, "MTP (C8h, %d bytes): %*ph\n", TABS2_MTP_LEN,
+			 TABS2_MTP_LEN, ctx->mtp);
+		s6e3ha2_tabs2_init_gamma_table(ctx);
+	}
+
+	/* s6e3ha2_read_elvss() (:559-570) */
+	if (!ctx->elvss_read &&
+	    !s6e3ha2_tabs2_read(ctx, TABS2_LDI_ELVSS_REG, ctx->elvss,
+				TABS2_ELVSS_LEN)) {
+		ctx->elvss_read = true;
+		dev_info(dev, "ELVSS (B6h, %d bytes): %*ph\n", TABS2_ELVSS_LEN,
+			 TABS2_ELVSS_LEN, ctx->elvss);
+	}
+
+	/* s6e3ha2_read_tset() (:572-585): stored after the 0xB8 command byte */
+	if (!ctx->tset_read &&
+	    !s6e3ha2_tabs2_read(ctx, TABS2_LDI_TSET_REG, &ctx->tset_table[1],
+				TABS2_LDI_TSET_LEN)) {
+		ctx->tset_read = true;
+		ctx->tset_table[0] = TABS2_LDI_TSET_REG;
+		dev_info(dev, "TSET (B8h, %d bytes): %*ph\n", TABS2_LDI_TSET_LEN,
+			 TABS2_LDI_TSET_LEN, &ctx->tset_table[1]);
+	}
+}
+
+/* ------------------------------------------------------------------------
+ * Brightness: stock update_brightness() (:1087-1122) and its helpers
+ */
+
+/* s6e3ha2_gamma_ctl() (:596-614) */
+static int s6e3ha2_tabs2_gamma_ctl(struct s6e3ha2_tabs2 *ctx, bool force)
+{
+	const u8 *gamma = ctx->gamma_table[ctx->bl];
+
+	/* Without MTP data there is no table: leave the panel's 0xCA alone */
+	if (!ctx->gamma_valid)
+		return 0;
+
+	if (!force && ctx->current_bl == ctx->bl)
+		return 0;
+
+	if (!ctx->gamma_logged) {
+		dev_info(ctx->dev, "gamma %d nit (CAh): %*ph\n",
+			 tabs2_index_brightness[ctx->bl],
+			 TABS2_GAMMA_PARAM_SIZE, gamma);
+		ctx->gamma_logged = true;
+	} else {
+		dev_dbg(ctx->dev, "gamma %d nit (CAh): %*ph\n",
+			tabs2_index_brightness[ctx->bl],
+			TABS2_GAMMA_PARAM_SIZE, gamma);
+	}
+
+	return s6e3ha2_tabs2_dcs_write(ctx, gamma, TABS2_GAMMA_PARAM_SIZE);
+}
+
+/*
+ * s6e3ha2_aid_parameter_ctl() (:616-636): SEQ_AID_SET[0] = 0xB2
+ * (param.h:122-125) followed by inter_aor_cmd[brightness]
+ * (init_aid_dimming_table(), :946-957).
+ */
+static int s6e3ha2_tabs2_aid_ctl(struct s6e3ha2_tabs2 *ctx, bool force)
+{
+	const u8 *cur = tabs2_inter_aor_cmd[ctx->current_brightness];
+	const u8 *aor = tabs2_inter_aor_cmd[ctx->brightness];
+	u8 data[3] = { 0xb2, aor[0], aor[1] };
+
+	if (!force && cur[0] == aor[0] && cur[1] == aor[1])
+		return 0;
+
+	return s6e3ha2_tabs2_dcs_write(ctx, data, ARRAY_SIZE(data));
+}
+
+/*
+ * s6e3ha2_set_caps() + s6e3ha2_set_elvss() (:662-714).  The resend test
+ * compares union elvss_info {mps, offset, elvss_base} = bytes 1, 2 and 22
+ * of the command (:85-93, :693-695).
+ */
+static int s6e3ha2_tabs2_set_elvss(struct s6e3ha2_tabs2 *ctx, bool force)
+{
+	int caps = tabs2_caps(ctx->bl);
+	int level = tabs2_elvss_level(ctx->bl);
+	u8 data[TABS2_ELVSS_PARAM_SIZE];
+	size_t len = TABS2_ELVSS_PARAM_SIZE;
+	u32 elvss;
+	int ret;
+
+	tabs2_build_elvss(data, caps, level, ctx->elvss);
+	elvss = data[1] | data[2] << 8 | data[22] << 16;
+
+	if (!force && ctx->current_elvss == elvss)
+		return 0;
+
+	/*
+	 * Stock would send its zero-filled buffer (:1644) if the 0xB6 read
+	 * failed; send only MPS + ELVSS then, leaving the other 0xB6
+	 * parameters at their reset values.
+	 */
+	if (!ctx->elvss_read)
+		len = 3;
+
+	ret = s6e3ha2_tabs2_dcs_write(ctx, data, len);
+	dev_info(ctx->dev, "caps: %d, temperature: %d, elvss: %d, %x\n",
+		 caps, TABS2_TEMP_ABOVE_MINUS_20, level, elvss);
+	ctx->current_elvss = elvss;
+
+	return ret;
+}
+
+/*
+ * s6e3ha2_set_vint() (:751-775): vint_table[level] is SEQ_VINT_SET
+ * {0xF4, 0xAB, 0x21} with byte 2 = VINT_TABLE[level] (:1011-1027,
+ * param.h:135-138).
+ */
+static int s6e3ha2_tabs2_set_vint(struct s6e3ha2_tabs2 *ctx, bool force)
+{
+	u8 data[3] = { 0xf4, 0xab,
+		       tabs2_vint_table[tabs2_vint_level(ctx->bl)] };
+	int ret;
+
+	if (!force && ctx->current_vint == data[2])
+		return 0;
+
+	ret = s6e3ha2_tabs2_dcs_write(ctx, data, ARRAY_SIZE(data));
+	ctx->current_vint = data[2];
+	dev_info(ctx->dev, "vint: %x\n", ctx->current_vint);
+
+	return ret;
+}
+
+/* SEQ_GAMMA_UPDATE / SEQ_GAMMA_UPDATE_L, param.h:140-148 */
+static int s6e3ha2_tabs2_gamma_update(struct s6e3ha2_tabs2 *ctx)
+{
+	s6e3ha2_tabs2_dcs_write_seq(ctx, 0xf7, 0x03);
+	s6e3ha2_tabs2_dcs_write_seq(ctx, 0xf7, 0x00);
+	return 0;
+}
+
+/* s6e3ha2_set_acl() (:638-660) */
+static int s6e3ha2_tabs2_set_acl(struct s6e3ha2_tabs2 *ctx, bool force)
+{
+	int level = tabs2_acl_level(ctx->brightness);
+	int ret;
+
+	if (!force && ctx->current_acl == tabs2_acl_cutoff_table[level][1])
+		return 0;
+
+	ret = s6e3ha2_tabs2_dcs_write(ctx, tabs2_acl_cutoff_table[level], 2);
+	if (!ret)
+		ret = s6e3ha2_tabs2_dcs_write(ctx, tabs2_acl_opr_table[level], 2);
+	ctx->current_acl = tabs2_acl_cutoff_table[level][1];
+	dev_info(ctx->dev, "acl: %d, brightness: %d\n",
+		 ctx->current_acl, ctx->brightness);
+
+	return ret;
+}
+
+/*
+ * s6e3ha2_set_tset() (:716-733): the 8 bytes read from 0xB8 with the
+ * last one replaced by the temperature (bit 7 = sign).
+ */
+static int s6e3ha2_tabs2_set_tset(struct s6e3ha2_tabs2 *ctx, bool force)
+{
+	u8 tset = TABS2_TEMPERATURE;
+	int ret;
+
+	/*
+	 * Stock would send its zero-filled table if the 0xB8 read failed;
+	 * do not touch TSET then.
+	 */
+	if (!ctx->tset_read)
+		return 0;
+
+	if (!force && ctx->tset_table[TABS2_LDI_TSET_LEN] == tset)
+		return 0;
+
+	ctx->tset_table[TABS2_LDI_TSET_LEN] = tset;
+	ret = s6e3ha2_tabs2_dcs_write(ctx, ctx->tset_table,
+				      TABS2_TSET_PARAM_SIZE);
+	dev_info(ctx->dev, "temperature: %d, tset: %d\n",
+		 TABS2_TEMPERATURE, tset);
+
+	return ret;
+}
+
+/*
+ * s6e3ha2_set_hbm() (:735-749).  HBM_TABLE[LEVEL_IS_HBM(brightness)] is
+ * SEQ_HBM_ON only for brightness 355 (lcd.c:47), above this driver's
+ * maximum of 255, so this is always SEQ_HBM_OFF = {0x53, 0x00}
+ * (param.h:150-153).
+ */
+static int s6e3ha2_tabs2_set_hbm(struct s6e3ha2_tabs2 *ctx, bool force)
+{
+	static const u8 hbm_off[] = { 0x53, 0x00 };
+	int ret;
+
+	if (!force && ctx->current_hbm == hbm_off[1])
+		return 0;
+
+	ret = s6e3ha2_tabs2_dcs_write(ctx, hbm_off, ARRAY_SIZE(hbm_off));
+	ctx->current_hbm = hbm_off[1];
+	dev_info(ctx->dev, "hbm: %d, brightness: %d\n",
+		 ctx->current_hbm, ctx->brightness);
+
+	return ret;
+}
+
+/* update_brightness() (:1087-1122); called with ctx->lock held */
+static int s6e3ha2_tabs2_update_brightness(struct s6e3ha2_tabs2 *ctx,
+					   bool force)
+{
+	int ret;
+
+	ctx->brightness = min_t(unsigned int, ctx->bl_dev->props.brightness,
+				TABS2_MAX_BRIGHTNESS);
+	ctx->bl = tabs2_brightness_to_level(ctx->brightness);
+
+	s6e3ha2_tabs2_call_write_func(ret, s6e3ha2_tabs2_test_key_on_f0(ctx));
+	s6e3ha2_tabs2_call_write_func(ret, s6e3ha2_tabs2_gamma_ctl(ctx, force));
+	s6e3ha2_tabs2_call_write_func(ret, s6e3ha2_tabs2_aid_ctl(ctx, force));
+	s6e3ha2_tabs2_call_write_func(ret, s6e3ha2_tabs2_set_elvss(ctx, force));
+	s6e3ha2_tabs2_call_write_func(ret, s6e3ha2_tabs2_set_vint(ctx, force));
+	s6e3ha2_tabs2_call_write_func(ret, s6e3ha2_tabs2_gamma_update(ctx));
+	s6e3ha2_tabs2_call_write_func(ret, s6e3ha2_tabs2_set_acl(ctx, force));
+	s6e3ha2_tabs2_call_write_func(ret, s6e3ha2_tabs2_set_tset(ctx, force));
+	s6e3ha2_tabs2_call_write_func(ret, s6e3ha2_tabs2_set_hbm(ctx, force));
+	s6e3ha2_tabs2_call_write_func(ret, s6e3ha2_tabs2_test_key_off_f0(ctx));
+
+	ctx->current_bl = ctx->bl;
+	ctx->current_brightness = ctx->brightness;
+
+	dev_info(ctx->dev, "brightness=%u, bl=%u, candela=%d\n",
+		 ctx->brightness, ctx->bl, tabs2_index_brightness[ctx->bl]);
+
+	return 0;
+}
+
+/* ------------------------------------------------------------------------
+ * Panel power / init
+ */
+
+/*
+ * s6e3ha2_ldi_init(), s6e3ha2_tabs2_mipi_lcd.c:1124-1176: sleep out,
+ * keys, single-DSI interface setting, module information read, common
+ * setting, brightness, keys off.  Called with ctx->lock held.
+ */
+static int s6e3ha2_tabs2_panel_init(struct s6e3ha2_tabs2 *ctx)
+{
+	struct mipi_dsi_device *dsi = to_mipi_dsi_device(ctx->dev);
+	int ret;
+
+	/* 7. Sleep Out(11h); 8. Wait 5 ms */
+	s6e3ha2_tabs2_call_write_func(ret, mipi_dsi_dcs_exit_sleep_mode(dsi));
+	usleep_range(TABS2_SLEEP_OUT_DELAY_US_MIN, TABS2_SLEEP_OUT_DELAY_US_MAX);
+
+	s6e3ha2_tabs2_call_write_func(ret, s6e3ha2_tabs2_test_key_on_f0(ctx));
+	s6e3ha2_tabs2_call_write_func(ret, s6e3ha2_tabs2_test_key_on_fc(ctx));
+
+	/*
+	 * 9. Interface Setting: SEQ_SINGLE_DSI_1 = {0xf2, 0x67},
+	 * SEQ_SINGLE_DSI_2 = {0xf9, 0x09} (param.h:64-72); 10. Wait 120 ms.
+	 */
+	s6e3ha2_tabs2_dcs_write_seq(ctx, 0xf2, 0x67);
+	s6e3ha2_tabs2_dcs_write_seq(ctx, 0xf9, 0x09);
+	msleep(TABS2_INTERFACE_DELAY_MS);
+
+	/* 11. Module Information READ (+ the stock probe-time reads) */
+	s6e3ha2_tabs2_read_panel_info(ctx);
+
+	/* 12. Common Setting */
+	/* 4.2.1 TE(Vsync) ON: SEQ_TE_ON = {0x35, 0x00}, param.h:74-77 */
+	s6e3ha2_tabs2_dcs_write_seq(ctx, 0x35, 0x00);
+	/*
+	 * 4.2.2 TSP TE(Hsync) Control: SEQ_TSP_HSYNC_ON =
+	 * {0xbd, 0x11, 0x01, 0x02, 0x16, 0x02, 0x16} (param.h:79-82).
+	 */
+	s6e3ha2_tabs2_dcs_write_seq(ctx, 0xbd, 0x11, 0x01, 0x02,
+				     0x16, 0x02, 0x16);
+	/*
+	 * 4.2.3 PenTile Setting: SEQ_PENTILE_SETTING =
+	 * {0xc0, 0x00, 0x0f, 0xd8, 0xd8} (param.h:84-87).
+	 */
+	s6e3ha2_tabs2_dcs_write_seq(ctx, 0xc0, 0x00, 0x0f, 0xd8, 0xd8);
+	/*
+	 * 4.2.4 POC Setting: SEQ_POC_SETTING_1 = {0xb0, 0x20},
+	 * SEQ_POC_SETTING_2 = {0xfe, 0x08} (param.h:89-97).
+	 */
+	s6e3ha2_tabs2_dcs_write_seq(ctx, 0xb0, 0x20);
+	s6e3ha2_tabs2_dcs_write_seq(ctx, 0xfe, 0x08);
+	/* SEQ_PCD_SET_DET_LOW = {0xcc, 0x5c}, param.h:180-183 */
+	s6e3ha2_tabs2_dcs_write_seq(ctx, 0xcc, 0x5c);
+	/* 4.2.5 ERR_FG Setting: SEQ_ERR_FG_SETTING = {0xed, 0x44}, param.h:99-102 */
+	s6e3ha2_tabs2_dcs_write_seq(ctx, 0xed, 0x44);
+	/*
+	 * SEQ_TE_START_SETTING = {0xb9, 0x10, 0x07, 0xff, 0x00, 0x09}
+	 * (param.h:185-188).
+	 */
+	s6e3ha2_tabs2_dcs_write_seq(ctx, 0xb9, 0x10, 0x07, 0xff, 0x00, 0x09);
+	/*
+	 * 4.2.6 Memory Address Set: SEQ_COLUMN_ADDRESS =
+	 * {0x2a, 0x00, 0x00, 0x05, 0xff}, SEQ_PAGE_ADDRESS =
+	 * {0x2b, 0x00, 0x00, 0x07, 0xff} (param.h:104-112): the 1536x2048
+	 * (0x600 x 0x800) full-screen window.
+	 */
+	s6e3ha2_tabs2_dcs_write_seq(ctx, 0x2a, 0x00, 0x00, 0x05, 0xff);
+	s6e3ha2_tabs2_dcs_write_seq(ctx, 0x2b, 0x00, 0x00, 0x07, 0xff);
+
+	/* 13. Brightness Setting: update_brightness(lcd, 1) */
+	s6e3ha2_tabs2_call_write_func(ret,
+				      s6e3ha2_tabs2_update_brightness(ctx, true));
+
+	s6e3ha2_tabs2_call_write_func(ret, s6e3ha2_tabs2_test_key_off_fc(ctx));
+	s6e3ha2_tabs2_call_write_func(ret, s6e3ha2_tabs2_test_key_off_f0(ctx));
+
+	return 0;
+}
+
+static int s6e3ha2_tabs2_power_on(struct s6e3ha2_tabs2 *ctx)
+{
+	int ret;
+
+	/*
+	 * Stock enables VDD3_1.8V, VDDR_1.6V, VCI_3.0V in that order and
+	 * waits 10-11 ms; the supplies array below keeps that order.
+	 */
+	ret = regulator_bulk_enable(ARRAY_SIZE(ctx->supplies), ctx->supplies);
+	if (ret < 0)
+		return ret;
+
+	usleep_range(TABS2_POWER_ON_DELAY_US_MIN, TABS2_POWER_ON_DELAY_US_MAX);
+
+	/*
+	 * reset-gpios is GPIO_ACTIVE_LOW in DT (live_fdt.dts:1074 flag
+	 * cell 0x01), so logical 0 = physical high (reset released) and
+	 * logical 1 = physical low (reset asserted).  Stock drives
+	 * physical high, low, high with 5-6 ms between each step.
+	 */
+	gpiod_set_value(ctx->reset_gpio, 0);
+	usleep_range(TABS2_RESET_DELAY_US_MIN, TABS2_RESET_DELAY_US_MAX);
+	gpiod_set_value(ctx->reset_gpio, 1);
+	usleep_range(TABS2_RESET_DELAY_US_MIN, TABS2_RESET_DELAY_US_MAX);
+	gpiod_set_value(ctx->reset_gpio, 0);
+	usleep_range(TABS2_RESET_DELAY_US_MIN, TABS2_RESET_DELAY_US_MAX);
+
+	return 0;
+}
+
+static void s6e3ha2_tabs2_power_off(struct s6e3ha2_tabs2 *ctx)
+{
+	/* Stock "disable_display_driver_power": reset asserted, rails off */
+	gpiod_set_value(ctx->reset_gpio, 1);
+	regulator_bulk_disable(ARRAY_SIZE(ctx->supplies), ctx->supplies);
+}
+
+static int s6e3ha2_tabs2_disable(struct drm_panel *panel)
+{
+	struct s6e3ha2_tabs2 *ctx = container_of(panel, struct s6e3ha2_tabs2,
+						 panel);
+	struct mipi_dsi_device *dsi = to_mipi_dsi_device(ctx->dev);
+	int ret;
+
+	/* s6e3ha2_power_off() (:1253-1255): stop brightness updates first */
+	mutex_lock(&ctx->lock);
+	ctx->ldi_enable = false;
+	mutex_unlock(&ctx->lock);
+
+	/* s6e3ha2_ldi_disable(): 2. Display Off (28h), 3. Sleep In (10h) */
+	s6e3ha2_tabs2_call_write_func(ret, mipi_dsi_dcs_set_display_off(dsi));
+	s6e3ha2_tabs2_call_write_func(ret, mipi_dsi_dcs_enter_sleep_mode(dsi));
+
+	/* 4. Wait 120 ms */
+	msleep(TABS2_SLEEP_IN_DELAY_MS);
+
+	return 0;
+}
+
+static int s6e3ha2_tabs2_unprepare(struct drm_panel *panel)
+{
+	struct s6e3ha2_tabs2 *ctx = container_of(panel, struct s6e3ha2_tabs2,
+						 panel);
+
+	s6e3ha2_tabs2_power_off(ctx);
+
+	return 0;
+}
+
+static int s6e3ha2_tabs2_prepare(struct drm_panel *panel)
+{
+	struct s6e3ha2_tabs2 *ctx = container_of(panel, struct s6e3ha2_tabs2,
+						 panel);
+	int ret;
+
+	ret = s6e3ha2_tabs2_power_on(ctx);
+	if (ret < 0)
+		return ret;
+
+	mutex_lock(&ctx->lock);
+	ret = s6e3ha2_tabs2_panel_init(ctx);
+	mutex_unlock(&ctx->lock);
+	if (ret < 0)
+		goto err;
+
+	return 0;
+
+err:
+	s6e3ha2_tabs2_power_off(ctx);
+	return ret;
+}
+
+static int s6e3ha2_tabs2_enable(struct drm_panel *panel)
+{
+	struct s6e3ha2_tabs2 *ctx = container_of(panel, struct s6e3ha2_tabs2,
+						 panel);
+	struct mipi_dsi_device *dsi = to_mipi_dsi_device(ctx->dev);
+	int ret;
+
+	/* 16. Display On(29h) */
+	ret = mipi_dsi_dcs_set_display_on(dsi);
+	if (ret < 0)
+		return ret;
+
+	/*
+	 * s6e3ha2_power_on() (:1228-1232): ldi_enable = 1, then a second
+	 * forced update_brightness() after DISPLAY_ON.
+	 */
+	mutex_lock(&ctx->lock);
+	ctx->ldi_enable = true;
+	ret = s6e3ha2_tabs2_update_brightness(ctx, true);
+	mutex_unlock(&ctx->lock);
+
+	return ret;
+}
+
+/*
+ * Backlight: stock range and default (MAX_BRIGHTNESS 255, DEFAULT 122,
+ * s6e3ha2_tabs2_mipi_lcd.c:55-56), brightness -> level (nit) via
+ * brightness_table[].  Like stock s6e3ha2_set_brightness() (:1311-1333),
+ * a change is sent to the panel only while it is on (ldi_enable).
+ */
+static int s6e3ha2_tabs2_bl_update_status(struct backlight_device *bl_dev)
+{
+	struct s6e3ha2_tabs2 *ctx = bl_get_data(bl_dev);
+	int ret = 0;
+
+	mutex_lock(&ctx->lock);
+	if (ctx->ldi_enable)
+		ret = s6e3ha2_tabs2_update_brightness(ctx, false);
+	mutex_unlock(&ctx->lock);
+
+	return ret;
+}
+
+/*
+ * Stock s6e3ha2_get_brightness() (:1304-1309) returns the candela of the
+ * current level; actual_brightness must stay within 0..max_brightness for
+ * the backlight class, so return the brightness value instead (the
+ * candela is in the "brightness=, bl=, candela=" log line).
+ */
+static int s6e3ha2_tabs2_bl_get_brightness(struct backlight_device *bl_dev)
+{
+	return bl_dev->props.brightness;
+}
+
+static const struct backlight_ops s6e3ha2_tabs2_bl_ops = {
+	.update_status = s6e3ha2_tabs2_bl_update_status,
+	.get_brightness = s6e3ha2_tabs2_bl_get_brightness,
+};
+
+/*
+ * Stock panel node s6e3ha2_qxga (live_fdt.dts:1045-1061): 1536x2048
+ * (resolution 0x600 x 0x800), refresh 60, h-porch <hbp 1, hfp 1,
+ * hsa 1>, v-porch <vbp 15, vfp 1, vsa 1> (decon_dt_exynos5430.c:460-471
+ * maps h-porch to [hbp, hfp, hsa] and v-porch to [vbp, vfp, vsa]).
+ *
+ * Pixel clock = (1536+1+1+1) * (2048+15+1+1) * 60 = 1539 * 2065 * 60
+ * = 190682220 Hz -> 190682 kHz.
+ */
+static const struct drm_display_mode s6e3ha2_tabs2_mode = {
+	.clock = 190682,
+	.hdisplay = 1536,
+	.hsync_start = 1536 + 1,
+	.hsync_end = 1536 + 1 + 1,
+	.htotal = 1536 + 1 + 1 + 1,
+	.vdisplay = 2048,
+	.vsync_start = 2048 + 1,
+	.vsync_end = 2048 + 1 + 1,
+	.vtotal = 2048 + 1 + 1 + 15,
+	.flags = 0,
+};
+
+static int s6e3ha2_tabs2_get_modes(struct drm_panel *panel,
+				   struct drm_connector *connector)
+{
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_duplicate(connector->dev, &s6e3ha2_tabs2_mode);
+	if (!mode) {
+		dev_err(panel->dev, "failed to add mode %ux%u@%u\n",
+			s6e3ha2_tabs2_mode.hdisplay, s6e3ha2_tabs2_mode.vdisplay,
+			drm_mode_vrefresh(&s6e3ha2_tabs2_mode));
+		return -ENOMEM;
+	}
+
+	drm_mode_set_name(mode);
+
+	mode->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	drm_mode_probed_add(connector, mode);
+
+	/* 8.0-inch 4:3 panel: 1536x2048 pixels -> 122.4 x 163.2 mm */
+	connector->display_info.width_mm = 122;
+	connector->display_info.height_mm = 163;
+
+	return 1;
+}
+
+static const struct drm_panel_funcs s6e3ha2_tabs2_drm_funcs = {
+	.disable = s6e3ha2_tabs2_disable,
+	.unprepare = s6e3ha2_tabs2_unprepare,
+	.prepare = s6e3ha2_tabs2_prepare,
+	.enable = s6e3ha2_tabs2_enable,
+	.get_modes = s6e3ha2_tabs2_get_modes,
+};
+
+static int s6e3ha2_tabs2_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.max_brightness = TABS2_MAX_BRIGHTNESS,
+		.brightness = TABS2_DEFAULT_BRIGHTNESS,
+	};
+	struct s6e3ha2_tabs2 *ctx;
+	int ret;
+
+	ctx = devm_kzalloc(dev, sizeof(*ctx), GFP_KERNEL);
+	if (!ctx)
+		return -ENOMEM;
+
+	mipi_dsi_set_drvdata(dsi, ctx);
+	ctx->dev = dev;
+
+	ret = devm_mutex_init(dev, &ctx->lock);
+	if (ret)
+		return ret;
+
+	/*
+	 * Stock probe state (:1671-1676): brightness = current_brightness =
+	 * DEFAULT_BRIGHTNESS, bl = current_bl = DEFAULT_GAMMA_INDEX
+	 * (IBRIGHTNESS_162NT, :58), current_acl = 0.  The first update is
+	 * forced, so these only seed the change detection.
+	 */
+	ctx->brightness = TABS2_DEFAULT_BRIGHTNESS;
+	ctx->current_brightness = TABS2_DEFAULT_BRIGHTNESS;
+	ctx->bl = TABS2_IBR_162NT;
+	ctx->current_bl = TABS2_IBR_162NT;
+
+	/*
+	 * Stock mipi_dsi node (live_fdt.dts:1025-1043): 4 data lanes
+	 * (e_no_data_lane = 3), RGB888 (e_pixel_format = 7), command
+	 * interface (e_interface = 0 -> DSIM_COMMAND,
+	 * exynos_mipi_dsim.h enum mipi_dsim_interface_type),
+	 * eot_disable = 1 (no EoT packets).  Same flags as the TM2 board's
+	 * s6e3ha2 (panel-samsung-s6e3ha2.c:695-697): no MIPI_DSI_MODE_VIDEO,
+	 * so the Exynos DSI glue sets i80 mode (exynos_drm_dsi.c:54) and
+	 * DECON waits on its hardware TE trigger (exynos5433-decon match
+	 * data I80_HW_TRG, via samsung,disp-sysreg).
+	 */
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_CLOCK_NON_CONTINUOUS |
+		MIPI_DSI_MODE_VIDEO_NO_HFP | MIPI_DSI_MODE_VIDEO_NO_HBP |
+		MIPI_DSI_MODE_VIDEO_NO_HSA | MIPI_DSI_MODE_NO_EOT_PACKET;
+
+	/*
+	 * Panel supplies in the stock power-on order:
+	 * VDD3_1.8V (ldo39), VDDR_1.6V (ldo37), VCI_3.0V (ldo25)
+	 * (live_fdt.dts:1080-1082 decon_board_gts28).
+	 */
+	ctx->supplies[0].supply = "vdd3";
+	ctx->supplies[1].supply = "vddr";
+	ctx->supplies[2].supply = "vci";
+
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(ctx->supplies),
+				      ctx->supplies);
+	if (ret < 0) {
+		dev_err(dev, "failed to get regulators: %d\n", ret);
+		return ret;
+	}
+
+	/* reset-gpios = <&gpg0 0 GPIO_ACTIVE_LOW> (live_fdt.dts:1074) */
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->reset_gpio)) {
+		dev_err(dev, "cannot get reset-gpios %ld\n",
+			PTR_ERR(ctx->reset_gpio));
+		return PTR_ERR(ctx->reset_gpio);
+	}
+
+	ctx->bl_dev = backlight_device_register("s6e3ha2_tabs2", dev, ctx,
+						&s6e3ha2_tabs2_bl_ops, &props);
+	if (IS_ERR(ctx->bl_dev)) {
+		dev_err(dev, "failed to register backlight device\n");
+		return PTR_ERR(ctx->bl_dev);
+	}
+
+	drm_panel_init(&ctx->panel, dev, &s6e3ha2_tabs2_drm_funcs,
+		       DRM_MODE_CONNECTOR_DSI);
+	ctx->panel.prepare_prev_first = true;
+
+	drm_panel_add(&ctx->panel);
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0)
+		goto remove_panel;
+
+	return ret;
+
+remove_panel:
+	drm_panel_remove(&ctx->panel);
+	backlight_device_unregister(ctx->bl_dev);
+
+	return ret;
+}
+
+static void s6e3ha2_tabs2_remove(struct mipi_dsi_device *dsi)
+{
+	struct s6e3ha2_tabs2 *ctx = mipi_dsi_get_drvdata(dsi);
+
+	mipi_dsi_detach(dsi);
+	drm_panel_remove(&ctx->panel);
+	backlight_device_unregister(ctx->bl_dev);
+}
+
+static const struct of_device_id s6e3ha2_tabs2_of_match[] = {
+	{ .compatible = "samsung,s6e3ha2-tabs2" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, s6e3ha2_tabs2_of_match);
+
+static struct mipi_dsi_driver s6e3ha2_tabs2_driver = {
+	.probe = s6e3ha2_tabs2_probe,
+	.remove = s6e3ha2_tabs2_remove,
+	.driver = {
+		.name = "panel-samsung-s6e3ha2-tabs2",
+		.of_match_table = s6e3ha2_tabs2_of_match,
+	},
+};
+module_mipi_dsi_driver(s6e3ha2_tabs2_driver);
+
