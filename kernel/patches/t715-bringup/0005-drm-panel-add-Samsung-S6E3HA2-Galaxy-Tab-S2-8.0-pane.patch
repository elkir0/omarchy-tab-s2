+/* calc_point_voltages(), dynamic_aid.c:58-125 */
+static int tabs2_calc_point_voltages(struct tabs2_daid_work *w)
+{
+	s64 (*pv)[TABS2_CI_MAX] = w->point_voltages;
+	const int *vd, *mtp;
+	int numerator, denominator;
+	s64 v0 = TABS2_VREG;
+	s64 t1, t2;
+	int iv, c, idx;
+
+	/* iv == 0 (VT) */
+	vd = &tabs2_gamma_default[0];
+	mtp = &w->mtp[0];
+	denominator = tabs2_gamma_formula[0][1];
+	for (c = 0; c < TABS2_CI_MAX; c++) {
+		/* stock indexes vt_voltage_value[] without a bounds check */
+		idx = vd[c] + mtp[c];
+		if (idx < 0 || idx >= TABS2_VT_VOLTAGE_COUNT)
+			return -ERANGE;
+		t1 = v0;
+		t2 = v0 * tabs2_vt_voltage_value[idx];
+		pv[0][c] = t1 - div_s64(t2, denominator);
+	}
+
+	/* iv == IV_MAX - 1 .. 1 */
+	for (iv = TABS2_IV_MAX - 1; iv > 0; iv--) {
+		vd = &tabs2_gamma_default[iv * TABS2_CI_MAX];
+		mtp = &w->mtp[iv * TABS2_CI_MAX];
+		numerator = tabs2_gamma_formula[iv][0];
+		denominator = tabs2_gamma_formula[iv][1];
+
+		for (c = 0; c < TABS2_CI_MAX; c++) {
+			if (iv == 1) {
+				t1 = v0;
+				t2 = v0 - pv[iv + 1][c];
+			} else if (iv == TABS2_IV_MAX - 1) {
+				t1 = v0;
+				t2 = v0 - TABS2_VREF_H;
+			} else {
+				t1 = pv[0][c];
+				t2 = pv[0][c] - pv[iv + 1][c];
+			}
+			t2 *= vd[c] + mtp[c] + numerator;
+			pv[iv][c] = t1 - div_s64(t2, denominator);
+		}
+	}
+
+	return 0;
+}
