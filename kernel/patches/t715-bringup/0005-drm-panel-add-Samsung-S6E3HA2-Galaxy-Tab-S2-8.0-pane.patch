+/*
+ * 0xB6 payload for one (caps, ELVSS level), init_elvss_table() lcd.c:959-990:
+ * the 22 bytes read back from 0xB6 at probe, then byte 1 = MPS_TABLE[caps]
+ * and byte 2 = ELVSS_TABLE[level].  The two temperature variants of the
+ * stock table are identical (the per-temperature line is commented out,
+ * lcd.c:987).
+ */
+static void tabs2_build_elvss(u8 out[TABS2_ELVSS_PARAM_SIZE], int caps,
+			      int level, const u8 elvss_read[TABS2_ELVSS_LEN])
+{
+	int i;
+
+	for (i = 0; i < TABS2_ELVSS_LEN; i++)
+		out[1 + i] = elvss_read[i];
+
+	out[0] = 0xb6;				/* LDI_ELVSS_REG, lcd.c:69 */
+	out[1] = tabs2_mps_table[caps];
+	out[2] = tabs2_elvss_table[level];
+}
