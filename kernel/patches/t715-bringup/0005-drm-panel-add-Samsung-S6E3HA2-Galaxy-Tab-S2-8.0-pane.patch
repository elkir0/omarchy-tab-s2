+ * siop_enable = 0 and acl_enable = 0 (lcd.c:1675, 1683):
+ * LEVEL_IS_ACL_OFF(brightness) = 255 <= brightness <= 354 (lcd.c:49).
+ */
+static int tabs2_acl_level(unsigned int brightness)
+{
+	if (brightness >= TABS2_MAX_BRIGHTNESS &&
+	    brightness <= TABS2_EXTEND_BRIGHTNESS - 1)
+		return TABS2_ACL_STATUS_0P;
+
+	return TABS2_ACL_STATUS_15P;
