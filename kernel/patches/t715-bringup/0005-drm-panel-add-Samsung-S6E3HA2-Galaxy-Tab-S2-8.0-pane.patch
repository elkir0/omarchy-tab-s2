+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Brightness tables and "dynamic AID" gamma computation for the Samsung
+ * S6E3HA2 AMOLED panel of the Galaxy Tab S2 8.0 (SM-T715, board "gts28").
+ *
+ * Private to panel-samsung-s6e3ha2-tabs2.c.  It is a separate header only
+ * so that the very same code can be compiled on the host by the unit test
+ * scripts/tests/test_s6e3ha2_tabs2_gamma.py (sm-t715-linux tree), which
+ * checks it against an independent Python port of the stock algorithm.
+ * It therefore only uses <linux/types.h>, <linux/math64.h> (div_s64,
+ * div64_s64) and <linux/errno.h>.
+ *
+ * Everything is transcribed from Samsung's GPL-2.0 downstream kernel
+ * (kernel_universal5433), directory drivers/video/exynos/panels/.  File
+ * names in the comments below are relative to that directory:
+ *   dynamic_aid.c, dynamic_aid.h        generic dynamic-AID algorithm
+ *   dynamic_aid_s6e3ha2_tabs2.h         per-panel dynamic-AID tables
+ *   dynamic_aid_gamma_curve.h           gamma 2.15 / 2.20 curves
+ *   s6e3ha2_tabs2_mipi_lcd.c ("lcd.c")  MTP decode, 0xCA layout,
+ *                                       update_brightness() decisions
+ *   s6e3ha2_tabs2_param.h ("param.h")   ELVSS / VINT / ACL tables
+ *
+ * Integer arithmetic follows the stock code type for type: int where stock
+ * uses int (struct rgb_t, l_value, m_gray, the gamma result), s64 where it
+ * uses s64 (struct rgb64_t, t1/t2), div_s64()/div64_s64() (truncating
+ * towards zero) where it uses them.  The only behavioural additions are
+ * range checks on the three spots where stock would index out of bounds
+ * or divide by zero for nonsensical MTP data; they return an error instead
+ * (the caller then leaves the panel's own gamma alone).
+ */
+
+#ifndef _PANEL_SAMSUNG_S6E3HA2_TABS2_DIMMING_H
+#define _PANEL_SAMSUNG_S6E3HA2_TABS2_DIMMING_H
+
+#include <linux/errno.h>
+#include <linux/math64.h>
+#include <linux/types.h>
+
+/* ------------------------------------------------------------------------
+ * Sizes
+ */
+
+/* LDI_MTP_LEN = 44, "MTP + Manufacture Date" (lcd.c:64-65) */
+#define TABS2_MTP_LEN			44
+/* SEQ_ELVSS_SET is 0xB6 + 22 bytes (param.h:127-133); LDI_ELVSS_LEN = 22 (lcd.c:69-70) */
+#define TABS2_ELVSS_PARAM_SIZE		23
+#define TABS2_ELVSS_LEN			(TABS2_ELVSS_PARAM_SIZE - 1)
+/* SEQ_GAMMA_CONTROL_SET is 0xCA + 35 bytes (param.h:114-120, GAMMA_PARAM_SIZE param.h:4) */
+#define TABS2_GAMMA_PARAM_SIZE		36
+
+/*
+ * Backlight range: MIN_BRIGHTNESS 0, MAX_BRIGHTNESS 255, DEFAULT_BRIGHTNESS
+ * 122 (lcd.c:54-56); EXTEND_BRIGHTNESS 355 is stock's HBM step (lcd.c:53).
+ */
+#define TABS2_MAX_BRIGHTNESS		255
+#define TABS2_DEFAULT_BRIGHTNESS	122
+#define TABS2_EXTEND_BRIGHTNESS		355
+
+/* dynamic_aid.h:4-9 */
+enum {
+	TABS2_CI_RED,
+	TABS2_CI_GREEN,
+	TABS2_CI_BLUE,
+	TABS2_CI_MAX
+};
+
+/* Gamma reference points, dynamic_aid_s6e3ha2_tabs2.h:7-19 */
