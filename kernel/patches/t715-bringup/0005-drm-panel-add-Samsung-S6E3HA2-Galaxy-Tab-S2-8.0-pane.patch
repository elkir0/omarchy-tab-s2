+static int tabs2_elvss_level(unsigned int bl)
+{
+	int nit = tabs2_index_brightness[bl];
+	int level = TABS2_ELVSS_STATUS_MAX - 1;	/* ELVSS_STATUS_360 */
+	int i;
+
+	for (i = 0; i < TABS2_ELVSS_STATUS_MAX; i++) {
+		if (nit <= tabs2_elvss_dim_table[i]) {
+			level = i;
+			break;
+		}
