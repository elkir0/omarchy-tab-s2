+/*
+ * init_mtp_data(), lcd.c:797-823: turn the 0xC8 read-back into signed
+ * per-point offsets mtp[iv * CI_MAX + c].
+ *   bytes 0..5    V255 R,G,B: sign in bit 0 of bytes 0/2/4, magnitude in 1/3/5
+ *   bytes 6..29   V203 .. V3 R,G,B: bit 7 sign, bits 6..0 magnitude
+ *   bytes 33, 34  VT: R = low nibble of 33, G = high nibble of 33, B = 34
+ *                 (stock copies them to bytes 30..32 first, then decodes
+ *                 30..32 like the other points, bit 7 sign)
+ * Bytes 35..39 are not used; 40..43 are the manufacture date (lcd.c:550-554).
+ */
+static void tabs2_decode_mtp(const u8 raw[TABS2_MTP_LEN],
+			     int mtp[TABS2_IV_MAX * TABS2_CI_MAX])
+{
+	u8 d[TABS2_MTP_LEN];
+	int i, c, j;
+
+	for (i = 0; i < TABS2_MTP_LEN; i++)
+		d[i] = raw[i];
+
+	d[32] = d[34];			/* VT B */
+	d[31] = (d[33] >> 4) & 0xf;	/* VT G */
+	d[30] = d[33] & 0xf;		/* VT R */
+
+	for (c = 0, j = 0; c < TABS2_CI_MAX; c++, j++) {
+		if (d[j++] & 0x01)
+			mtp[(TABS2_IV_MAX - 1) * TABS2_CI_MAX + c] = d[j] * (-1);
+		else
+			mtp[(TABS2_IV_MAX - 1) * TABS2_CI_MAX + c] = d[j];
+	}
+
+	for (i = TABS2_IV_MAX - 2; i >= 0; i--) {
+		for (c = 0; c < TABS2_CI_MAX; c++, j++) {
+			if (d[j] & 0x80)
+				mtp[TABS2_CI_MAX * i + c] = (d[j] & 0x7f) * (-1);
+			else
+				mtp[TABS2_CI_MAX * i + c] = d[j];
+		}
+	}
+}
