+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/siliconmitus,sm5703-fuel-gauge.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Silicon Mitus SM5703 Fuel Gauge
+
+maintainers:
+  - elkir0 <elkir0@users.noreply.github.com>
+
+description:
+  The SM5703 fuel gauge is a standalone I2C device, separate from the
+  SM5703 charger and regulator MFD. It measures the battery voltage,
+  current and temperature, and computes the state of charge from a
+  battery model loaded into it by the host.
+
+allOf:
+  - $ref: power-supply.yaml#
+
+properties:
+  compatible:
+    const: siliconmitus,sm5703-fuel-gauge
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+    description:
+      Low state of charge, low voltage and temperature alarm output.
+
+required:
+  - compatible
+  - reg
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        fuel-gauge@71 {
+            compatible = "siliconmitus,sm5703-fuel-gauge";
+            reg = <0x71>;
+            interrupt-parent = <&gpa1>;
+            interrupts = <4 IRQ_TYPE_EDGE_BOTH>;
+        };
+    };
