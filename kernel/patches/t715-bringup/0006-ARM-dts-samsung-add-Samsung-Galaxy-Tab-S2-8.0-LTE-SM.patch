@@ -0,0 +1,15 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Samsung Galaxy Tab S2 8.0 LTE (SM-T715), Exynos5433 - milestone 6a
+ *
+ * Board file (validated base: PMIC, eMMC, USB, SMP, watchdog) plus the
+ * audio hardware description (WM1814 codec on hsi2c_3, I2S0) from
+ * exynos5433-gts28ltexx-m6.dtsi.  No sound node yet: this milestone
+ * documents the hardware the machine driver will need, it does not
+ * instantiate a card.  See docs/AUDIO_M6.md.
+ */
+
+/dts-v1/;
+
+#include "exynos5433-gts28ltexx.dts"
+#include "exynos5433-gts28ltexx-m6.dtsi"
diff --git a/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx-m6.dtsi b/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx-m6.dtsi
new file mode 100644
index 000000000..923afffff
--- /dev/null
+++ b/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx-m6.dtsi
@@ -0,0 +1,129 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Samsung Galaxy Tab S2 8.0 LTE (SM-T715), Exynos5433 - milestone 6a
+ *
+ * Audio hardware description: the Cirrus/Wolfson WM1814 codec on HSI2C
+ * channel 3 (0x14e70000) plus the Exynos5433 I2S0 controller that the
+ * (future) machine driver will bind it to.  This milestone only
+ * describes the hardware - there is deliberately no sound node, so
+ * nothing binds yet.  All values are transcribed from the device's
+ * live device tree (01_dumps/live_fdt.dts) and mapped onto the
+ * mainline bindings; see docs/AUDIO_M6.md for the value-by-value
+ * source table and the machine-driver specification.
+ */
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/mfd/arizona.h>
+
+/*
+ * HSI2C channel 3 carries the WM1814 audio codec.
+ * live_fdt.dts: hsi2c@14E70000 (lines 1959-1972, compatible
+ * "samsung,exynos5-hsi2c", samsung,check-transdone-int, status okay) -
+ * mapped by register address to the mainline label hsi2c_3.  The
+ * mainline default pinctrl hs_i2c3_bus (gpd1-3/gpd1-2, FUNC_3,
+ * PULL_UP) reproduces the stock codec-i2c group; the stock
+ * samsung,check-transdone-int quirk has no mainline binding and no
+ * mainline user, so it is left out (see docs/AUDIO_M6.md).
+ */
+&hsi2c_3 {
+	status = "okay";
+
+	wm1814: audio-codec@1a {
+		compatible = "wlf,wm1814";
+		reg = <0x1a>;
+
+		interrupt-parent = <&gpa0>;
+		/* Pin gpa0-4; the live tree's type cell (0) carries no
+		 * type and the downstream arizona driver hard-codes
+		 * IRQF_TRIGGER_LOW; same wiring as TM2. */
+		interrupts = <4 IRQ_TYPE_LEVEL_LOW>;
+
+		/* MCLK1 = 24 MHz from the PMU CLKOUT pin (TM2 wiring);
+		 * MCLK2 (32k) is not described - the live tree does not
+		 * say where it comes from on this board.  The dmic-ref
+		 * MICBIAS1 constant is 1 in the live tree's raw cell too
+		 * (input 2 -> ref 1, input 3 -> ref 0). */
+		clocks = <&pmu_system_controller 0>;
+		clock-names = "mclk1";
+
+		gpio-controller;
+		#gpio-cells = <2>;
+		interrupt-controller;
+		#interrupt-cells = <2>;
+		#sound-dai-cells = <1>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&codec_reset_pins &codec_ldoena_pins
+			     &codec_irq_pins>;
+
+		wlf,reset = <&gpc0 7 GPIO_ACTIVE_HIGH>;
+		wlf,ldoena = <&gpf0 0 GPIO_ACTIVE_HIGH>;
+
+		/* core supplies; every rail is the S2MPS13 LDO18
+		 * (V_CODEC_1.8V_AP) in the live tree. */
+		AVDD-supply = <&ldo18_reg>;
+		LDOVDD-supply = <&ldo18_reg>;
+		DBVDD1-supply = <&ldo18_reg>;
+		DBVDD2-supply = <&ldo18_reg>;
+		DBVDD3-supply = <&ldo18_reg>;
+		CPVDD-supply = <&ldo18_reg>;
+		SPKVDDL-supply = <&ldo18_reg>;
+		SPKVDDR-supply = <&ldo18_reg>;
+
+		wlf,inmode = <ARIZONA_INMODE_DIFF ARIZONA_INMODE_DIFF
+			      ARIZONA_INMODE_DIFF ARIZONA_INMODE_DIFF>;
+		wlf,dmic-ref = <2 ARIZONA_DMIC_MICBIAS1 3 0>;
+		wlf,out-mono = <0 1 1 0 0 0>;
+		wlf,max-channels-clocked = <2 0 0>;
+
+		wlf,micd-detect-debounce = <300>;
+		wlf,micd-bias-start-time = <0x1>;
+		wlf,micd-rate = <0x7>;
+		wlf,micd-force-micbias;
+		wlf,micd-configs = <0x0 1 0>;
+		wlf,micd-timeout-ms = <1000>;
+		wlf,micd-software-compare;
+		wlf,gpsw = <ARIZONA_GPSW_CLAMP_DISABLED>;
+
+		wlf,gpio-defaults = <0xa101 0xa101 0xa101 0xa101 0x8101>;
+	};
+};
+
+/*
+ * PMU CLKOUT feeds the codec MCLK1 pin; parent it on the 24 MHz board
+ * oscillator, as TM2 does (exynos5433-tm2-common.dtsi:1248-1250).
+ * The downstream mach-exynos code programmes the same gate by writing
+ * 0x1000 to EXYNOS_PMU_DEBUG.
+ */
+&pmu_system_controller {
+	assigned-clocks = <&pmu_system_controller 0>;
+	assigned-clock-parents = <&xxti>;
+};
+
+/* I2S0 (LPASS) is the SoC side of the codec link. */
+&i2s0 {
+	status = "okay";
+};
+
+&pinctrl_alive {
+	codec_irq_pins: codec-irq-pins {
+		samsung,pins = "gpa0-4";
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+	};
+};
+
+&pinctrl_imem {
+	codec_ldoena_pins: codec-ldoena-pins {
+		samsung,pins = "gpf0-0";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+	};
+};
+
+&pinctrl_peric {
+	codec_reset_pins: codec-reset-pins {
+		samsung,pins = "gpc0-7";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
+	};
+};
