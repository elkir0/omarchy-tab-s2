+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Samsung Galaxy Tab S2 8.0 LTE (SM-T715), Exynos5433 - milestone 5
+ *
+ * Board file (validated base: PMIC, eMMC, USB, SMP, watchdog) plus
+ * Wi-Fi (BCM4358 on PCIe, brcmfmac) and Bluetooth (BCM4358 on UART3,
+ * hci_bcm) from exynos5433-gts28ltexx-m5.dtsi.  See docs/WIFI_BT_M5.md.
+ */
