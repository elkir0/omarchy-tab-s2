+/* ==================================================================== */
+/* 7. eMMC                                                              */
+/* ==================================================================== */
+
+/*
+ * Internal eMMC on mshc_0 (dwmmc0@15540000).
+ * live_fdt.dts: bus-width 8, ciu-div 3, sdr <3 0 2 0>, ddr <3 0 3 2>,
+ * fifo-depth 0x80, card-detect-delay 200, broken-cd,
+ * supports-highspeed, supports-hs200-1-8v-mode.
+ * The downstream 4-cell timings <div f_drv drv sample> decode to the
+ * mainline 2-cell <sample drv> form (see docs/DT_M2.md).
+ *
+ * On the model of the TM2 board, which runs this SoC's eMMC controller
+ * in HS400 on mainline (exynos5433-tm2-common.dtsi:951-971), with this
+ * tablet's values where it has its own:
+ *  - no vmmc/vqmmc: the stock eMMC node is fixed_volt
+ *    (live_fdt.dts:4050) and LDO17/LDO2 are the SD slot rails (stock
+ *    dmesg "15560000.dwmmc2: vmmc on, vqmmc on"); TM2 lists none
+ *    either.  With LDO2 attached, the first test boots ran the I/O at
+ *    3.3 V and every 50 MHz data read timed out (DRTO).
+ *  - CIU clock 800 MHz: the stock kernel goes straight from 400 kHz to
+ *    HS400 with a 200 MHz bus (stock dmesg "Bus speed =
+ *    200000000Hz"), i.e. 200 MHz * (ciu-div 3 + 1), the TM2 rate too.
+ *    Mainline cannot raise it itself (the request stops at the FSYS
+ *    user mux), so CMU_TOP is set directly.
+ *  - HS200 (kept from milestone 2), sample phase found by tuning, drive
+ *    phase 3 as the stock samsung,dw-mshc-hs200-timing <3 0 3 0>
+ *    (div, fine drive, drive, sample; live_fdt.dts:4081).
+ *
+ * The driver side (drivers/mmc/host/dw_mmc-exynos.c, exynos5433_drv_data)
+ * keeps the hardware data timeout at its maximum, as the stock kernel
+ * does: this eMMC answers reads later than its TAAC allows.
+ */
+&mshc_0 {
+	status = "okay";
+	cap-mmc-highspeed;
+	mmc-hs200-1_8v;
+	non-removable;
+	card-detect-delay = <200>;
+	samsung,dw-mshc-ciu-div = <3>;
+	samsung,dw-mshc-sdr-timing = <0 3>;
+	samsung,dw-mshc-ddr-timing = <2 3>;
+	fifo-depth = <0x80>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&sd0_clk &sd0_cmd &sd0_rdqs &sd0_bus1 &sd0_bus4
+		     &sd0_bus8>;
+	bus-width = <8>;
+	assigned-clocks = <&cmu_top CLK_SCLK_MMC0_FSYS>;
+	assigned-clock-rates = <800000000>;
+};
+
+/*
+ * eMMC command/data pads as the stock tree configures them: drive
+ * strength 2 (FAST_SR3) and no pull (live_fdt.dts:3407-3413 sd0-cmd,
+ * 3546-3561 sd0-bus-width8/1, 3874-3880 sd0-bus-width4), instead of the
+ * SoC dtsi defaults (FAST_SR4, data lines pulled up).  The clock pad
+ * already matches (FAST_SR4 = stock clk_val 3).
+ */
+&sd0_cmd {
+	samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR3>;
+};
+
+&sd0_bus1 {
+	samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+	samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR3>;
+};
+
+&sd0_bus4 {
+	samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+	samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR3>;
+};
+
+&sd0_bus8 {
+	samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+	samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR3>;
+};
+
+/* ==================================================================== */
+/* 8. USB device port (DWC3, PHY clocks, SM5703 MUIC)                   */
+/* ==================================================================== */
+
+/*
+ * USB 3.0 DRD (usb@15400000) in peripheral mode.
+ * live_fdt.dts: status okay, dwc3 dr_mode "otg", maximum-speed
+ * "high-speed".  We force peripheral mode: the SM5703 MUIC below only
+ * routes the data lines to the AP PHY and is not wired to the DWC3 as
+ * a role source; the real OTG role would be driven by it.
+ *
+ * No vdd33/vdd10 supplies: the live tree does not say which PMIC rails
+ * feed the USB block (they are left as the bootloader set them, like
+ * the stock kernel does), so the driver gets dummy regulators instead
+ * of rails borrowed from another board.
+ */
+&usbdrd30 {
+	status = "okay";
+};
+
+&usbdrd_dwc3 {
+	dr_mode = "peripheral";
+	maximum-speed = "high-speed";
+};
+
+&usbdrd30_phy {
+	status = "okay";
+};
+
+/*
+ * USB 3.0 DRD PHY clocks: switch the FSYS user muxes from OSCCLK to the
+ * PHY outputs, as the stock kernel's clock init and the TM2 board
+ * (exynos5433-tm2-common.dtsi:260-281) do.
+ */
+&cmu_fsys {
+	assigned-clocks = <&cmu_fsys CLK_MOUT_PHYCLK_USBDRD30_UDRD30_PHYCLOCK_USER>,
+			  <&cmu_fsys CLK_MOUT_PHYCLK_USBDRD30_UDRD30_PIPE_PCLK_USER>;
+	assigned-clock-parents = <&cmu_fsys CLK_PHYCLK_USBDRD30_UDRD30_PHYCLOCK_PHY>,
+				 <&cmu_fsys CLK_PHYCLK_USBDRD30_UDRD30_PIPE_PCLK_PHY>;
+};
+
+/ {
+	/*
+	 * SM5703 MUIC: routes the connector's D+/D- to the AP USB PHY, the
+	 * modem or the UART.  The stock kernel switches them to the AP on
+	 * every USB attach and opens them on shutdown, so after a reboot
+	 * from Android nothing reaches the PHY until a driver does it.
+	 * Bit-banged I2C on gpd1-5 (SDA) / gpd1-4 (SCL), 2 us delay,
+	 * address 0x25, interrupt gpa3-6 (live_fdt.dts:3061-3078; falling
+	 * edge per the stock muic_task.c).  Mainline extcon-sm5502 handles
+	 * this chip ("siliconmitus,sm5703-muic", as on the msm8916 Samsung
+	 * J5 boards).
+	 */
+	i2c_muic: i2c-muic {
+		compatible = "i2c-gpio";
+		sda-gpios = <&gpd1 5 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		scl-gpios = <&gpd1 4 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		i2c-gpio,delay-us = <2>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		muic: extcon@25 {
+			compatible = "siliconmitus,sm5703-muic";
+			reg = <0x25>;
+			interrupt-parent = <&gpa3>;
+			interrupts = <6 IRQ_TYPE_EDGE_FALLING>;
+		};
+	};
+};
+
+/* ==================================================================== */
+/* 9. Power-off and thermal protection                                  */
+/* ==================================================================== */
+
+/*
+ * Power-off: drive PS_HOLD low, as the stock kernel does (clear bit 8,
+ * "PS_HOLD Out/High", of PS_HOLD_CONTROL at PMU + 0x330C;
+ * kernel_universal5433 drivers/staging/samsung/sec_reboot.c:89-95,
+ * mach/regs-pmu-exynos5433.h:163).  Without it, poweroff and the
+ * critical thermal trip end in a halt with the PMIC still on.
+ */
+&pmu_system_controller {
+	poweroff: syscon-poweroff {
+		compatible = "syscon-poweroff";
+		regmap = <&pmu_system_controller>;
+		offset = <0x330c>;
+		mask = <0x100>;
+		value = <0x0>;
+	};
+};
+
+/* TMUs and trips (docs/THERMAL.md); no cpufreq cooling yet. */
+#include "exynos5433-gts28ltexx-thermal.dtsi"
+
+/* ==================================================================== */
+/* 10. Native display                                                   */
+/* ==================================================================== */
+
+/*
+ * DECON + MIC + MIPI-DSI + S6E3HA2 "TabS2" panel with the stock dynamic-AID
+ * gamma (docs/DISPLAY_M3.md); validated on the tablet on 2026-10-28.
+ */
+#include "exynos5433-gts28ltexx-m3.dtsi"
+
+/*
+ * The bootloader framebuffer is no longer needed once exynos-drm drives the
+ * panel, and simpledrm on it shows up as a second DRM device: phoc then
+ * picks it as the primary GPU and fails (first Phosh test, 2026-10-28).
+ */
+&framebuffer {
+	status = "disabled";
+};
+
+/* ==================================================================== */
+/* 11. Input: touchscreen and keys                                      */
+/* ==================================================================== */
+
+/*
+ * Synaptics s5806 (RMI4 over HSI2C) and gpio-keys (volume up/down, home,
+ * power): docs/INPUT_M4.md, validated on the tablet on 2026-10-28.
+ */
+#include "exynos5433-gts28ltexx-m4.dtsi"
+
+/* ==================================================================== */
+/* 12. GPU (Mali-T760 MP6, panfrost)                                    */
+/* ==================================================================== */
+
+/*
+ * No OPP table: Linux never changes the GPU voltage or clock (docs/GPU.md).
+ * Validated on the tablet on 2026-10-28: Mali-T760 id 0x750 r0p1, 6 shader
+ * cores, boot clock 266 MHz with vdd_g3d (BUCK6) at 937 500 uV, Mesa
+ * "Mali-T760 MC6 (Panfrost)" GLES 3.1 renderer in phoc, no GPU faults.
+ */
+#include "exynos5433-gts28ltexx-gpu.dtsi"
diff --git a/arch/arm/configs/gts28ltexx_defconfig b/arch/arm/configs/gts28ltexx_defconfig
new file mode 100644
index 000000000..35408e73e
--- /dev/null
+++ b/arch/arm/configs/gts28ltexx_defconfig
@@ -0,0 +1,173 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# Samsung Galaxy Tab S2 8.0 LTE (SM-T715, Exynos5433)
+#
+# 32-bit (ARMv7/LPAE) configuration: the bootloader can only boot a
+# 32-bit kernel.  Pairs with exynos5433-gts28ltexx.dts.  This is the
+# configuration validated on the tablet (boot3 test image, 2026-10-28:
+# Arch Linux, 8 cores, PMIC, eMMC, USB ECM, watchdog, sec_log console,
+# ramoops) plus CGROUP_PIDS and CRYPTO_USER.  Milestone fragments still
+# under test (gts28ltexx_m*.config) are merged on top of it by
+# scripts/kbuild-mainline.sh --fragment.  Generated with
+# "make savedefconfig".
+#
+# Why the non-obvious values:
+# - CMDLINE + CMDLINE_EXTEND: sboot replaces /chosen/bootargs with its
+#   own ~850-byte line and the kernel keeps at most COMMAND_LINE_SIZE
+#   (1024) bytes, so the boot.img header command line stays empty and
+#   our options are appended to the bootloader's (drivers/of/fdt.c
+#   early_init_dt_scan_chosen).  The whole line was 986 bytes on the
+#   first boot.  SMP is on (no "nosmp"); the initramfs finds the root.
+# - s3c2410_wdt.tmr_atboot=1: s3c2410_wdt only starts the watchdog at
+#   probe with it (no Kconfig symbol); the watchdog core then pings it
+#   until userspace opens /dev/watchdog (WATCHDOG_HANDLE_BOOT_ENABLED,
+#   WATCHDOG_OPEN_TIMEOUT=0, both defaults).  See docs/WATCHDOG.md.
+# - POWER_RESET_SYSCON (selected by ARCH_EXYNOS): syscon-reboot on PMU
+#   SWRESET (same register and value as the stock kernel,
+#   kernel_universal5433 arch/arm/mach-exynos/common.c:980), so a panic
+#   before the watchdog probes still restarts the board.
+# - PMIC, eMMC and USB gadget chain built in (=y) so a rootfs can be
+#   mounted from eMMC and the gadget used before userspace can load
+#   modules (docs/DT_M2.md).  USB_DWC3_HAPS/OF_SIMPLE stay =m, as in the
+#   validated build.
+# - INET, PACKET, UNIX, BLK_DEV_LOOP, OVERLAY_FS, POSIX_MQUEUE,
+#   INPUT_EVDEV: the initramfs to Arch (USB telnet/DHCP, read-only loop
+#   image under a tmpfs overlay) and systemd.
+# - I2C_GPIO, I2C_CHARDEV, EXTCON_SM5502: SM5703 MUIC on bit-banged I2C
+#   (USB port, exynos5433-gts28ltexx.dts section 8).
+# - MAGIC_SYSRQ: unattended test boots restart the board through
+#   /proc/sysrq-trigger (software reset keeps INFORM3, unlike a watchdog
+#   reset).
+# - CGROUP_PIDS, CRYPTO_USER: systemd (pids.max warnings on the first
+#   Arch boot; systemd-modules-load asks for crypto_user).
+#
+# Note: CONFIG_WIRELESS/WLAN are implied by CFG80211; FRAMEBUFFER_CONSOLE
+# by DRM_FBDEV_EMULATION; namespaced options by NAMESPACES.
+
+CONFIG_KERNEL_XZ=y
+CONFIG_SYSVIPC=y
+CONFIG_POSIX_MQUEUE=y
+CONFIG_BPF_SYSCALL=y
+CONFIG_CGROUPS=y
+CONFIG_MEMCG=y
+CONFIG_CGROUP_PIDS=y
+CONFIG_CGROUP_BPF=y
+CONFIG_USER_NS=y
+CONFIG_BLK_DEV_INITRD=y
+CONFIG_ARCH_EXYNOS=y
+CONFIG_SOC_EXYNOS5433=y
+CONFIG_ARM_LPAE=y
+CONFIG_SMP=y
+CONFIG_VMSPLIT_2G=y
+CONFIG_NR_CPUS=8
+CONFIG_HIGHMEM=y
+CONFIG_CMDLINE="console=tty0 loglevel=8 clk_ignore_unused pd_ignore_unused panic=5 oops=panic s3c2410_wdt.tmr_atboot=1"
+CONFIG_CMDLINE_EXTEND=y
+CONFIG_VFP=y
+CONFIG_NEON=y
+CONFIG_MODULES=y
+CONFIG_NET=y
+CONFIG_PACKET=y
+CONFIG_UNIX=y
+CONFIG_INET=y
+CONFIG_CFG80211=m
+CONFIG_PCI=y
+CONFIG_PCI_MSI=y
+CONFIG_PCI_EXYNOS=m
+CONFIG_DEVTMPFS=y
+CONFIG_DEVTMPFS_MOUNT=y
+CONFIG_BLK_DEV_LOOP=y
+CONFIG_NETDEVICES=y
+CONFIG_BRCMFMAC=m
+CONFIG_BRCMFMAC_PCIE=y
+CONFIG_INPUT_EVDEV=y
+CONFIG_I2C_CHARDEV=y
+CONFIG_I2C_GPIO=y
+CONFIG_WATCHDOG=y
+CONFIG_S3C2410_WATCHDOG=y
+CONFIG_MFD_SEC_CORE=y
+CONFIG_REGULATOR=y
+CONFIG_REGULATOR_S2MPS11=y
+CONFIG_DRM=y
+CONFIG_DRM_FBDEV_EMULATION=y
+CONFIG_DRM_EXYNOS=m
+CONFIG_DRM_EXYNOS5433_DECON=y
+CONFIG_DRM_EXYNOS_DSI=y
+CONFIG_DRM_EXYNOS_MIC=y
+CONFIG_DRM_SIMPLEDRM=y
+CONFIG_DRM_PANFROST=m
+CONFIG_USB=y
+CONFIG_USB_DWC3=y
+CONFIG_USB_DWC3_GADGET=y
+CONFIG_USB_DWC3_HAPS=m
+CONFIG_USB_DWC3_OF_SIMPLE=m
+CONFIG_USB_GADGET=y
+CONFIG_USB_CONFIGFS=y
+CONFIG_USB_CONFIGFS_ECM=y
+CONFIG_USB_CONFIGFS_RNDIS=y
+CONFIG_MMC=y
+CONFIG_MMC_DW=y
+CONFIG_MMC_DW_EXYNOS=y
+CONFIG_COMMON_CLK_S2MPS11=y
+CONFIG_SAMSUNG_SEC_LOG_CONSOLE=y
+CONFIG_EXTCON=y
+CONFIG_EXTCON_SM5502=y
+CONFIG_EXT4_FS=y
+CONFIG_EXT4_FS_POSIX_ACL=y
+CONFIG_AUTOFS_FS=y
+CONFIG_OVERLAY_FS=y
+CONFIG_TMPFS=y
+CONFIG_TMPFS_POSIX_ACL=y
+CONFIG_PSTORE=y
+CONFIG_PSTORE_CONSOLE=y
+CONFIG_PSTORE_PMSG=y
+CONFIG_PSTORE_RAM=y
+CONFIG_CRYPTO_USER=y
+CONFIG_FONTS=y
+CONFIG_PRINTK_TIME=y
+CONFIG_MAGIC_SYSRQ=y
+CONFIG_PANIC_TIMEOUT=5
+
+# Thermal validation (docs/THERMAL.md): emul_temp for testing the trips;
+# drop once the trips are validated on the device.
+CONFIG_THERMAL_EMULATION=y
+
+# The initramfs reads /sys/class/watchdog/watchdog0/bootstatus to tell a
+# watchdog reset (which would loop back into RECOVERY) from a normal boot.
+CONFIG_WATCHDOG_SYSFS=y
+
+# Native display (docs/DISPLAY_M3.md, validated on the tablet 2026-10-28).
+# DRM_EXYNOS is m in the base config; the DECON/DSI/MIC bools need it =y.
+CONFIG_DRM_EXYNOS=y
+CONFIG_DRM_EXYNOS5433_DECON=y
+CONFIG_DRM_EXYNOS_DSI=y
+CONFIG_DRM_EXYNOS_MIC=y
+CONFIG_DRM_PANEL_SAMSUNG_S6E3HA2_TABS2=y
+CONFIG_BACKLIGHT_CLASS_DEVICE=y
+CONFIG_PHY_EXYNOS_MIPI_VIDEO=y
+# Scan-out buffers come from CMA (no IOMMU in use): one 1536x2048 XRGB8888
+# buffer is 12 MiB and the default 16 MiB pool made every allocation fail.
+CONFIG_CMA=y
+CONFIG_DMA_CMA=y
+CONFIG_CMA_SIZE_MBYTES=256
+
+# Real-time clock of the S2MPS13 PMIC (kept by Android): without it the
+# system starts in 1970 and PAM reports passwords "changed in future".
+CONFIG_RTC_CLASS=y
+CONFIG_RTC_DRV_S5M=y
+
+# Touchscreen (Synaptics s5806, RMI4 over I2C) and keys (gpio-keys):
+# docs/INPUT_M4.md, validated on the tablet on 2026-10-28.
+CONFIG_INPUT=y
+CONFIG_INPUT_KEYBOARD=y
+CONFIG_KEYBOARD_GPIO=y
+CONFIG_RMI4_CORE=y
+CONFIG_RMI4_I2C=y
+CONFIG_RMI4_F11=y
+CONFIG_RMI4_F12=y
+
+# Mali-T760 GPU (docs/GPU.md, validated on the tablet 2026-10-28) stays a
+# MODULE: built in, its probe runs before the initramfs watchdog guard,
+# and the first built-in boot looped (watchdog reset -> sboot boots
+# RECOVERY again).  Loaded by hand / by the initramfs after the guard.
+CONFIG_DRM_PANFROST=m
diff --git a/arch/arm/configs/gts28ltexx_m5.config b/arch/arm/configs/gts28ltexx_m5.config
new file mode 100644
index 000000000..b1c118738
--- /dev/null
+++ b/arch/arm/configs/gts28ltexx_m5.config
@@ -0,0 +1,61 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# Samsung Galaxy Tab S2 8.0 LTE (SM-T715, Exynos5433) - milestone 5
+#
+# Fragment merged on top of gts28ltexx_defconfig by
+#   make gts28ltexx_defconfig gts28ltexx_m5.config
+# (run by scripts/kbuild-mainline.sh --fragment gts28ltexx_m5.config).
+#
+# The defconfig already carries the milestone-2 base (PMIC, eMMC, USB
+# gadget).  This fragment adds the Wi-Fi/Bluetooth milestone-5 symbols:
+#
+#  - Exynos5433 PCIe host + PHY for the BCM4358 (14e4:43ec), built-in:
+#    the Wi-Fi chip is behind it and modules are not usable at the
+#    milestone's rootfs stage (no module loading set up).
+#  - brcmfmac (BRCMFMAC + BRCMFMAC_PCIE) built-in.  BRCMFMAC=y also
+#    avoids a firmware/module request for brcmfmac-wcc (fwvid vendor
+#    ops for the 0x43ec/WCC match are registered in the same vmlinux
+#    when built-in).  Firmware loading at boot is not a problem: the
+#    kernel request goes through the usual firmware loader and is
+#    satisfied from the rootfs once mounted; until then the driver
+#    probes fine and only the firmware request waits/fails.
+#  - Bluetooth HCI UART (BT_HCIUART_BCM, which selects BT_BCM and
+#    BT_HCIUART_H4) built-in.
+#  - Serial device bus for the hci_bcm serial client (SERIAL_DEV_BUS=y
+#    because SERIAL_DEV_CTRL_TTYPORT depends on SERIAL_DEV_BUS != m).
+#  - RFKILL for radio kill-switch wiring.
+#
+# Symbols flipped from =m by this fragment: CFG80211 (defconfig =m).
+# Newly enabled (not set in gts28ltexx_defconfig): SERIAL_SAMSUNG
+# (no Kconfig default; needed for ttySAC3), RFKILL, BT.
+
+# PCIe host + PHY for the BCM4358 (mainline 6.12: PCI_EXYNOS is =m in
+# gts28ltexx_defconfig, PHY_EXYNOS_PCIE is a bool that depends on
+# PCI_EXYNOS).
+CONFIG_PCI=y
+CONFIG_PCI_MSI=y
+CONFIG_PCI_EXYNOS=y
+CONFIG_PHY_EXYNOS_PCIE=y
+
+# Wi-Fi: brcmfmac with PCIe bus support.
+CONFIG_CFG80211=y
+CONFIG_BRCMFMAC=y
+CONFIG_BRCMFMAC_PCIE=y
+
+# Bluetooth: hci_uart with the Broadcom protocol (selects BT_BCM and
+# BT_HCIUART_H4).
+CONFIG_BT=y
+CONFIG_BT_HCIUART=y
+CONFIG_BT_HCIUART_BCM=y
+
+# Serial device bus (hci_bcm attaches through serdev); TTYPORT needs
+# SERIAL_DEV_BUS != m, hence =y.
+CONFIG_SERIAL_DEV_BUS=y
+CONFIG_SERIAL_DEV_CTRL_TTYPORT=y
+
+# Samsung serial driver for ttySAC3 (not in defconfig, no Kconfig
+# default; Bluetooth lives on that UART).
+CONFIG_SERIAL_SAMSUNG=y
+
+# Radio kill switch.
+CONFIG_RFKILL=y
diff --git a/arch/arm/configs/gts28ltexx_m6.config b/arch/arm/configs/gts28ltexx_m6.config
new file mode 100644
index 000000000..4a749e422
--- /dev/null
+++ b/arch/arm/configs/gts28ltexx_m6.config
@@ -0,0 +1,58 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# Milestone 6a (audio hardware) config fragment for the gts28ltexx
+# board.  Merged on top of gts28ltexx_defconfig (see
+# scripts/kbuild-mainline.sh --fragment), which already carries the
+# milestone-2 base (PMIC, eMMC, USB gadget).  Adds the audio chain:
+# Samsung I2S, the Arizona MFD/codec stack for the WM1814 (driven as
+# WM8998) and its internal regulators.  There is no machine driver
+# yet, so no sound card is instantiated; these options only make the
+# codec MFD and its ASoC component probe.  See docs/AUDIO_M6.md for the
+# rationale.
+#
+# All symbols set here hold (=y): SND_SOC_SAMSUNG and SND_SAMSUNG_I2S
+# have no user-visible blocker, and MFD_ARIZONA_I2C/MFD_WM8998 are
+# tristates with prompts.  The one deliberate omission is the codec's
+# ASoC component itself: CONFIG_SND_SOC_WM8998 is a promptless
+# tristate (sound/soc/codecs/Kconfig:2414-2416) whose only in-tree
+# activators are imply from SND_SOC_ALL_CODECS (needs COMPILE_TEST,
+# unacceptable on a device config) and select from a machine driver -
+# and mainline has no WM8998 machine driver.  A fragment line is
+# silently dropped for such symbols (olddefconfig ignores user values
+# without a prompt; verified by hand-appending the line to .config).
+# Mainline's own pattern is SND_SOC_SAMSUNG_TM2_WM5110
+# (sound/soc/samsung/Kconfig:118-125) selecting SND_SOC_WM5110; the
+# machine-driver milestone must do the same with SND_SOC_WM8998, which
+# also flips the promptless SND_SOC_ARIZONA helper (codec glue +
+# arizona-jack) to y via its defaults (sound/soc/codecs/Kconfig:366-377).
+
+# --- milestone 6a: audio ---
+# Sound core; SND selects SND_JACK/REGMAP_I2C as needed.
+CONFIG_SOUND=y
+CONFIG_SND=y
+CONFIG_SND_SOC=y
+CONFIG_SND_SOC_SAMSUNG=y
+# Exynos5433 I2S0 controller (sound/soc/samsung/i2s.c).
+CONFIG_SND_SAMSUNG_I2S=y
+# Arizona MFD over I2C (drivers/mfd/arizona-i2c.c matches
+# "wlf,wm1814") and the WM8998 cell set (WM1814 shares it).  The
+# wm8998-codec ASoC cell itself stays unbuilt (see header): its
+# SND_SOC_WM8998 symbol is promptless and needs the machine driver's
+# select.
+CONFIG_MFD_ARIZONA_I2C=y
+CONFIG_MFD_WM8998=y
+# Internal LDO1 (DCVDD) and MICSUPP (MICVDD) regulator cells of the
+# Arizona MFD (drivers/mfd/arizona-core.c: early_devs/wm8998_devs).
+CONFIG_REGULATOR_ARIZONA_LDO1=y
+CONFIG_REGULATOR_ARIZONA_MICSUPP=y
+# Arizona GPIO block (wm8998_devs "arizona-gpio" cell); also needed
+# because the codec node is a gpio-controller.
+CONFIG_GPIO_ARIZONA=y
+# Extcon: arizona-jack.c (linked into snd-soc-arizona) registers an
+# extcon device for jack detection.
+CONFIG_EXTCON=y
+# LPASS MFD (audio-subsystem@11400000) parents I2S0 and its ADMA.
+CONFIG_MFD_EXYNOS_LPASS=y
+# ADMA (arm,pl330) provides the I2S0 DMA channels.
+CONFIG_DMADEVICES=y
+CONFIG_PL330_DMA=y
diff --git a/arch/arm/configs/gts28ltexx_m7.config b/arch/arm/configs/gts28ltexx_m7.config
new file mode 100644
index 000000000..8a87eaaf1
--- /dev/null
+++ b/arch/arm/configs/gts28ltexx_m7.config
@@ -0,0 +1,29 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# Samsung Galaxy Tab S2 8.0 LTE (SM-T715, Exynos5433) - milestone 7
+#
+# Fragment merged on top of gts28ltexx_defconfig by
+#   make gts28ltexx_defconfig gts28ltexx_m7.config
+# (run by scripts/kbuild-mainline.sh --fragment gts28ltexx_m7.config).
+#
+# The defconfig already carries the milestone-2 base (PMIC +
+# regulators, eMMC, USB gadget).  This fragment adds the milestone-7
+# sensor drivers: the IIO core, the st_lsm6dsx IMU driver (covers the
+# LSM6DS3), the yamaha-yas530 magnetometer driver (covers the YAS537)
+# and the gpio-keys Hall switch, all built-in (=y) so
+# iio-sensor-proxy can read orientation and cover state from an
+# initramfs.
+#
+# I2C_EXYNOS5 (=y in the defconfig) is the hsi2c_10 controller driver
+# the two sensors sit on.
+
+# --- milestone 7 ---
+CONFIG_IIO=y
+CONFIG_IIO_BUFFER=y
+CONFIG_IIO_TRIGGERED_BUFFER=y
+CONFIG_IIO_ST_LSM6DSX=y
+CONFIG_IIO_ST_LSM6DSX_I2C=y
+CONFIG_YAMAHA_YAS530=y
+
+CONFIG_INPUT_EVDEV=y
+CONFIG_KEYBOARD_GPIO=y
