diff --git a/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx-gpu.dtsi b/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx-gpu.dtsi
new file mode 100644
index 000000000..9bbbbebab
--- /dev/null
+++ b/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx-gpu.dtsi
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Samsung Galaxy Tab S2 8.0 LTE (SM-T715), Exynos5433 - Mali-T760 GPU
+ *
+ * Enables the SoC's gpu@14ac0000 node (exynos5433.dtsi:1186-1235) for the
+ * mainline panfrost driver, with no frequency or voltage scaling: the GPU
+ * runs at the clock the G3D clock unit already has, on BUCK6 at the voltage
+ * the bootloader left.  docs/GPU.md has the source table and the reasoning.
+ *
+ * Stock reference (01_dumps/live_fdt.dts:1830-1836, node "mali"): same
+ * registers (0x14ac0000, 0x5000), same interrupts in the same order (SPI
+ * 282/283/281 = job/mmu/gpu), core clock aclk_g3d (mainline CLK_ACLK_G3D),
+ * power domain pd-g3d@105c4060 (mainline pd_g3d).  All of that is already
+ * in the SoC node; only the supply, the OPP table and the status change
+ * here.
+ */
+
+&gpu {
+	/*
+	 * GPU rail: BUCK6, "vdd_g3d" in the stock tree (live_fdt.dts:2399-2407)
+	 * and the regulator the stock Mali platform code drives
+	 * (kernel_universal5433 drivers/gpu/arm/t7xx/r22p0/platform/exynos/
+	 * gpu_exynos5433.c:683, regulator_get(NULL, "vdd_g3d")).  The board
+	 * file keeps it always-on at the bootloader voltage (600-1500 mV
+	 * window, no voltage request from anyone).  With no OPP table below,
+	 * panfrost only takes an enable reference on it
+	 * (panfrost_device.c:86-117, 225-230) and never sets a voltage.
+	 * The phandle also orders the GPU probe after the PMIC.
+	 */
+	mali-supply = <&buck6_reg>;
+	status = "okay";
+
+	/*
+	 * No OPP table, hence no devfreq: panfrost_devfreq_init() returns 0
+	 * when the device has no table (panfrost_devfreq.c:151-157) and the
+	 * GPU keeps the clock rate it finds at probe.  The SoC table is the
+	 * stock Mali driver's default table (gpu_exynos5433.c:46-55); stock
+	 * replaces its voltages by per-chip ASV values at boot
+	 * (gpu_dvfs_governor.c:263-284), and at 700 MHz it is below the
+	 * stock value of the slowest group in table version 1 (1150000 vs
+	 * 1162500 uV, mach/asv-exynos5433.h:539).  This chip's ASV group is
+	 * not known (docs/THERMAL.md section 8.1).
+	 */
+	/delete-property/ operating-points-v2;
+	/delete-node/ opp-table;
+};
diff --git a/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx-m3.dtsi b/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx-m3.dtsi
new file mode 100644
index 000000000..dbec75873
--- /dev/null
+++ b/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx-m3.dtsi
@@ -0,0 +1,156 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Samsung Galaxy Tab S2 8.0 LTE (SM-T715), Exynos5433 - milestone 3:
+ * native display.  Enable the mainline Exynos DRM display pipeline
+ * (DECON -> MIC -> MIPI-DSI -> Samsung S6E3HA2 1536x2048 AMOLED panel)
+ * and clock it from cmu_disp / cmu_mif, following the upstream TM2
+ * board as the reference for the same SoC (exynos5433-tm2.dts /
+ * exynos5433-tm2-common.dtsi).  See docs/DISPLAY_M3.md for the full
+ * source-value table and the DSI clock arithmetic.
+ *
+ * Everything here comes from the stock device tree
+ * (01_dumps/live_fdt.dts, line numbers cited per value) and Samsung's
+ * downstream kernel (02_sources/kernel_universal5433).
+ *
+ * Deliberately NOT touched:
+ *   - &framebuffer (simple-framebuffer): milestone 1 owns it; the DRM
+ *     pipeline takes over from simpledrm once it probes.
+ *   - &decon_tv / HDMI: out of scope for this board.
+ */
+
+#include <dt-bindings/clock/exynos5433.h>
+#include <dt-bindings/gpio/gpio.h>
+
+/*
+ * Panel TE (tearing effect) input pin, stock "disp_teson"
+ * (live_fdt.dts:5926-5931): gpg0-1 in display TES function
+ * (pin-function 0x02, EXYNOS_PIN_FUNC_2).  DECON receives TE through
+ * this display-domain mux (I80 hardware trigger via syscon_disp), not
+ * as a GPIO interrupt: the exynos5433-decon match data sets I80_HW_TRG
+ * and only falls back to a "te" platform IRQ if the DT node provides
+ * one, which it does not (exynos5433_drm_decon.c:748-752; the SoC dtsi
+ * decon node carries only fifo/vsync/lcd_sys IRQs).
+ */
+&pinctrl_peric {
+	disp_teson: disp-teson-pins {
+		samsung,pins = "gpg0-1";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
+	};
+};
+
+/*
+ * Display clocks, modelled on the TM2 board's &cmu_disp override
+ * (exynos5433-tm2.dts:25-53) minus every decon_tv entry, which this
+ * board never uses (no HDMI).  The parent topology is TM2's verbatim.
+ *
+ * Rates - pixel clock chain for the 1536x2048@60 panel mode
+ * (pixel clock 190682 kHz, see the panel driver):
+ *   CLK_FOUT_DISP_PLL = 1500 MHz: an exact exynos5433_pll_rates[]
+ *   entry (clk-exynos5433.c:748, PMS 250/4/0).
+ *   CLK_DIV_SCLK_DECON_VCLK_DISP = 1500 MHz / 8 = 187.5 MHz, giving a
+ *   ~59 Hz refresh: the closest achievable to 60 Hz, because the PLL
+ *   table has no ~190.68 MHz entry (the alternative, 1600/8 = 200 MHz,
+ *   would give ~63 Hz) and the divider is 3 bits wide, so /8 fits
+ *   (clk-exynos5433.c:2732).
+ *   Mainline DECON never calls clk_set_rate (exynos5433_drm_decon.c);
+ *   DT assigned-clocks are the only way to program this divider.
+ * Zero-rate entries are skipped by the clock core (clk-conf.c
+ * __set_clk_rates, "if (rate)"), so they only pad the parents array.
+ */
+&cmu_disp {
+	assigned-clocks = <&cmu_disp CLK_FOUT_DISP_PLL>,
+			  <&cmu_disp CLK_DIV_SCLK_DECON_VCLK_DISP>,
+			  <&cmu_disp CLK_MOUT_ACLK_DISP_333_USER>,
+			  <&cmu_disp CLK_MOUT_SCLK_DSIM0_USER>,
+			  <&cmu_disp CLK_MOUT_SCLK_DSIM0>,
+			  <&cmu_disp CLK_MOUT_SCLK_DECON_ECLK_USER>,
+			  <&cmu_disp CLK_MOUT_SCLK_DECON_ECLK>,
+			  <&cmu_disp CLK_MOUT_PHYCLK_MIPIDPHY0_RXCLKESC0_USER>,
+			  <&cmu_disp CLK_MOUT_PHYCLK_MIPIDPHY0_BITCLKDIV8_USER>,
+			  <&cmu_disp CLK_MOUT_DISP_PLL>;
+	assigned-clock-parents = <0>, <0>,
+				 <&cmu_mif CLK_ACLK_DISP_333>,
+				 <&cmu_mif CLK_SCLK_DSIM0_DISP>,
+				 <&cmu_disp CLK_MOUT_SCLK_DSIM0_USER>,
+				 <&cmu_mif CLK_SCLK_DECON_ECLK_DISP>,
+				 <&cmu_disp CLK_MOUT_SCLK_DECON_ECLK_USER>,
+				 <&cmu_disp CLK_PHYCLK_MIPIDPHY0_RXCLKESC0_PHY>,
+				 <&cmu_disp CLK_PHYCLK_MIPIDPHY0_BITCLKDIV8_PHY>,
+				 <&cmu_disp CLK_FOUT_DISP_PLL>;
+	assigned-clock-rates = <1500000000>, <187500000>, <0>, <0>, <0>,
+				<0>, <0>, <0>, <0>, <0>;
+};
+
+&decon {
+	status = "okay";
+};
+
+&mic {
+	status = "okay";
+};
+
+/*
+ * DSI host.  Stock mipi_dsi node (live_fdt.dts:1025-1043):
+ * eot_disable = 1 (no EoT packets, live_fdt.dts:1026), e_no_data_lane
+ * = 3 (4 lanes, live_fdt.dts:1042), e_interface = 0 (DSIM_COMMAND,
+ * i.e. CPU/I80 interface, live_fdt.dts:1035), e_pixel_format = 7
+ * (RGB888, live_fdt.dts:1034).
+ *
+ * DSI PLL clocks - see docs/DISPLAY_M3.md for the full derivation:
+ *   samsung,burst-clock-frequency = 512 MHz.  Stock
+ *   timing,dsi-hs-clk = <1024> MHz (live_fdt.dts:1046) is a lane-rate
+ *   request that the downstream driver halves (target 512 MHz) before
+ *   programming PLLCTRL with PMS (p=3, m=64, s=0) = 512 MHz VCO
+ *   (dsim_reg_calculate_pms, dsim_reg_5430.c).  Mainline
+ *   samsung_dsim_pll_find_pms(fin=24 MHz, fout=512 MHz) returns the
+ *   same (3, 64, 0), exactly: 64 * 24 / 3 = 512.  Asking for 1024 MHz
+ *   instead would yield (2, 85, 0) = 1020 MHz (m is capped at 125), a
+ *   different register value than stock.  512 MHz burst = 1024 Mbps
+ *   per lane (DDR), matching stock's lane rate.
+ *   samsung,esc-clock-frequency = 16 MHz: byte clock 64 MHz / 4, the
+ *   TM2 upstream value for the same SoC.  Stock DT asks for 7 MHz
+ *   (esc_clk = 0x6acfc0, live_fdt.dts:1037), but mainline computes the
+ *   escape divider as DIV_ROUND_UP(byte, esc) and clamps esc <= 20 MHz
+ *   (samsung-dsim.c samsung_dsim_enable_clock); 16 MHz is the value
+ *   proven on mainline for this DSI block.
+ *   samsung,pll-clock-frequency = 24 MHz: PLL reference (fin), TM2
+ *   upstream value; the SoC OSCCLK is 24 MHz.
+ *
+ * Supplies: downstream decon_mipi_dsi.c manages no DSIM regulators
+ * (the DSIM core rail is board-wired, always on).  Mainline
+ * samsung-dsim bulk-gets "vddcore" and "vddio"; with no vddcore node
+ * in the DT the regulator core supplies a dummy (regulator core,
+ * of_have_populated_dt() full constraints), and vddio is the 1.8 V
+ * panel I/O rail VDD3 (ldo39), as on the panel side.
+ */
+&dsi {
+	status = "okay";
+	vddio-supply = <&ldo39_reg>;
+	samsung,burst-clock-frequency = <512000000>;
+	samsung,esc-clock-frequency = <16000000>;
+	samsung,pll-clock-frequency = <24000000>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&disp_teson>;
+
+	/*
+	 * Stock panel node s6e3ha2_qxga (live_fdt.dts:1045-1061):
+	 * resolution 0x600 x 0x800 = 1536x2048 (live_fdt.dts:1054),
+	 * refresh 60 (live_fdt.dts:1058), size 0x7a x 0xa3 = 122 x 163 mm
+	 * (live_fdt.dts:1057), h-porch <1,1,1> (live_fdt.dts:1060),
+	 * v-porch <15,1,1> (live_fdt.dts:1055), dsi-hs-clk 1024 MHz
+	 * (live_fdt.dts:1046).  Reset gpg0-0 active low
+	 * (decon_board_gts28 reset_display_driver_panel,
+	 * live_fdt.dts:1074-1076); supplies VDD3_1.8V (ldo39),
+	 * VDDR_1.6V (ldo37), VCI_3.0V (ldo25)
+	 * (live_fdt.dts:1080-1082).  No ports needed: the DSI child is
+	 * implicit, as on TM2 (exynos5433-tm2.dts panel@0).
+	 */
+	panel@0 {
+		compatible = "samsung,s6e3ha2-tabs2";
+		reg = <0>;
+		vdd3-supply = <&ldo39_reg>;
+		vddr-supply = <&ldo37_reg>;
+		vci-supply = <&ldo25_reg>;
+		reset-gpios = <&gpg0 0 GPIO_ACTIVE_LOW>;
+	};
+};
diff --git a/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx-m4.dtsi b/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx-m4.dtsi
new file mode 100644
index 000000000..d731df128
--- /dev/null
+++ b/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx-m4.dtsi
@@ -0,0 +1,167 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Samsung Galaxy Tab S2 8.0 LTE (SM-T715), Exynos5433 - milestone 4
+ *
+ * Input devices: Synaptics RMI4 touchscreen and the GPIO keys (power,
+ * volume up/down, home).  All values are transcribed from the device's
+ * live device tree (01_dumps/live_fdt.dts) and mapped onto the mainline
+ * bindings; see docs/INPUT_M4.md for the value-by-value source table.
+ * The Coreriver tc300 touch-key controller on the same panel has no
+ * mainline driver and is deliberately left out.
+ */
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/linux-event-codes.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+
+/ {
+	/*
+	 * live_fdt.dts:7021-7060 "gpio_keys" node.  The stock tree gives
+	 * every button a 3-cell GPIO specifier whose flag cell is 0x0f;
+	 * bit 0 is OF_GPIO_ACTIVE_LOW, so all four keys are active low
+	 * (same wiring as the TM2 board, exynos5433-tm2-common.dtsi:56).
+	 * No debounce-interval in the stock tree: the downstream driver
+	 * defaults to 10 ms (drivers/input/keyboard/gpio_keys.c:859).
+	 */
+	gpio-keys {
+		compatible = "gpio-keys";
+
+		button-volume-up {
+			/* live_fdt.dts:7027-7033: <gpa2 0 0x0f>, 0x73 */
+			label = "gpio-keys: KEY_VOLUMEUP";
+			gpios = <&gpa2 0 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_VOLUMEUP>;
+			debounce-interval = <10>;
+		};
+
+		button-volume-down {
+			/* live_fdt.dts:7044-7050: <gpa2 1 0x0f>, 0x72 */
+			label = "gpio-keys: KEY_VOLUMEDOWN";
+			gpios = <&gpa2 1 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_VOLUMEDOWN>;
+			debounce-interval = <10>;
+		};
+
+		button-home {
+			/* live_fdt.dts:7035-7042: <gpa0 3 0x0f>, 0xac,
+			 * gpio-key,wakeup = <1>. */
+			label = "gpio-keys: KEY_HOMEPAGE";
+			gpios = <&gpa0 3 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_HOMEPAGE>;
+			debounce-interval = <10>;
+			wakeup-source;
+		};
+
+		button-power {
+			/* live_fdt.dts:7052-7058: <gpa2 7 0x0f>, 0x74,
+			 * gpio-key,wakeup = <1>. */
+			label = "gpio-keys: KEY_POWER";
+			gpios = <&gpa2 7 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_POWER>;
+			debounce-interval = <10>;
+			wakeup-source;
+		};
+	};
+};
+
+/*
+ * HSI2C channel 5 carries the Synaptics touchscreen.
+ * live_fdt.dts:1645-1676: hsi2c@14ED0000 (compatible
+ * "samsung,exynos5-hsi2c", samsung,i2c-max-bus-freq 0x61a80 = 400000) -
+ * mainline label hsi2c_5 (exynos5433.dtsi i2c@14ed0000), whose default
+ * pinctrl hs_i2c5_bus already matches the stock hs-i2c5-bus group
+ * (gpj1-0/gpj1-1, func 4, pull-up).  The stock "samsung,check-transdone-int"
+ * and "samsung,i2c-sda-delay" quirks are not read by the mainline
+ * i2c-exynos5 driver and are left out.
+ */
+&hsi2c_5 {
+	status = "okay";
+	clock-frequency = <400000>;
+
+	touchscreen@20 {
+		/* live_fdt.dts:1660-1675, reg <0x20>, compatible
+		 * "synaptics,rmi4" = mainline "syna,rmi4-i2c". */
+		compatible = "syna,rmi4-i2c";
+		reg = <0x20>;
+
+		/*
+		 * Stock "synaptics,irq_gpio = <0x42 0x01 0x00>" = gpa1-1
+		 * (live_fdt.dts:1674, bank phandle 0x42 at line 145); the
+		 * stock driver requests it with irq_type 0x2008 =
+		 * IRQF_TRIGGER_LOW | IRQF_ONESHOT
+		 * (synaptics,irq_type at live_fdt.dts:1669, decode in
+		 * drivers/input/touchscreen/synaptics_dsx2/
+		 * synaptics_i2c_rmi.c:1526 and linux/interrupt.h).  The
+		 * mainline core takes the trigger type from the DT and adds
+		 * IRQF_ONESHOT itself (drivers/input/rmi4/rmi_driver.c:221),
+		 * so the DT only carries IRQ_TYPE_LEVEL_LOW.
+		 */
+		interrupt-parent = <&gpa1>;
+		interrupts = <1 IRQ_TYPE_LEVEL_LOW>;
+
+		/*
+		 * Stock rails named "tsp_avdd" (analog, 3.3 V) and "tsp_io"
+		 * (IO/digital, 1.85 V), live_fdt.dts:1661/1665 -> S2MPS13
+		 * LDO30/LDO31 of the board file (PMIC section).  The
+		 * mainline driver enables vdd then vio in bulk, matching
+		 * the downstream avdd-then-dvdd power-on order
+		 * (synaptics_i2c_rmi.c:3704-3712).
+		 */
+		vdd-supply = <&ldo30_reg>;
+		vio-supply = <&ldo31_reg>;
+
+		/*
+		 * Stock power-on sequence: rails enabled, then 150 ms
+		 * margin before the first I2C access
+		 * (SYNAPTICS_POWER_MARGIN_TIME, synaptics_i2c_rmi.h:127,
+		 * used at synaptics_i2c_rmi.c:3969).  The stock node has no
+		 * reset GPIO (only "synaptics,irq_gpio"), so no
+		 * reset-gpios; the mainline rmi_i2c driver would not read
+		 * one either.
+		 */
+		syna,startup-delay-ms = <150>;
+
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		/* RMI4 function 01, always present.  No nosleep/doze tuning
+		 * in the stock tree, so none is invented here. */
+		rmi4-f01@1 {
+			reg = <0x1>;
+		};
+
+		/*
+		 * The stock driver handles both 2D-sensor functions, F11
+		 * and F12 (synaptics_i2c_rmi.c:1345/2886 and :1353/2908);
+		 * which one the panel's firmware exposes cannot be told
+		 * without the device, so both sub-nodes carry the stock
+		 * coordinates and the core binds whichever function is
+		 * found in the PDT.  Coordinates from "synaptics,max_coords
+		 * = <0x600 0x800>" (live_fdt.dts:1671) = 1536 x 2048.  The
+		 * stock tree declares no axis inversion or swap, so none is
+		 * set here; the mainline driver reads the real max values
+		 * from the sensor's control registers.
+		 */
+		rmi4-f11@11 {
+			reg = <0x11>;
+			touchscreen-size-x = <1536>;
+			touchscreen-size-y = <2048>;
+		};
+
+		rmi4-f12@12 {
+			reg = <0x12>;
+			touchscreen-size-x = <1536>;
+			touchscreen-size-y = <2048>;
+		};
+
+		/*
+		 * Left out, with reasons:
+		 * - "synaptics,firmware_name"/"firmware_name2"/
+		 *   "project_name" (live_fdt.dts:1670-1673): firmware
+		 *   reflashing is RMI4_F34 scope, not an input milestone.
+		 * - "synaptics,num_lines = <0x29 0x1f>" (live_fdt.dts:1664):
+		 *   downstream-only tuning; mainline reads the sensor
+		 *   geometry from the F11/F12 registers.
+		 */
+	};
+};
