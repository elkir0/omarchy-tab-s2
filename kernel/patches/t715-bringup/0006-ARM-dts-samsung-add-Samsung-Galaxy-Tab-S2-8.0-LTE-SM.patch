diff --git a/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx-m5.dtsi b/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx-m5.dtsi
new file mode 100644
index 000000000..755a84365
--- /dev/null
+++ b/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx-m5.dtsi
@@ -0,0 +1,288 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Samsung Galaxy Tab S2 8.0 LTE (SM-T715), Exynos5433 - milestone 5
+ *
+ * Wi-Fi: Broadcom BCM4358 on PCIe (brcmfmac), Bluetooth: BCM4358 on
+ * UART3 (hci_bcm).
+ *
+ * The stock kernel toggled the radio-enable GPIOs from vendor glue
+ * (bcmdhd dhd_custom_exynos.c, bcm4358.c) that has no mainline
+ * equivalent, so the sequencing is expressed with mainline mechanisms:
+ *
+ *  - wlan_reg_on (WLAN_EN, gpj2-0): the stock "samsung,brcm-wlan" gpio
+ *    0 (live_fdt.dts:4733-4738).  Mainline pci-exynos.c gets+enables
+ *    vdd18/vdd10 before host init and link training
+ *    (drivers/pci/controller/dwc/pci-exynos.c:307-314), so wiring the
+ *    GPIO rail as the required vdd18-supply is the one mainline hook
+ *    that powers the chip before perst is released.  always-on +
+ *    boot-on keep it up for the chip's lifetime, matching stock bcmdhd
+ *    which leaves WLAN_EN asserted once Wi-Fi is on.
+ *
+ *  - pcie_vdd10: the binding requires a 1.0 V PCIe rail
+ *    (samsung,exynos-pcie.yaml), but the live tree names no rail for
+ *    the PCIe block - this SoC's PMIC description has no LDO6/LDO7
+ *    (live_fdt.dts:2345-3080), so TM2's rails cannot be transcribed.
+ *    A dummy always-on fixed regulator restates the bootloader's
+ *    leave-on state (same policy as the usbdrd30 comment in
+ *    exynos5433-gts28ltexx.dts, PMIC section).
+ *
+ *  - BT_EN (gpd4-0) has a single writer: hci_bcm's shutdown-gpios.
+ *    No vbat/vddio supplies are given to hci_bcm: the binding makes
+ *    them optional and the live tree does not name those rails, so the
+ *    driver runs them as NULL instead of borrowing rails from another
+ *    board.
+ *
+ * All GPIOs, pins, clocks, IRQs and the baud rate are transcribed from
+ * the device's live device tree (01_dumps/live_fdt.dts) and the vendor
+ * configuration preserved in this repo (04_arch_rootfs overlay); see
+ * docs/WIFI_BT_M5.md for the value-by-value source table and the
+ * firmware-file derivations.
+ */
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/clock/samsung,s2mps11.h>
+
+/ {
+	aliases {
+		serial3 = &serial_3;
+	};
+
+	/*
+	 * WLAN_EN (gpj2-0): gpio 0 of the stock wlan node
+	 * (live_fdt.dts:4733-4738).  Downstream bcmdhd drives it high and
+	 * sleeps before touching the chip (dhd_custom_exynos.c:
+	 * gpio_direction_output(wlan_pwr_on, 1), then msleep
+	 * WIFI_TURNON_DELAY = 200, line 64).  No mainline driver owns this
+	 * GPIO, so it is modelled as a fixed 1.8 V rail consumed as the
+	 * PCIe controller's vdd18 supply.  The 1.8 V level is the generic
+	 * PCIe vdd18 level of the binding; the live tree does not name the
+	 * rail behind the pin, so no PMIC rail is claimed.
+	 */
+	wlan_reg_on: regulator-wlan-reg-on {
+		compatible = "regulator-fixed";
+		regulator-name = "wlan_reg_on";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		gpio = <&gpj2 0 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-always-on;
+		regulator-boot-on;
+		/* WIFI_TURNON_DELAY, dhd_custom_exynos.c:64 (200 ms). */
+		startup-delay-us = <200000>;
+	};
+
+	/*
+	 * PCIe vdd10: binding-required 1.0 V rail.  The live tree names no
+	 * rail for the PCIe block; this always-on placeholder restates the
+	 * bootloader's leave-on state rather than borrowing TM2's ldo6.
+	 */
+	pcie_vdd10: regulator-pcie-vdd10 {
+		compatible = "regulator-fixed";
+		regulator-name = "pcie_vdd10";
+		regulator-min-microvolt = <1000000>;
+		regulator-max-microvolt = <1000000>;
+		regulator-always-on;
+		regulator-boot-on;
+	};
+};
+
+/*
+ * PCIe host (fsys domain): stock pcie@15700000 (live_fdt.dts:7062-7077,
+ * "samsung,exynos5433-pcie"/"snps,dw-pcie", GIC SPI 245).  The stock
+ * node's pinctrl-0 = <pcie_bus cfg-wlanen pcie_wake wlan_host_wake>
+ * (four phandles, live_fdt.dts:7071); we mirror those four groups with
+ * mainline pinctrl settings.
+ *
+ * Mainline pci-exynos.c has no perst-GPIO support: the link reset flows
+ * from the controller registers (exynos_pcie_assert/deassert_core_reset),
+ * and the required vdd10/vdd18 supplies are the only pre-link power
+ * hook.  assigned-clocks restate TM2's 100 MHz refclk muxing
+ * (exynos5433-tm2-common.dtsi &pcie); the live tree leaves the CMU muxes
+ * as the bootloader set them.
+ */
+&pcie {
+	status = "okay";
+
+	pinctrl-names = "default";
+	/*
+	 * pcie_bus: SoC-level group gpr3-4/5/6 func 3 pull-up
+	 * (exynos5433-pinctrl.dtsi:340; same pins as the stock pcie_bus
+	 * group, live_fdt.dts:3849-3855).
+	 * wlan_en_pins / pcie_wake_pins / wlan_host_wake_pins: board groups
+	 * defined below, transcribed from the stock cfg-wlanen, pcie_wake
+	 * and wlan_host_wake groups.
+	 */
+	pinctrl-0 = <&pcie_bus &wlan_en_pins &pcie_wake_pins
+		     &wlan_host_wake_pins>;
+
+	vdd10-supply = <&pcie_vdd10>;
+	vdd18-supply = <&wlan_reg_on>;
+
+	assigned-clocks = <&cmu_fsys CLK_MOUT_SCLK_PCIE_100_USER>,
+			  <&cmu_top CLK_MOUT_SCLK_PCIE_100>;
+	assigned-clock-parents = <&cmu_top CLK_SCLK_PCIE_100_FSYS>,
+				 <&cmu_top CLK_MOUT_BUS_PLL_USER>;
+	assigned-clock-rates = <0>, <100000000>;
+
+	interrupt-map-mask = <0 0 0 0>;
+	interrupt-map = <0 0 0 0 &gic GIC_SPI 245 IRQ_TYPE_LEVEL_HIGH>;
+
+	/*
+	 * Stock config space reads 14e4:43ec (dmesg.txt:312
+	 * "device_vendor_id reg : 43ec14e4"), which mainline brcmfmac
+	 * matches via its BRCM_PCIE_4356_DEVICE_ID entry (pcie.c:2688).
+	 * Firmware choice is chip-ID-driven, not PCI-ID-driven: 0x4358 is
+	 * read from the chipcommon register at probe (chip.c:989),
+	 * yielding brcmfmac4358-pcie.
+	 *
+	 * The node carries a pci<vendor>,<device> compatible, as the PCI
+	 * bus binding requires for every function node (pci-device.yaml,
+	 * applied through pci-bus-common's patternProperties) and as the
+	 * Apple precedent does (t8103-jxxx.dtsi wifi@0,0 with
+	 * "pci14e4,4425"); 0x43ec is not in the fmac binding enum, so
+	 * "brcm,bcm4329-fmac" is not usable here without a schema finding.
+	 * Device matching is not affected: on PCI, brcmfmac binds through
+	 * its pci_device_id table, not DT.
+	 *
+	 * reg <0x10000 ...> = bus 1, device 0, function 0 - the stock
+	 * kernel enumerates the EP at 0000:01:00.0 (same idiom as the
+	 * Apple t8103-jxxx.dtsi wifi@0,0 node).
+	 *
+	 * No interrupts property: brcmf_of_probe parses IRQs for SDIO
+	 * only and returns early for other buses (brcmfmac/of.c:129), so
+	 * a DT OOB IRQ would be ignored by the PCIe driver anyway.
+	 * brcm,board-type is honoured even on PCI: brcmf_of_probe reads
+	 * it before its brcm,bcm4329-fmac gate (of.c:83 vs the
+	 * of_device_is_compatible() return at of.c:109-110), shortening
+	 * the NVRAM lookup to brcmfmac4358-pcie.gts28ltexx.txt
+	 * (firmware.c brcm_alt_fw_path).
+	 */
+	wifi@0,0 {
+		compatible = "pci14e4,43ec";
+		reg = <0x10000 0x0 0x0 0x0 0x0>;
+		brcm,board-type = "gts28ltexx";
+	};
+};
+
+&pcie_phy {
+	status = "okay";
+};
+
+/*
+ * Board pin groups, transcribed from the stock groups, placed inside
+ * their pinctrl controller nodes (only controller children become
+ * pin groups): cfg-wlanen (live_fdt.dts:5626-5632) and pcie_wake
+ * (402-407) / wlan_host_wake (666-672) / cfg-hostwake (438-444) /
+ * cfg-btwake (3496-3501) / cfg-en (6196-6201).  The stock power-down
+ * cells (samsung,pin-con-pdn / pin-pud-pdn) are kept out, like the
+ * rest of mainline exynos5433 boards.
+ */
+&pinctrl_ese {
+	wlan_en_pins: wlan-en-pins {
+		samsung,pins = "gpj2-0";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR4>;
+	};
+};
+
+&pinctrl_alive {
+	pcie_wake_pins: pcie-wake-pins {
+		samsung,pins = "gpf1-0";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+	};
+
+	wlan_host_wake_pins: wlan-host-wake-pins {
+		samsung,pins = "gpf3-1";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
+	};
+
+	bt_host_wake_pins: bt-host-wake-pins {
+		samsung,pins = "gpa2-2";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+	};
+};
+
+&pinctrl_fsys {
+	bt_wake_pins: bt-wake-pins {
+		samsung,pins = "gpr3-7";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+	};
+};
+
+&pinctrl_peric {
+	bt_en_pins: bt-en-pins {
+		samsung,pins = "gpd4-0";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
+	};
+};
+
+/*
+ * Bluetooth: stock serial@11460000 (live_fdt.dts:3988-4001) = mainline
+ * serial_3 = ttySAC3 (getprop.txt:240 ro.bluetooth.tty=ttySAC3), with
+ * the stock "broadcom,bcm4358" child (live_fdt.dts:4198-4203).  TM2
+ * wires the same three control pins on the same UART
+ * (exynos5433-tm2-common.dtsi &serial_3 bluetooth node).
+ */
+&serial_3 {
+	status = "okay";
+
+	bluetooth {
+		/*
+		 * No bcm4358 entry in hci_bcm's of_match table
+		 * (hci_bcm.c:1597-1612); brcm,bcm43540-bt carries
+		 * bcm4354_device_data with .no_early_set_baudrate = true,
+		 * matching the stock fixed-baud attach flow: the vendor
+		 * stack opens ttySAC3 at 921600 and loads the .hcd at
+		 * that speed.
+		 *
+		 * No brcm,requires-autobaud-mode: the stock flow never
+		 * autobauds.
+		 */
+		compatible = "brcm,bcm43540-bt";
+
+		/* BT_EN: stock gpio 0 / cfg-en, gpd4-0 (live_fdt.dts:4198
+		 * -4203, 6196-6201). */
+		shutdown-gpios = <&gpd4 0 GPIO_ACTIVE_HIGH>;
+		/* BT_WAKE: stock gpio 1 / cfg-btwake, gpr3-7. */
+		device-wakeup-gpios = <&gpr3 7 GPIO_ACTIVE_HIGH>;
+		/*
+		 * HOST_WAKE: stock gpio 2 / cfg-hostwake, gpa2-2.
+		 * interrupt-names "host-wakeup" is what hci_bcm looks up
+		 * (hci_bcm.c:1245, of_irq_get_byname(node,
+		 * "host-wakeup")); rising edge matches the downstream
+		 * IRQF_TRIGGER_RISING request (bcm4358.c).  interrupts
+		 * rather than the deprecated host-wakeup-gpios.
+		 */
+		interrupt-parent = <&gpa2>;
+		interrupts = <2 IRQ_TYPE_EDGE_RISING>;
+		interrupt-names = "host-wakeup";
+
+		/*
+		 * 32.768 kHz BT clock from the PMIC: s2mps13_osc output 2
+		 * ("s2mps13_bt", exynos5433-gts28ltexx.dts, PMIC section;
+		 * S2MPS11_CLK_BT = 2 in samsung,s2mps11.h).  "extclk" is
+		 * the deprecated spelling of "txco" but resolves through
+		 * bcm_get_txco's fallback (hci_bcm.c:1067-1082) and is
+		 * what TM2 uses; the stock BT node carries no clocks
+		 * property, the source follows the TM2 wiring for the
+		 * same chip family.
+		 */
+		clocks = <&s2mps13_osc S2MPS11_CLK_BT>;
+		clock-names = "extclk";
+
+		/* Stock attach baud (04_arch_rootfs overlay
+		 * etc/default/brcm-bluetooth BT_BAUD=921600; vendor
+		 * getprop ro.bluetooth.tty + libbt_vndcfg.txt). */
+		max-speed = <921600>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&bt_host_wake_pins &bt_wake_pins &bt_en_pins>;
+	};
+};
diff --git a/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx-m6.dts b/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx-m6.dts
