new file mode 100644
index 000000000..663ef82ea
--- /dev/null
+++ b/tools/testing/modem_v1/README
@@ -0,0 +1,43 @@
+modem_v1 SIPC5 ring vectors (gate O2)
+=====================================
+
+Host-side check of the SIPC5 framing, padding and BOOT-ring write code of
+drivers/misc/modem_v1 (Shannon SS333 modem, sec_modem_v1), against the ring
+vectors of research/modem/research/analysis/loader_spec_v2.md section 10.4
+(project repository omarchy-tab-s2).
+
+    make -C tools/testing/modem_v1 run
+
+Prints one TAP line per check and exits 0 only if every check passes.  Built
+with the host cc (-std=gnu11 -Wall -Wextra -Werror); nothing runs on the
+tablet and no kernel build is needed.
+
+What is compiled from the driver, unmodified:
+  - include/sipc5.h and include/circ_queue.h, included as they are;
+  - sipc5_build_config() and sipc5_build_header() from modem_io_device.c,
+    check_udl_space() and udl_write() from link_device_bootdump.c, copied
+    at build time by extract.awk into gen/ (the build fails if one of them
+    is not found, so the test cannot run against stale code).
+build_frame() in sipc5_vectors.c mirrors the framing steps of misc_write();
+the five txq accessors are copies of the one-line inlines of
+link_device_memory.h.
+
+Checks:
+  - seven vectors: 4-byte request (FC D7 08 00), CRC frame (FC D7 0C 00),
+    2064-byte data frame (FC D7 14 08), TOC frame (FC D7 14 02), last MAIN
+    frame (FC D7 B4 01), synthetic 921-byte frame (FC D7 9D 03, 3 zero
+    padding bytes, 928 in the ring), BOOT over SPI (F8 D7 00 2A, 0x29FC
+    payload bytes left after the header is stripped): header bytes, length
+    field, total length, payload placement, padding, and that the CP's
+    round-up-4 advance equals the AP's head advance;
+  - padding sizes 0..8, the 4/6-byte header boundary (0xFFFB/0xFFFC), the
+    decoding of a CP reply frame;
+  - udl_write on a 0x1FD000-byte ring (three frames back to back), a wrap
+    at the end of a 64-byte ring, and the all-or-nothing -ENOSPC case.
+
+Host size_t: sipc5.h asserts sizeof(size_t) == SIPC5_ALIGN (4), a check for
+the ARM32 kernel build.  On a 64-bit host the shim (shim/linux/build_bug.h)
+turns static_assert into a no-op for the included driver headers;
+sipc5_vectors.c asserts SIPC5_ALIGN == 4 itself.  With the 3.10 rule
+(padding to sizeof(size_t)) this host would pad to 8 and 20 checks fail,
+e.g. the 12-byte CRC frame becomes 16 bytes.
diff --git a/tools/testing/modem_v1/extract.awk b/tools/testing/modem_v1/extract.awk
new file mode 100644
index 000000000..0928cd753
--- /dev/null
+++ b/tools/testing/modem_v1/extract.awk
@@ -0,0 +1,18 @@
+# Print the definition of function FN (awk -v fn=NAME) from a C file: the
+# lines from "static ... NAME(" at column 0 to the closing "}" at column 0.
+# A prototype (a header that ends with ");" before any "{") is skipped.
+# Exit status 1 if no definition was found.
+BEGIN { state = 0; found = 0 }
+state == 0 && $0 ~ "^static[^;]*[ *]" fn "\\(" { buf = $0 "\n"; state = 1; next }
+state == 1 {
+	if ($0 ~ /\);[ \t]*$/) { state = 0; buf = ""; next }
+	buf = buf $0 "\n"
+	if ($0 == "{") state = 2
+	next
+}
+state == 2 {
+	buf = buf $0 "\n"
+	if ($0 == "}") { printf "%s", buf; found = 1; state = 3 }
+	next
+}
+END { if (!found) exit 1 }
diff --git a/tools/testing/modem_v1/shim/linux/build_bug.h b/tools/testing/modem_v1/shim/linux/build_bug.h
new file mode 100644
index 000000000..44df6a6bf
--- /dev/null
+++ b/tools/testing/modem_v1/shim/linux/build_bug.h
@@ -0,0 +1,11 @@
+/*
+ * sipc5.h asserts sizeof(size_t) == SIPC5_ALIGN (4): a check for the ARM32
+ * kernel build.  On a 64-bit host size_t is 8, so the included driver
+ * headers get a no-op static_assert; sipc5_vectors.c asserts
+ * SIPC5_ALIGN == 4 itself and checks the padding through the vectors.
+ */
+#ifndef SHIM_LINUX_BUILD_BUG_H
+#define SHIM_LINUX_BUILD_BUG_H
+#undef static_assert
+#define static_assert(expr, ...) _Static_assert(1, "kernel-only check")
+#endif
