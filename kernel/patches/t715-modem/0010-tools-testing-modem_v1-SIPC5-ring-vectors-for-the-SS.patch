--- /dev/null
+++ b/tools/testing/modem_v1/Makefile
@@ -0,0 +1,50 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# Host-side check of the SIPC5 framing, padding and BOOT-ring write code of
+# drivers/misc/modem_v1 against the ring vectors of
+# research/modem/research/analysis/loader_spec_v2.md section 10.4 (gate O2).
+# The functions under test are compiled from the driver sources: the
+# headers are included as they are, and the static functions are extracted
+# from the .c files at build time, so the test can never check stale code.
+#
+#   make -C tools/testing/modem_v1 run
+
+SRC	:= ../../../drivers/misc/modem_v1
+GEN	:= gen
+CC	?= cc
+# -Wno-unused-parameter: the extracted driver functions keep their 3.10
+# signatures (sipc5_build_header() does not use its link_device argument).
+# -Wno-pointer-sign: as in the kernel build (udl_write() takes skb->data,
+# an unsigned char *, into a char *).
+CFLAGS	:= -std=gnu11 -O2 -Wall -Wextra -Werror -Wno-unused-parameter \
+	   -Wno-pointer-sign \
+	   -I shim -I $(SRC)/include -I $(GEN)
+
+all: sipc5_vectors
+
+$(GEN)/framing.h: $(SRC)/modem_io_device.c extract.awk
+	@mkdir -p $(GEN)
+	@echo "/* generated from modem_io_device.c, do not edit */" > $@.tmp
+	awk -v fn=sipc5_build_config -f extract.awk $< >> $@.tmp
+	awk -v fn=sipc5_build_header -f extract.awk $< >> $@.tmp
+	@mv $@.tmp $@
+
+$(GEN)/udl.h: $(SRC)/link_device_bootdump.c extract.awk
+	@mkdir -p $(GEN)
+	@echo "/* generated from link_device_bootdump.c, do not edit */" > $@.tmp
+	awk -v fn=check_udl_space -f extract.awk $< >> $@.tmp
+	awk -v fn=udl_write -f extract.awk $< >> $@.tmp
+	@mv $@.tmp $@
+
+sipc5_vectors: sipc5_vectors.c $(GEN)/framing.h $(GEN)/udl.h \
+		$(SRC)/include/sipc5.h $(SRC)/include/circ_queue.h \
+		$(wildcard shim/linux/*.h)
+	$(CC) $(CFLAGS) -o $@ sipc5_vectors.c
+
+run: sipc5_vectors
+	./sipc5_vectors
+
+clean:
+	rm -rf $(GEN) sipc5_vectors
+
+.PHONY: all run clean
