--- a/drivers/misc/modem_v1/include/sipc5.h
+++ b/drivers/misc/modem_v1/include/sipc5.h
@@ -16,7 +16,8 @@
 #define __SIPC5_H__
 
 #include <linux/types.h>
-#include <linux/platform_data/modem_v1.h>
+#include <linux/build_bug.h>
+#include "modem_v1.h"
 
 /* SIPC5 link-layer header */
 struct __packed sipc5_link_header {
@@ -90,10 +91,20 @@ static inline u8 sipc5_get_ctrl(u8 *frm)
 	return frm[SIPC5_CTRL_OFFSET];
 }
 
+/*
+ * 6.12 port: frames are padded to SIPC5_ALIGN bytes.  The 3.10 code used
+ * sizeof(size_t), which is 4 on the stock ARM32 kernel and on this one; the
+ * CP BOOT advances its ring pointer by round-up-4, so the value is pinned
+ * (research/modem/research/SYNTHESIS.md section 2.8, RI C8).
+ */
+#define SIPC5_ALIGN	4
+static_assert(sizeof(size_t) == SIPC5_ALIGN,
+	      "SIPC5 padding must stay 4 bytes (stock ARM32 sizeof(size_t))");
+
 static inline unsigned int sipc5_calc_padding_size(unsigned int len)
 {
-	unsigned int residue = len & (sizeof(size_t) - 1);
-	return residue ? (sizeof(size_t) - residue) : 0;
+	unsigned int residue = len & (SIPC5_ALIGN - 1);
+	return residue ? (SIPC5_ALIGN - residue) : 0;
 }
 
