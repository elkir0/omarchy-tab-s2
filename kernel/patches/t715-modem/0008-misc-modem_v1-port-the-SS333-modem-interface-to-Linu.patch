diff --git a/drivers/misc/modem_v1/include/modem_wakelock.h b/drivers/misc/modem_v1/include/modem_wakelock.h
new file mode 100644
index 000000000..b214feba3
--- /dev/null
+++ b/drivers/misc/modem_v1/include/modem_wakelock.h
@@ -0,0 +1,51 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Android wake_lock API of the Samsung 3.10 tree (<linux/wakelock.h>) on top
+ * of mainline wakeup sources, so that the vendor call sites stay unchanged.
+ * Same mapping as the wakelock.h compatibility header of later Android
+ * common kernels: a wake_lock is a wakeup_source; a NULL source (failed
+ * registration) turns every call into a no-op.
+ */
+
+#ifndef __MODEM_WAKELOCK_H__
+#define __MODEM_WAKELOCK_H__
+
+#include <linux/jiffies.h>
+#include <linux/pm_wakeup.h>
+
+#define WAKE_LOCK_SUSPEND	0
+
+struct wake_lock {
+	struct wakeup_source *ws;
+};
+
+static inline void wake_lock_init(struct wake_lock *lock, int type,
+				  const char *name)
+{
+	lock->ws = wakeup_source_register(NULL, name);
+}
+
+static inline void wake_lock(struct wake_lock *lock)
+{
+	if (lock->ws)
+		__pm_stay_awake(lock->ws);
+}
+
+static inline void wake_lock_timeout(struct wake_lock *lock, long timeout)
+{
+	if (lock->ws)
+		__pm_wakeup_event(lock->ws, jiffies_to_msecs(timeout));
+}
+
+static inline void wake_unlock(struct wake_lock *lock)
+{
+	if (lock->ws)
+		__pm_relax(lock->ws);
+}
+
+static inline bool wake_lock_active(struct wake_lock *lock)
+{
+	return lock->ws ? lock->ws->active : false;
+}
+
+#endif /* __MODEM_WAKELOCK_H__ */
