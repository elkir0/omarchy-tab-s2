new file mode 100644
index 000000000..a46f6c090
--- /dev/null
+++ b/drivers/misc/modem_v1/Kconfig
@@ -0,0 +1,23 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# Samsung modem interface (modem_v1), port of the Samsung 3.10 driver for
+# the Shannon SS333 CP of the Galaxy Tab S2 (SM-T715): SIPC5 over MIPI-LLI
+# shared memory, CP first stage over SPI.
+#
+
+config SEC_MODEM_V1
+	tristate "Samsung SS333 modem interface (SIPC5 over MIPI-LLI, SPI boot)"
+	depends on ARM
+	depends on MIPI_LLI && SPI && OF && GPIOLIB && NET
+	select CRC32
+	help
+	  Samsung modem interface driver (SVNET2 "modem_v1") for the Shannon
+	  SS333 CP of the Galaxy Tab S2 8.0 LTE (SM-T715): /dev/umts_* character
+	  devices, rmnet0-3 network interfaces, the SIPC5 memory link over
+	  MIPI-LLI shared memory and the SPI link that carries the CP first
+	  stage.  Ported from the Samsung 3.10 kernel (drivers/misc/modem_v1).
+
+	  The module never drives a CP line, the SPI bus or the MIPI-LLI link
+	  unless its allow_hw parameter is set.
+
+	  Build it as a module (sec_modem_v1); it cannot be unloaded.
