From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: elkir0 <elkir0@users.noreply.github.com>
Date: Sat, 31 Oct 2026 12:00:00 +0000
Subject: [PATCH 01/16] dt-bindings: clock: exynos5433: add CMU_CPIF MIPI-LLI
 clock IDs

The MIPI-LLI link to the SS333 modem needs the two 150 MHz symbol
clocks the M-PHY feeds back to CMU_CPIF, the two SRC_SEL_CPIF1 muxes
that select them, and ten ENABLE_IP_CPIF0/1 gates (the clock list of the
stock DT node, kernel_universal5433 arch/arm/boot/dts/exynos5433.dtsi:
2128-2172).  None of them is modelled upstream.

CLK_SCLK_MPHY_PLL and CLK_SCLK_UFS_MPHY already share ID 11; that is
left alone, since renumbering would break the DT ABI, and the new IDs
start at 12.  CLKS_NR_CPIF follows the new last ID.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/clk/samsung/clk-exynos5433.c   |  2 +-
 include/dt-bindings/clock/exynos5433.h | 22 ++++++++++++++++++++++
 2 files changed, 23 insertions(+), 1 deletion(-)

diff --git a/drivers/clk/samsung/clk-exynos5433.c b/drivers/clk/samsung/clk-exynos5433.c
index 609d31a7a..ec83641de 100644
--- a/drivers/clk/samsung/clk-exynos5433.c
+++ b/drivers/clk/samsung/clk-exynos5433.c
@@ -23,7 +23,7 @@
 
 /* NOTE: Must be equal to the last clock ID increased by one */
 #define CLKS_NR_TOP			(CLK_SCLK_HDMI_SPDIF_DISP + 1)
-#define CLKS_NR_CPIF			(CLK_SCLK_UFS_MPHY + 1)
+#define CLKS_NR_CPIF			(CLK_GATE_CPIFNM_200 + 1)
 #define CLKS_NR_MIF			(CLK_SCLK_BUS_PLL_ATLAS + 1)
 #define CLKS_NR_PERIC			(CLK_DIV_SCLK_SC_IN + 1)
 #define CLKS_NR_PERIS			(CLK_SCLK_OTP_CON + 1)
diff --git a/include/dt-bindings/clock/exynos5433.h b/include/dt-bindings/clock/exynos5433.h
index d12c1a963..6c534db0d 100644
--- a/include/dt-bindings/clock/exynos5433.h
+++ b/include/dt-bindings/clock/exynos5433.h
@@ -198,6 +198,28 @@
 #define CLK_SCLK_MPHY_PLL		11
 #define CLK_SCLK_UFS_MPHY		11
 
+/*
+ * MIPI-LLI clocks.  CLK_SCLK_MPHY_PLL and CLK_SCLK_UFS_MPHY above share
+ * ID 11 (upstream bug, kept: renumbering would break the DT ABI), so the
+ * new IDs start at 12.
+ */
+#define CLK_PHYCLK_LLI_TX0_SYMBOL		12
+#define CLK_PHYCLK_LLI_RX0_SYMBOL		13
+
+#define CLK_MOUT_PHYCLK_LLI_TX0_SYMBOL_USER	14
+#define CLK_MOUT_PHYCLK_LLI_RX0_SYMBOL_USER	15
+
+#define CLK_GATE_LLI_SVC_LOC			16
+#define CLK_GATE_LLI_SVC_REM			17
+#define CLK_GATE_LLI_LL_INIT			18
+#define CLK_GATE_LLI_BE_INIT			19
+#define CLK_GATE_LLI_CMN_CFG			20
+#define CLK_GATE_LLI_TX0_CFG			21
+#define CLK_GATE_LLI_RX0_CFG			22
+#define CLK_GATE_LLI_TX0_SYMBOL			23
+#define CLK_GATE_LLI_RX0_SYMBOL			24
+#define CLK_GATE_CPIFNM_200			25
+
 /* CMU_MIF */
 #define CLK_FOUT_MEM0_PLL		1
 #define CLK_FOUT_MEM1_PLL		2
