index 000000000..ec11f7b89
--- /dev/null
+++ b/drivers/misc/mipi-lli/mipi-lli.c
@@ -0,0 +1,827 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * MIPI-LLI driver
+ *
+ * Copyright (C) 2013 Samsung Electronics Co.Ltd
+ * Author: Yulgon Kim <yulgon.kim@samsung.com>
+ *
+ * Port to Linux 6.12 for the SS333 modem link of the SM-T715
+ * (research/modem/research/analysis/kernel_port_design.md section 2.2):
+ *  - the exported API keeps the 3.10 prototypes; every call is safe
+ *    before the driver is bound;
+ *  - the shared memory is a DT reserved-memory region owned by the
+ *    controller driver; nothing is mapped here any more (3.10
+ *    mipi_lli_vmap and the store commands 5/6/98/99 are gone);
+ *  - allow_hw (default 0) gates every hardware access: with 0 nothing
+ *    turns a clock on or touches an LLI, M-PHY or PMU register;
+ *  - lli_control keeps its show format, the loader polls it;
+ *  - debugfs mipi-lli/{status,hw_init,reset} for the bring-up gates.
+ */
+
+#include <linux/debugfs.h>
+#include <linux/device.h>
+#include <linux/fs.h>
+#include <linux/interrupt.h>
+#include <linux/irq.h>
+#include <linux/jiffies.h>
+#include <linux/kstrtox.h>
+#include <linux/mipi-lli.h>
+#include <linux/module.h>
+#include <linux/ratelimit.h>
+#include <linux/seq_file.h>
+#include <linux/sysfs.h>
+#include <linux/wait.h>
+
+static struct mipi_lli *g_lli;
+
+static bool allow_hw;
+module_param(allow_hw, bool, 0644);
+MODULE_PARM_DESC(allow_hw,
+	"Allow LLI clock, register and PMU access (default 0: the driver binds but never touches the hardware)");
+
+static bool lli_debug_cmds;
+module_param(lli_debug_cmds, bool, 0644);
+MODULE_PARM_DESC(lli_debug_cmds,
+	"Accept lli_control commands 1 (re-init), 2 (master), 3 (mount); also needs allow_hw=1");
+
+static unsigned int sig_irq_storm_limit = 10000;
+module_param(sig_irq_storm_limit, uint, 0644);
+MODULE_PARM_DESC(sig_irq_storm_limit,
+	"Signal (SPI 185) interrupts per second above which the IRQ is disabled until mipi_lli_enable_irq() or a reset (0: no guard)");
+
+static struct mipi_lli *lli_get(void)
+{
+	/* Pairs with smp_store_release() in mipi_lli_add_driver(). */
+	return smp_load_acquire(&g_lli);
+}
+
+/**
+ * mipi_lli_hw_allowed - may the MIPI-LLI and modem drivers touch hardware
+ *
+ * Returns the allow_hw module parameter.
+ */
+bool mipi_lli_hw_allowed(void)
+{
+	return READ_ONCE(allow_hw);
+}
+EXPORT_SYMBOL(mipi_lli_hw_allowed);
+
+/* Explicit actions need allow_hw=1 and the clocks on. */
+static bool lli_hw_usable(struct mipi_lli *lli)
+{
+	return lli && mipi_lli_hw_allowed() && mipi_lli_clks_on(lli);
+}
+
+/*
+ * hw_init: clocks on (once), PMU LLI_PHY_CON = 1, LLI interrupts masked and
+ * cleared, IRQs enabled.  Process context only, under hw_mutex.
+ */
+static int mipi_lli_hw_init_locked(struct mipi_lli *lli)
+{
+	lockdep_assert_held(&lli->hw_mutex);
+
+	if (!mipi_lli_hw_allowed())
+		return -EPERM;
+	if (lli->hw_init_done)
+		return 0;
+
+	return lli->driver->hw_init(lli);
+}
+
+static int mipi_lli_hw_init(struct mipi_lli *lli)
+{
+	int ret;
+
+	might_sleep();
+
+	mutex_lock(&lli->hw_mutex);
+	ret = mipi_lli_hw_init_locked(lli);
+	mutex_unlock(&lli->hw_mutex);
+
+	return ret;
+}
+
+/* allow_hw=1 and hw_init done (runs it, and may sleep, if not). */
+static int lli_prepare_hw(struct mipi_lli *lli)
+{
+	if (!mipi_lli_hw_allowed())
+		return -EPERM;
+	/* Pairs with smp_store_release() at the end of hw_init. */
+	if (smp_load_acquire(&lli->hw_init_done))
+		return 0;
+
+	return mipi_lli_hw_init(lli);
+}
+
+static void lli_refused(struct mipi_lli *lli, const char *what, int err)
+{
+	dev_warn_ratelimited(lli->dev, "lli: %s refused (%d): allow_hw=%d hw_init=%d\n",
+			     what, err, mipi_lli_hw_allowed(), lli->hw_init_done);
+}
+
+/*
+ * Explicit soft reset (mipi_lli_reset, debugfs reset, lli_control 1).  Process
+ * context, hw_init done.  Starts a new interlock round (reset_done and
+ * remap_ok cleared until its SW_RESET_DONE), re-arms the
+ * RESET_ON_ERROR_SENT limiter and re-enables an IRQ the storm guards
+ * disabled.
+ */
+static void lli_do_reset(struct mipi_lli *lli)
+{
+	unsigned long flags;
+
+	WRITE_ONCE(lli->reset_done, false);
+	WRITE_ONCE(lli->remap_ok, false);
+	WRITE_ONCE(lli->roe_stopped, false);
+	WRITE_ONCE(lli->roe_resets, 0);
+
+	if (READ_ONCE(lli->irq_storm_off)) {
+		WRITE_ONCE(lli->irq_storm_off, false);
+		enable_irq(lli->irq);
+	}
+
+	spin_lock_irqsave(&lli->lock, flags);
+	if (lli->sig_storm_off && !lli->sig_irq_active) {
+		lli->sig_storm_off = false;
+		enable_irq(lli->irq_sig);
+		lli->sig_irq_active = true;
+	}
+	spin_unlock_irqrestore(&lli->lock, flags);
+
+	lli->driver->init(lli);
+
+	atomic_set(&lli->mnt_cnt, 0);
+}
+
+/**
+ * mipi_lli_remap_ok - mount interlock state
+ *
+ * True when the last SW_RESET_DONE wrote the link settings and read back
+ * the expected IAL_LL/BE_INIT_ADDR_REMAP and LLI_PHY_CON; cleared by every
+ * reset.  The LLI driver accepts a mount only while it holds.
+ */
+bool mipi_lli_remap_ok(void)
+{
+	struct mipi_lli *lli = lli_get();
+
+	return lli && READ_ONCE(lli->remap_ok);
+}
+EXPORT_SYMBOL(mipi_lli_remap_ok);
+
+/**
+ * mipi_lli_wait_reset_done - wait for the SW_RESET_DONE of the last reset
+ * @timeout_ms: how long to wait
+ *
+ * For the modem driver, which must release CP_RESET only after this.
+ * Sleeps.  Returns 0 if a SW_RESET_DONE was handled since the last
+ * mipi_lli_reset() and remap_ok holds, -EIO if it was handled but the
+ * readback failed, -ETIMEDOUT if none came, -ENODEV if not bound.
+ */
+int mipi_lli_wait_reset_done(unsigned int timeout_ms)
+{
+	struct mipi_lli *lli = lli_get();
+
+	if (!lli)
+		return -ENODEV;
+
+	might_sleep();
+
+	/* Pairs with smp_store_release() in the SW_RESET_DONE handler. */
+	wait_event_timeout(lli->reset_wq, smp_load_acquire(&lli->reset_done),
+			   msecs_to_jiffies(timeout_ms));
+	if (!smp_load_acquire(&lli->reset_done))
+		return -ETIMEDOUT;
+
+	return READ_ONCE(lli->remap_ok) ? 0 : -EIO;
+}
+EXPORT_SYMBOL(mipi_lli_wait_reset_done);
+
+/**
+ * mipi_lli_get_phys_base
+ *
+ * Returns physical base address, 0 while the driver is not bound.
+ */
+unsigned long mipi_lli_get_phys_base(void)
+{
+	struct mipi_lli *lli = lli_get();
+
+	/* The probe refuses a region that does not end below 4 GiB. */
+	return lli ? (unsigned long)lli->phy_addr : 0;
+}
+EXPORT_SYMBOL(mipi_lli_get_phys_base);
+
+/**
+ * mipi_lli_get_phys_size
+ *
+ * Returns phys address size, 0 while the driver is not bound.
+ */
+unsigned long mipi_lli_get_phys_size(void)
+{
+	struct mipi_lli *lli = lli_get();
+
+	return lli ? (unsigned long)lli->shdmem_size : 0;
+}
+EXPORT_SYMBOL(mipi_lli_get_phys_size);
+
+/**
+ * mipi_lli_suspended
+ *
+ * Returns mipi_lli_is_suspended.
+ */
+int mipi_lli_suspended(void)
+{
+	struct mipi_lli *lli = lli_get();
+
+	return lli ? lli->is_suspended : 0;
+}
+EXPORT_SYMBOL(mipi_lli_suspended);
+
+/**
+ * mipi_lli_get_link_status
+ *
+ * Returns mipi_lli_link_status.
+ */
+int mipi_lli_get_link_status(void)
+{
+	struct mipi_lli *lli = lli_get();
+
+	return lli ? atomic_read(&lli->state) : LLI_UNMOUNTED;
+}
+EXPORT_SYMBOL(mipi_lli_get_link_status);
+
+/**
+ * mipi_lli_set_link_status
+ * @state: enum mipi_lli_link_status
+ *
+ * Returns 0, -ENODEV while the driver is not bound.
+ */
+int mipi_lli_set_link_status(int state)
+{
+	struct mipi_lli *lli = lli_get();
+
+	if (!lli)
+		return -ENODEV;
+
+	atomic_set(&lli->state, state);
+
+	return 0;
+}
+EXPORT_SYMBOL(mipi_lli_set_link_status);
+
+/**
+ * mipi_lli_register_handler
+ * @handler: callback function when signal interrupt is occured.
+ * @data: parameter when handler is callbacked.
+ *
+ * Returns 0 on success, -EINVAL without handler, -ENODEV while the driver
+ * is not bound.
+ */
+int mipi_lli_register_handler(void (*handler)(void *, u32), void *data)
+{
+	struct mipi_lli *lli = lli_get();
+	unsigned long flags;
+
+	if (!handler)
+		return -EINVAL;
+	if (!lli)
+		return -ENODEV;
+
+	/* Register interrupt handler */
+	spin_lock_irqsave(&lli->lock, flags);
+	lli->hd.data = data;
+	lli->hd.handler = handler;
+	spin_unlock_irqrestore(&lli->lock, flags);
+
+	return 0;
+}
+EXPORT_SYMBOL(mipi_lli_register_handler);
+
+/**
+ * mipi_lli_unregister_handler
+ * @handler: callback function when signal interrupt is occured.
+ *
+ * Returns 0 on success, -EINVAL otherwise.
+ */
+int mipi_lli_unregister_handler(void (*handler)(void *, u32))
+{
+	struct mipi_lli *lli = lli_get();
+	unsigned long flags;
+	int ret = 0;
+
+	if (!handler || !lli)
+		return -EINVAL;
+
+	/* Unregister interrupt handler */
+	spin_lock_irqsave(&lli->lock, flags);
+	if (lli->hd.handler != handler) {
+		ret = -EINVAL;
+	} else {
+		lli->hd.data = NULL;
+		lli->hd.handler = NULL;
+	}
+	spin_unlock_irqrestore(&lli->lock, flags);
+
+	return ret;
+}
+EXPORT_SYMBOL(mipi_lli_unregister_handler);
+
+/**
+ * mipi_lli_send_interrupt - sending sideband signal.
+ * @cmd: Send interrupt command
+ *
+ * Does nothing with allow_hw=0 or before hw_init.
+ */
+void mipi_lli_send_interrupt(u32 cmd)
+{
+	struct mipi_lli *lli = lli_get();
+
+	if (!lli_hw_usable(lli))
+		return;
+
+	lli->driver->send_signal(lli, cmd);
+}
+EXPORT_SYMBOL(mipi_lli_send_interrupt);
+
+/**
+ * mipi_lli_reset_interrupt - Clear all sideband signal.
+ */
+void mipi_lli_reset_interrupt(void)
+{
+	struct mipi_lli *lli = lli_get();
+
+	if (!lli_hw_usable(lli))
+		return;
+
+	lli->driver->reset_signal(lli);
+}
+EXPORT_SYMBOL(mipi_lli_reset_interrupt);
+
+/**
+ * mipi_lli_read_interrupt - reading sideband signal.
+ *
+ * Returns a sideband signal bit that generated by CP (0 without hardware
+ * access).
+ */
+u32 mipi_lli_read_interrupt(void)
+{
+	struct mipi_lli *lli = lli_get();
+
+	if (!lli_hw_usable(lli))
+		return 0;
+
+	return lli->driver->read_signal(lli);
+}
+EXPORT_SYMBOL(mipi_lli_read_interrupt);
+
+/**
+ * mipi_lli_debug_info - Print debugging information for LLI.
+ */
+void mipi_lli_debug_info(void)
+{
+	struct mipi_lli *lli = lli_get();
+
+	if (!lli_hw_usable(lli))
+		return;
+
+	lli->driver->debug_info(lli);
+}
+EXPORT_SYMBOL(mipi_lli_debug_info);
+
+/**
+ * mipi_lli_reset - Reset all resource for the first mount
+ *
+ * Needs allow_hw=1; runs hw_init first if needed, and may then sleep.
+ */
+void mipi_lli_reset(void)
+{
+	struct mipi_lli *lli = lli_get();
+	int ret;
+
+	if (!lli)
+		return;
+
+	ret = lli_prepare_hw(lli);
+	if (ret) {
+		lli_refused(lli, "reset", ret);
+		return;
+	}
+
+	lli_do_reset(lli);
+}
+EXPORT_SYMBOL(mipi_lli_reset);
+
+/**
+ * mipi_lli_reload - Reload all resource for re-init
+ *
+ * Atomic context (modem_v1 calls it under a spinlock): never runs hw_init,
+ * does nothing before it.
+ */
+void mipi_lli_reload(void)
+{
+	struct mipi_lli *lli = lli_get();
+
+	if (!lli_hw_usable(lli))
+		return;
+
+	lli->driver->init(lli);
+}
+EXPORT_SYMBOL(mipi_lli_reload);
+
+static ssize_t lli_control_show(struct device *dev,
+				struct device_attribute *attr, char *buf)
+{
+	struct mipi_lli *lli = dev_get_drvdata(dev);
+
+	/* Exact 3.10 format: the loader polls for "MIPI-LLI 1". */
+	return sysfs_emit(buf, "MIPI-LLI %x\n", lli->driver->get_status(lli));
+}
+
+/*
+ * 0 = debug dump (allow_hw=1 and hw_init done).  1 = re-init, 2 = set
+ * master, 3 = mount: only with lli_debug_cmds=1 and allow_hw=1, never during
+ * a CP session (SYNTHESIS section 5, rule 8).  Store commands 4, 5, 6, 98 and
+ * 99 of 3.10 are gone.
+ */
+static ssize_t lli_control_store(struct device *dev,
+				 struct device_attribute *attr,
+				 const char *buf, size_t count)
+{
+	struct mipi_lli *lli = dev_get_drvdata(dev);
+	int command, ret = 0;
+
+	if (kstrtoint(buf, 10, &command))
+		return -EINVAL;
+
+	if (!mipi_lli_hw_allowed() ||
+	    (command != 0 && !READ_ONCE(lli_debug_cmds))) {
+		dev_err(dev, "lli: lli_control %d refused: allow_hw=%d lli_debug_cmds=%d\n",
+			command, mipi_lli_hw_allowed(), READ_ONCE(lli_debug_cmds));
+		return -EPERM;
+	}
+
+	mutex_lock(&lli->hw_mutex);
+
+	switch (command) {
+	case 0:
+		if (mipi_lli_clks_on(lli))
+			lli->driver->debug_info(lli);
+		else
+			ret = -EAGAIN;
+		break;
+	case 1:
+		ret = mipi_lli_hw_init_locked(lli);
+		if (!ret)
+			lli_do_reset(lli);
+		break;
+	case 2:
+		ret = mipi_lli_hw_init_locked(lli);
+		if (!ret)
+			lli->driver->set_master(lli, true);
+		break;
+	case 3:
+		ret = mipi_lli_hw_init_locked(lli);
+		if (!ret)
+			ret = lli->driver->link_startup_mount(lli);
+		break;
+	default:
+		dev_err(dev, "Un-support control command\n");
+		ret = -EINVAL;
+		break;
+	}
+
+	mutex_unlock(&lli->hw_mutex);
+
+	return ret ? ret : count;
+}
+static DEVICE_ATTR_RW(lli_control);
+
+static struct attribute *mipi_lli_attrs[] = {
+	&dev_attr_lli_control.attr,
+	NULL,
+};
+
+static const struct attribute_group mipi_lli_group = {
+	.attrs = mipi_lli_attrs,
+};
+
+const struct attribute_group *mipi_lli_groups[] = {
+	&mipi_lli_group,
+	NULL,
+};
+
+static irqreturn_t mipi_lli_sig_irq(int irq, void *_dev)
+{
+	struct mipi_lli *lli = _dev;
+	struct mipi_lli_ipc_handler hd;
+	u32 intr;
+
+	/* Enabled only by hw_init; never read an unclocked block. */
+	if (!mipi_lli_clks_on(lli))
+		return IRQ_NONE;
+
+	atomic_inc(&lli->irq_sig_count);
+
+	intr = lli->driver->read_signal(lli);
+
+	if (mipi_lli_irq_storm(&lli->sig_window, &lli->sig_window_cnt,
+			       READ_ONCE(sig_irq_storm_limit))) {
+		spin_lock(&lli->lock);
+		if (lli->sig_irq_active) {
+			disable_irq_nosync(irq);
+			lli->sig_irq_active = false;
+			lli->sig_storm_off = true;
+		}
+		spin_unlock(&lli->lock);
+		dev_err(lli->dev, "lli: irq storm: more than %u signal interrupts in 1 s, irq disabled\n",
+			READ_ONCE(sig_irq_storm_limit));
+		return IRQ_HANDLED;
+	}
+
+	spin_lock(&lli->lock);
+	hd = lli->hd;
+	spin_unlock(&lli->lock);
+
+	if (hd.handler)
+		hd.handler(hd.data, intr);
+
+	return IRQ_HANDLED;
+}
+
+/* Quiesce: allowed whenever the IRQ could be enabled. */
+void mipi_lli_disable_irq(void)
+{
+	struct mipi_lli *lli = lli_get();
+	unsigned long flags;
+
+	if (!lli)
+		return;
+
+	spin_lock_irqsave(&lli->lock, flags);
+
+	if (lli->sig_irq_active) {
+		disable_irq_nosync(lli->irq_sig);
+		lli->sig_irq_active = false;
+	}
+
+	spin_unlock_irqrestore(&lli->lock, flags);
+}
+EXPORT_SYMBOL(mipi_lli_disable_irq);
+
+void mipi_lli_enable_irq(void)
+{
+	struct mipi_lli *lli = lli_get();
+	unsigned long flags;
+
+	if (!lli_hw_usable(lli))
+		return;
+
+	spin_lock_irqsave(&lli->lock, flags);
+
+	if (!lli->sig_irq_active) {
+		enable_irq(lli->irq_sig);
+		lli->sig_irq_active = true;
+		lli->sig_storm_off = false;
+	}
+
+	spin_unlock_irqrestore(&lli->lock, flags);
+}
+EXPORT_SYMBOL(mipi_lli_enable_irq);
+
+/**
+ * mipi_lli_intr_enable
+ *
+ * Needs allow_hw=1; runs hw_init first if needed, and may then sleep.
+ */
+void mipi_lli_intr_enable(void)
+{
+	struct mipi_lli *lli = lli_get();
+	int ret;
+
+	if (!lli)
+		return;
+
+	ret = lli_prepare_hw(lli);
+	if (ret) {
+		lli_refused(lli, "intr_enable", ret);
+		return;
+	}
+
+	lli->driver->intr_enable(lli);
+}
+EXPORT_SYMBOL(mipi_lli_intr_enable);
+
+/**
+ * mipi_lli_intr_disable
+ *
+ * Quiesce: allowed whenever the clocks are on, does nothing otherwise.
+ */
+void mipi_lli_intr_disable(void)
+{
+	struct mipi_lli *lli = lli_get();
+
+	if (!lli || !mipi_lli_clks_on(lli))
+		return;
+
+	lli->driver->intr_disable(lli);
+}
+EXPORT_SYMBOL(mipi_lli_intr_disable);
+
+/*
+ * mipi_lli_suspend must call by modem_if.
+ */
+void mipi_lli_suspend(void)
+{
+	struct mipi_lli *lli = lli_get();
+
+	if (!lli_hw_usable(lli))
+		return;
+
+	lli->driver->suspend(lli);
+}
+EXPORT_SYMBOL(mipi_lli_suspend);
+
+/*
+ * mipi_lli_resume must call by modem_if.
+ */
+void mipi_lli_resume(void)
+{
+	struct mipi_lli *lli = lli_get();
+
+	if (!lli_hw_usable(lli))
+		return;
+
+	lli->driver->resume(lli);
+}
+EXPORT_SYMBOL(mipi_lli_resume);
+
+/* --- debugfs ------------------------------------------------------------ */
+
+static const char *lli_state_name(int state)
+{
+	switch (state) {
+	case LLI_UNMOUNTED:	return "LLI_UNMOUNTED";
+	case LLI_MOUNTED:	return "LLI_MOUNTED";
+	case LLI_WAITFORMOUNT:	return "LLI_WAITFORMOUNT";
+	default:		return "?";
+	}
+}
+
+static void lli_show_irq(struct seq_file *s, const char *name, int irq,
+			 atomic_t *count)
+{
+	struct irq_data *d = irq_get_irq_data(irq);
+	unsigned long hwirq = d ? irqd_to_hwirq(d) : 0;
+
+	/* GIC: hwirq = SPI number + 32 */
+	seq_printf(s, "irq %s (GIC SPI %lu, virq %d): %d\n", name,
+		   hwirq >= 32 ? hwirq - 32 : hwirq, irq, atomic_read(count));
+}
+
+static int lli_status_show(struct seq_file *s, void *unused)
+{
+	struct mipi_lli *lli = s->private;
+	int state = atomic_read(&lli->state);
+
+	mutex_lock(&lli->hw_mutex);
+
+	seq_printf(s, "allow_hw: %d\n", mipi_lli_hw_allowed());
+	seq_printf(s, "lli_debug_cmds: %d\n", READ_ONCE(lli_debug_cmds));
+	seq_printf(s, "hw_init: %s\n", lli->hw_init_done ? "done" : "not done");
+	seq_printf(s, "clocks: %s\n", mipi_lli_clks_on(lli) ? "on" : "off");
+	seq_printf(s, "link: %s (%d)\n", lli_state_name(state), state);
+	seq_printf(s, "shmem: %pa size %pa, remap 0x%08x\n",
+		   &lli->phy_addr, &lli->shdmem_size, lli->remap_addr);
+	seq_printf(s, "remap_ok: %d (reset_done %d; last readback LL 0x%08x BE 0x%08x LLI_PHY_CON 0x%x)\n",
+		   READ_ONCE(lli->remap_ok), READ_ONCE(lli->reset_done),
+		   lli->remap_ll_rb, lli->remap_be_rb, lli->pmu_rb);
+	seq_printf(s, "mount: ok %d fail %d roe %d pa_err %d%s\n",
+		   lli->mnt_ok, lli->mnt_fail, lli->roe_cnt, lli->pa_err_cnt,
+		   READ_ONCE(lli->roe_stopped) ? " (error soft reset stopped)" : "");
+	lli_show_irq(s, "lli", lli->irq, &lli->irq_count);
+	lli_show_irq(s, "signal", lli->irq_sig, &lli->irq_sig_count);
+	seq_printf(s, "storm guard: lli %s, signal %s\n",
+		   READ_ONCE(lli->irq_storm_off) ? "tripped" : "ok",
+		   READ_ONCE(lli->sig_storm_off) ? "tripped" : "ok");
+
+	/* Registers only with the clocks on (hw_init done). */
+	lli->driver->status_show(lli, s, mipi_lli_clks_on(lli));
+	if (!mipi_lli_clks_on(lli))
+		seq_puts(s, "registers: not read (clocks off)\n");
+
+	mutex_unlock(&lli->hw_mutex);
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(lli_status);
+
+static int lli_debugfs_trigger(const char __user *ubuf, size_t count)
+{
+	bool val;
+	int ret;
+
+	ret = kstrtobool_from_user(ubuf, count, &val);
+	if (ret)
+		return ret;
+
+	return val ? 0 : -EINVAL;
+}
+
+/* echo 1 > hw_init: clocks on, PMU LLI_PHY_CON = 1, IRQs on.  allow_hw=1. */
+static ssize_t lli_hw_init_write(struct file *file, const char __user *ubuf,
+				 size_t count, loff_t *ppos)
+{
+	struct mipi_lli *lli = file->private_data;
+	int ret;
+
+	ret = lli_debugfs_trigger(ubuf, count);
+	if (ret)
+		return ret;
+	if (!mipi_lli_hw_allowed())
+		return -EPERM;
+
+	ret = mipi_lli_hw_init(lli);
+
+	return ret ? ret : count;
+}
+
+static const struct file_operations lli_hw_init_fops = {
+	.owner	= THIS_MODULE,
+	.open	= simple_open,
+	.write	= lli_hw_init_write,
+	.llseek	= noop_llseek,
+};
+
+/*
+ * echo 1 > reset: hw_init + intr_enable + soft reset, i.e. what modem_v1's
+ * ld->reset does, without the CP power sequence.  allow_hw=1.  Gate G3:
+ * run it with the CP held in reset, then read the remap registers back in
+ * status.
+ */
+static ssize_t lli_reset_write(struct file *file, const char __user *ubuf,
+			       size_t count, loff_t *ppos)
+{
+	struct mipi_lli *lli = file->private_data;
+	int ret;
+
+	ret = lli_debugfs_trigger(ubuf, count);
+	if (ret)
+		return ret;
+	if (!mipi_lli_hw_allowed())
+		return -EPERM;
+
+	mutex_lock(&lli->hw_mutex);
+	ret = mipi_lli_hw_init_locked(lli);
+	if (!ret) {
+		dev_info(lli->dev, "lli: debugfs reset\n");
+		lli->driver->intr_enable(lli);
+		lli_do_reset(lli);
+	}
+	mutex_unlock(&lli->hw_mutex);
+
+	return ret ? ret : count;
+}
+
+static const struct file_operations lli_reset_fops = {
+	.owner	= THIS_MODULE,
+	.open	= simple_open,
+	.write	= lli_reset_write,
+	.llseek	= noop_llseek,
+};
+
+static void mipi_lli_debugfs_init(struct mipi_lli *lli)
+{
+	lli->debugfs = debugfs_create_dir("mipi-lli", NULL);
+	debugfs_create_file("status", 0400, lli->debugfs, lli, &lli_status_fops);
+	debugfs_create_file("hw_init", 0200, lli->debugfs, lli, &lli_hw_init_fops);
+	debugfs_create_file("reset", 0200, lli->debugfs, lli, &lli_reset_fops);
+}
+
+/*
+ * Called at the end of the controller probe.  No hardware access: the
+ * signal IRQ is requested disabled (IRQF_NO_AUTOEN) and only hw_init
+ * enables it.
+ */
+int mipi_lli_add_driver(struct mipi_lli *lli)
+{
+	struct device *dev = lli->dev;
+	int ret;
+
+	if (lli_get())
+		return -EBUSY;
+
+	ret = devm_request_irq(dev, lli->irq_sig, mipi_lli_sig_irq,
+			       IRQF_NO_AUTOEN, dev_name(dev), lli);
+	if (ret)
+		return dev_err_probe(dev, ret, "signal irq %d\n", lli->irq_sig);
+	lli->sig_irq_active = false;
+
+	dev_info(dev, "share IPC memory phys = %pa, size = %pa\n",
+		 &lli->phy_addr, &lli->shdmem_size);
+
+	dev_set_drvdata(dev, lli);
+	mipi_lli_debugfs_init(lli);
+
+	smp_store_release(&g_lli, lli);
+
+	return 0;
+}
diff --git a/include/linux/mipi-lli.h b/include/linux/mipi-lli.h
new file mode 100644
index 000000000..7521d1ff2
--- /dev/null
+++ b/include/linux/mipi-lli.h
@@ -0,0 +1,221 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * MIPI-LLI driver
+ *
+ * Copyright (C) 2013 Samsung Electronics Co.Ltd
+ * Author: Yulgon Kim <yulgon.kim@samsung.com>
+ *
+ * Port to Linux 6.12 for the Exynos5433 / SS333 modem link of the SM-T715
+ * (32-bit LPAE kernel): the exported API keeps the 3.10 prototypes used by
+ * modem_v1; mipi_lli_get_pm_svc() is gone (no link PM FSM in this port)
+ * and mipi_lli_hw_allowed() is new.
+ */
+
+#ifndef __MIPI_LLI_H
+#define __MIPI_LLI_H
+
+#include <linux/atomic.h>
+#include <linux/jiffies.h>
+#include <linux/mutex.h>
+#include <linux/sizes.h>
+#include <linux/spinlock.h>
+#include <linux/types.h>
+#include <linux/wait.h>
+
+#define MIPI_LLI_RESERVE_SIZE SZ_8M
+
+enum mipi_lli_link_status {
+	LLI_UNMOUNTED,
+	LLI_MOUNTED,
+	LLI_WAITFORMOUNT,
+};
+
+struct attribute_group;
+struct clk_bulk_data;
+struct dentry;
+struct device;
+struct exynos_mphy;
+struct regmap;
+struct seq_file;
+
+struct mipi_lli_ipc_handler {
+	void *data;
+	void (*handler)(void *, u32);
+};
+
+struct mipi_lli_modem {
+	bool	scrambler;
+	bool	automode;
+};
+
+struct mipi_lli {
+	const struct lli_driver *driver;	/* hw-specific hooks */
+
+	struct mipi_lli_modem	modem_info;
+	struct clk_bulk_data	*clks;
+	int			num_clks;
+
+	int			irq;		/* link (DME) irq */
+	int			irq_sig;	/* TL signal (doorbell) irq */
+	bool			sig_irq_active;
+	bool			sb_mask_active; /* sideband signal mask active */
+	void __iomem		*regs;		/* PA/DME/IAL/DL/TL */
+	void __iomem		*remote_regs;	/* remote window, unused */
+	void __iomem		*sys_regs;	/* SYSREG_CPIF */
+	struct regmap		*pmu;		/* PMU syscon (LLI_PHY_CON) */
+	struct exynos_mphy	*mphy;
+
+	struct mutex		hw_mutex;	/* hw_init and explicit actions */
+	spinlock_t		lock;
+	struct device		*dev;
+	struct dentry		*debugfs;
+
+	phys_addr_t		phy_addr;	/* shared memory (memory-region) */
+	phys_addr_t		shdmem_size;
+	u32			remap_addr;	/* IAL_LL/BE_INIT_ADDR_REMAP */
+	atomic_t		state;
+	atomic_t		mnt_cnt;
+	bool			is_master;
+	bool			is_suspended;
+	bool			is_debug_possible;
+
+	/*
+	 * clks_enabled: the LLI clocks are on, so LLI/M-PHY registers may be
+	 * accessed.  Set only by hw_init, which needs allow_hw=1.
+	 */
+	bool			clks_enabled;
+	bool			hw_init_done;
+	bool			pa_err_6;
+
+	/*
+	 * Mount interlock, recomputed at every SW_RESET_DONE: remap_ok = the
+	 * settings were written and IAL_LL/BE_INIT_ADDR_REMAP read back
+	 * remap_addr and PMU LLI_PHY_CON reads 1.  LLI_MOUNT_CTRL is written
+	 * only while it holds.  reset_done: a SW_RESET_DONE was handled since
+	 * the last explicit reset (mipi_lli_reset and friends).
+	 */
+	bool			remap_ok;
+	bool			reset_done;
+	u32			remap_ll_rb;	/* last readbacks */
+	u32			remap_be_rb;
+	u32			pmu_rb;
+	wait_queue_head_t	reset_wq;
+
+	/* RESET_ON_ERROR_SENT soft-reset limiter */
+	unsigned long		roe_window;
+	unsigned int		roe_resets;
+	bool			roe_stopped;
+
+	/* IRQ storm guards (per second) */
+	unsigned long		irq_window;
+	unsigned int		irq_window_cnt;
+	bool			irq_storm_off;	/* link irq disabled by the guard */
+	unsigned long		sig_window;
+	unsigned int		sig_window_cnt;
+	bool			sig_storm_off;	/* signal irq disabled by the guard */
+
+	/* counters (statics in 3.10) */
+	int			mnt_ok;
+	int			mnt_fail;
+	int			roe_cnt;
+	int			pa_err_cnt;
+	atomic_t		irq_count;
+	atomic_t		irq_sig_count;
+
+	struct mipi_lli_ipc_handler hd;
+};
+
+struct lli_driver {
+	int	(*hw_init)(struct mipi_lli *lli);
+	int	(*init)(struct mipi_lli *lli);
+	int	(*set_master)(struct mipi_lli *lli, bool is_master);
+	int	(*link_startup_mount)(struct mipi_lli *lli);
+	int	(*get_status)(struct mipi_lli *lli);
+
+	int	(*send_signal)(struct mipi_lli *lli, u32 cmd);
+	int	(*reset_signal)(struct mipi_lli *lli);
+	int	(*read_signal)(struct mipi_lli *lli);
+	int	(*debug_info)(struct mipi_lli *lli);
+
+	int	(*intr_enable)(struct mipi_lli *lli);
+	int	(*intr_disable)(struct mipi_lli *lli);
+
+	int	(*suspend)(struct mipi_lli *lli);
+	int	(*resume)(struct mipi_lli *lli);
+
+	/* software state; registers too if @regs (clocks on) */
+	void	(*status_show)(struct mipi_lli *lli, struct seq_file *s, bool regs);
+};
+
+/* Inside the module only (between exynos-mipi-lli.c and mipi-lli.c). */
+int mipi_lli_add_driver(struct mipi_lli *lli);
+extern const struct attribute_group *mipi_lli_groups[];
+
+/*
+ * LLI/M-PHY registers may be accessed: the LLI clocks are on.  Only hw_init
+ * turns them on, and only with allow_hw=1.
+ */
+static inline bool mipi_lli_clks_on(const struct mipi_lli *lli)
+{
+	return READ_ONCE(lli->clks_enabled);
+}
+
+/* IRQ storm guard: more than @limit calls within 1 s?  (@limit 0: never.) */
+static inline bool mipi_lli_irq_storm(unsigned long *window, unsigned int *cnt,
+				      unsigned int limit)
+{
+	if (!limit)
+		return false;
+
+	if (time_after(jiffies, *window + HZ)) {
+		*window = jiffies;
+		*cnt = 0;
+	}
+
+	return ++(*cnt) > limit;
+}
+
+/*
+ * Exported API (modem_v1).  Every call is safe before the driver is bound
+ * (it does nothing, or returns 0 / LLI_UNMOUNTED); mipi_lli_get_phys_base()
+ * and mipi_lli_get_phys_size() return 0 until then, which callers use to
+ * defer their probe.  With the allow_hw module parameter at 0 no call
+ * touches the hardware.  mipi_lli_reset() and mipi_lli_intr_enable() may
+ * sleep the first time (they run hw_init) and mipi_lli_wait_reset_done()
+ * sleeps; every other call can be made from atomic context.
+ *
+ * Mount interlock: the driver accepts a CP mount (writes LLI_MOUNT_CTRL)
+ * only while mipi_lli_remap_ok(); after mipi_lli_reset(), the modem driver
+ * calls mipi_lli_wait_reset_done() and releases CP_RESET only on 0.
+ */
+extern unsigned long mipi_lli_get_phys_base(void);
+extern unsigned long mipi_lli_get_phys_size(void);
+
+extern int mipi_lli_get_link_status(void);
+extern int mipi_lli_set_link_status(int status);
+extern int mipi_lli_suspended(void);
+extern int mipi_lli_register_handler(void (*handler)(void *, u32), void *data);
+extern int mipi_lli_unregister_handler(void (*handler)(void *, u32));
+extern void mipi_lli_send_interrupt(u32 cmd);
+extern void mipi_lli_reset_interrupt(void);
+extern u32 mipi_lli_read_interrupt(void);
+extern void mipi_lli_debug_info(void);
+extern void mipi_lli_intr_enable(void);
+extern void mipi_lli_intr_disable(void);
+extern void mipi_lli_reset(void);
+extern void mipi_lli_reload(void);
+
+extern void mipi_lli_suspend(void);
+extern void mipi_lli_resume(void);
+
+extern void mipi_lli_disable_irq(void);
+extern void mipi_lli_enable_irq(void);
+
+extern bool mipi_lli_hw_allowed(void);
+extern bool mipi_lli_remap_ok(void);
+extern int mipi_lli_wait_reset_done(unsigned int timeout_ms);
+
+#define lli_err(dev, fmt, ...)	dev_err(dev, fmt, ##__VA_ARGS__)
+#define lli_info(dev, fmt, ...)	dev_info(dev, fmt, ##__VA_ARGS__)
+
+#endif /* __MIPI_LLI_H */
