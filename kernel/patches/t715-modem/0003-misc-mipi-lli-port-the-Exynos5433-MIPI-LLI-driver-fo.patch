+static int poll_bit_set(void __iomem *ptr, u32 val, int timeout)
+{
+	u32 reg;
+
+	do {
+		reg = readl(ptr);
+		if (reg & val)
+			return 0;
+
+		udelay(1);
+	} while (timeout-- > 0);
+
+	return -ETIME;
+}
+
+/*
+ * IAL_LL/BE_INIT_ADDR_REMAP: base[31:bit_pos] in bits [31:8], bit_pos =
+ * log2(size) in the low bits, enable bit 7 (3.10 exynos-mipi-lli.c:68-90).
+ */
+#define LLI_REMAP_VALUE(base, bit_pos)					\
+	(((((u32)(base)) >> (bit_pos)) << LLI_REMAP_BASE_ADDR_SHIFT) |	\
+	 (bit_pos) | LLI_REMAP_ENABLE)
+
+/*
+ * The board's cp-shmem@de000000, 8 MiB (bit_pos 23):
+ * 0xde000000 >> 23 = 0x1bc; 0x1bc << 8 = 0x1bc00; | 23 (0x17) | 0x80 =
+ * 0x0001bc97, the value gate G3 must read back (SYNTHESIS D3).  Checked at
+ * build time here and against exynos_lli_cal_remap() at probe.
+ */
+#define LLI_REMAP_REF_BASE	0xde000000u
+#define LLI_REMAP_REF_SIZE	SZ_8M
+#define LLI_REMAP_REF_VALUE	0x0001bc97u
+static_assert(LLI_REMAP_VALUE(LLI_REMAP_REF_BASE, 23) == LLI_REMAP_REF_VALUE);
+static_assert(LLI_REMAP_REF_SIZE == (1u << 23));
+
+/*
+ * The only shared memory region the probe accepts without
+ * shmem_unsafe_base=1: the board's cp-shmem@de000000 (SYNTHESIS D3,
+ * kernel_boot_review.md 5.1).
+ */
+#define LLI_SHMEM_BASE		LLI_REMAP_REF_BASE
+#define LLI_SHMEM_SIZE		LLI_REMAP_REF_SIZE
+/* CP MPU region 3 is 256 MiB (radio_image.md 2.4): no System RAM in it. */
+#define LLI_CP_WINDOW		SZ_256M
+
+/* Returns 0 if the region cannot be remapped. */
+static u32 exynos_lli_cal_remap(phys_addr_t base_addr, phys_addr_t size)
+{
+	u32 bit_pos;
+
+	/* power-of-two size, at least 256 bytes (the base field starts at bit 8) */
+	if (size < BIT(LLI_REMAP_BASE_ADDR_SHIFT) || size > SZ_2G ||
+	    !is_power_of_2((unsigned long)size))
+		return 0;
+
+	/* check base_address is aligned with size */
+	if (base_addr & (size - 1))
+		return 0;
+
+	/* 32-bit register: the whole region below 4 GiB */
+	if ((u64)base_addr + size - 1 > U32_MAX)
+		return 0;
+
+	bit_pos = __ffs((unsigned long)size);
+
+	return LLI_REMAP_VALUE(base_addr, bit_pos);
+}
