+		pr_err("[LLI]0x%x : 0x%08x\n", 0x10F24000 + lli_debug_info[i],
+		       readl(lli->regs + lli_debug_info[i]));
+
+	for (i = 0; i < ARRAY_SIZE(phy_std_debug_info); i++)
+		pr_err("[MPHY-STD]0x%x : 0x%08x\n",
+		       0x10F20000 + (phy_std_debug_info[i] / 4),
+		       readl(phy->loc_regs + phy_std_debug_info[i]));
+
+	return 0;
+}
