+/*
+ * RESET_ON_ERROR_SENT: 3.10 soft-reset unconditionally (:951-955).  Allow
+ * roe_reset_limit resets per second, then stop re-arming until the next
+ * explicit reset (mipi_lli_reset, debugfs reset, lli_control 1).
+ */
+static bool exynos_lli_roe_reset_allowed(struct mipi_lli *lli)
+{
+	unsigned int limit = READ_ONCE(roe_reset_limit);
+
+	if (READ_ONCE(lli->roe_stopped))
+		return false;
+	if (!limit)
+		return true;
+
+	if (time_after(jiffies, lli->roe_window + HZ)) {
+		lli->roe_window = jiffies;
+		WRITE_ONCE(lli->roe_resets, 0);
+	}
+
+	WRITE_ONCE(lli->roe_resets, lli->roe_resets + 1);
+	if (lli->roe_resets <= limit)
+		return true;
+
+	WRITE_ONCE(lli->roe_stopped, true);
+	pr_err("Error sent: more than %u soft resets within 1 s, re-arming stopped\n",
+	       limit);
+
+	return false;
+}
+
+static irqreturn_t exynos_mipi_lli_threaded_irq(int irq, void *_lli)
+{
+	struct mipi_lli *lli = _lli;
+	struct exynos_mphy *phy = lli->mphy;
+	int credit = 0;
+	int rx_fsm_state, tx_fsm_state, afc_val, csa_status;
+
+	rx_fsm_state = readl(phy->loc_regs + PHY_RX_FSM_STATE(0));
+	tx_fsm_state = readl(phy->loc_regs + PHY_TX_FSM_STATE(0));
+	csa_status = readl(lli->regs + EXYNOS_DME_CSA_SYSTEM_STATUS);
+	credit = readl(lli->regs + EXYNOS_DL_DBG_TX_CREDTIS);
+
+	writel(0x1, lli->regs + EXYNOS_PA_MPHY_CMN_ENABLE);
+	afc_val = readl(phy->loc_regs + (0x27*4));
+	writel(0x0, lli->regs + EXYNOS_PA_MPHY_CMN_ENABLE);
+
+	pr_info("rx=%x, tx=%x, afc=%x, status=%x, pa_err=%x\n",
+		rx_fsm_state, tx_fsm_state, afc_val, csa_status, lli->pa_err_cnt);
+
+	if (!credit) {
+		u32 delay = 0;
+
+		for (delay = 0 ; delay < READ_ONCE(credit_cnt) ; delay++) {
+			usleep_range(1000, 1000);
+			credit = readl(lli->regs + EXYNOS_DL_DBG_TX_CREDTIS);
+
+			if (credit)
+				break;
+		}
+		pr_info("waiting %ums for CREDITS: rx=%x, tx=%x\n", delay,
+			readl(phy->loc_regs + PHY_RX_FSM_STATE(0)),
+			readl(phy->loc_regs + PHY_TX_FSM_STATE(0)));
+
+		if (!credit) {
+			pr_err("ERR: Mount failed : %d\n", ++lli->mnt_fail);
+			exynos_lli_debug_info(lli);
+			pr_err("DUMP: ok:%d fail:%d roe:%d\n",
+			       lli->mnt_ok, lli->mnt_fail, lli->roe_cnt);
+
+			return IRQ_HANDLED;
+		}
+	}
+
+	/* Mount with DL credits: the AFC code is valid from now on. */
+	if (!phy->afc_valid) {
+		phy->afc_val = afc_val;
+		phy->afc_valid = true;
+	}
+
+	lli->pa_err_6 = false;
+
+	atomic_set(&lli->state, LLI_MOUNTED);
+	atomic_inc(&lli->mnt_cnt);
+	pr_info("Mount (ok:%d fail:%d roe:%d pa_err:%d)\n",
+		++lli->mnt_ok, lli->mnt_fail, lli->roe_cnt, lli->pa_err_cnt);
+
+	return IRQ_HANDLED;
+}
+
+/*
+ * Pending events are always read and cleared once the clocks are on.  The
+ * actions that program the link (settings at SW_RESET_DONE, mount accept,
+ * automode, soft reset, re-arm after unmount) also need allow_hw=1, so
+ * writing 0 to allow_hw freezes the link without leaving an interrupt
+ * asserted.
+ */
+static irqreturn_t exynos_mipi_lli_irq(int irq, void *_lli)
+{
+	struct mipi_lli *lli = _lli;
+	struct exynos_mphy *phy = lli->mphy;
+	bool hw_ok;
+	u32 status;
+
+	/* Enabled only by hw_init; never read an unclocked block. */
+	if (!mipi_lli_clks_on(lli))
+		return IRQ_NONE;
+
+	atomic_inc(&lli->irq_count);
+	hw_ok = mipi_lli_hw_allowed();
+
+	status = readl(lli->regs + EXYNOS_DME_LLI_INTR_STATUS);
+
+	if (mipi_lli_irq_storm(&lli->irq_window, &lli->irq_window_cnt,
+			  READ_ONCE(irq_storm_limit))) {
+		/* mask and clear at the source too, then stop the line */
+		exynos_lli_clear_intr_enable(lli);
+		if (status)
+			writel(status, lli->regs + EXYNOS_DME_LLI_INTR_STATUS);
+		disable_irq_nosync(irq);
+		WRITE_ONCE(lli->irq_storm_off, true);
+		pr_err("irq storm: more than %u link interrupts in 1 s (status 0x%x), irq disabled until the next reset\n",
+		       READ_ONCE(irq_storm_limit), status);
+		return IRQ_HANDLED;
+	}
+
+	if (!status)
+		return IRQ_NONE;
+
+	if (status & INTR_SW_RESET_DONE) {
+		int ret = -EPERM;
+
+		pr_info("SW_RESET_DONE ++\n");
+		if (hw_ok)
+			ret = exynos_lli_setting(lli);
+		else
+			pr_err("allow_hw=0: link settings not written\n");
+
+		/* mount interlock: recomputed at every SW_RESET_DONE */
+		exynos_lli_check_remap(lli, ret == 0);
+
+		lli->is_debug_possible = true;
+
+		if (status & INTR_RESET_ON_ERROR_DETECTED) {
+			pr_info("LLI is wating for mount after LINE-RESET..\n");
+			atomic_set(&lli->state, LLI_WAITFORMOUNT);
+		}
+
+		/* Pairs with smp_load_acquire() in mipi_lli_wait_reset_done(). */
+		smp_store_release(&lli->reset_done, true);
+		wake_up_all(&lli->reset_wq);
+	}
+
+	if (status & INTR_MPHY_HIBERN8_EXIT_DONE) {
+		pr_info("HIBERN8_EXIT_DONE: rx=%x, tx=%x\n",
+			readl(phy->loc_regs + PHY_RX_FSM_STATE(0)),
+			readl(phy->loc_regs + PHY_TX_FSM_STATE(0)));
+		if (!READ_ONCE(lli->remap_ok)) {
+			/* no mount without a verified remap (CP accesses to AP memory) */
+			pr_err("mount refused (remap %08x/%08x)\n",
+			       readl(lli->regs + EXYNOS_IAL_LL_INIT_ADDR_REMAP),
+			       readl(lli->regs + EXYNOS_IAL_BE_INIT_ADDR_REMAP));
+		} else if (hw_ok) {
+			mdelay(1);
+			writel(LLI_MOUNT_CTRL, lli->regs + EXYNOS_DME_CSA_SYSTEM_SET);
+		}
+	}
+
+	if (status & INTR_MPHY_HIBERN8_ENTER_DONE)
+		pr_info("HIBERN8_ENTER_DONE\n");
+
+	if (status & INTR_PA_PLU_DETECTED)
+		pr_info("PLU_DETECT\n");
+
+	if (status & INTR_PA_PLU_DONE) {
+		pr_info("PLU_DONE\n");
+
+		if (hw_ok && lli->modem_info.automode)
+			exynos_mipi_lli_set_automode(lli, true);
+	}
+
+	if ((status & INTR_RESET_ON_ERROR_DETECTED))
+		pr_err("Error detected ++ roe_cnt = %d\n", ++lli->roe_cnt);
+
+	if (status & INTR_RESET_ON_ERROR_SENT) {
+		pr_err("Error sent ++ roe_cnt = %d\n", ++lli->roe_cnt);
+		/* W1C first: 3.10 reset without clearing (review D1-h). */
+		writel(status, lli->regs + EXYNOS_DME_LLI_INTR_STATUS);
+		if (hw_ok && exynos_lli_roe_reset_allowed(lli)) {
+			exynos_lli_soft_reset(lli);
+			return IRQ_HANDLED;
+		}
+
+		/* No reset: mask so that the line stays quiet. */
+		exynos_lli_clear_intr_enable(lli);
+		return IRQ_HANDLED;
+	}
+
+	if (status & INTR_PA_ERROR_INDICATION) {
+		int rx = readl(lli->regs + EXYNOS_DME_LLI_PA_INTR_REASON);
+
+		pr_err_ratelimited("PA_REASON:%d cnt:%d\n", rx, ++lli->pa_err_cnt);
+	}
+
+	if (status & INTR_DL_ERROR_INDICATION) {
+		pr_info("DL_REASON %x\n",
+			readl(lli->regs + EXYNOS_DME_LLI_DL_INTR_REASON));
+	}
+
+	if (status & INTR_TL_ERROR_INDICATION) {
+		pr_info("TL_REASON %x\n",
+			readl(lli->regs + EXYNOS_DME_LLI_TL_INTR_REASON));
+	}
+
+	if (status & INTR_IAL_ERROR_INDICATION) {
+		pr_info("IAL_REASON0 %x, REASON1 %x\n",
+			readl(lli->regs + EXYNOS_DME_LLI_IAL_INTR_REASON0),
+			readl(lli->regs + EXYNOS_DME_LLI_IAL_INTR_REASON1));
+	}
+
+	if (status & INTR_LLI_MOUNT_DONE) {
+		writel(status, lli->regs + EXYNOS_DME_LLI_INTR_STATUS);
+		pr_info("Mount intr\n");
+
+		return IRQ_WAKE_THREAD;
+	}
+
+	if (status & INTR_LLI_UNMOUNT_DONE) {
+		atomic_set(&lli->state, LLI_UNMOUNTED);
+		writel(status, lli->regs + EXYNOS_DME_LLI_INTR_STATUS);
+		/* no link PM FSM: always re-arm (3.10: when no unmount_cb) */
+		if (hw_ok)
+			exynos_lli_init(lli);
+
+		pr_info("Unmount\n");
+
+		lli->is_debug_possible = false;
+
+		return IRQ_HANDLED;
+	}
+
+	writel(status, lli->regs + EXYNOS_DME_LLI_INTR_STATUS);
+
+	return IRQ_HANDLED;
+}
+
+/*
+ * memory-region interlocks; refuse to bind unless all hold
+ * (kernel_boot_review.md 5.1 item 1):
+ *  - base 0xde000000, size 8 MiB, unless shmem_unsafe_base=1;
+ *  - power-of-two size on a size-aligned base below 4 GiB, or the remap
+ *    register cannot describe it (3.10 found out only in IRQ context,
+ *    exynos-mipi-lli.c:304-308);
+ *  - no System RAM in the region: a reservation that failed still yields
+ *    an "OF: reserved mem:" line and a lookup (review D3-b);
+ *  - no System RAM in the 256 MiB CP window from the base either, in case
+ *    the IAL does not mask the remap to the region size (review D3-c; the
+ *    board DT makes all DRAM from 0xde000000 up no-map).
+ */
+static int exynos_lli_get_shmem(struct mipi_lli *lli)
+{
+	struct device *dev = lli->dev;
+	struct device_node *rmem_np;
+	struct reserved_mem *rmem;
+
+	rmem_np = of_parse_phandle(dev->of_node, "memory-region", 0);
+	if (!rmem_np)
+		return dev_err_probe(dev, -EINVAL, "lli: no memory-region\n");
+
+	rmem = of_reserved_mem_lookup(rmem_np);
+	of_node_put(rmem_np);
+	if (!rmem)
+		return dev_err_probe(dev, -EINVAL, "lli: memory-region not reserved\n");
+
+	lli->phy_addr = rmem->base;
+	lli->shdmem_size = rmem->size;
+
+	if ((lli->phy_addr != LLI_SHMEM_BASE ||
+	     lli->shdmem_size != LLI_SHMEM_SIZE) && !shmem_unsafe_base)
+		return dev_err_probe(dev, -EINVAL,
+				     "lli: shared memory %pa size %pa, only 0xde000000 size 0x800000 is allowed (shmem_unsafe_base=0)\n",
+				     &lli->phy_addr, &lli->shdmem_size);
+
+	/* Self-test of the arithmetic behind the G3 readback value. */
+	if (exynos_lli_cal_remap(LLI_REMAP_REF_BASE, LLI_REMAP_REF_SIZE) !=
+	    LLI_REMAP_REF_VALUE)
+		return dev_err_probe(dev, -EINVAL, "lli: remap self-test failed\n");
+
+	lli->remap_addr = exynos_lli_cal_remap(lli->phy_addr, lli->shdmem_size);
+	if (!lli->remap_addr)
+		return dev_err_probe(dev, -EINVAL,
+				     "lli: shared memory %pa size %pa: needs a power-of-two size on a size-aligned base below 4 GiB\n",
+				     &lli->phy_addr, &lli->shdmem_size);
+
+	if (region_intersects(lli->phy_addr, lli->shdmem_size,
+			      IORESOURCE_SYSTEM_RAM, IORES_DESC_NONE) !=
+	    REGION_DISJOINT)
+		return dev_err_probe(dev, -EBUSY,
+				     "lli: shared memory %pa size %pa overlaps System RAM: reservation failed?\n",
+				     &lli->phy_addr, &lli->shdmem_size);
+
+	if (region_intersects(lli->phy_addr, LLI_CP_WINDOW,
+			      IORESOURCE_SYSTEM_RAM, IORES_DESC_NONE) !=
+	    REGION_DISJOINT)
+		return dev_err_probe(dev, -EBUSY,
+				     "lli: System RAM within 256 MiB above %pa: all DRAM above the shared memory must be no-map\n",
+				     &lli->phy_addr);
+
+	if (lli->shdmem_size != MIPI_LLI_RESERVE_SIZE)
+		dev_warn(dev, "lli: shared memory size %pa, stock is 8 MiB\n",
+			 &lli->shdmem_size);
+
+	dev_info(dev, "lli: shared memory %pa size %pa, remap 0x%08x\n",
+		 &lli->phy_addr, &lli->shdmem_size, lli->remap_addr);
+
+	return 0;
+}
+
+/*
+ * Probe: maps the registers, looks up the PMU regmap, the shared memory,
+ * the clocks and the IRQs (requested disabled), and touches no LLI, M-PHY
+ * or PMU register and no clock gate.  (The driver core has already applied
+ * the node's assigned-clocks: CMU_MIF DIV_MIF3 and CMU_CPIF SRC_SEL_CPIF1,
+ * as 3.10 did at probe.)
+ */
+static int exynos_mipi_lli_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct device_node *np = dev->of_node;
+	struct exynos_mphy *phy;
+	struct mipi_lli *lli;
+	int i, ret;
+
+	lli = devm_kzalloc(dev, sizeof(*lli), GFP_KERNEL);
+	if (!lli)
+		return -ENOMEM;
+
+	phy = devm_kzalloc(dev, sizeof(*phy), GFP_KERNEL);
+	if (!phy)
+		return -ENOMEM;
+
+	lli->dev = dev;
+	phy->dev = dev;
+	lli->mphy = phy;
+	lli->driver = &exynos_lli_driver;
+
+	lli->regs = devm_platform_ioremap_resource_byname(pdev, "lli");
+	if (IS_ERR(lli->regs))
+		return PTR_ERR(lli->regs);
+
+	lli->remote_regs = devm_platform_ioremap_resource_byname(pdev, "remote");
+	if (IS_ERR(lli->remote_regs))
+		return PTR_ERR(lli->remote_regs);
+
+	lli->sys_regs = devm_platform_ioremap_resource_byname(pdev, "sysreg");
+	if (IS_ERR(lli->sys_regs))
+		return PTR_ERR(lli->sys_regs);
+
+	phy->loc_regs = devm_platform_ioremap_resource_byname(pdev, "mphy");
+	if (IS_ERR(phy->loc_regs))
+		return PTR_ERR(phy->loc_regs);
+
+	lli->pmu = exynos_get_pmu_regmap_by_phandle(np, "samsung,pmu-syscon");
+	if (IS_ERR(lli->pmu))
+		return dev_err_probe(dev, PTR_ERR(lli->pmu), "lli: PMU regmap\n");
+
+	ret = exynos_lli_get_shmem(lli);
+	if (ret)
+		return ret;
+
+	lli->num_clks = ARRAY_SIZE(exynos_lli_clk_names);
+	lli->clks = devm_kcalloc(dev, lli->num_clks, sizeof(*lli->clks),
+				 GFP_KERNEL);
+	if (!lli->clks)
+		return -ENOMEM;
+	for (i = 0; i < lli->num_clks; i++)
+		lli->clks[i].id = exynos_lli_clk_names[i];
+	ret = devm_clk_bulk_get(dev, lli->num_clks, lli->clks);
+	if (ret)
+		return dev_err_probe(dev, ret, "lli: clocks\n");
+
+	/* Cached rate, after assigned-clock-rates; nothing is enabled. */
+	dev_info(dev, "lli: dout_aclk_cpif_200 = %lu (clocks off)\n",
+		 clk_get_rate(lli->clks[0].clk));
+
+	lli->irq = platform_get_irq_byname(pdev, "lli");
+	if (lli->irq < 0)
+		return lli->irq;
+
+	lli->irq_sig = platform_get_irq_byname(pdev, "signal");
+	if (lli->irq_sig < 0)
+		return lli->irq_sig;
+
+	lli->modem_info.scrambler = of_property_read_bool(np, "samsung,lli-scrambler");
+	lli->modem_info.automode = of_property_read_bool(np, "samsung,lli-automode");
+	pr_info("scrambler:%d, automode:%d\n",
+		lli->modem_info.scrambler, lli->modem_info.automode);
+
+	exynos_mphy_get_setting(phy, np);
+
+	mutex_init(&lli->hw_mutex);
+	spin_lock_init(&lli->lock);
+	atomic_set(&lli->state, LLI_UNMOUNTED);
+	atomic_set(&lli->mnt_cnt, 0);
+	lli->is_master = false;
+	lli->is_debug_possible = false;
+	init_waitqueue_head(&lli->reset_wq);
+	lli->roe_window = jiffies;
+	lli->irq_window = jiffies;
+	lli->sig_window = jiffies;
+
+	/* Disabled until hw_init: no handler can run on an unclocked block. */
+	ret = devm_request_threaded_irq(dev, lli->irq, exynos_mipi_lli_irq,
+					exynos_mipi_lli_threaded_irq,
+					IRQF_NO_AUTOEN, dev_name(dev), lli);
+	if (ret)
+		return dev_err_probe(dev, ret, "lli: link irq %d\n", lli->irq);
+
+	ret = mipi_lli_add_driver(lli);
+	if (ret)
+		return ret;
+
+	pr_info("Registered MIPI-LLI interface (allow_hw=%d)\n",
+		mipi_lli_hw_allowed());
+
+	return 0;
+}
+
+static const struct of_device_id exynos_mipi_lli_dt_match[] = {
+	{ .compatible = "samsung,exynos5433-mipi-lli" },
+	{},
+};
+/*
+ * No MODULE_DEVICE_TABLE on purpose: the module is never autoloaded from
+ * the DT node; it loads only by hand or as a dependency of the modem
+ * module (SYNTHESIS section 5, rule 15).
+ */
+
+static struct platform_driver exynos_mipi_lli_driver = {
+	.probe = exynos_mipi_lli_probe,
+	.driver = {
+		.name = "exynos-mipi-lli",
+		.of_match_table = exynos_mipi_lli_dt_match,
+		.dev_groups = mipi_lli_groups,
+		/* the LLI may be live: no unbind through sysfs, no remove */
+		.suppress_bind_attrs = true,
+	},
+};
+
+static int __init exynos_mipi_lli_driver_init(void)
+{
+	return platform_driver_register(&exynos_mipi_lli_driver);
+}
+module_init(exynos_mipi_lli_driver_init);
+/* No module_exit: the module cannot be unloaded while the link may be up. */
+
+MODULE_DESCRIPTION("Exynos5433 MIPI-LLI driver (SS333 modem link)");
+MODULE_AUTHOR("Yulgon Kim <yulgon.kim@samsung.com>");
+MODULE_LICENSE("GPL");
