+}
+
+/* Every reset invalidates the mount interlock until its SW_RESET_DONE. */
+static inline void exynos_lli_soft_reset(struct mipi_lli *lli)
+{
+	WRITE_ONCE(lli->remap_ok, false);
+	writel(1, lli->regs + EXYNOS_DME_LLI_RESET);
+}
+
+static int exynos_lli_init(struct mipi_lli *lli)
+{
+	/* Set LLI Interrupt Enable */
+	exynos_lli_set_intr_enable(lli);
+
+	/* Reset LLI with a spin lock */
+	exynos_lli_soft_reset(lli);
+
+	return 0;
+}
+
+/* SW_RESET_DONE, hard IRQ context (stock: exynos-mipi-lli.c:282-385). */
+static int exynos_lli_setting(struct mipi_lli *lli)
+{
+	struct exynos_mphy *phy = lli->mphy;
+	u32 remap_addr;
+	int ret;
+
+	/* update lli_link_state as reset */
+	if (atomic_read(&lli->state) & LLI_WAITFORMOUNT)
+		atomic_set(&lli->state, LLI_WAITFORMOUNT);
+	else
+		atomic_set(&lli->state, LLI_UNMOUNTED);
+
+	exynos_lli_system_config(lli);
+
+	/* enable LLI_PHY_CONTROL (syscon regmap: spinlock, IRQ safe) */
+	ret = regmap_write(lli->pmu, EXYNOS5433_LLI_PHY_CONTROL, 1);
+	if (ret)
+		pr_err("LLI_PHY_CONTROL write failed: %d\n", ret);
+
+	/* set_system clk period */
+	writel(SYSTEM_CLOCK_PERIOD, lli->regs + EXYNOS_PA_SYSTEM_CLK_PERIOD);
+
+	/* Set DriveTactiveDuration */
+	writel(0xf, lli->regs + EXYNOS_PA_DRIVE_TACTIVATE_DURATION);
+
+	/* computed and checked at probe */
+	remap_addr = lli->remap_addr;
+	if (!remap_addr) {
+		pr_err("remap calculation error\n");
+		return -EINVAL;
+	}
+
+	/* Un-set LL_INIT REMAP Address */
+	writel(remap_addr, lli->regs + EXYNOS_IAL_LL_INIT_ADDR_REMAP);
+
+	/* Set BE_INIT REMAP Address */
+	writel(remap_addr, lli->regs + EXYNOS_IAL_BE_INIT_ADDR_REMAP);
+
+	/* LLI Interrupt enable */
+	exynos_lli_set_intr_enable(lli);
+
+	/* Set BE TC enable */
+	writel(0, lli->regs + EXYNOS_DME_BE_TC_DISABLE);
+
+	/* Set Breaking point enable */
+	writel(0, lli->regs + EXYNOS_PA_DBG_PA_BREAK_POINT_ENABLE);
+
+	/* Set Error count enable */
+	writel(1, lli->regs + EXYNOS_PA_PHIT_ERR_COUNT_ENABLE);
+
+	/* Set Receive count enable */
+	writel(1, lli->regs + EXYNOS_PA_PHIT_RECEIVE_COUNT_ENABLE);
+
+	/* Set Acti Tx/Rx count enable */
+	writel(1, lli->regs + EXYNOS_PA_TX_COUNT);
+	writel(1, lli->regs + EXYNOS_PA_RX_COUNT);
+
+	/*
+	 Set Rx Latch
+	 Edge and number of latches from M-RX to PA.
+	 [0:7] where,
+	 [0] : Rising edge. 1 cycle.
+	 [1] : Rising edge. 2 cycles.
+	 [2] : No latch (Bypass)
+	 [3-7] : Reserved
+	 */
+	writel(2, lli->regs + EXYNOS_PA_PA_DBG_RX_LATCH_MODE);
+
+	writel(0x40, lli->regs + EXYNOS_PA_NACK_RTT);
+	writel(0x0, lli->regs + EXYNOS_PA_MK0_INSERTION_ENABLE);
+	/* SS333 (was #if CONFIG_UMTS_MODEM_SS300 || SS303 || SS333) */
+	writel((128<<0) | (15<<8) | (1<<12), lli->regs + EXYNOS_PA_MK0_CONTROL);
+
+	/* Set Scrambler enable */
+	if (lli->modem_info.scrambler)
+		writel(1, lli->regs + EXYNOS_PA_USR_SCRAMBLER_ENABLE);
+
+	/* MPHY configuration */
+	exynos_mphy_init(phy);
+
+	writel(0x1, lli->regs + EXYNOS_PA_MPHY_CMN_ENABLE);
+	exynos_mphy_cmn_init(phy);
+	writel(0x0, lli->regs + EXYNOS_PA_MPHY_CMN_ENABLE);
+
+	writel(0x1, lli->regs + EXYNOS_PA_MPHY_OV_TM_ENABLE);
+	exynos_mphy_ovtm_init(phy);
+	writel(0x0, lli->regs + EXYNOS_PA_MPHY_OV_TM_ENABLE);
+
+	/* Update PA configuration for MPHY standard attributes */
+	writel(0xFFFFFFFF, lli->regs + EXYNOS_PA_CONFIG_UPDATE);
+
+	/* Set SNF FIFO for LL&BE */
+	writel(((0x1F<<1) | 1), lli->regs + EXYNOS_IAL_LL_SNF_FIFO);
+	writel(((0x1F<<1) | 1), lli->regs + EXYNOS_IAL_BE_SNF_FIFO);
+
+	writel(0x1000, lli->regs + EXYNOS_PA_WORSTCASE_RTT);
+
+	pr_debug("MIPI LLI is initialized\n");
+
+	return 0;
+}
+
+/*
+ * Mount interlock (kernel_boot_review.md 5.1 items 3-4): after the
+ * settings, read the remap registers and LLI_PHY_CON back.  remap_ok only
+ * if the settings were written and all three match.
+ */
+static void exynos_lli_check_remap(struct mipi_lli *lli, bool settings_ok)
+{
+	unsigned int pmu = 0;
+	bool ok;
+
+	lli->remap_ll_rb = readl(lli->regs + EXYNOS_IAL_LL_INIT_ADDR_REMAP);
+	lli->remap_be_rb = readl(lli->regs + EXYNOS_IAL_BE_INIT_ADDR_REMAP);
+	if (regmap_read(lli->pmu, EXYNOS5433_LLI_PHY_CONTROL, &pmu))
+		pmu = ~0u;
+	lli->pmu_rb = pmu;
+
+	ok = settings_ok && lli->remap_addr &&
+	     lli->remap_ll_rb == lli->remap_addr &&
+	     lli->remap_be_rb == lli->remap_addr && pmu == 1;
+
+	WRITE_ONCE(lli->remap_ok, ok);
+
+	pr_info("remap LL_INIT 0x%08x BE_INIT 0x%08x (expected 0x%08x), LLI_PHY_CON 0x%x: remap_ok=%d\n",
+		lli->remap_ll_rb, lli->remap_be_rb, lli->remap_addr, pmu, ok);
+}
+
+static int exynos_lli_set_master(struct mipi_lli *lli, bool is_master)
+{
+	lli->is_master = is_master;
+
+	writel((is_master << 1), lli->regs + EXYNOS_DME_CSA_SYSTEM_SET);
+
+	return 0;
+}
+
+static int exynos_lli_link_startup_mount(struct mipi_lli *lli)
+{
+	u32 regs;
+	int ret = 0;
+
+	if (lli->is_master) {
+		regs = readl(lli->regs + EXYNOS_DME_CSA_SYSTEM_STATUS);
+		if (regs & LLI_MOUNTED) {
+			pr_debug("LLI master already mounted\n");
+			return ret;
+		}
+
+		regs = readl(lli->regs + EXYNOS_DME_CSA_SYSTEM_SET);
+		writel((0x1 << 2) | regs,
+			lli->regs + EXYNOS_DME_CSA_SYSTEM_SET);
+	} else {
+		ret = poll_bit_set(lli->regs + EXYNOS_DME_LLI_INTR_STATUS,
+			     INTR_MPHY_HIBERN8_EXIT_DONE,
+			     1000);
+		if (ret) {
+			pr_err("HIBERN8 Exit Failed\n");
+			return ret;
+		}
+
+		regs = readl(lli->regs + EXYNOS_DME_CSA_SYSTEM_SET);
+		writel((0x1 << 2) | regs,
+			lli->regs + EXYNOS_DME_CSA_SYSTEM_SET);
+	}
+
+	return ret;
+}
+
+static int exynos_lli_get_status(struct mipi_lli *lli)
+{
+	return atomic_read(&lli->state);
+}
+
+/* GPIO sideband build (CONFIG_EXYNOS_MIPI_LLI_GPIO_SIDEBAND=y on 5433) */
+static int exynos_lli_send_signal(struct mipi_lli *lli, u32 cmd)
+{
+	int is_mounted = 0;
+
+	if (atomic_read(&lli->state) != LLI_MOUNTED) {
+		pr_err_ratelimited("LLI not mounted !! mnt_reg = %d %d\n",
+				   is_mounted, lli->pa_err_6);
+		return -EIO;
+	}
+
+	/* For unmount failed issue, we should check the
+	   LLI_MOUNT_CTRL is cleared or not */
+	is_mounted = readl(lli->regs + EXYNOS_DME_CSA_SYSTEM_STATUS);
+	if (!(is_mounted & LLI_MOUNT_CTRL) || lli->pa_err_6)
+		return -EIO;
+
+	writel(cmd, lli->regs + EXYNOS_TL_SIGNAL_SET_MSB);
+
+	return 0;
+}
+
+static int exynos_lli_reset_signal(struct mipi_lli *lli)
+{
+	writel(0xFFFFFFFF, lli->regs + EXYNOS_TL_SIGNAL_CLR_LSB);
+	writel(0xFFFFFFFF, lli->regs + EXYNOS_TL_SIGNAL_CLR_MSB);
+
+	return 0;
+}
+
+static int exynos_lli_read_signal(struct mipi_lli *lli)
+{
+	u32 intr_lsb, intr_msb;
+
+	intr_lsb = readl(lli->regs + EXYNOS_TL_SIGNAL_STATUS_LSB);
+	intr_msb = readl(lli->regs + EXYNOS_TL_SIGNAL_STATUS_MSB);
+
+	if (intr_lsb)
+		writel(intr_lsb, lli->regs + EXYNOS_TL_SIGNAL_CLR_LSB);
+	if (intr_msb)
+		writel(intr_msb, lli->regs + EXYNOS_TL_SIGNAL_CLR_MSB);
+
+	pr_debug("LSB = %x, MSB = %x\n", intr_lsb, intr_msb);
+
+	return intr_lsb;
+}
+
+static int exynos_lli_intr_enable(struct mipi_lli *lli)
+{
+	if (lli->is_suspended)
+		return -1;
+
+	if (exynos_lli_get_intr_enable(lli) != EXYNOS_LLI_INTR_ENABLED)
+		exynos_lli_set_intr_enable(lli);
+
+	return 0;
+}
+
+static int exynos_lli_intr_disable(struct mipi_lli *lli)
+{
+	if (lli->is_suspended)
+		return -1;
+
+	if (exynos_lli_get_intr_enable(lli) != EXYNOS_LLI_INTR_DISABLED)
+		exynos_lli_set_intr_disable(lli);
+
+	return 0;
+}
+
+/*
+ * Only reached through mipi_lli_suspend/resume (no system sleep callbacks:
+ * without the link PM FSM they were no-ops in 3.10 too).  3.10 also gated
+ * the LLI clocks here; this port keeps them on once hw_init has enabled
+ * them (one clk_bulk_prepare_enable), so these never sleep.
+ */
+static int exynos_lli_suspend(struct mipi_lli *lli)
+{
+	lli->is_suspended = true;
+	lli->is_debug_possible = false;
+
+	/* masking all of lli interrupts */
+	exynos_lli_system_config(lli);
+	exynos_lli_clear_intr_enable(lli);
+
+	/* clearing all of lli sideband signal */
+	exynos_lli_reset_signal(lli);
+
+	/* disable LLI_PHY_CONTROL */
+	regmap_write(lli->pmu, EXYNOS5433_LLI_PHY_CONTROL, 0);
+
+	return 0;
+}
+
+static int exynos_lli_resume(struct mipi_lli *lli)
+{
+	/* enable LLI_PHY_CONTROL */
+	regmap_write(lli->pmu, EXYNOS5433_LLI_PHY_CONTROL, 1);
+
+	/* re-init all of lli resource */
+	exynos_lli_init(lli);
+
+	lli->is_suspended = false;
+
+	return 0;
+}
+
+static void exynos_mipi_lli_set_automode(struct mipi_lli *lli, bool is_auto)
+{
+	if (is_auto)
+		writel(CSA_AUTO_MODE, lli->regs + EXYNOS_PA_CSA_PA_SET);
+	else
+		writel(CSA_AUTO_MODE, lli->regs + EXYNOS_PA_CSA_PA_CLR);
+}
+
+/*
+ * First and only place the clocks are turned on.  Called with hw_mutex
+ * held and allow_hw=1 (mipi-lli.c).
+ */
+static int exynos_lli_hw_init(struct mipi_lli *lli)
+{
+	unsigned long flags;
+	u32 status;
+	int ret;
+
+	ret = clk_bulk_prepare_enable(lli->num_clks, lli->clks);
+	if (ret) {
+		pr_err("hw_init: clock enable failed: %d\n", ret);
+		return ret;
+	}
+	WRITE_ONCE(lli->clks_enabled, true);
+
+	pr_info("dout_aclk_cpif_200 = %lu\n", clk_get_rate(lli->clks[0].clk));
+
+	/* enable LLI_PHY_CONTROL */
+	ret = regmap_write(lli->pmu, EXYNOS5433_LLI_PHY_CONTROL, 1);
+	if (ret) {
+		pr_err("hw_init: LLI_PHY_CONTROL write failed: %d\n", ret);
+		WRITE_ONCE(lli->clks_enabled, false);
+		clk_bulk_disable_unprepare(lli->num_clks, lli->clks);
+		return ret;
+	}
+
+	/* No LLI interrupt before the first reset asks for them. */
+	exynos_lli_clear_intr_enable(lli);
+	status = readl(lli->regs + EXYNOS_DME_LLI_INTR_STATUS);
+	if (status)
+		writel(status, lli->regs + EXYNOS_DME_LLI_INTR_STATUS);
+
+	pr_info("hw_init: INTR_STATUS was 0x%x, CSA_SYSTEM_STATUS 0x%x\n",
+		status, readl(lli->regs + EXYNOS_DME_CSA_SYSTEM_STATUS));
+
+	/* Pairs with smp_load_acquire() in mipi-lli.c lli_prepare_hw(). */
+	smp_store_release(&lli->hw_init_done, true);
+
+	enable_irq(lli->irq);
+
+	spin_lock_irqsave(&lli->lock, flags);
+	if (!lli->sig_irq_active) {
+		enable_irq(lli->irq_sig);
+		lli->sig_irq_active = true;
+	}
+	spin_unlock_irqrestore(&lli->lock, flags);
+
+	return 0;
+}
+
+static void exynos_lli_status_show(struct mipi_lli *lli, struct seq_file *s,
+				   bool regs)
+{
+	unsigned int pmu;
+	int ret;
+
+	seq_printf(s, "afc_valid: %d (afc 0x%x)\n", lli->mphy->afc_valid,
+		   lli->mphy->afc_val);
+	if (!regs)
+		return;
+
+	seq_printf(s, "CSA_SYSTEM_STATUS: 0x%08x\n",
+		   readl(lli->regs + EXYNOS_DME_CSA_SYSTEM_STATUS));
+	seq_printf(s, "INTR_ENABLE: 0x%08x\n",
+		   readl(lli->regs + EXYNOS_DME_LLI_INTR_ENABLE));
+	seq_printf(s, "INTR_STATUS: 0x%08x\n",
+		   readl(lli->regs + EXYNOS_DME_LLI_INTR_STATUS));
+	seq_printf(s, "IAL_LL_INIT_ADDR_REMAP: 0x%08x (expected 0x%08x)\n",
+		   readl(lli->regs + EXYNOS_IAL_LL_INIT_ADDR_REMAP), lli->remap_addr);
+	seq_printf(s, "IAL_BE_INIT_ADDR_REMAP: 0x%08x (expected 0x%08x)\n",
+		   readl(lli->regs + EXYNOS_IAL_BE_INIT_ADDR_REMAP), lli->remap_addr);
+	seq_printf(s, "IAL_LL_TARG_ADDR_REMAP: 0x%08x\n",
+		   readl(lli->regs + EXYNOS_IAL_LL_TARG_ADDR_REMAP));
+	seq_printf(s, "IAL_BE_TARG_ADDR_REMAP: 0x%08x\n",
+		   readl(lli->regs + EXYNOS_IAL_BE_TARG_ADDR_REMAP));
+	seq_printf(s, "IAL_OVERLAP_ADDR_CTRL_EN: 0x%08x\n",
+		   readl(lli->regs + EXYNOS_IAL_OVERLAP_ADDR_CTRL_EN));
+	seq_printf(s, "PA_SYSTEM_CLK_PERIOD: %u\n",
+		   readl(lli->regs + EXYNOS_PA_SYSTEM_CLK_PERIOD));
+
+	ret = regmap_read(lli->pmu, EXYNOS5433_LLI_PHY_CONTROL, &pmu);
+	if (ret)
+		seq_printf(s, "PMU LLI_PHY_CON (0x720): read error %d\n", ret);
+	else
+		seq_printf(s, "PMU LLI_PHY_CON (0x720): 0x%08x\n", pmu);
+}
