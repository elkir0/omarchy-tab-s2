+# SPDX-License-Identifier: GPL-2.0-only
+#
+# MIPI LLI
+#
+
+config MIPI_LLI
+	tristate "Exynos5433 MIPI-LLI controller (SS333 modem link)"
+	depends on ARCH_EXYNOS || COMPILE_TEST
+	depends on OF && HAS_IOMEM
+	help
+	  MIPI-LLI (Low Latency Interface) controller and M-PHY of the
+	  Exynos5433 CP interface, which links the application processor
+	  to an external Samsung Shannon SS333 modem (Samsung Galaxy Tab S2
+	  SM-T715).  Ported from Samsung's 3.10 kernel; exports the API the
+	  modem_v1 driver uses.
+
+	  The driver binds without touching the hardware: the allow_hw
+	  module parameter (default 0) must be set before it turns a clock
+	  on or accesses an LLI, M-PHY or PMU register.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called exynos5433-mipi-lli.
