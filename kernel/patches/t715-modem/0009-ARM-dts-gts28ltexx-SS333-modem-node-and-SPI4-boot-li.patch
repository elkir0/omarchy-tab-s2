+
+/*
+ * SPI4 TX-only bus: CLK gpv7-1, nCS gpv7-2, MOSI gpv7-4, function 3,
+ * pull-up, drive 0 (K/exynos5433-modem-ss333.dtsi:170-174; live:6331-6338:
+ * pin-function 3, pin-pud 3, pin-drv 0).  The mainline group is gpv7-1/3/4
+ * with the same function, pull and drive (ML exynos5433-pinctrl.dtsi
+ * :727-732): only the pin list changes, so the controller drives nCS.
+ */
+&spi4_bus {
+	samsung,pins = "gpv7-1", "gpv7-2", "gpv7-4";
+};
+
+&pinctrl_peric {
+	/*
+	 * CP_SPI_MISO gpv7-3, unused (TX only): input, pull-down; same in
+	 * power-down.  Stock initial state live:5764-5769 (function 0,
+	 * pud 1), sleep state live:6530-6534 (con-pdn 2, pud-pdn 1);
+	 * K/exynos5433-modem-ss333.dtsi:206-215.
+	 */
+	cp_spi_miso: cp-spi-miso-pins {
+		samsung,pins = "gpv7-3";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
+		samsung,pin-con-pdn = <EXYNOS_PIN_PDN_INPUT>;
+		samsung,pin-pud-pdn = <EXYNOS_PIN_PULL_DOWN>;
+	};
+};
+
+/*
+ * SPI4 @ 0x14d00000 (not 0x14d30000, which is SPI1: SYNTHESIS.md C09)
+ * carries BOOT (0x29fc bytes, one transfer) to the SS333 BootROM: SPI mode
+ * 0, 8 bit, 100 kHz (K/exynos5433-modem-ss333.dtsi:154-169; live:1747-1772,
+ * spi-max-frequency 0x186a0).  The SoC node is disabled by default
+ * (ML arch/arm64/boot/dts/exynos/exynos5433.dtsi:1535-1553).  Without the
+ * pl330 driver the controller works in PIO mode (KP section 3.5).
+ */
+&spi_4 {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&spi4_bus &cp_spi_miso>;
+
+	cp_boot_spi: modem-boot@0 {
+		compatible = "samsung,ss333-boot-spi", "spi_boot_link";
+		reg = <0>;
+		spi-max-frequency = <100000>;
+
+		/*
+		 * live:1769-1772: feedback delay 0.  The stock
+		 * samsung,spi-chip-select-mode = <1> has no mainline property;
+		 * the 5433 port config already uses S3C64XX_SPI_QUIRK_CS_AUTO
+		 * (ML drivers/spi/spi-s3c64xx.c:1561-1571).
+		 */
+		controller-data {
+			samsung,spi-feedback-delay = <0>;
+		};
+	};
+};
