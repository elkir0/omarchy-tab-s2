+				iod,id = <244>;
+				iod,format = <0>;
+				iod,io_type = <0>;
+				iod,links = <0x400>;
+				iod,attrs = <0x82>;	/* ATTR_SBD_IPC | ATTR_SIPC5 */
+				iod,app = "CLD";
+				iod,ul_num_buffers = <16>;
+				iod,ul_buffer_size = <2048>;
+				iod,dl_num_buffers = <32>;
