+			io_device_9 {
+				iod,name = "rmnet3";
+				iod,id = <13>;
+				iod,format = <1>;
+				iod,io_type = <1>;
+				iod,links = <0x400>;
+				iod,attrs = <0x180>;
+				iod,app = "NET";
+				iod,ul_num_buffers = <256>;
+				iod,ul_buffer_size = <2048>;
