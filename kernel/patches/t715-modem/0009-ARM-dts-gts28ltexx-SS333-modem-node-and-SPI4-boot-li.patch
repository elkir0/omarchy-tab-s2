+			io_device_7 {
+				iod,name = "rmnet1";
+				iod,id = <11>;
+				iod,format = <1>;
+				iod,io_type = <1>;
+				iod,links = <0x400>;
+				iod,attrs = <0x180>;
+				iod,app = "NET";
+				iod,ul_num_buffers = <256>;
+				iod,ul_buffer_size = <2048>;
+				iod,dl_num_buffers = <512>;
+				iod,dl_buffer_size = <2048>;
+			};
+			io_device_8 {
+				iod,name = "rmnet2";
+				iod,id = <12>;
+				iod,format = <1>;
+				iod,io_type = <1>;
+				iod,links = <0x400>;
+				iod,attrs = <0x180>;
+				iod,app = "NET";
+				iod,ul_num_buffers = <256>;
