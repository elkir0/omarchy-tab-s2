+			};
+			io_device_6 {
+				iod,name = "rmnet0";
+				iod,id = <10>;
+				iod,format = <1>;
+				iod,io_type = <1>;
+				iod,links = <0x400>;
+				iod,attrs = <0x180>;
+				iod,app = "NET";
+				iod,ul_num_buffers = <256>;
