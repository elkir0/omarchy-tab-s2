+
+/*
+ * Prints what failed and exits non-zero on the first failure.
+ */
+#define CHECK(cond)							\
+	do {								\
+		if (!(cond)) {						\
+			printf("FAIL %s:%d: %s\n", __func__, __LINE__,	\
+			       #cond);					\
+			exit(1);					\
+		}							\
+	} while (0)
+
+static void test_reg_input(void)
+{
+	CHECK(sm5703_reg_input(450) == 0x07);
+	CHECK(sm5703_reg_input(1750) == 0x21);
+	CHECK(sm5703_reg_input(100) == 0x07);	/* clamped up to 450 */
+	CHECK(sm5703_reg_input(0) == 0x07);
+	CHECK(sm5703_reg_input(-5000) == 0x07);
+	CHECK(sm5703_reg_input(2000) == 0x21);	/* clamped down to 1750 */
+	CHECK(sm5703_reg_input(500) == 0x08);
+	CHECK(sm5703_reg_input(1000) == 0x12);
+}
+
+static void test_reg_fast(void)
+{
+	CHECK(sm5703_reg_fast(2100) == 0x28);
+	CHECK(sm5703_reg_fast(2000) == 0x26);
+	CHECK(sm5703_reg_fast(100) == 0x00);
+	CHECK(sm5703_reg_fast(450) == 0x07);
+	CHECK(sm5703_reg_fast(0) == 0x00);	/* clamped up to 100 */
+	CHECK(sm5703_reg_fast(-1) == 0x00);
+	CHECK(sm5703_reg_fast(2500) == 0x28);	/* clamped down to 2100 */
+}
+
+static void test_reg_float(void)
+{
+	CHECK(sm5703_reg_float(4200) == 0x08);
+	CHECK(sm5703_reg_float(4390) == 0x1b);
+	CHECK(sm5703_reg_float(4120) == 0x08);	/* clamped up to 4200 */
+	CHECK(sm5703_reg_float(0) == 0x08);
+	CHECK(sm5703_reg_float(4500) == 0x1b);	/* clamped down to 4390 */
+	CHECK(sm5703_reg_float(4340) == 0x16);
+}
+
+static void test_thermistor_ends(void)
+{
+	int t;
+
+	CHECK(!sm5703_thermistor_deci_c(57, &t));
+	CHECK(!sm5703_thermistor_deci_c(1473, &t));
+	CHECK(!sm5703_thermistor_deci_c(-1, &t));
+	CHECK(sm5703_thermistor_deci_c(58, &t));
+	CHECK(t == 850);
+	CHECK(sm5703_thermistor_deci_c(1472, &t));
+	CHECK(t == -150);
+}
+
+static void test_thermistor_points(void)
+{
+	struct {
+		int raw;
+		int deci_c;
+	} pts[] = {
+		{ 141, 550 }, { 166, 500 }, { 195, 450 }, { 219, 400 },
+		{ 541, 150 }, { 645, 100 }, { 907, 0 }, { 1068, -50 },
+		{ 60, 840 }, { 63, 820 }, { 92, 690 }, { 106, 640 },
+		{ 228, 390 }, { 276, 340 }, { 456, 190 }, { 765, 50 },
+		{ 779, 40 }, { 810, 30 }, { 865, 20 }, { 866, 10 },
+		{ 928, -10 }, { 998, -30 }, { 1034, -40 }, { 1103, -60 },
+		{ 1134, -70 }, { 1158, -80 }, { 1210, -90 }, { 1259, -100 },
+	};
+	unsigned int i;
+	int t;
+
+	for (i = 0; i < sizeof(pts) / sizeof(pts[0]); i++) {
+		CHECK(sm5703_thermistor_deci_c(pts[i].raw, &t));
+		CHECK(t == pts[i].deci_c);
+	}
+}
+
+static void test_thermistor_interpolation(void)
+{
+	int t;
+
+	/* Midway between 98 (805 at raw 98) and 100 at raw 100: raw 99 */
+	CHECK(sm5703_thermistor_deci_c(99, &t));
+	CHECK(t == 665);
+
+	/* Halfway between 440 (raw 200) and 430 (raw 204): raw 202 gives 435 */
+	CHECK(sm5703_thermistor_deci_c(202, &t));
+	CHECK(t == 435);
+
+	/* Raw 100 is not a table point: 690 at 92, 640 at 106, C division */
+	CHECK(sm5703_thermistor_deci_c(100, &t));
+	CHECK(t == 662);
+}
+
+static void test_thermistor_monotonic(void)
+{
+	int raw, prev = 1000;	/* above the warmest point */
+
+	for (raw = 58; raw <= 1472; raw++) {
+		int t;
+
+		if (!sm5703_thermistor_deci_c(raw, &t))
+			continue;
+		CHECK(t <= prev);
+		prev = t;
+	}
+}
+
+static void test_first_zone(void)
+{
+	CHECK(sm5703_chg_first_zone(550) == SM5703_ZONE_HOT_STOP);
+	CHECK(sm5703_chg_first_zone(551) == SM5703_ZONE_HOT_STOP);
+	CHECK(sm5703_chg_first_zone(1000) == SM5703_ZONE_HOT_STOP);
+	CHECK(sm5703_chg_first_zone(549) == SM5703_ZONE_WARM);
+	CHECK(sm5703_chg_first_zone(450) == SM5703_ZONE_WARM);
+	CHECK(sm5703_chg_first_zone(449) == SM5703_ZONE_NORMAL);
+	CHECK(sm5703_chg_first_zone(250) == SM5703_ZONE_NORMAL);
+	CHECK(sm5703_chg_first_zone(101) == SM5703_ZONE_NORMAL);
+	CHECK(sm5703_chg_first_zone(100) == SM5703_ZONE_COOL);
+	CHECK(sm5703_chg_first_zone(99) == SM5703_ZONE_COOL);
+	CHECK(sm5703_chg_first_zone(0) == SM5703_ZONE_COOL);
+	CHECK(sm5703_chg_first_zone(-49) == SM5703_ZONE_COOL);
+	CHECK(sm5703_chg_first_zone(-50) == SM5703_ZONE_COLD_STOP);
+	CHECK(sm5703_chg_first_zone(-51) == SM5703_ZONE_COLD_STOP);
+	CHECK(sm5703_chg_first_zone(-1000) == SM5703_ZONE_COLD_STOP);
+}
+
+/*
+ * An independent restatement of the zone rules, so that the transition
+ * checks do not merely repeat the implementation.
+ */
+static enum sm5703_chg_zone sm5703_chg_next_zone_ref(
+					enum sm5703_chg_zone cur, int deci_c)
+{
+	if (deci_c >= 550)
+		return SM5703_ZONE_HOT_STOP;
+	if (deci_c <= -50)
+		return SM5703_ZONE_COLD_STOP;
+
+	switch (cur) {
+	case SM5703_ZONE_HOT_STOP:
+		if (deci_c <= 430)
+			return SM5703_ZONE_NORMAL;
+		if (deci_c <= 500)
+			return SM5703_ZONE_WARM;
+		return SM5703_ZONE_HOT_STOP;
+	case SM5703_ZONE_COLD_STOP:
+		if (deci_c >= 150)
+			return SM5703_ZONE_NORMAL;
+		if (deci_c >= 0)
+			return SM5703_ZONE_COOL;
+		return SM5703_ZONE_COLD_STOP;
+	case SM5703_ZONE_WARM:
+		if (deci_c <= 430)
+			return SM5703_ZONE_NORMAL;
+		return SM5703_ZONE_WARM;
+	case SM5703_ZONE_COOL:
+		if (deci_c >= 150)
+			return SM5703_ZONE_NORMAL;
+		return SM5703_ZONE_COOL;
+	case SM5703_ZONE_NORMAL:
+		if (deci_c >= 450)
+			return SM5703_ZONE_WARM;
+		if (deci_c <= 100)
+			return SM5703_ZONE_COOL;
+		return SM5703_ZONE_NORMAL;
+	}
+
+	return cur;
+}
+
+/*
+ * Each transition on both sides of its threshold, from every zone.
+ */
+static void test_next_zone(void)
+{
+	static const struct {
+		enum sm5703_chg_zone cur;
+		int deci_c;
+		enum sm5703_chg_zone want;
+	} t[] = {
+		/* HOT_STOP: T <= 430 NORMAL, T <= 500 WARM, else stays */
+		{ SM5703_ZONE_HOT_STOP, 429, SM5703_ZONE_NORMAL },
+		{ SM5703_ZONE_HOT_STOP, 430, SM5703_ZONE_NORMAL },
+		{ SM5703_ZONE_HOT_STOP, 431, SM5703_ZONE_WARM },
+		{ SM5703_ZONE_HOT_STOP, 500, SM5703_ZONE_WARM },
+		{ SM5703_ZONE_HOT_STOP, 501, SM5703_ZONE_HOT_STOP },
+		{ SM5703_ZONE_HOT_STOP, 549, SM5703_ZONE_HOT_STOP },
+		/* COLD_STOP: T >= 150 NORMAL, T >= 0 COOL, else stays */
+		{ SM5703_ZONE_COLD_STOP, 151, SM5703_ZONE_NORMAL },
+		{ SM5703_ZONE_COLD_STOP, 150, SM5703_ZONE_NORMAL },
+		{ SM5703_ZONE_COLD_STOP, 149, SM5703_ZONE_COOL },
+		{ SM5703_ZONE_COLD_STOP, 0, SM5703_ZONE_COOL },
+		{ SM5703_ZONE_COLD_STOP, -1, SM5703_ZONE_COLD_STOP },
+		{ SM5703_ZONE_COLD_STOP, -49, SM5703_ZONE_COLD_STOP },
+		/* WARM: T <= 430 NORMAL, else stays */
+		{ SM5703_ZONE_WARM, 429, SM5703_ZONE_NORMAL },
+		{ SM5703_ZONE_WARM, 430, SM5703_ZONE_NORMAL },
+		{ SM5703_ZONE_WARM, 431, SM5703_ZONE_WARM },
+		{ SM5703_ZONE_WARM, 449, SM5703_ZONE_WARM },
+		/* COOL: T >= 150 NORMAL, else stays */
+		{ SM5703_ZONE_COOL, 151, SM5703_ZONE_NORMAL },
+		{ SM5703_ZONE_COOL, 150, SM5703_ZONE_NORMAL },
+		{ SM5703_ZONE_COOL, 149, SM5703_ZONE_COOL },
+		{ SM5703_ZONE_COOL, 101, SM5703_ZONE_COOL },
+		/* NORMAL: T >= 450 WARM, T <= 100 COOL, else stays */
+		{ SM5703_ZONE_NORMAL, 449, SM5703_ZONE_NORMAL },
+		{ SM5703_ZONE_NORMAL, 450, SM5703_ZONE_WARM },
+		{ SM5703_ZONE_NORMAL, 451, SM5703_ZONE_WARM },
+		{ SM5703_ZONE_NORMAL, 101, SM5703_ZONE_NORMAL },
+		{ SM5703_ZONE_NORMAL, 100, SM5703_ZONE_COOL },
+		{ SM5703_ZONE_NORMAL, 99, SM5703_ZONE_COOL },
+	};
+	static const enum sm5703_chg_zone zones[] = {
+		SM5703_ZONE_COLD_STOP, SM5703_ZONE_COOL, SM5703_ZONE_NORMAL,
+		SM5703_ZONE_WARM, SM5703_ZONE_HOT_STOP,
+	};
+	unsigned int i;
+	int deci_c;
+
+	/* The absolute thresholds apply from every zone */
+	for (i = 0; i < sizeof(zones) / sizeof(zones[0]); i++) {
+		for (deci_c = -70; deci_c <= 560; deci_c++) {
+			enum sm5703_chg_zone want;
+
+			if (deci_c >= 550)
+				want = SM5703_ZONE_HOT_STOP;
+			else if (deci_c <= -50)
+				want = SM5703_ZONE_COLD_STOP;
+			else
+				continue;
+			CHECK(sm5703_chg_next_zone(zones[i], deci_c) == want);
+		}
+	}
+
+	for (i = 0; i < sizeof(t) / sizeof(t[0]); i++)
+		CHECK(sm5703_chg_next_zone(t[i].cur, t[i].deci_c) ==
+		      t[i].want);
+
+	/* Every threshold, on both sides, from every zone */
+	{
+		static const int thresholds[] = {
+			-50, -49, -1, 0, 1, 99, 100, 101, 149, 150, 151,
+			429, 430, 431, 449, 450, 451, 499, 500, 501,
+			549, 550, 551,
+		};
+		unsigned int j, k;
+
+		for (j = 0; j < sizeof(zones) / sizeof(zones[0]); j++) {
+			for (k = 0; k < sizeof(thresholds) / sizeof(thresholds[0]); k++) {
+				int c = thresholds[k];
+				enum sm5703_chg_zone want =
+					sm5703_chg_next_zone_ref(zones[j], c);
+
+				CHECK(sm5703_chg_next_zone(zones[j], c) == want);
+			}
+		}
+	}
+
+	/* Between its thresholds, every zone holds where it is.  The HOT_STOP
+	 * and COLD_STOP mid-bands overlap the absolute stop thresholds, which
+	 * are covered above. */
+	for (deci_c = 101; deci_c <= 449; deci_c++) {
+		CHECK(sm5703_chg_next_zone(SM5703_ZONE_NORMAL, deci_c) ==
+		      SM5703_ZONE_NORMAL);
+	}
+	for (deci_c = 431; deci_c <= 449; deci_c++)
+		CHECK(sm5703_chg_next_zone(SM5703_ZONE_WARM, deci_c) ==
+		      SM5703_ZONE_WARM);
+	for (deci_c = 101; deci_c <= 149; deci_c++)
+		CHECK(sm5703_chg_next_zone(SM5703_ZONE_COOL, deci_c) ==
+		      SM5703_ZONE_COOL);
+}
+
+static void test_limits(void)
+{
+	struct sm5703_chg_limits lim;
+
+	/* TA, NORMAL */
+	sm5703_chg_get_limits(SM5703_CABLE_TA, SM5703_ZONE_NORMAL, &lim);
+	CHECK(lim.input_ma == 1750);
+	CHECK(lim.charge_ma == 2100);
+	CHECK(lim.float_mv == 4390);
+	CHECK(lim.recharge_mv == 4340);
+	CHECK(lim.enable);
+
+	/* USB, NORMAL */
+	sm5703_chg_get_limits(SM5703_CABLE_USB, SM5703_ZONE_NORMAL, &lim);
+	CHECK(lim.input_ma == 450);
+	CHECK(lim.charge_ma == 450);
+	CHECK(lim.float_mv == 4390);
+	CHECK(lim.recharge_mv == 4340);
+	CHECK(lim.enable);
+
+	/* WARM caps the charge current and lowers the float voltage */
+	sm5703_chg_get_limits(SM5703_CABLE_TA, SM5703_ZONE_WARM, &lim);
+	CHECK(lim.input_ma == 1750);
+	CHECK(lim.charge_ma == 2000);
+	CHECK(lim.float_mv == 4200);
+	CHECK(lim.recharge_mv == 4150);
+	CHECK(lim.enable);
+
+	sm5703_chg_get_limits(SM5703_CABLE_USB, SM5703_ZONE_WARM, &lim);
+	CHECK(lim.input_ma == 450);
+	CHECK(lim.charge_ma == 450);	/* base is already below the cap */
+	CHECK(lim.float_mv == 4200);
+	CHECK(lim.recharge_mv == 4150);
+	CHECK(lim.enable);
+
+	/* COOL caps the charge current and lowers the float voltage */
+	sm5703_chg_get_limits(SM5703_CABLE_TA, SM5703_ZONE_COOL, &lim);
+	CHECK(lim.input_ma == 1750);
+	CHECK(lim.charge_ma ==  2000);
+	CHECK(lim.float_mv == 4200);
+	CHECK(lim.recharge_mv == 4050);
+	CHECK(lim.enable);
+
+	sm5703_chg_get_limits(SM5703_CABLE_USB, SM5703_ZONE_COOL, &lim);
+	CHECK(lim.input_ma == 450);
+	CHECK(lim.charge_ma == 450);
+	CHECK(lim.float_mv == 4200);
+	CHECK(lim.recharge_mv == 4050);
+	CHECK(lim.enable);
+
+	/* The stop zones keep the base input and charge, but stop charging */
+	sm5703_chg_get_limits(SM5703_CABLE_TA, SM5703_ZONE_HOT_STOP, &lim);
+	CHECK(lim.input_ma == 1750);
+	CHECK(lim.charge_ma == 2100);
+	CHECK(lim.float_mv == 4200);
+	CHECK(lim.recharge_mv == 4050);
+	CHECK(!lim.enable);
+
+	sm5703_chg_get_limits(SM5703_CABLE_TA, SM5703_ZONE_COLD_STOP, &lim);
+	CHECK(lim.input_ma == 1750);
+	CHECK(lim.charge_ma == 2100);
+	CHECK(lim.float_mv == 4200);
+	CHECK(lim.recharge_mv == 4050);
+	CHECK(!lim.enable);
+
+	sm5703_chg_get_limits(SM5703_CABLE_USB, SM5703_ZONE_HOT_STOP, &lim);
+	CHECK(lim.input_ma == 450);
+	CHECK(lim.charge_ma == 450);
+	CHECK(lim.float_mv == 4200);
+	CHECK(lim.recharge_mv == 4050);
+	CHECK(!lim.enable);
+
+	sm5703_chg_get_limits(SM5703_CABLE_USB, SM5703_ZONE_COLD_STOP, &lim);
+	CHECK(lim.input_ma == 450);
+	CHECK(lim.charge_ma == 450);
+	CHECK(lim.float_mv == 4200);
+	CHECK(lim.recharge_mv == 4050);
+	CHECK(!lim.enable);
+
+	/* No cable, whatever the zone: minimum limits, never charging */
+	sm5703_chg_get_limits(SM5703_CABLE_NONE, SM5703_ZONE_NORMAL, &lim);
+	CHECK(lim.input_ma == 450);
+	CHECK(lim.charge_ma == 450);
+	CHECK(lim.float_mv == 4200);
+	CHECK(lim.recharge_mv == 4050);
+	CHECK(!lim.enable);
+
+	sm5703_chg_get_limits(SM5703_CABLE_NONE, SM5703_ZONE_WARM, &lim);
+	CHECK(lim.input_ma == 450);
+	CHECK(lim.charge_ma == 450);
+	CHECK(lim.float_mv == 4200);
+	CHECK(lim.recharge_mv == 4050);
+	CHECK(!lim.enable);
+
+	sm5703_chg_get_limits(SM5703_CABLE_NONE, SM5703_ZONE_COOL, &lim);
+	CHECK(lim.input_ma == 450);
+	CHECK(lim.charge_ma == 450);
+	CHECK(lim.float_mv == 4200);
+	CHECK(lim.recharge_mv == 4050);
+	CHECK(!lim.enable);
+
+	sm5703_chg_get_limits(SM5703_CABLE_NONE, SM5703_ZONE_HOT_STOP, &lim);
+	CHECK(lim.input_ma == 450);
+	CHECK(lim.charge_ma == 450);
+	CHECK(lim.float_mv == 4200);
+	CHECK(lim.recharge_mv == 4050);
+	CHECK(!lim.enable);
+
+	sm5703_chg_get_limits(SM5703_CABLE_NONE, SM5703_ZONE_COLD_STOP, &lim);
+	CHECK(lim.input_ma == 450);
+	CHECK(lim.charge_ma == 450);
+	CHECK(lim.float_mv == 4200);
+	CHECK(lim.recharge_mv == 4050);
+	CHECK(!lim.enable);
+}
+
+/* No combination may exceed the chip's maximum float, input or charge */
+static void test_limits_max(void)
+{
+	static const enum sm5703_chg_cable cables[] = {
+		SM5703_CABLE_NONE, SM5703_CABLE_USB, SM5703_CABLE_TA,
+	};
+	static const enum sm5703_chg_zone zones[] = {
+		SM5703_ZONE_COLD_STOP, SM5703_ZONE_COOL, SM5703_ZONE_NORMAL,
+		SM5703_ZONE_WARM, SM5703_ZONE_HOT_STOP,
+	};
+	unsigned int i, j;
+
+	for (i = 0; i < sizeof(cables) / sizeof(cables[0]); i++) {
+		for (j = 0; j < sizeof(zones) / sizeof(zones[0]); j++) {
+			struct sm5703_chg_limits lim;
+
+			sm5703_chg_get_limits(cables[i], zones[j], &lim);
+			CHECK(lim.float_mv <= 4390);
+			CHECK(lim.input_ma <= 1750);
+			CHECK(lim.charge_ma <= 2100);
+		}
+	}
+}
