index ab52e3123..05fe9c9dd 100644
--- a/drivers/power/supply/Kconfig
+++ b/drivers/power/supply/Kconfig
@@ -836,6 +836,22 @@ config BATTERY_SM5703
 	  To compile this driver as a module, choose M here: the module
 	  will be called sm5703_fuel_gauge.
 
+config CHARGER_SM5703
+	tristate "Silicon Mitus SM5703 charger support"
+	depends on I2C
+	depends on EXTCON
+	select REGMAP_I2C
+	help
+	  Say Y here to enable support for the charger block of the
+	  Silicon Mitus SM5703, as found on the Samsung Galaxy Tab S2 8.0
+	  LTE.  The driver applies the stock Android charging currents and
+	  float voltages, and stops charging outside the battery's thermal
+	  limits, with the hysteresis of the stock driver.  The cable type
+	  comes from the MUIC's extcon device.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called sm5703_charger.
+
