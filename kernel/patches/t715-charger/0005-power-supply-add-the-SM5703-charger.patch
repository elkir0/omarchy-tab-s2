 arch/arm/configs/gts28ltexx_defconfig         |   8 +-
 drivers/power/supply/Kconfig                  |  16 +
 drivers/power/supply/Makefile                 |   1 +
 drivers/power/supply/sm5703_charger.c         | 806 ++++++++++++++++++
 drivers/power/supply/sm5703_charger_policy.h  | 251 ++++++
 .../power/supply/sm5703_charger_policy_test.c | 449 ++++++++++
 7 files changed, 1542 insertions(+), 3 deletions(-)
 create mode 100644 drivers/power/supply/sm5703_charger.c
 create mode 100644 drivers/power/supply/sm5703_charger_policy.h
 create mode 100644 drivers/power/supply/sm5703_charger_policy_test.c

diff --git a/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx-battery.dtsi b/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx-battery.dtsi
index eff8b1b00..0853410f2 100644
--- a/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx-battery.dtsi
+++ b/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx-battery.dtsi
@@ -28,6 +28,20 @@ fuel-gauge@71 {
 	};
 };
 
+/*
+ * The SM5703's charger block answers at 0x49 on hsi2c_8, live_fdt.dts:4371.
+ * Pins gpb0-1/gpb0-0 function 4, as stock.
+ */
+&hsi2c_8 {
+	status = "okay";
+
+	charger@49 {
+		compatible = "siliconmitus,sm5703-charger";
+		reg = <0x49>;
+		extcon = <&muic>;
+	};
+};
+
 /* Channel 2 is the battery thermistor: stock "adc-temp", live_fdt.dts:5012. */
 &adc {
 	status = "okay";
diff --git a/arch/arm/configs/gts28ltexx_defconfig b/arch/arm/configs/gts28ltexx_defconfig
index 0ef16ae24..15155793a 100644
--- a/arch/arm/configs/gts28ltexx_defconfig
+++ b/arch/arm/configs/gts28ltexx_defconfig
@@ -246,10 +246,12 @@ CONFIG_IIO=y
 CONFIG_EXYNOS_ADC=y
 CONFIG_IIO_ST_LSM6DSX=m
 CONFIG_YAMAHA_YAS530=m
-# Battery fuel gauge (SM5703 on HSI2C7, read-only, docs/BATTERY.md):
-# the power_supply class that UPower reads, and the driver as a module.
+# Battery (SM5703 on HSI2C7, read-only gauge, docs/BATTERY.md) and its
