From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: elkir0 <elkir0@users.noreply.github.com>
Date: Mon, 2 Nov 2026 12:00:00 +0000
Subject: [PATCH 4/5] power: supply: sm5703-fuel-gauge: the battery thermistor
 as TEMP

The gauge's own sensor reads its die, several degrees above the battery,
and the charger's thermal rules need the battery.  Read the thermistor on
ADC channel 2 with stock's 66-point table and report it as TEMP, the die
as TEMP_AMBIENT.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../exynos5433-gts28ltexx-battery.dtsi        |  7 ++
 arch/arm/configs/gts28ltexx_defconfig         |  1 +
 drivers/power/supply/Kconfig                  |  8 +-
 drivers/power/supply/sm5703_fuel_gauge.c      | 86 ++++++++++++++++++-
 4 files changed, 97 insertions(+), 5 deletions(-)

diff --git a/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx-battery.dtsi b/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx-battery.dtsi
index c18e783cc..eff8b1b00 100644
--- a/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx-battery.dtsi
+++ b/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx-battery.dtsi
@@ -23,5 +23,12 @@ &hsi2c_7 {
 	fuel-gauge@71 {
 		compatible = "siliconmitus,sm5703-fuel-gauge";
 		reg = <0x71>;
+		io-channels = <&adc 2>;
+		io-channel-names = "batt-temp";
 	};
 };
+
+/* Channel 2 is the battery thermistor: stock "adc-temp", live_fdt.dts:5012. */
+&adc {
+	status = "okay";
+};
diff --git a/arch/arm/configs/gts28ltexx_defconfig b/arch/arm/configs/gts28ltexx_defconfig
index 54c49e0f2..0ef16ae24 100644
--- a/arch/arm/configs/gts28ltexx_defconfig
+++ b/arch/arm/configs/gts28ltexx_defconfig
@@ -243,6 +243,7 @@ CONFIG_INPUT_UINPUT=y
 # watchdog guard, so a probe that stalls on the I2C bus cannot loop the
 # board.  iio-sensor-proxy reads them for auto-rotation.
 CONFIG_IIO=y
+CONFIG_EXYNOS_ADC=y
 CONFIG_IIO_ST_LSM6DSX=m
 CONFIG_YAMAHA_YAS530=m
 # Battery fuel gauge (SM5703 on HSI2C7, read-only, docs/BATTERY.md):
diff --git a/drivers/power/supply/Kconfig b/drivers/power/supply/Kconfig
index 403631ada..ab52e3123 100644
--- a/drivers/power/supply/Kconfig
+++ b/drivers/power/supply/Kconfig
@@ -822,14 +822,16 @@ config CHARGER_RT5033
 config BATTERY_SM5703
 	tristate "Silicon Mitus SM5703 fuel gauge support"
 	depends on I2C
+	depends on IIO
 	select REGMAP_I2C
 	help
 	  Say Y here to enable read-only support for the Silicon Mitus
 	  SM5703 fuel gauge, as found on the Samsung Galaxy Tab S2 8.0 LTE.
 	  The driver reports the state of charge, voltage, current and
-	  temperature measured by the gauge.  It never writes to the chip,
-	  which must have been initialised with a battery model beforehand
-	  (by the stock firmware).
+	  the battery temperature measured through the gauge and its
+	  thermistor.  It never writes to the gauge, which must have been
+	  initialised with a battery model beforehand (by the stock
+	  firmware).
 
 	  To compile this driver as a module, choose M here: the module
 	  will be called sm5703_fuel_gauge.
diff --git a/drivers/power/supply/sm5703_fuel_gauge.c b/drivers/power/supply/sm5703_fuel_gauge.c
index 719b82e5a..d6ba8019d 100644
--- a/drivers/power/supply/sm5703_fuel_gauge.c
+++ b/drivers/power/supply/sm5703_fuel_gauge.c
@@ -22,12 +22,19 @@
  * stock driver writes to CURR_CAL before every SOC read, OCV tracking,
  * low-SOC/low-voltage alarms (no IRQ is used, the driver polls) and the
  * "dynamic" capacity_max learnt at each full charge.
+ *
+ * The battery temperature comes from the battery thermistor on the exynos
+ * ADC (io-channel "batt-temp"), through sm5703_thermistor_deci_c() in
+ * sm5703_charger_policy.h: the gauge's own sensor reads the chip, not the
+ * battery, and runs 10 to 20 degC above it under charge.  That sensor is
+ * still reported, as POWER_SUPPLY_PROP_TEMP_AMBIENT.
  */
 
 #include <linux/bitfield.h>
 #include <linux/bits.h>
 #include <linux/devm-helpers.h>
 #include <linux/i2c.h>
+#include <linux/iio/consumer.h>
 #include <linux/minmax.h>
 #include <linux/mod_devicetable.h>
 #include <linux/module.h>
@@ -35,6 +42,8 @@
 #include <linux/regmap.h>
 #include <linux/workqueue.h>
 
+#include "sm5703_charger_policy.h"
+
 #define SM5703_FG_REG_DEVICE_ID		0x00
 #define SM5703_FG_REG_CNTL		0x01
 #define SM5703_FG_REG_SOC		0x05
@@ -89,8 +98,12 @@
 #define SM5703_FG_STATUS_SAMPLES	3
 #define SM5703_FG_CHECK_INTERVAL	msecs_to_jiffies(10000)
 
+/* Thermistor readings taken per temperature report; the extremes go */
+#define SM5703_FG_TEMP_SAMPLES		5
+
 struct sm5703_fg {
 	struct regmap *regmap;
+	struct iio_channel *thermistor;
 	struct power_supply *psy;
 	struct delayed_work poll_work;
 	int last_capacity;
@@ -202,8 +215,11 @@ static int sm5703_fg_get_status(struct sm5703_fg *fg, int *capacity,
 
 /*
  * Temperature of the gauge's own sensor, in 0.1 degree C, as in
- * sm5703_get_temperature().  It is only measured once the stock driver
- * has set ENABLE_TEMP_MEASURE, so report nothing otherwise.
+ * sm5703_get_temperature().  The sensor reads the chip, not the battery:
+ * it is 10 to 20 degC above the battery under charge, so the battery
+ * temperature itself is read from the thermistor below.  It is only
+ * measured once the stock driver has set ENABLE_TEMP_MEASURE, so report
+ * nothing otherwise.
  */
 static int sm5703_fg_get_temp(struct sm5703_fg *fg, int *temp)
 {
@@ -229,6 +245,47 @@ static int sm5703_fg_get_temp(struct sm5703_fg *fg, int *temp)
 	return 0;
 }
 
+/*
+ * Battery temperature from the thermistor, in 0.1 degree C: 5 raw
+ * readings, the smallest and largest dropped, the rest averaged and
+ * converted with the stock table.  Anything else falls back to the
+ * gauge's own (hotter) sensor, and the caller warns once.
+ */
+static int sm5703_fg_get_batt_temp(struct sm5703_fg *fg, int *temp)
+{
+	int samples[SM5703_FG_TEMP_SAMPLES];
+	int sum = 0, deci_c;
+	int i, min_s, max_s;
+
+	if (!fg->thermistor)
+		return -ENODATA;
+
+	for (i = 0; i < SM5703_FG_TEMP_SAMPLES; i++) {
+		/* IIO_VAL_INT, not 0, on success */
+		if (iio_read_channel_raw(fg->thermistor, &samples[i]) < 0)
+			return -ENODATA;
+	}
+
+	min_s = samples[0];
+	max_s = samples[0];
+	for (i = 0; i < SM5703_FG_TEMP_SAMPLES; i++) {
+		if (samples[i] < min_s)
+			min_s = samples[i];
+		if (samples[i] > max_s)
+			max_s = samples[i];
+		sum += samples[i];
+	}
+	sum -= min_s + max_s;
+	sum /= SM5703_FG_TEMP_SAMPLES - 2;
+
+	if (!sm5703_thermistor_deci_c(sum, &deci_c))
+		return -ENODATA;
+
+	*temp = deci_c;
+
+	return 0;
+}
+
 static int sm5703_fg_get_property(struct power_supply *psy,
 				  enum power_supply_property psp,
 				  union power_supply_propval *val)
@@ -257,6 +314,13 @@ static int sm5703_fg_get_property(struct power_supply *psy,
 	case POWER_SUPPLY_PROP_CURRENT_NOW:
 		return sm5703_fg_get_current(fg, &val->intval);
 	case POWER_SUPPLY_PROP_TEMP:
+		if (!sm5703_fg_get_batt_temp(fg, &val->intval))
+			return 0;
+
+		dev_warn_once(&psy->dev,
+			      "battery thermistor unreadable, reporting the gauge sensor's temperature\n");
+		return sm5703_fg_get_temp(fg, &val->intval);
+	case POWER_SUPPLY_PROP_TEMP_AMBIENT:
 		return sm5703_fg_get_temp(fg, &val->intval);
 	default:
 		return -EINVAL;
@@ -272,6 +336,7 @@ static enum power_supply_property sm5703_fg_props[] = {
 	POWER_SUPPLY_PROP_VOLTAGE_OCV,
 	POWER_SUPPLY_PROP_CURRENT_NOW,
 	POWER_SUPPLY_PROP_TEMP,
+	POWER_SUPPLY_PROP_TEMP_AMBIENT,
 };
 
 static const struct power_supply_desc sm5703_fg_desc = {
@@ -402,6 +467,23 @@ static int sm5703_fg_probe(struct i2c_client *client)
 		dev_warn(dev,
 			 "battery model not loaded, readings are unreliable until the stock driver initialises the gauge\n");
 
+	/*
+	 * The battery thermistor on the exynos ADC.  A device tree without it
+	 * (-ENODEV) is not an error: TEMP then stays on the gauge's sensor.
+	 */
+	fg->thermistor = devm_iio_channel_get(dev, "batt-temp");
+	if (IS_ERR(fg->thermistor)) {
+		ret = PTR_ERR(fg->thermistor);
+		if (ret == -EPROBE_DEFER)
+			return dev_err_probe(dev, ret,
+					     "batt-temp channel not yet ready\n");
+		if (ret != -ENODEV)
+			dev_warn(dev,
+				 "no batt-temp channel, falling back to the gauge sensor for the battery temperature (%d)\n",
+				 ret);
+		fg->thermistor = NULL;
+	}
+
 	/* The first reading is reported as is, the poll work debounces later ones */
 	if (sm5703_fg_get_status(fg, &capacity, &fg->status))
 		fg->status = POWER_SUPPLY_STATUS_UNKNOWN;
-- 
2.52.0

