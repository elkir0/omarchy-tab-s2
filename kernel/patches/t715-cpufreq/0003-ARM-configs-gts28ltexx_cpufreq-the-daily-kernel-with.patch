diff --git a/arch/arm/configs/gts28ltexx_cpufreq.config b/arch/arm/configs/gts28ltexx_cpufreq.config
new file mode 100644
index 000000000..99aa33e05
--- /dev/null
+++ b/arch/arm/configs/gts28ltexx_cpufreq.config
@@ -0,0 +1,43 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# The daily candidate with CPU frequency scaling (docs/hardware/CPUFREQ.md in
+# the omarchy-tab-s2 repository: stage 1 passed on 2026-11-03, the owner's
+# answer in section 11). Merged on top of gts28ltexx_defconfig
+# (kernel/kbuild-mainline.sh --fragment gts28ltexx_cpufreq.config), for the
+# board's exynos5433-gts28ltexx-cpufreq.dtsi. Takes the place of
+# gts28ltexx_modem.config: one fragment per build, so its lines come first,
+# unchanged.
+
+# --- gts28ltexx_modem.config ---
+# SPI core built in for the SS333 boot link; the controller, MIPI-LLI and
+# modem_v1 as modules that shannon-loader inserts (see that fragment).
+CONFIG_SPI=y
+CONFIG_SPI_S3C64XX=m
+CONFIG_MIPI_LLI=m
+CONFIG_SEC_MODEM_V1=m
+CONFIG_GPIO_SYSFS=y
+
+# --- CPU frequency scaling ---
+CONFIG_CPU_FREQ=y
+CONFIG_CPU_FREQ_STAT=y
+
+# schedutil by default: stage 1's idle run held the A53s at 400 MHz 95 % of
+# the time. userspace stays for cpufreq.sh's steps.
+CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
+CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
+CONFIG_CPU_FREQ_GOV_USERSPACE=y
+CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
+
+# A module, as in the test kernels: udev loads it from the root, after the
+# initramfs's watchdog guard, so a fault in it cannot loop the boot.
+CONFIG_CPUFREQ_DT=m
+
+# CPU cooling for the board's A53 maps.
+CONFIG_CPU_THERMAL=y
+CONFIG_CPU_FREQ_THERMAL=y
+
+# The soak's detectors (CPUFREQ.md section 9, 1f): a lockup or a hung task is
+# reported in the log. They only panic if their sysctls ask for it.
+CONFIG_DEBUG_KERNEL=y
+CONFIG_SOFTLOCKUP_DETECTOR=y
+CONFIG_DETECT_HUNG_TASK=y
