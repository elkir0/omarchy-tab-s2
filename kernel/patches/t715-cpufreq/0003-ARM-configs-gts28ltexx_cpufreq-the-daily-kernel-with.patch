@@ -831,7 +831,7 @@ poweroff: syscon-poweroff {
 /* TMUs and trips (docs/THERMAL.md); CPU cooling in the next file. */
 #include "exynos5433-gts28ltexx-thermal.dtsi"
 
-/* CPU frequency scaling, stage 1: test kernels only (docs/hardware/CPUFREQ.md). */
+/* CPU frequency scaling: the A53 levels, the A57s held at 1.2 GHz (docs/hardware/CPUFREQ.md). */
 #include "exynos5433-gts28ltexx-cpufreq.dtsi"
 
