From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: elkir0 <elkir0@users.noreply.github.com>
Date: Tue, 3 Nov 2026 12:00:00 +0000
Subject: [PATCH 1/3] ARM: dts: gts28ltexx: A53 frequency scaling, test kernels
 only

The A53s scale from 400 MHz to 1.2 GHz at this chip's own voltages (ASV
group 1, as the stock kernel logged them at every boot), 875 000 to
1 162 500 uV, without 700 MHz (mainline's PLL entry differs from
stock's) and without 1.3 GHz.  The SoC's tables are deleted: they sit
25-75 mV under this chip at the same clock.

The A57s get a single level, the 1.2 GHz and 1 062 500 uV they run
today, because their body bias and EMA are not stock's and that state is
proven at 1.2 GHz only.  cpufreq-dt needs a table on every possible CPU,
so they get a policy that cannot move, and BUCK2 is held at that
voltage.  BUCK3 cannot leave the A53 range, whatever a table says.

The new tables need names of their own: exynos5433-bus.dtsi already has
opp-table-2 to opp-table-6 at the root, and a node of the same name
merges into it.

The SoC's cooling maps go.  Each zone throttles the A53s alone at
stock's thresholds: apollo 81 C to 1.0 GHz and 86 C down to 0.4 GHz,
atlas0 and atlas1 95 and 100 C.

Passed on the tablet on 2026-11-03 in image mode with the CP off: every
level under hash load, a 10 minute storm between 400 MHz and 1.2 GHz,
and the throttle under emul_temp.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../exynos5433-gts28ltexx-cpufreq.dtsi        | 264 ++++++++++++++++++
 .../dts/samsung/exynos5433-gts28ltexx.dts     |   5 +-
 2 files changed, 268 insertions(+), 1 deletion(-)
 create mode 100644 arch/arm/boot/dts/samsung/exynos5433-gts28ltexx-cpufreq.dtsi

diff --git a/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx-cpufreq.dtsi b/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx-cpufreq.dtsi
new file mode 100644
index 000000000..847b9532b
--- /dev/null
+++ b/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx-cpufreq.dtsi
@@ -0,0 +1,264 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Samsung Galaxy Tab S2 8.0 LTE (SM-T715), Exynos5433 - CPU frequency
+ * scaling, stage 1 for the A53s (docs/hardware/CPUFREQ.md in the
+ * omarchy-tab-s2 repository).
+ *
+ * TEST KERNELS ONLY, with gts28ltexx_cpufreq_test.config: cpufreq-dt is a
+ * module, blacklisted at boot (t715.modblacklist=cpufreq_dt) and loaded by
+ * hand, so a bad table cannot hang the boot before the initramfs guard
+ * (CPUFREQ.md section 8.3).
+ *
+ * The voltages are this chip's, not the SoC's: ASV table version 8, group 1,
+ * as the stock kernel logged them at every boot of this tablet (CPUFREQ.md
+ * section 3.2). The SoC dtsi's tables are 25-75 mV under them at the same
+ * clock, so they are deleted, and no OPP above this stage's cap exists at
+ * all. These tables must not go to another unit unchanged (risk 9).
+ *
+ * A53 (cpu0-3, vdd_kfc on BUCK3): 400 MHz to 1.2 GHz. 700 MHz is left out:
+ * mainline's PLL entry differs from stock's (P = 3 against 6, CPUFREQ.md
+ * section 2.2). 1.3 GHz is left out: +8 % clock for +18 % power (section 4).
+ * The A53 ABB reads bypass, as stock writes it at every level, and stock has
+ * no EMA control on this cluster (asv-exynos5433_cal.c:505-516 is ATLAS
+ * only), so the lower levels run the cluster in stock's own state.
+ *
+ * A57 (cpu4-7, vdd_eagle on BUCK2): one level, the 1.2 GHz and 1 062 500 uV
+ * the cluster runs today. Not lower: the A57 ABB reads bypass and EMA 2, not
+ * stock's level 8 and EMA 3 (P0, decision D7), a state proven at 1.2 GHz
+ * only. cpufreq-dt needs a table on every possible CPU (an empty one fails
+ * dt_cpufreq_early_init(), and with it the whole probe), so the A57s get a
+ * policy that cannot move.
+ *
+ * cpu-supply comes with the tables: without it the OPP core changes the
+ * clock and never the voltage (CPUFREQ.md section 2.3). cpu1-3 and cpu5-7
+ * share their cluster's table (opp-shared), so the supply on cpu0 and cpu4
+ * covers them, as on TM2 (exynos5433-tm2-common.dtsi).
+ *
+ * clock-latency-ns: stock's transition latency, 100 us
+ * (exynos-mp-cpufreq.c:1132). opp-suspend: the reboot and shutdown level,
+ * set by cpufreq_suspend() from device_shutdown() (CPUFREQ.md section 2.5).
+ */
+
+/delete-node/ &cluster_a53_opp_table;
+/delete-node/ &cluster_a57_opp_table;
+
+/*
+ * Node names of their own: exynos5433-bus.dtsi already has opp-table-2 to
+ * opp-table-6 at the root, and a node of the same name merges into it.
+ */
+/ {
+	cluster_a53_t715_opp_table: opp-table-t715-a53 {
+		compatible = "operating-points-v2";
+		opp-shared;
+
+		opp-400000000 {
+			opp-hz = /bits/ 64 <400000000>;
+			opp-microvolt = <875000>;
+			clock-latency-ns = <100000>;
+		};
+		opp-500000000 {
+			opp-hz = /bits/ 64 <500000000>;
+			opp-microvolt = <912500>;
+			clock-latency-ns = <100000>;
+		};
+		opp-600000000 {
+			opp-hz = /bits/ 64 <600000000>;
+			opp-microvolt = <937500>;
+			clock-latency-ns = <100000>;
+		};
+		opp-800000000 {
+			opp-hz = /bits/ 64 <800000000>;
+			opp-microvolt = <1000000>;
+			clock-latency-ns = <100000>;
+		};
+		opp-900000000 {
+			opp-hz = /bits/ 64 <900000000>;
+			opp-microvolt = <1025000>;
+			clock-latency-ns = <100000>;
+		};
+		opp-1000000000 {
+			opp-hz = /bits/ 64 <1000000000>;
+			opp-microvolt = <1087500>;
+			clock-latency-ns = <100000>;
+		};
+		opp-1100000000 {
+			opp-hz = /bits/ 64 <1100000000>;
+			opp-microvolt = <1125000>;
+			clock-latency-ns = <100000>;
+		};
+		opp-1200000000 {
+			opp-hz = /bits/ 64 <1200000000>;
+			opp-microvolt = <1162500>;
+			clock-latency-ns = <100000>;
+			opp-suspend;
+		};
+	};
+
+	cluster_a57_t715_opp_table: opp-table-t715-a57 {
+		compatible = "operating-points-v2";
+		opp-shared;
+
+		opp-1200000000 {
+			opp-hz = /bits/ 64 <1200000000>;
+			opp-microvolt = <1062500>;
+			clock-latency-ns = <100000>;
+			opp-suspend;
+		};
+	};
+};
+
+&cpu0 {
+	operating-points-v2 = <&cluster_a53_t715_opp_table>;
+	cpu-supply = <&buck3_reg>;
+};
+&cpu1 { operating-points-v2 = <&cluster_a53_t715_opp_table>; };
+&cpu2 { operating-points-v2 = <&cluster_a53_t715_opp_table>; };
+&cpu3 { operating-points-v2 = <&cluster_a53_t715_opp_table>; };
+
+&cpu4 {
+	operating-points-v2 = <&cluster_a57_t715_opp_table>;
+	cpu-supply = <&buck2_reg>;
+};
+&cpu5 { operating-points-v2 = <&cluster_a57_t715_opp_table>; };
+&cpu6 { operating-points-v2 = <&cluster_a57_t715_opp_table>; };
+&cpu7 { operating-points-v2 = <&cluster_a57_t715_opp_table>; };
+
+/*
+ * The rails cannot leave this stage's range, whatever a table says
+ * (CPUFREQ.md section 2.3, "Rail limit"): BUCK3 from the lowest A53 level to
+ * the highest, BUCK2 held where it is. Both ranges contain the voltage sboot
+ * leaves (B2OUT 0x6a, B3OUT 0x7a, P5), so the regulator core changes nothing
+ * at probe.
+ */
+&buck2_reg {
+	regulator-min-microvolt = <1062500>;
+	regulator-max-microvolt = <1062500>;
+};
+
+&buck3_reg {
+	regulator-min-microvolt = <875000>;
+	regulator-max-microvolt = <1162500>;
+};
+
+/*
+ * CPU cooling (CPUFREQ.md section 5.2), A53 rows only: the A57 policy has a
+ * single level, so it has nothing to give.
+ *
+ * The SoC's maps go first: seven "active" trips from 65 C with states
+ * numbered for the SoC's tables (exynos5433-tmu.dtsi), which would take the
+ * A53s down 15 C before stock's first step. Their trips stay, mapped to
+ * nothing, as they are today.
+ *
+ * A53 states: 0 = 1.2 GHz, 1 = 1.1, 2 = 1.0, 3 = 0.9, 4 = 0.8, 5 = 0.6,
+ * 6 = 0.5, 7 = 0.4 GHz.
+ *   apollo  81 C: down to 1.0 GHz, stock's KFC sensor above 80 C, which
+ *                 stock reads as 98 C, its 95 C row (exynos_thermal.c:991-996)
+ *   apollo  86 C: down to 0.4 GHz, stock's KFC above 85 C, read as 112 C,
+ *                 its 110 C row (exynos_thermal.c:997-1000); beside the
+ *                 board's "hot" trip at the same temperature, which only
+ *                 notifies
+ *   atlas   95 C: down to 1.0 GHz, stock's 95 C row (exynos5433.dtsi:2054-2085)
+ *   atlas  100 C: down to 0.4 GHz, stock's 100 C row
+ * Hysteresis 2 C, as the board's other trips (stock threshold_falling).
+ * step_wise takes the first state of a range at once, then one more per
+ * poll (100 ms while passive) only while the temperature rises; at a steady
+ * temperature it holds, and it gives states back one per poll as it falls
+ * (emul_temp on this tablet, 2026-11-03).
+ */
+&atlas0_thermal {
+	/delete-node/ cooling-maps;
+};
+
+&apollo_thermal {
+	/delete-node/ cooling-maps;
+};
+
+&apollo_thermal {
+	trips {
+		apollo_a53_1g: apollo-a53-1g {
+			temperature = <81000>;	/* millicelsius */
+			hysteresis = <2000>;	/* millicelsius */
+			type = "passive";
+		};
+
+		apollo_a53_min: apollo-a53-min {
+			temperature = <86000>;	/* millicelsius */
+			hysteresis = <2000>;	/* millicelsius */
+			type = "passive";
+		};
+	};
+
+	cooling-maps {
+		map-a53-1g {
+			trip = <&apollo_a53_1g>;
+			cooling-device = <&cpu0 0 2>, <&cpu1 0 2>,
+					 <&cpu2 0 2>, <&cpu3 0 2>;
+		};
+
+		map-a53-min {
+			trip = <&apollo_a53_min>;
+			cooling-device = <&cpu0 2 7>, <&cpu1 2 7>,
+					 <&cpu2 2 7>, <&cpu3 2 7>;
+		};
+	};
+};
+
+&atlas0_thermal {
+	trips {
+		atlas0_a53_1g: atlas0-a53-1g {
+			temperature = <95000>;	/* millicelsius */
+			hysteresis = <2000>;	/* millicelsius */
+			type = "passive";
+		};
+
+		atlas0_a53_min: atlas0-a53-min {
+			temperature = <100000>;	/* millicelsius */
+			hysteresis = <2000>;	/* millicelsius */
+			type = "passive";
+		};
+	};
+
+	cooling-maps {
+		map-a53-1g {
+			trip = <&atlas0_a53_1g>;
+			cooling-device = <&cpu0 0 2>, <&cpu1 0 2>,
+					 <&cpu2 0 2>, <&cpu3 0 2>;
+		};
+
+		map-a53-min {
+			trip = <&atlas0_a53_min>;
+			cooling-device = <&cpu0 2 7>, <&cpu1 2 7>,
+					 <&cpu2 2 7>, <&cpu3 2 7>;
+		};
+	};
+};
+
+&atlas1_thermal {
+	trips {
+		atlas1_a53_1g: atlas1-a53-1g {
+			temperature = <95000>;	/* millicelsius */
+			hysteresis = <2000>;	/* millicelsius */
+			type = "passive";
+		};
+
+		atlas1_a53_min: atlas1-a53-min {
+			temperature = <100000>;	/* millicelsius */
+			hysteresis = <2000>;	/* millicelsius */
+			type = "passive";
+		};
+	};
+
+	cooling-maps {
+		map-a53-1g {
+			trip = <&atlas1_a53_1g>;
+			cooling-device = <&cpu0 0 2>, <&cpu1 0 2>,
+					 <&cpu2 0 2>, <&cpu3 0 2>;
+		};
+
+		map-a53-min {
+			trip = <&atlas1_a53_min>;
+			cooling-device = <&cpu0 2 7>, <&cpu1 2 7>,
+					 <&cpu2 2 7>, <&cpu3 2 7>;
+		};
+	};
+};
diff --git a/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx.dts b/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx.dts
index 5356eb905..b5173848a 100644
--- a/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx.dts
+++ b/arch/arm/boot/dts/samsung/exynos5433-gts28ltexx.dts
@@ -828,9 +828,12 @@ poweroff: syscon-poweroff {
 	};
 };
 
-/* TMUs and trips (docs/THERMAL.md); no cpufreq cooling yet. */
+/* TMUs and trips (docs/THERMAL.md); CPU cooling in the next file. */
 #include "exynos5433-gts28ltexx-thermal.dtsi"
 
+/* CPU frequency scaling, stage 1: test kernels only (docs/hardware/CPUFREQ.md). */
+#include "exynos5433-gts28ltexx-cpufreq.dtsi"
+
 /* ==================================================================== */
 /* 10. Native display                                                   */
