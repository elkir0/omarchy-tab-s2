"""Run shannond from a checkout or from /usr/lib/shannond (package next to bin/)."""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))
from shannond.daemon import main  # noqa: E402

sys.exit(main())
