def build_dispatch(table=ENCODINGS):
    """First-level table indexed by bits 31:21 of the word: the rows that can
    match words with those top bits, in table order (None: no row can)."""
    rows = []
    for mask, value, key, _doc in table:
        if value & ~mask & 0xFFFFFFFF:
            raise AssertionError("value outside mask: %#x/%#x" % (mask, value))
        rows.append((mask, value, CLS[key]))
    dispatch = [None] * 2048
    for top in range(2048):
        hi = top << 21
        bucket = tuple(r for r in rows if (hi & r[0] & 0xFFE00000) == (r[1] & 0xFFE00000))
        if bucket:
            dispatch[top] = bucket
    return dispatch


DISPATCH = build_dispatch()


def classify_word(w):
    """Class key of one instruction word, or None (ARMv8.0 or unallocated)."""
    bucket = DISPATCH[w >> 21]
    if bucket:
        for mask, value, cls in bucket:
            if w & mask == value:
                return CLASS_KEYS[cls]
    return None


def scan_words(words, dispatch=DISPATCH):
    """Hot loop: [(word index, word, class index)] for every match."""
    hits = []
    add = hits.append
    for i, w in enumerate(words):
        bucket = dispatch[w >> 21]
        if bucket is not None:
            for mask, value, cls in bucket:
                if w & mask == value:
                    add((i, w, cls))
                    break
    return hits


# ---------------------------------------------------------------------------
# Outline atomics
# ---------------------------------------------------------------------------

# libgcc (-moutline-atomics), compiler-rt and Rust's compiler-builtins name
# their helpers __aarch64_<op><bytes>_<model>; each checks
# __aarch64_have_lse_atomics before using the LSE instruction.
OUTLINE_HELPER_RE = re.compile(
    rb"__aarch64_(?:cas|casp|swp|ldadd|ldclr|ldeor|ldset)(?:1|2|4|8|16)_(?:relax|acq|rel|acq_rel|sync)\Z")


def _is_ret(w):
    return (w & 0xFFFFFC1F) == 0xD65F0000


def _ends_block(w):
    # RET, BR, unconditional B, or zero/UDF padding
    return ((w & 0xFFFFFC1F) in (0xD65F0000, 0xD61F0000)
            or (w & 0xFC000000) == 0x14000000 or w == 0)


NOP = 0xD503201F


def _lse_size(w):
    """(is_pair, size bits) of an LSE word, to match the LL/SC fallback."""
    if (w & 0xBFA07C00) == 0x08207C00:      # CASP: sz in bit 30
        return True, (w >> 30) & 1
    return False, w >> 30


def flag_load_before(words, i):
    """Heuristic 1: the LSE word at i is at most 16 instructions after the
    __aarch64_have_lse_atomics test that libgcc, compiler-rt and Rust's
    compiler-builtins all emit with the IP0 register,
        ADRP X16, flag; LDRB W16, [X16, #:lo12:flag]; CBZ/CBNZ W16, fallback
    and is followed within 4 instructions by RET (the LSE fast path).
    Ordinary code testing a byte flag uses other registers and no RET."""
    for j in range(i - 1, max(0, i - 17), -1):
        if ((words[j] & 0xFFC003FF) == 0x39400210              # LDRB W16, [X16, #imm]
                and (words[j - 1] & 0x9F00001F) == 0x90000010  # ADRP X16
                and (words[j + 1] & 0x7E00001F) == 0x34000010):  # CBZ/CBNZ W16
            break
    else:
        return False
    return any(_is_ret(words[k]) for k in range(i + 1, min(len(words), i + 5)))


def small_llsc_function(words, i):
    """Heuristic 2: the LSE word at i sits in the first 8 instructions of a
    function shorter than 32 instructions that ends with an LL/SC loop of the
    same access size (LDXR/LDAXR ... STXR/STLXR, or the pair forms for CASP),
    then RET. The function starts after the previous RET/BR/B or padding."""
    n = len(words)
    start = None
    for j in range(i - 1, max(-1, i - 33), -1):
        if _ends_block(words[j]):
            start = j + 1
            break
    if start is None:
        if i > 32:
            return False
        start = 0
    while start < i and words[start] == NOP:
        start += 1
    if i - start >= 8:      # helpers: [BTI] ADRP LDRB CBZ [MOV] <LSE> - the LSE op comes first
        return False
    end = min(n, start + 31)
    pair, size = _lse_size(words[i])
    k = start
    while k < end:
        w = words[k]
        if pair:
            is_ldx = (w & 0xBFFF0000) == 0x887F0000 and ((w >> 30) & 1) == size
        else:
            is_ldx = (w & 0x3FFF7C00) == 0x085F7C00 and (w >> 30) == size
        if is_ldx:
            for m in range(k + 1, end):
                s = words[m]
                if pair:
                    is_stx = (s & 0xBFE00000) == 0x88200000
                else:
                    is_stx = (s & 0x3FE07C00) == 0x08007C00
                if is_stx:
                    for e in range(m + 1, end):
                        if _is_ret(words[e]):
                            return i < e
                    return False
        k += 1
    return False


# ---------------------------------------------------------------------------
# ELF parsing (64-bit little-endian only, by hand)
# ---------------------------------------------------------------------------

class NotElf(Exception):
    pass


class OtherArch(Exception):
    pass


class ElfError(Exception):
    pass


EM_AARCH64 = 183
ET_NAMES = {1: "REL", 2: "EXEC", 3: "DYN", 4: "CORE"}
SHT_SYMTAB, SHT_NOBITS, SHT_DYNSYM = 2, 8, 11
SHF_EXECINSTR = 0x4
PT_LOAD, PT_INTERP = 1, 3
PF_X = 0x1
SHN_UNDEF, SHN_LORESERVE, SHN_XINDEX = 0, 0xFF00, 0xFFFF


def _cstr(data, off, limit=None):
    if off < 0 or off >= len(data):
        return b""
    end = data.find(b"\0", off, limit if limit is not None else len(data))
    if end < 0:
        end = limit if limit is not None else len(data)
    return bytes(data[off:end])


class CodeRegion:
    """An executable section (or PT_LOAD segment) to decode."""
    __slots__ = ("index", "name", "vaddr", "offset", "size")

    def __init__(self, index, name, vaddr, offset, size):
        self.index, self.name, self.vaddr, self.offset, self.size = index, name, vaddr, offset, size


class Elf:
    def __init__(self, data):
        self.data = data
        size = len(data)
        if size < 4 or bytes(data[:4]) != b"\x7fELF":
            raise NotElf()
        if size < 20:
            raise ElfError("truncated ELF identification (%d bytes)" % size)
        ei_class, ei_data = data[4], data[5]
        if ei_data not in (1, 2):
            raise ElfError("bad EI_DATA %d" % ei_data)
        machine = struct.unpack_from("<H" if ei_data == 1 else ">H", data, 18)[0]
        if machine != EM_AARCH64 or ei_class != 2 or ei_data != 1:
            raise OtherArch("machine %d class %d data %d" % (machine, ei_class, ei_data))
        if size < 64:
            raise ElfError("truncated ELF header (%d bytes)" % size)
        (self.e_type, _m, _v, self.entry, phoff, shoff, _f, _ehs, phentsize, phnum,
         shentsize, shnum, shstrndx) = struct.unpack_from("<HHIQQQIHHHHHH", data, 16)
        self.type_name = ET_NAMES.get(self.e_type, "type%d" % self.e_type)

        # program headers
        self.segments = []
        if phoff and phnum:
            if phentsize < 56:
                raise ElfError("bad e_phentsize %d" % phentsize)
            if phoff + phnum * phentsize > size:
                raise ElfError("program header table beyond end of file")
            for k in range(phnum):
                self.segments.append(struct.unpack_from("<IIQQQQQQ", data, phoff + k * phentsize))
        self.has_interp = any(p[0] == PT_INTERP for p in self.segments)

        # section headers
        self.sections = []
        if shoff:
            if shentsize < 64:
                raise ElfError("bad e_shentsize %d" % shentsize)
            if shoff + shentsize > size:
                raise ElfError("section header table beyond end of file")
            if shnum == 0 or shstrndx == SHN_XINDEX:
                sec0 = struct.unpack_from("<IIQQQQIIQQ", data, shoff)
                if shnum == 0:
                    shnum = sec0[5]
                if shstrndx == SHN_XINDEX:
                    shstrndx = sec0[6]
            if shoff + shnum * shentsize > size:
                raise ElfError("section header table beyond end of file")
            for k in range(shnum):
                self.sections.append(struct.unpack_from("<IIQQQQIIQQ", data, shoff + k * shentsize))
        self.shstr = None
        if self.sections and 0 < shstrndx < len(self.sections):
            s = self.sections[shstrndx]
            if s[1] != SHT_NOBITS and s[4] + s[5] <= size:
                self.shstr = (s[4], s[4] + s[5])

    def section_name(self, k):
        if self.shstr is None:
            return "#%d" % k
        lo, hi = self.shstr
        return _cstr(self.data, lo + self.sections[k][0], hi).decode("latin-1") or "#%d" % k

    def code_regions(self):
        """Executable sections; PT_LOAD+PF_X segments when there are none."""
        regions = []
        size = len(self.data)
        for k, s in enumerate(self.sections):
            _name, sh_type, flags, addr, off, sz = s[:6]
            if not flags & SHF_EXECINSTR or sh_type == SHT_NOBITS or sz == 0:
                continue
            if off + sz > size:
                raise ElfError("section %s beyond end of file" % self.section_name(k))
            regions.append(CodeRegion(k, self.section_name(k), addr, off, sz))
        if self.sections:
            return regions, "sections"
        for k, p in enumerate(self.segments):
            p_type, p_flags, off, vaddr, _pa, filesz = p[:6]
            if p_type != PT_LOAD or not p_flags & PF_X or filesz == 0:
                continue
            if off + filesz > size:
                raise ElfError("PT_LOAD segment %d beyond end of file" % k)
            regions.append(CodeRegion(-1 - k, "LOAD#%d" % k, vaddr, off, filesz))
        if not regions:
            raise ElfError("no section headers and no executable PT_LOAD segment")
        return regions, "segments"

    def symbols(self, wanted):
        """Yield (table kind, name, value, size, shndx) for symbols whose name
        passes wanted(strtab, offset)."""
        size = len(self.data)
        for k, s in enumerate(self.sections):
            sh_type = s[1]
            if sh_type not in (SHT_SYMTAB, SHT_DYNSYM):
                continue
            off, sz, link, entsize = s[4], s[5], s[6], s[9]
            if entsize != 24 or off + sz > size or not 0 < link < len(self.sections):
                continue
            st = self.sections[link]
            if st[4] + st[5] > size:
                continue
            strtab = bytes(self.data[st[4]:st[4] + st[5]])
            if not wanted(strtab, None):
                continue
            kind = "symtab" if sh_type == SHT_SYMTAB else "dynsym"
            raw = bytes(self.data[off:off + sz - sz % 24])
            for st_name, _info, _other, shndx, value, ssize in struct.iter_unpack("<IBBHQQ", raw):
                if st_name and wanted(strtab, st_name):
                    yield kind, _cstr(strtab, st_name), value, ssize, shndx

    def has_symtab(self):
        return any(s[1] == SHT_SYMTAB and s[5] for s in self.sections)


# ---------------------------------------------------------------------------
# Per-file analysis
# ---------------------------------------------------------------------------

def _region_of(regions, elf, shndx, value):
    """(region, offset in region) of a symbol, or (None, None)."""
    if elf.e_type == 1:                               # ET_REL: section-relative
        for r in regions:
            if r.index == shndx:
                return r, value
        return None, None
    for r in regions:
        if r.vaddr <= value < r.vaddr + r.size:
            return r, value - r.vaddr
    return None, None


def _want_helpers_or_mapping(strtab, off):
    if off is None:
        return b"__aarch64_" in strtab or b"$d" in strtab or b"$x" in strtab
    c = strtab[off] if off < len(strtab) else 0
    if c == 0x24:                                     # '$'
        return strtab.startswith((b"$d", b"$x"), off)
    return strtab.startswith(b"__aarch64_", off)


def analyse_elf(elf, max_faults):
    regions, source = elf.code_regions()

    # symbols: outline helpers and "$d"/"$x" mapping symbols
    helpers = {}            # region index -> [(lo, hi)] byte offsets
    mapping = {}            # region index -> [(offset, is_data)]
    helper_names = set()
    if source == "sections":
        for _kind, name, value, ssize, shndx in elf.symbols(_want_helpers_or_mapping):
            if shndx == SHN_UNDEF or shndx >= SHN_LORESERVE:
                continue                              # undefined, absolute, common, xindex
            r, off = _region_of(regions, elf, shndx, value)
            if r is None:
                continue
            if name.startswith(b"$"):
                if name[:2] in (b"$d", b"$x") and (len(name) == 2 or name[2:3] == b"."):
                    mapping.setdefault(r.index, []).append((off, name[1:2] == b"d"))
            elif OUTLINE_HELPER_RE.match(name):
                helpers.setdefault(r.index, []).append((off, off + (ssize or 128)))
                helper_names.add(name.decode("latin-1"))
    use_heuristic = not elf.has_symtab()

    counts = [0] * len(CLASS_KEYS)
    lse_inline = lse_safe = lse_probable = 0
    faults = []             # (vaddr, file offset, section, word, class)
    n_words = 0
    for r in regions:
        nbytes = r.size - r.size % 4
        words = array.array("I")
        if words.itemsize != 4:
            words = array.array("L")
        words.frombytes(bytes(elf.data[r.offset:r.offset + nbytes]))
        if sys.byteorder != "little":
            words.byteswap()
        n_words += len(words)
        # blank data ranges named by "$d" mapping symbols
        marks = sorted(mapping.get(r.index, ()))
        for k, (off, is_data) in enumerate(marks):
            if is_data:
                hi = marks[k + 1][0] if k + 1 < len(marks) else nbytes
                lo_w, hi_w = (off + 3) // 4, min(len(words), hi // 4)
                if hi_w > lo_w:
                    words[lo_w:hi_w] = array.array(words.typecode, bytes(4 * (hi_w - lo_w)))
        ranges = helpers.get(r.index, ())
        for i, w, cls in scan_words(words):
            counts[cls] += 1
            if cls == LSE:
                off = i * 4
                if any(lo <= off < hi for lo, hi in ranges):
                    lse_safe += 1
                    continue
                if use_heuristic and (flag_load_before(words, i) or small_llsc_function(words, i)):
                    lse_probable += 1
                    continue
                lse_inline += 1
            if IS_FAULT[cls]:
                faults.append((r.vaddr + i * 4, r.offset + i * 4, r.name, w, CLASS_KEYS[cls]))

    faults.sort()
    nfaults = len(faults)
    if max_faults:
        faults = faults[:max_faults]
    return {
        "type": elf.type_name,
        "code_from": source,
        "words": n_words,
        "counts": {k: counts[i] for i, k in enumerate(CLASS_KEYS)},
        "lse": {"inline": lse_inline, "outline_safe": lse_safe, "outline_probable": lse_probable},
        "outline_mode": "symbols" if not use_heuristic else "heuristic",
        "outline_helpers": sorted(helper_names),
        "fault_count": nfaults,
        "faults": [{"vaddr": "%#x" % va, "offset": "%#x" % fo, "section": sec,
                    "encoding": "%#010x" % w, "class": c} for va, fo, sec, w, c in faults],
        "executable": elf.e_type == 2 or (elf.e_type == 3 and elf.has_interp),
    }


def _open_data(path):
    with open(path, "rb") as f:
        try:
            return mmap.mmap(f.fileno(), 0, access=mmap.ACCESS_READ)
        except (ValueError, OSError):
            return f.read()


def check_file(path, display, opts, stats):
    """Analyse one file; returns a result dict or None when skipped."""
    try:
        data = _open_data(path)
    except OSError as e:
        stats["error"] += 1
        return {"path": display, "verdict": "ERROR", "error": "cannot read: %s" % e.strerror}
    t0 = time.monotonic()
    try:
        try:
            elf = Elf(data)
            res = analyse_elf(elf, opts.faults)
        except NotElf:
            stats["skipped_non_elf"] += 1
            return None
        except OtherArch:
            stats["skipped_other_arch"] += 1
            return None
        except (ElfError, struct.error, ValueError, IndexError, OverflowError, MemoryError) as e:
            stats["error"] += 1
            return {"path": display, "verdict": "ERROR", "error": str(e) or e.__class__.__name__}
    finally:
        if isinstance(data, mmap.mmap):
            data.close()
    res["seconds"] = round(time.monotonic() - t0, 3)
    res = dict({"path": display, "verdict": "RISK" if res["fault_count"] else "OK"}, **res)
    stats["risk" if res["fault_count"] else "ok"] += 1
    if opts.run and res["executable"]:
        res["run"] = run_program(path)
        if res["run"]["signal"] == "SIGILL":
            stats["sigill"] += 1
        elif res["run"]["signal"] == "SIGSEGV":
            stats["sigsegv"] += 1
    return res


