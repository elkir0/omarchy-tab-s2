# Output
# ---------------------------------------------------------------------------

def format_line(res):
    if res["verdict"] == "ERROR":
        return "ERROR %s  %s" % (res["path"], res["error"])
    c, lse = res["counts"], res["lse"]
    parts = ["lse=%d(inline)/%d(outline)" % (lse["inline"], lse["outline_safe"] + lse["outline_probable"])]
    if lse["outline_probable"]:
        parts.append("outline=heuristic")
    for k in CLASS_KEYS:
        if k != "lse" and c[k]:
            parts.append("%s=%d%s" % (k, c[k], "(hint,harmless)" if k == "pac_bti" else ""))
    if res["code_from"] == "segments":
        parts.append("code=PT_LOAD")
    lines = ["%-5s %s  %s" % (res["verdict"], res["path"], " ".join(parts))]
    for f in res["faults"]:
        if res["type"] == "REL":
            where = "%s+%#x" % (f["section"], int(f["vaddr"], 16))
        else:
            where = "%s (file %s)" % (f["vaddr"], f["offset"])
        lines.append("      fault %s %s %s" % (where, f["encoding"], f["class"]))
    if res["fault_count"] > len(res["faults"]):
        lines.append("      ... %d more" % (res["fault_count"] - len(res["faults"])))
    run = res.get("run")
    if run:
        lines.append("      run %s: %s%s" % (run["arg"], run["status"],
                                             (" (%s)" % run["error"]) if run.get("error") else ""))
    return "\n".join(lines)


def main(argv=None):
    ap = argparse.ArgumentParser(
        prog="t715-isa-audit",
        description="Find instructions newer than ARMv8.0-A in AArch64 ELF files "
                    "(the SM-T715 CPU: fp asimd aes pmull sha1 sha2 crc32).")
    ap.add_argument("paths", metavar="PATH", nargs="+",
                    help="ELF file, directory, or Arch package (*.pkg.tar.zst/.xz/.gz)")
    ap.add_argument("--json", action="store_true", help="print one JSON document")
    ap.add_argument("--run", action="store_true",
                    help="also run each executable once with --version (then --help), "
                         "10 s timeout, and report SIGILL/SIGSEGV")
    ap.add_argument("--faults", type=int, default=3, metavar="N",
                    help="fault addresses listed per RISK file (default 3, 0 = all)")
    opts = ap.parse_args(argv)
    if opts.faults < 0:
        ap.error("--faults must be >= 0")
    missing = [p for p in opts.paths if not os.path.lexists(p)]
    if missing:
        ap.error("no such file or directory: %s" % ", ".join(missing))

    warnings = []
    if opts.run:
        w = target_cpu_warning()
        if w:
            warnings.append(w)
            if not opts.json:
                print("warning: " + w, file=sys.stderr)

    stats = {"ok": 0, "risk": 0, "error": 0, "skipped_non_elf": 0, "skipped_other_arch": 0,
             "sigill": 0, "sigsegv": 0}
    results = []
    t0 = time.monotonic()

    def emit(res):
        if res is None:
            return
        if opts.json:
            results.append(res)
        else:
            print(format_line(res), flush=True)

    for p in opts.paths:
        check_path(p, opts, stats, emit)

    elapsed = time.monotonic() - t0
    checked = stats["ok"] + stats["risk"] + stats["error"]
    skipped = stats["skipped_non_elf"] + stats["skipped_other_arch"]
    failed = stats["risk"] > 0 or (opts.run and stats["sigill"] > 0)
    if opts.json:
        doc = {
            "tool": "t715-isa-audit",
            "baseline": "armv8.0-a (fp asimd aes pmull sha1 sha2 crc32)",
            "classes": {k: d for k, d, _f in CLASSES},
            "files": results,
            "summary": dict(checked=checked, skipped=skipped, seconds=round(elapsed, 3), **stats),
            "warnings": warnings,
        }
        json.dump(doc, sys.stdout, indent=1)
        sys.stdout.write("\n")
    else:
        line = ("summary: checked=%d ok=%d risk=%d error=%d skipped=%d (non-elf=%d other-arch=%d)"
                % (checked, stats["ok"], stats["risk"], stats["error"], skipped,
                   stats["skipped_non_elf"], stats["skipped_other_arch"]))
        if opts.run:
            line += " sigill=%d sigsegv=%d" % (stats["sigill"], stats["sigsegv"])
        line += " time=%.1fs" % elapsed
        print(line)
    return 1 if failed else 0


if __name__ == "__main__":
    try:
        status = main()
        sys.stdout.flush()
    except KeyboardInterrupt:
        status = 130
    except BrokenPipeError:                       # e.g. piped into head
        try:
            os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        except OSError:
            pass
        status = 1
    sys.exit(status)
