def target_cpu_warning():
    try:
        with open("/proc/cpuinfo", encoding="latin-1") as f:
            text = f.read()
    except OSError:
        return "no /proc/cpuinfo here: --run only means something on the ARMv8.0 tablet"
    feats = set()
    for line in text.splitlines():
        if line.lower().startswith("features") and ":" in line:
            feats.update(line.split(":", 1)[1].split())
    if not feats:
        return "/proc/cpuinfo has no Features line: --run only means something on the ARMv8.0 tablet"
    if "atomics" in feats:
        return ("this CPU has LSE ('atomics' in /proc/cpuinfo): newer instructions do not fault "
                "here, --run only means something on the ARMv8.0 tablet")
    return None


def _run_once(path, arg, home, env):
    try:
        proc = subprocess.Popen([path, arg], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                stderr=subprocess.DEVNULL, cwd=home, env=env, start_new_session=True)
    except OSError as e:
        return {"arg": arg, "status": "exec-error", "error": e.strerror or str(e), "signal": None}
    try:
        rc = proc.wait(timeout=10)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except OSError:
            proc.kill()
        proc.wait()
        return {"arg": arg, "status": "timeout", "signal": None}
    if rc < 0:
        try:
            name = signal.Signals(-rc).name
        except ValueError:
            name = "signal %d" % -rc
        return {"arg": arg, "status": name, "signal": name}
    # A launcher that re-executes the program (Electron, a shell wrapper) reports
    # its child's fatal signal as an exit code 128 + N: a crash all the same.
    if rc - 128 in CRASH_SIGNALS:
        name = signal.Signals(rc - 128).name
        return {"arg": arg, "status": "%s (exit %d)" % (name, rc), "exit": rc, "signal": name}
    return {"arg": arg, "status": "exit %d" % rc, "exit": rc, "signal": None}


CRASH_SIGNALS = {int(signal.SIGILL), int(signal.SIGSEGV), int(signal.SIGBUS), int(signal.SIGABRT),
                 int(signal.SIGTRAP), int(signal.SIGFPE)}


def cores_since(path, since):
    """Core dumps systemd-coredump recorded since `since` (epoch seconds) for `path`
    itself (a launcher that re-executes itself, as Electron does, crashes under the
    same path): [(exe, signal)]. Other programs of the same directory are not
    counted: their cores belong to their own run. Empty where coredumpctl is
    missing or answers nothing."""
    try:
        p = subprocess.run(["coredumpctl", "--no-pager", "--json=short", "list",
                            "--since=@%d" % int(since)],
                           stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=20)
        records = json.loads(p.stdout) if p.returncode == 0 and p.stdout.strip() else []
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return []
    out = []
    for r in records if isinstance(records, list) else []:
        exe = str(r.get("exe") or "")
        if exe == os.path.abspath(path):
            try:
                name = signal.Signals(int(r.get("sig"))).name
            except (TypeError, ValueError):
                name = "signal %s" % r.get("sig")
            out.append((exe, name))
    return out


def run_program(path):
    home = tempfile.mkdtemp(prefix="t715-isa-audit-home-")
    env = {k: v for k, v in os.environ.items() if k not in ("DISPLAY", "WAYLAND_DISPLAY", "HOME")}
    env["HOME"] = home
    since = time.time()
    try:
        res = _run_once(os.path.abspath(path), "--version", home, env)
        if res.get("exit", 0) != 0 and not res.get("signal"):
            res = _run_once(os.path.abspath(path), "--help", home, env)
            res["after"] = "--version exited non-zero"
        cores = cores_since(path, since)
        if cores:
            res["cores"] = ["%s %s" % (sig, exe) for exe, sig in cores]
            if not res.get("signal"):
                res["signal"] = cores[0][1]
                res["status"] = "%s (core dump of %s)" % (cores[0][1], os.path.basename(cores[0][0]))
        return res
    finally:
        shutil.rmtree(home, ignore_errors=True)


# ---------------------------------------------------------------------------
# Walking paths and packages
# ---------------------------------------------------------------------------

PKG_SUFFIXES = (".pkg.tar.zst", ".pkg.tar.xz", ".pkg.tar.gz")


def _last_line(stderr, rc):
    lines = stderr.decode("utf-8", "replace").strip().splitlines()
    return lines[-1] if lines else "exit %d" % rc


def extract_package(pkg, dest):
    """Extract an Arch package with bsdtar, else tar (else zstd -dc | tar for
    a tar without zstd support); returns an error message or None."""
    errors = []
    for prog in ("bsdtar", "tar"):
        if shutil.which(prog):
            p = subprocess.run([prog, "-xf", pkg, "-C", dest], stdin=subprocess.DEVNULL,
                               stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
            if p.returncode == 0:
                return None
            errors.append(_last_line(p.stderr, p.returncode))
    if pkg.endswith(".zst") and shutil.which("zstd") and shutil.which("tar"):
        unz = subprocess.Popen(["zstd", "-dcq", "--", pkg], stdin=subprocess.DEVNULL,
                               stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        p = subprocess.run(["tar", "-xf", "-", "-C", dest], stdin=unz.stdout,
                           stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
        unz.stdout.close()
        unz_err = unz.stderr.read()
        unz.stderr.close()
        if unz.wait() == 0 and p.returncode == 0:
            return None
        errors.append(_last_line(unz_err, unz.returncode) if unz.returncode
                          else _last_line(p.stderr, p.returncode))
    if not errors:
        return "cannot extract: neither bsdtar nor tar found"
    return "cannot extract: %s" % errors[0]


def walk(top):
    """Regular files under top, sorted, symlinks neither followed nor listed."""
    for root, dirs, files in os.walk(top, followlinks=False):
        dirs.sort()
        for name in sorted(files):
            p = os.path.join(root, name)
            try:
                st = os.lstat(p)
            except OSError:
                continue
            if stat.S_ISREG(st.st_mode):
                yield p


def check_path(path, opts, stats, emit):
    if os.path.isdir(path):
        for p in walk(path):
            emit(check_file(p, p, opts, stats))
    elif path.endswith(PKG_SUFFIXES):
        tmp = tempfile.mkdtemp(prefix="t715-isa-audit-pkg-")
        try:
            err = extract_package(path, tmp)
            if err:
                stats["error"] += 1
                emit({"path": path, "verdict": "ERROR", "error": err})
                return
            for p in walk(tmp):
                emit(check_file(p, path + "::" + os.path.relpath(p, tmp), opts, stats))
        finally:
            shutil.rmtree(tmp, ignore_errors=True)
    else:
        emit(check_file(path, path, opts, stats))


