#!/usr/bin/env bash
# build-pkg — build pkg/NAME/PKGBUILD for aarch64 with makepkg and publish
# the result in the local pacman repository out/repo/aarch64
# (t715-omarchy.db), next to Omarchy's packages (tools/fetch-omarchy).
# Adapted from omarchy-tab-s2/image/tools/build-pkg, which does the
# same for armv7h under qemu. Here the container is native arm64.
#
# Usage:
#   build-pkg NAME [--force] [-h|--help]
#     NAME     a directory pkg/NAME/ holding a PKGBUILD and its local sources
#     --force  rebuild and republish even if the repository already holds this version
#
# Everything runs in the dev image (lib/common.sh): full upgrade, the build
# dependencies installed with pacman (ALARM's aarch64 repositories, plus
# [t715-omarchy] before [core] when it exists), then makepkg as the
# unprivileged user "builder". Sources are downloaded inside the container
# into cache/srcdest and checked by makepkg on
# every build. Before publication each package file is checked in the
# container: .PKGINFO matches its file name, every ELF file is a 64-bit
# little-endian AArch64 one (arch = aarch64) and an arch = any package holds
# none. The macOS host only moves whole package files (out/repo/aarch64/).
#
# Idempotent: without --force, if MANIFEST-built.tsv already records the files
# this PKGBUILD version produces, with matching sha256, and t715-omarchy.db
# lists them, nothing is built and nothing is written. Older files of NAME's
# packages are removed from the repository; Omarchy's packages are never
# touched (they belong to tools/fetch-omarchy).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/common.sh
. "$SCRIPT_DIR/../lib/common.sh"
LOG_TAG=build-pkg

NAME=""
FORCE=0
while [ $# -gt 0 ]; do
    case "$1" in
        --force)   FORCE=1; shift ;;
        -h|--help) sed -n '2,28p' "${BASH_SOURCE[0]}"; exit 0 ;;
        -*)        die "unknown option: $1 (see --help)" ;;
        *)         [ -z "$NAME" ] || die "only one NAME at a time (see --help)"
                   NAME="$1"; shift ;;
    esac
done
[ -n "$NAME" ] || die "missing NAME (see --help)"
[[ "$NAME" =~ ^[a-z0-9@_+][a-z0-9@._+-]*$ ]] || die "invalid package directory name: $NAME"

PKG_DIR="$ROOTFS_DIR/pkg/$NAME"
[ -f "$PKG_DIR/PKGBUILD" ] || die "no $PKG_DIR/PKGBUILD"

REPO_OUT="$REPO_DIR"
BUILT="$REPO_OUT/MANIFEST-built.tsv"
PKG_CACHE="$CACHE_DIR/pkg/$ARCH"
WORK="$CACHE_DIR/build-pkg/$NAME"
SRC_VOLUME="$SRCDEST_DIR"
PACKAGER_ID="SM-T715 arm64 build-pkg <noreply@localhost>"
BUILT_HEADER="$(printf 'name\tpkgname\tversion\tarch\tfilename\tsha256\trecipe_sha256\tbuilt_utc')"

pkgname_of() { printf '%s\n' "$1" | sed -E 's/-[^-]+-[^-]+-[^-]+\.pkg\.tar\.zst$//'; }
entry_of()   { printf '%s\n' "$1" | sed -E 's/-[^-]+\.pkg\.tar\.zst$//'; }   # name-ver-rel
db_entries() { # the name-ver-rel entries t715-omarchy.db lists (listing only)
    if [ -f "$REPO_OUT/t715-omarchy.db.tar.gz" ]; then
        tar -tzf "$REPO_OUT/t715-omarchy.db.tar.gz" | sed -n 's|^\(.*\)/desc$|\1|p' | sort
    fi
}

# Hash of everything in pkg/NAME (PKGBUILD, patches, ...): recorded with the
# build so that a recipe changed without a pkgrel bump can be reported.
recipe_sha256() {
    (cd "$PKG_DIR" && find . -type f ! -name .DS_Store ! -path './src/*' ! -path './pkg/*' \
        ! -name '*.pkg.tar.*' | LC_ALL=C sort | while IFS= read -r f; do
            printf '%s  %s\n' "$(sha256_of "$f")" "$f"
        done) | shasum -a 256 | awk '{print $1}'
}
RECIPE_SHA="$(recipe_sha256)"

docker_preflight
ensure_dev_image
mkdir -p "$SRC_VOLUME" "$WORK" "$PKG_CACHE" "$REPO_OUT"

# ------------------------------------------------------- container script
# MODE=query: prints "ARCH <arch>" for each arch=() entry and "FILE <name>"
# for each package file the PKGBUILD produces. MODE=build: upgrades, installs
# the dependencies, runs makepkg, checks the packages, copies them to /out
# and prints "FILE <file>\t<pkgname>\t<pkgver>\t<arch>" for each. Everything
# else goes to stderr.
IFS= read -r -d '' CONTAINER_SCRIPT <<'EOS' || true
set -euo pipefail
fail() { echo "build-pkg (container): $*" >&2; exit 1; }

id builder >/dev/null 2>&1 || useradd -m -U builder
rm -rf /build; mkdir -p /build/recipe /build/work /build/out
cp -a /recipe/. /build/recipe/
chown -R builder:builder /build /srcdest
# /run writable by the build user, sticky as /tmp (this container is thrown away): t715-modem's
# check() runs the loader's black-box tests, whose CP state file must be under /run/, the only
# place the loader writes to.
chmod 1777 /run

# [t715-omarchy] before [core], when the local repository exists, so that a
# PKGBUILD can depend on packages built or imported here; under Docker, no
# alpm sandbox, download user or free-space check.
sed -i '/^\[options\]/a DisableSandbox' /etc/pacman.conf
sed -i -e 's/^CheckSpace/#CheckSpace/' -e 's/^DownloadUser/#DownloadUser/' /etc/pacman.conf
if [ -e /repo/t715-omarchy.db ]; then
    awk -v stanza='[t715-omarchy]
SigLevel = Optional TrustedOnly
Server = file:///repo' '
        !done && /^\[core\]$/ { print stanza; print ""; done = 1 }
        { print }
    ' /etc/pacman.conf > /tmp/pacman.conf.t715
    grep -q '^\[t715-omarchy\]$' /tmp/pacman.conf.t715 || fail "could not declare [t715-omarchy]"
    cat /tmp/pacman.conf.t715 > /etc/pacman.conf
    # Omarchy's signing key: the repository's own keyring says which, and it
    # must be the pinned one.
    k=$(ls /repo/omarchy-keyring-*-any.pkg.tar.zst)
    d=$(mktemp -d); bsdtar -xf "$k" -C "$d" usr/share/pacman/keyrings
    kr="$d/usr/share/pacman/keyrings"
    fprs="$(sed -n 's/^\([0-9A-F]\{40\}\):.*$/\1/p' "$kr/omarchy-trusted" | sort -u)"
    for fpr in $fprs; do
        printf '%s\n' "$PINNED_FPRS" | grep -qx "$fpr" || fail "UNPINNED KEY $fpr in omarchy-keyring"
    done
    pacman-key --add "$kr/omarchy.gpg"
    for fpr in $fprs; do pacman-key --lsign-key "$fpr" >/dev/null; done
    rm -rf "$d"
fi
# named ALARM mirrors before the geographic redirector, which can send to a
# mirror that lags its own database (setup-pacman.sh says more)
{ printf 'Server = http://%s.mirror.archlinuxarm.org/$arch/$repo\n' de fl.us
  cat /etc/pacman.d/mirrorlist; } > /tmp/mirrorlist.t715
cat /tmp/mirrorlist.t715 > /etc/pacman.d/mirrorlist
echo "== pacman -Syu" >&2
pacman -Syu --noconfirm --noprogressbar >&2 || fail "pacman -Syu failed"

mk() { # makepkg as builder, with this tool's fixed settings
    (cd /build/recipe && runuser -u builder -- env \
        PKGDEST=/build/out SRCDEST=/srcdest BUILDDIR=/build/work \
        PKGEXT=.pkg.tar.zst PACKAGER="$PACKAGER" MAKEFLAGS="-j$JOBS" \
        makepkg "$@")
}

mk --printsrcinfo > /build/SRCINFO || fail "makepkg --printsrcinfo failed"

if [ "$MODE" = query ]; then
    sed -n 's/^	arch = /ARCH /p' /build/SRCINFO | sort -u
    mk --packagelist | sed 's|.*/|FILE |'
    exit 0
fi

# What makepkg --syncdeps would install (the pkgbase section of .SRCINFO:
# depends, makedepends, checkdepends, plus their _aarch64 variants), installed
# by root here so that no sudo is needed; makepkg re-checks them.  For an
# arch = any package (scripts, QML, data) only its makedepends and
# checkdepends are installed, makepkg runs with --nodeps, and each runtime
# depend must still resolve (pacman -Sp): a data package that depends on
# omarchy would else pull the whole desktop into this container.
any_only=1
while IFS= read -r a; do [ "$a" = any ] || any_only=0; done < <(sed -n 's/^	arch = //p' /build/SRCINFO)
kinds='depends|makedepends|checkdepends'
[ "$any_only" -eq 0 ] || kinds='makedepends|checkdepends'
deps=()
while IFS= read -r d; do deps+=("$d"); done < <(awk -v kinds="$kinds" '
    /^pkgname = / { exit }
    $0 ~ "^(	)(" kinds ")(_aarch64)? = " { sub(/^	[a-z_0-9]+ = /, ""); print }
' /build/SRCINFO)
if [ "$any_only" -eq 1 ]; then
    rdeps=()
    while IFS= read -r d; do rdeps+=("$d"); done < <(awk '
        /^	depends(_aarch64)? = / { sub(/^	[a-z_0-9]+ = /, ""); print }
    ' /build/SRCINFO | sort -u)
    unresolved=""
    for d in ${rdeps[@]+"${rdeps[@]}"}; do
        pacman -Sp --print-format %n "$d" >/dev/null 2>&1 || unresolved="$unresolved $d"
    done
    [ -z "$unresolved" ] || fail "arch = any: runtime depends that no repository provides:$unresolved"
    echo "== arch = any: ${#rdeps[@]} runtime depends resolve (not installed here)" >&2
fi
if [ "${#deps[@]}" -gt 0 ]; then
    echo "== installing ${#deps[@]} build dependencies" >&2
    pacman -S --needed --asdeps --noconfirm --noprogressbar "${deps[@]}" >&2 \
        || fail "dependency installation failed"
fi

echo "== makepkg (as builder, $JOBS jobs)" >&2
mkflags=(--noconfirm --noprogressbar)
[ "$any_only" -eq 0 ] || mkflags+=(--nodeps)
mk "${mkflags[@]}" >&2 || fail "makepkg failed"

shopt -s nullglob
pkgs=( /build/out/*.pkg.tar.zst )
[ "${#pkgs[@]}" -gt 0 ] || fail "makepkg produced no package"
for f in "${pkgs[@]}"; do
    b="${f##*/}"
    bsdtar -tf "$f" > /build/members || fail "$b: unreadable archive"
    for m in .PKGINFO .MTREE; do
        grep -qxF "$m" /build/members || fail "$b has no $m"
    done
    info="$(bsdtar -xOf "$f" .PKGINFO)"
    name="$(printf '%s\n' "$info" | sed -n 's/^pkgname = //p' | head -n1)"
    ver="$(printf '%s\n' "$info" | sed -n 's/^pkgver = //p' | head -n1)"
    arch="$(printf '%s\n' "$info" | sed -n 's/^arch = //p' | head -n1)"
    [ "$b" = "$name-$ver-$arch.pkg.tar.zst" ] || fail "$b: .PKGINFO says $name $ver $arch"
    case "$arch" in aarch64|any) ;; *) fail "$b: arch $arch is neither aarch64 nor any" ;; esac

    # Machine code check on the extracted files (here, never on the host):
    # 64-bit little-endian AArch64 only, and none at all in an arch = any package.
    d="$(mktemp -d)"
    bsdtar -xf "$f" -C "$d"
    nelf=0
    while IFS= read -r -d '' x; do
        hdr="$(head -c 20 -- "$x" | od -An -tx1 | tr -d ' \n')"
        case "$hdr" in 7f454c46*) ;; *) continue ;; esac
        nelf=$((nelf + 1))
        [ "$arch" != any ] || fail "$b: arch = any but contains an ELF file: ${x#$d/}"
        # EI_CLASS (byte 4) = 2 (ELF64), EI_DATA (5) = 1 (LE), e_machine (18-19) = 0xb7 (AArch64)
        [ "${hdr:8:4}" = 0201 ] && [ "${hdr:36:4}" = b700 ] \
            || fail "$b: ${x#$d/} is not a 64-bit little-endian AArch64 ELF file"
    done < <(find "$d" -type f -print0)
    rm -rf "$d"
    echo "checked $b: arch $arch, $nelf ELF file(s), all AArch64" >&2

    cp -f "$f" "/out/$b"
    printf 'FILE %s\t%s\t%s\t%s\n' "$b" "$name" "$ver" "$arch"
done
EOS

run_container() { # MODE [extra docker args...]: container script, stdout = protocol
    local mode="$1"; shift
    # bash -c, not bash -s: stdin stays free, so nothing makepkg runs can
    # swallow the rest of the script.
    docker run --rm --platform "$PLATFORM" \
        -v "$PKG_DIR:/recipe:ro" -v "$SRC_VOLUME:/srcdest" \
        -v "$PKCACHE_DIR:/var/cache/pacman/pkg" \
        -e MODE="$mode" -e PACKAGER="$PACKAGER_ID" -e JOBS="$JOBS" \
        -e PINNED_FPRS="$(sed -e 's/#.*//' -e 's/[[:space:]]//g' "$ROOTFS_DIR/omarchy-trusted.fpr" | grep -E '^[0-9A-F]{40}$')" \
        "$@" "$DEV_IMAGE" bash -c "$CONTAINER_SCRIPT" build-pkg </dev/null
}
# Makepkg's jobs: the Docker VM has 8 CPUs and under 6 GB of RAM.
JOBS="${T715_BUILD_JOBS:-6}"

# ------------------------------------------------------------ what it makes
log "$NAME: reading pkg/$NAME/PKGBUILD in $DEV_IMAGE"
QUERY="$(run_container query)" || die "$NAME: cannot read pkg/$NAME/PKGBUILD with makepkg"
ARCHES="$(printf '%s\n' "$QUERY" | sed -n 's/^ARCH //p')"
FILES="$(printf '%s\n' "$QUERY" | sed -n 's/^FILE //p' | LC_ALL=C sort)"
[ -n "$FILES" ] || die "$NAME: makepkg --packagelist lists no package"
printf '%s\n' "$ARCHES" | grep -qxE 'aarch64|any' \
    || die "$NAME: arch=() has neither aarch64 nor any ($(echo $ARCHES))"
while IFS= read -r f; do
    case "$f" in
        *-aarch64.pkg.tar.zst|*-any.pkg.tar.zst) ;;
        *) die "$NAME: unexpected package file name $f" ;;
    esac
done <<< "$FILES"
PKGNAMES="$(while IFS= read -r f; do pkgname_of "$f"; done <<< "$FILES" | LC_ALL=C sort -u)"

# A package name comes from one producer only: not Omarchy's (fetch-omarchy).
while IFS= read -r p; do
    if [ -f "$REPO_OUT/MANIFEST-omarchy.tsv" ] \
       && awk -F'\t' -v p="$p" 'NR > 1 && $1 == p { f = 1 } END { exit !f }' "$REPO_OUT/MANIFEST-omarchy.tsv"; then
        die "$p is one of Omarchy's packages (MANIFEST-omarchy.tsv): do not rebuild it"
    fi
    if [ -f "$BUILT" ] && awk -F'\t' -v p="$p" -v n="$NAME" 'NR > 1 && $2 == p && $1 != n { f = 1 } END { exit !f }' "$BUILT"; then
        die "$p is already built from another pkg/ directory (MANIFEST-built.tsv)"
    fi
done <<< "$PKGNAMES"

# ------------------------------------------------------------ up to date?
recorded() { # FIELD...: the given columns of NAME's MANIFEST-built.tsv rows
    [ -f "$BUILT" ] || return 0
    awk -F'\t' -v n="$NAME" -v cols="$*" '
        BEGIN { k = split(cols, c, " ") }
        NR > 1 && $1 == n { s = $(c[1]); for (i = 2; i <= k; i++) s = s "\t" $(c[i]); print s }
    ' "$BUILT"
}
OLD_FILES="$(recorded 5 | LC_ALL=C sort)"

if [ "$FORCE" -eq 0 ] && [ -n "$OLD_FILES" ] && [ "$OLD_FILES" = "$FILES" ]; then
    up_to_date=1
    entries="$(db_entries)"
    while IFS=$'\t' read -r f sha; do
        if [ ! -f "$REPO_OUT/$f" ] || [ "$(sha256_of "$REPO_OUT/$f")" != "$sha" ]; then
            log "$f: missing from $REPO_OUT or changed since its build"; up_to_date=0
        elif ! printf '%s\n' "$entries" | grep -qxF "$(entry_of "$f")"; then
            log "$f: not listed in t715-omarchy.db"; up_to_date=0
        fi
    done < <(recorded 5 6)
    if [ "$up_to_date" -eq 1 ]; then
        old_recipe="$(recorded 7 | head -n1)"
        if [ "$old_recipe" != "$RECIPE_SHA" ]; then
            log "WARNING: pkg/$NAME changed since this version was built, but its version did not: bump pkgrel (or use --force)"
        fi
        log "$NAME: $(echo $FILES) already in $REPO_OUT: nothing to do (--force rebuilds)"
        exit 0
    fi
fi

# ------------------------------------------------------------------ build
STAGE="$WORK/out"
BUILD_LOG="$WORK/build.log"
rm -rf "$STAGE"; mkdir -p "$STAGE"
repo_mount=()
[ -e "$REPO_OUT/t715-omarchy.db" ] && repo_mount=(-v "$REPO_OUT:/repo:ro")
log "$NAME: building $(echo $FILES) in $DEV_IMAGE (log $BUILD_LOG)"
start="$(date +%s)"
if ! run_container build -v "$STAGE:/out" ${repo_mount[@]+"${repo_mount[@]}"} \
        2>&1 >"$WORK/plan.txt" | tee "$BUILD_LOG" >&2; then
    die "$NAME: build failed (log $BUILD_LOG)"
fi
log "$NAME: built in $(( ($(date +%s) - start) / 60 )) min"

BUILT_FILES="$(sed -n 's/^FILE \([^	]*\)	.*$/\1/p' "$WORK/plan.txt" | LC_ALL=C sort)"
[ "$BUILT_FILES" = "$FILES" ] \
    || die "$NAME: makepkg produced [$(echo $BUILT_FILES)], expected [$(echo $FILES)]"

# -------------------------------------------------------------- publish
while IFS= read -r f; do
    cp -f "$STAGE/$f" "$PKG_CACHE/$f"
    cp -f "$STAGE/$f" "$REPO_OUT/$f.part"
    mv -f "$REPO_OUT/$f.part" "$REPO_OUT/$f"
done <<< "$FILES"
# Files of an earlier version of NAME (recorded by us, never anyone else's).
while IFS= read -r f; do
    [ -n "$f" ] || continue
    if ! printf '%s\n' "$FILES" | grep -qxF "$f"; then
        rm -f "$REPO_OUT/$f"
        log "removed stale $f"
    fi
done <<< "$OLD_FILES"

# The index: rebuilt from every package file of the directory (ours and
# Omarchy's), so that it lists exactly what is there.
log "indexing $REPO_OUT (repo-add)"
docker run --rm -i --platform "$PLATFORM" -v "$REPO_OUT:/repo" "$DEV_IMAGE" bash -s >&2 <<'EOS' || die "repo-add failed"
set -euo pipefail
shopt -s nullglob
cd /repo
pkgs=( *.pkg.tar.zst )
[ "${#pkgs[@]}" -gt 0 ] || { echo "no packages in /repo" >&2; exit 1; }
rm -f t715-omarchy.db t715-omarchy.db.tar.gz t715-omarchy.files t715-omarchy.files.tar.gz
repo-add -q t715-omarchy.db.tar.gz "${pkgs[@]}"
rm -f t715-omarchy.db.tar.gz.old t715-omarchy.files.tar.gz.old
echo "repo-add: ${#pkgs[@]} package(s) indexed" >&2
EOS
entries="$(db_entries)"
while IFS= read -r f; do
    printf '%s\n' "$entries" | grep -qxF "$(entry_of "$f")" \
        || die "$f: not listed in t715-omarchy.db after repo-add"
done <<< "$FILES"

# MANIFEST-built.tsv: NAME's rows replaced, the other pkg/ directories' kept.
now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
{
    printf '%s\n' "$BUILT_HEADER"
    {
        if [ -f "$BUILT" ]; then
            awk -F'\t' -v n="$NAME" 'NR > 1 && $1 != n' "$BUILT"
        fi
        while IFS=$'\t' read -r f p v a; do
            printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$NAME" "$p" "$v" "$a" "$f" \
                "$(sha256_of "$REPO_OUT/$f")" "$RECIPE_SHA" "$now"
        done < <(sed -n 's/^FILE //p' "$WORK/plan.txt")
    } | LC_ALL=C sort -t$'\t' -k1,1 -k5,5
} > "$BUILT.tmp"
mv -f "$BUILT.tmp" "$BUILT"

while IFS= read -r f; do
    log "published $f (sha256 $(sha256_of "$REPO_OUT/$f"))"
done <<< "$FILES"
