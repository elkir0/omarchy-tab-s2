    fail "omarchy-migrate --pending lists for $U: $(printf '%s\n' "$out" | head -n 4 | tr '\n' ' ')"
elif [ "$nmig" -gt 0 ] && [ "$(ls /home/$U/.local/state/omarchy/migrations/ 2>/dev/null | wc -l)" -ge "$nmig" ]; then
    pass "no pending Omarchy migration for $U: all $nmig marked done (no login notice)"
