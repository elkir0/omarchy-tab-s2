hold=/usr/share/t715-omarchy/omarchy-migrations.hold
if [ -s "$hold" ] && bash -n /usr/local/bin/t715-omarchy-migrations-hold 2>/dev/null; then
    missing=""
    while read -r name _; do
        case "$name" in ''|'#'*) continue ;; esac
        [ -f "/usr/share/omarchy/migrations/$name" ] || missing="$missing $name"
    done < "$hold"
    if [ -z "$missing" ]; then
        pass "the migration hold list: $(grep -c '^[0-9]*\.sh' "$hold") migrations, each shipped by this Omarchy; t715-omarchy-migrations-hold parses"
    else
