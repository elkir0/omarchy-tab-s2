# smoke-check-omarchy — the Omarchy image's part of the smoke check, sourced
# by /usr/lib/t715-arm64/smoke-check when omarchy is installed (the functions
# pass/fail/warn/info/run, $U and $tmp come from it).
#
# Adapted from omarchy-tab-s2/image/rootfs/smoke-check.sh (read-only):
# its session stack sections, verbatim except for the user (the image's
# placeholder instead of alarm) and the two vendor files, placeholders in
# this image: missing, they are a warning here.
#
# FAIL: Omarchy is not 4.5.x, or a touch-layer or Omarchy Mobile package is
#       not at the version this build pins (below); an Omarchy migration is
#       pending for the user (the login notice); mako is installed; SDDM does
#       not log the user into omarchy.desktop;
#       Hyprland, quickshell, uwsm or sddm cannot report a version; ldd misses
#       a library of Hyprland, quickshell, sddm or squeekboard; the dmabuf-check
#       shim is not wired; the touch layer is not in place (t715-keys --check,
#       the on-screen keyboard's gsettings, terminal layouts, session
#       environment); the touch shell is not (omamobile-omarchy's patch series,
#       the QML modules its plugins import, the user's profile or plugin links);
#       PipeWire's BlueZ plugin is missing; the user's Hyprland config does not
#       verify.
# WARN: other session binaries, QML modules the Omarchy shell may miss, the
#       two vendor files.

indent() { sed 's/^/        /'; }

echo "== Omarchy 4.5 and the touch layer's versions =="
# What this build pins (omarchy-pins, omamobile-pins, pkg/*/PKGBUILD,
# 2026-11-24): change them together.
expect_version() { # PACKAGE VERSION-PATTERN (an extended regular expression)
    local got
    got="$(pacman -Q "$1" 2>/dev/null | cut -d' ' -f2)"
    if [ -n "$got" ] && printf '%s\n' "$got" | grep -qxE "$2"; then
        pass "$1 $got"
    else
        fail "$1: ${got:-not installed}, expected $2"
    fi
}
expect_version omarchy '4\.5\.[0-9]+-[0-9.]+'
expect_version omarchy-settings "$(pacman -Q omarchy 2>/dev/null | cut -d' ' -f2 | sed 's/\./\\./g')"
