   && [ "$(readlink /etc/systemd/system/display-manager.service)" = /usr/lib/systemd/system/sddm.service ]; then
    pass "SDDM autologin: User=$U, Session=omarchy.desktop ($al; the session file is there; sddm is the display manager)"
