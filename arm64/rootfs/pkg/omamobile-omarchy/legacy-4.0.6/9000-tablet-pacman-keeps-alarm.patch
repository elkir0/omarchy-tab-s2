# SM-T715 (Galaxy Tab S2 8.0 LTE, arm64), tablet-only: same guards as the 4.5 series'
# 9000-tablet-pacman-keeps-alarm.patch, against Omarchy 4.0.6 (4.0.6-1): the
# tablet's pacman.conf (hand-built at image time, with [t715-omarchy] and
# Arch Linux ARM repositories) must not be replaced by Omarchy's x86_64
# pacman.conf and mirrorlist. The tablet updates with plain 'omarchy update'.
--- i/bin/omarchy-channel-set
+++ w/bin/omarchy-channel-set
@@ -6,6 +6,13 @@
 
 set -euo pipefail
 
+# SM-T715: keep Arch Linux ARM's repositories in /etc/pacman.conf.
+if grep -q '^\[alarm\]' /etc/pacman.conf; then
+  echo "omarchy-channel-set: not on this tablet. It would replace Arch Linux ARM's" >&2
+  echo "pacman.conf with Omarchy's x86_64 one. Update with 'omarchy update'." >&2
+  exit 1
+fi
+
 usage() { echo "Usage: omarchy-channel-set [stable|rc|edge|dev]"; }
 fail() { echo "Error: $*" >&2; exit 1; }
 
--- i/bin/omarchy-refresh-pacman
+++ w/bin/omarchy-refresh-pacman
@@ -3,6 +3,13 @@
 # omarchy:summary=Overwrite the package configuration for /etc/pacman with the Omarchy default of using its dedicated mirrors and repositories, then update all packages.
 # omarchy:requires-sudo=true
 
+# SM-T715: keep Arch Linux ARM's repositories in /etc/pacman.conf.
+if grep -q '^\[alarm\]' /etc/pacman.conf; then
+  echo "omarchy-refresh-pacman: not on this tablet. It would replace Arch Linux" >&2
+  echo "ARM's pacman.conf and mirrorlist with Omarchy's x86_64 ones. Update with 'omarchy update'." >&2
+  exit 1
+fi
+
 sudo cp -f /etc/pacman.conf /etc/pacman.conf.bak
 sudo cp -f /etc/pacman.d/mirrorlist /etc/pacman.d/mirrorlist.bak
 
