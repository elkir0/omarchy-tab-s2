#!/bin/bash
# SPDX-License-Identifier: MIT
# Stage the tablet build of omamobile-omarchy (SM-T715 arm64; from the
# Lenovomarchy port) into DESTDIR.
# Upstream 0.1.51's install, minus everything that assumes a packaged kernel
# or a phone: no modules-cleanup script, no omamobile-modules-cleanup units,
# no drop-in for Arch's linux-modules-cleanup (the tablet's kernel modules
# are not pacman packages and nothing may prune them), no omamobile-update
# wrapper or update-bin stand-ins (the tablet updates through Omarchy's own
# omarchy-update, kept safe by patches 9000/9001), no zram drop-in (the
# image's own /etc/systemd/zram-generator.conf already caps zram0 at half
# the RAM and /etc outranks /usr/lib drop-ins).
#   ./install DESTDIR
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
d=${1:?Usage: ./install DESTDIR}
[[ $d == /* && $d != "/" ]] || { echo "Use an absolute staging directory" >&2; exit 1; }
install -Dm755 bin/omamobile-omarchy-patches "$d/usr/bin/omamobile-omarchy-patches"
install -Dm755 lib/lock-pam "$d/usr/lib/omamobile-omarchy/lock-pam"
for f in patches/*.patch; do
  install -Dm644 "$f" "$d/usr/share/omamobile/omarchy/patches/${f##*/}"
done
install -Dm644 tmpfiles/omamobile-run.conf "$d/usr/lib/tmpfiles.d/omamobile-run.conf"
install -Dm644 libalpm/95-omamobile-omarchy-patches.hook "$d/usr/share/libalpm/hooks/95-omamobile-omarchy-patches.hook"
install -Dm644 LICENSE "$d/usr/share/licenses/omamobile-omarchy/LICENSE"
install -Dm644 LICENSE.omarchy "$d/usr/share/licenses/omamobile-omarchy/omarchy-MIT"
install -Dm644 version "$d/usr/share/omamobile/omarchy/version"
for f in legacy-4.0.6/*.patch; do
  install -Dm644 "$f" "$d/usr/share/omamobile/omarchy/legacy-4.0.6/${f##*/}"
done
