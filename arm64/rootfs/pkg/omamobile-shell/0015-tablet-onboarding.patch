@@ -0,0 +1,198 @@
+#!/bin/bash
+# SPDX-License-Identifier: MIT
+# The SM-T715 tablet's omamobile-onboarding (patch 0015) against fakes:
+# - the image's placeholder password counts as no PIN: the nudge asks for
+#   setup and --inner makes the user choose a PIN or password
+#   (omamobile-set-pin --inner); the candidate is sent to unix_chkpwd
+#   NUL-terminated, like the empty-password test (a trailing newline would be
+#   part of the password), and it is the script's own placeholder -- read
+#   from it here, not restated;
+# - Golden's AI step in --inner: the AI desktop apps in one multi-choice (an
+#   installed one is not offered, a failed install says so and carries on),
+#   the language voice input uses, and the default coding agent when none is
+#   set ("Later" falls back to Omarchy's invitation).
+set -euo pipefail
+cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
+fail() { printf 'not ok - %s\n' "$1" >&2; [[ -f ${t:-}/out ]] && cat "$t/out" >&2; exit 1; }
+pass() { printf 'ok - %s\n' "$1"; }
+t=$(mktemp -d); trap 'rm -rf "$t"' EXIT
+F=$t/fakes; mkdir -p "$F" "$t/home" "$t/omarchy/install/user/first-run"
+fake() { printf '#!/bin/bash\n%s\n' "$2" >"$F/$1"; chmod +x "$F/$1"; }
+# the placeholder the script carries, read from the script itself
+want=$(sed -n "s/^placeholder_pw='\(.*\)'\$/\\1/p" bin/omamobile-onboarding)
+[[ -n $want ]] || fail "the script does not carry its placeholder"
+# unix_chkpwd: reads the candidate from stdin NUL-terminated; empty input is
+# the no-password test, anything else the placeholder test. What it answers
+# comes from $T/empty-rc / $T/cand-rc; the format is recorded in $T/chk-fmt.
+cat >"$F/unix_chkpwd" <<'PY'
+#!/usr/bin/env python3
+import os
+import sys
+data = sys.stdin.buffer.read()
+t = os.environ["T"]
+want = os.environ["CHKPW_WANT"].encode()
+if data == b"":
+    fmt, key = "empty", "empty-rc"
+elif data == want + b"\0" and b"\n" not in data:
+    fmt, key = "ok", "cand-rc"
+else:
+    fmt, key = "bad", "cand-rc"
+with open(os.path.join(t, "chk-fmt"), "a") as f:
+    f.write(fmt + "\n")
+try:
+    rc = int(open(os.path.join(t, key)).read().strip())
+except OSError:
+    rc = 1
+sys.exit(rc)
+PY
+chmod +x "$F/unix_chkpwd"
+fake git 'echo set'
+fake gum 'case $1 in
+  input) n=$(cat "$T/asked" 2>/dev/null || echo 0); n=$((n + 1)); echo "$n" >"$T/asked"; sed -n "${n}p" "$T/answers" ;;
+  choose) printf "%s\n" "$*" >>"$T/choose-args"; [[ ! -t 0 ]] && cat >>"$T/choose-stdin"
+          case $* in *--no-limit*) [[ -e $T/chosen-apps ]] && cat "$T/chosen-apps" ;;
+          *) [[ -e $T/chosen-agent ]] && cat "$T/chosen-agent" ;; esac ;;
+  confirm) exit 1 ;;
+esac'
+fake omamobile-set-pin 'case $1 in --type) echo PIN ;; --inner) echo "set-pin --inner" >>"$T/log" ;; esac'
+fake omarchy-notification-send 'echo "notify $*" >>"$T/log"'
+printf 'echo "invite-agent" >>"$T/log"\n' >"$t/omarchy/install/user/first-run/setup-agent.hook"
+fake omarchy-pkg-present 'if [[ -e $T/present ]] && grep -qx "$1" "$T/present"; then exit 0; fi; exit 1'
+fake omarchy-install-ai-claude 'echo "install-claude" >>"$T/log"; [[ ! -e $T/fail-claude ]]'
+fake omarchy-install-ai-chatgpt 'echo "install-chatgpt" >>"$T/log"; [[ ! -e $T/fail-chatgpt ]]'
+fake omarchy-default-agent 'if [[ ${1:-} == --install ]]; then echo "set-agent $2" >>"$T/log"; if [[ -e $T/fail-agent ]]; then exit 1; fi; else [[ -e $T/agent ]] && cat "$T/agent"; fi; exit 0'
+# a real timeout, shortened: the probes' 10 s become 2 s
+fake timeout 'secs=$1; shift; [[ $secs -gt 2 ]] && secs=2; exec /usr/bin/timeout "$secs" "$@"'
+ob() {
+  : >"$t/log"; rm -f "$t/asked" "$t/choose-stdin" "$t/choose-args" "$t/chk-fmt"
+  printf '%s\n%s\n' "" "" >"$t/answers"
+  env -u XDG_STATE_HOME T="$t" CHKPW_WANT="$want" HOME="$t/home" USER=alice \
+    OMARCHY_PATH="$t/omarchy" OMAMOBILE_FP_RUNNER="$t/none" \
+    PATH="$F:/usr/bin:/bin" bash bin/omamobile-onboarding "$@" >"$t/out" 2>&1
+}
+# a password scenario: empty-rc / cand-rc are what unix_chkpwd answers to the
+# empty and the placeholder candidate
+pin_real()   { echo 1 >"$t/empty-rc"; echo 1 >"$t/cand-rc"; }
+pin_place()  { echo 1 >"$t/empty-rc"; echo 0 >"$t/cand-rc"; }
+pin_none()   { echo 0 >"$t/empty-rc"; echo 1 >"$t/cand-rc"; }
+
+# The placeholder password: the nudge asks for setup, and the candidate was
+# sent NUL-terminated, equal to the script's placeholder
+pin_place
+ob --nudge
+grep -q 'Finish setting up' "$t/log" || fail "the placeholder counts as no PIN: the nudge asks for setup"
+grep -q 'invite-agent' "$t/log" && fail "the placeholder: no agent invitation yet"
+grep -q '^empty$' "$t/chk-fmt" || fail "the empty-password test ran"
+grep -q '^ok$' "$t/chk-fmt" || fail "the placeholder was sent NUL-terminated and matched the script's own ($(cat "$t/chk-fmt"))"
+grep -q '^bad$' "$t/chk-fmt" && fail "a candidate was sent in a format unix_chkpwd does not read"
+# --inner makes the user choose a PIN or password
+ob --inner
+grep -q 'set-pin --inner' "$t/log" || fail "--inner with only the placeholder: omamobile-set-pin --inner runs"
+grep -q 'already has a' "$t/out" && fail "--inner with only the placeholder: not 'already has a PIN'"
+pass "the placeholder counts as no PIN: the nudge asks, --inner forces a PIN or password, sent NUL-terminated"
+
+# A real PIN: the nudge goes to the agent invitation, --inner says the PIN is there
+pin_real
+ob --nudge
+grep -q 'Finish setting up' "$t/log" && fail "a real PIN: no setup nudge"
+grep -q 'invite-agent' "$t/log" || fail "a real PIN: the agent invitation"
+grep -q '^ok$' "$t/chk-fmt" || fail "a real PIN: the placeholder was still tested ($(cat "$t/chk-fmt"))"
+ob --inner
+grep -q 'already has a' "$t/out" || fail "--inner with a PIN: says it already has one"
+grep -q 'set-pin --inner' "$t/log" && fail "--inner with a PIN: does not run set-pin again"
+# No password at all: only the empty test runs
+pin_none
+ob --nudge
+grep -q 'Finish setting up' "$t/log" || fail "no password: the nudge asks for setup"
+[[ $(wc -l <"$t/chk-fmt") == 1 ]] || fail "no password: the placeholder is not tested ($(cat "$t/chk-fmt"))"
+pass "a real PIN or none: the nudge and --inner behave as upstream's"
+
+# Golden's AI step: the apps, offered in one multi-choice, installed
+pin_real
+rm -f "$t/present" "$t/fail-claude" "$t/fail-chatgpt" "$t/agent" "$t/fail-agent" "$t/chosen-agent"
+printf 'Claude Desktop\nChatGPT Desktop\n' >"$t/chosen-apps"
+ob --inner
+grep -qxF "The AI desktop apps are downloaded from Omarchy's repository, so the network is needed." "$t/out" ||
+  fail "the apps step says where the apps come from and that the network is needed"
+grep -q -- '--no-limit' "$t/choose-args" || fail "the apps are one gum choose --no-limit"
+grep -qxF 'Claude Desktop' "$t/choose-stdin" || fail "Claude Desktop is offered"
+grep -qxF 'ChatGPT Desktop' "$t/choose-stdin" || fail "ChatGPT Desktop is offered"
+grep -q 'install-claude' "$t/log" && grep -q 'install-chatgpt' "$t/log" || fail "both choices install their app"
+grep -qxF 'Claude Desktop installed.' "$t/out" || fail "a successful install is said"
+grep -qxF 'ChatGPT Desktop installed.' "$t/out" || fail "the second install too"
+
+# An app already installed is not offered; both installed: no choice at all
+printf 'claude-desktop\nopenai-codex-desktop\n' >"$t/present"
+ob --inner
+grep -q -- '--no-limit' "$t/choose-args" && fail "both installed: no apps choice"
+grep -q 'AI desktop apps' "$t/out" && fail "both installed: nothing said about the apps"
+rm -f "$t/present"; printf 'claude-desktop\n' >"$t/present"
+ob --inner
+grep -qxF 'ChatGPT Desktop' "$t/choose-stdin" || fail "Claude Desktop installed: only ChatGPT Desktop is offered"
+grep -qxF 'Claude Desktop' "$t/choose-stdin" && fail "Claude Desktop installed: not offered"
+
+# A failed install says so and carries on
+rm -f "$t/present"; touch "$t/fail-claude"
+printf 'Claude Desktop\nChatGPT Desktop\n' >"$t/chosen-apps"
+ob --inner
+grep -qxF 'Claude Desktop was not installed now; try again later (Install > AI).' "$t/out" ||
+  fail "a failed install says so"
+grep -qxF 'ChatGPT Desktop installed.' "$t/out" || fail "a failed install carries on"
+grep -q 'invite-agent' "$t/log" || fail "after a failed install the run goes on"
+pass "the AI apps: offered in one multi-choice, installed ones not offered, a failure carries on"
+
+# The language voice input uses, from Voxtype's config
+rm -f "$t/fail-claude" "$t/chosen-apps"
+vox() { mkdir -p "$t/home/.config/voxtype"; printf '%s' "$1" >"$t/home/.config/voxtype/config.toml"; }
+vox '[whisper]
+language = "fr"
+'
+ob --inner
+grep -qxF 'Voice input uses Français. Change it any time in Setup > Voice.' "$t/out" ||
+  fail "language fr: its own name, and Setup > Voice ($(grep 'Voice input' "$t/out"))"
+vox '[whisper]
+language = "sv"
+'
+ob --inner
+grep -qxF 'Voice input uses sv. Change it any time in Setup > Voice.' "$t/out" ||
+  fail "a language the settings do not list: the code itself"
+vox '[other]
+language = "de"
+[whisper]
+model = "base"
+'
+ob --inner
+grep -qxF 'Voice input uses English. Change it any time in Setup > Voice.' "$t/out" ||
+  fail "no [whisper] language: Voxtype's default, English; another section's language is not read"
+vox '[whisper]
+language = "auto"
+'
+ob --inner
+grep -qxF 'Voice input uses Automatic. Change it any time in Setup > Voice.' "$t/out" || fail "auto: Automatic"
+rm -rf "$t/home/.config"
+ob --inner
+grep -q 'Voice input' "$t/out" && fail "no Voxtype config: nothing about the language"
+pass "the voice-input language: from [whisper] language, its own name or the code, nothing without Voxtype"
+
+# The default coding agent, when none is set
+printf 'claude\n' >"$t/agent"
+ob --inner
+grep -q 'Default coding agent' "$t/choose-args" && fail "an agent already set: no choice"
+grep -q 'set-agent' "$t/log" && fail "an agent already set: nothing installed"
+rm -f "$t/agent"
+printf 'Codex\n' >"$t/chosen-agent"
+ob --inner
+grep -qF -- '--header Default coding agent Claude Code Codex OpenCode Gemini GitHub Copilot Grok Later' "$t/choose-args" ||
+  fail "the agent choice offers the agents and Later ($(cat "$t/choose-args"))"
+grep -q 'set-agent codex' "$t/log" || fail "a choice runs omarchy-default-agent --install"
+grep -qxF 'Codex is the default coding agent now.' "$t/out" || fail "a set agent is said"
+printf 'Later\n' >"$t/chosen-agent"
+ob --inner
+grep -q 'set-agent' "$t/log" && fail "Later: nothing installed"
+grep -q 'invite-agent' "$t/log" || fail "Later falls back to Omarchy's invitation"
+printf 'Grok\n' >"$t/chosen-agent"; touch "$t/fail-agent"
+ob --inner
+grep -qxF 'Grok was not set as the default agent; pick one later in Setup > Default agent.' "$t/out" ||
+  fail "a failed agent install says so"
+grep -q 'invite-agent' "$t/log" || fail "a failed agent install carries on to the invitation"
+pass "the default coding agent: picked when none is set, installed, Later falls back to the invitation"
