index d58cf82..eca7b34 100755
--- a/plugins/omamobile.quicksettings/tile-action.sh
+++ b/plugins/omamobile.quicksettings/tile-action.sh
@@ -106,6 +106,11 @@ case $tile in
     # second; ejecting unmounts and says so.
     if [ "$want" = on ]; then exec t715-sdcard mount; else exec t715-sdcard eject; fi
     ;;
+  android)
+    # SM-T715: Waydroid's Android session (t715-android). Starting boots the
+    # container in the background; stopping shuts the session down.
+    if [ "$want" = on ]; then exec t715-android start; else exec t715-android stop; fi
+    ;;
   modem)
     # SM-T715: the modem's own switch (t715-modem-power, through polkit). Off
