+  // SM-T715 tablet: Waydroid's Android session (t715-android, in the root
+  // image's overlay). A tap starts or stops the session; starting boots
+  // Android in the background, and the sheet probes again 5 s later. A long
+  // press opens Android's Settings app. No "android" key without the command
+  // or when Waydroid is not installed: the tile stays dimmed.
+  QtObject {
+    id: android
+    readonly property bool available: root.probedHas("android")
+    readonly property bool enabled: available && root.probedOn("android", "android")
+    readonly property string icon: "󰀲"
+    readonly property string status: {
+      if (!available) return "Not installed"
+      if (root.optimistic["android"] !== undefined)
+        return root.optimistic["android"] ? "Starting…" : "Stopping…"
+      if (enabled)
+        return root.probed.android_container === "frozen" ? "Asleep" : "On"
+      return "Off"
+    }
+    readonly property bool longPress: true
+    function toggle() {
+      if (!available) return
+      root.runTileAction("android", !enabled)
+      androidProbeLater.restart()
+    }
+    function openDetails() {
+      root.dismiss()
+      Quickshell.execDetached(["t715-android", "settings"])
+    }
+  }
+
+  Timer {
+    id: androidProbeLater
+    interval: 5000
+    onTriggered: root.refreshProbe()
+  }
