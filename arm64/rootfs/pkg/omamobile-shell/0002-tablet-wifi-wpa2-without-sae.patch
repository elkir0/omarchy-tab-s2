   }
 
   function close() {
@@ -96,6 +97,12 @@ Item {
   property string actionKind: ""   // "connect" | "disconnect" | "forget"
   property string actionSsid: ""
   property bool actionSecured: false
+  // Whether the radio can do SAE (WPA3-Personal), from `iw phy` the first
+  // time the panel opens; until then (or without iw) Quickshell connects.
+  // SM-T715: the BCM4358 firmware has no SAE, so an SAE-flagged network
+  // joins through the WPA2 fallback below.
+  property bool phyHasSae: true
+  property bool phyChecked: false
   property string failureSsid: ""
   property string failureText: ""
 
@@ -313,7 +320,14 @@ Item {
     passwordField.text = ""
     cancelSheet()
     runAction("connect", ssid, true, function(network) {
-      if (typeof network.connectWithPsk === "function") {
+      if (!root.phyHasSae && network.security === WifiSecurityType.Sae) {
+        // SM-T715: no SAE in the radio, so a WPA3-flagged SSID is joined
+        // as WPA2-PSK (the router serves both; see nmcliWpa2ConnectArgv).
+        pskConnect.secret = psk
+        pskConnect.ssid = ssid
+        pskConnect.command = WifiModel.nmcliWpa2ConnectArgv(ssid, root.device ? root.device.name : "")
+        pskConnect.running = true
+      } else if (typeof network.connectWithPsk === "function") {
         network.connectWithPsk(psk)
       } else {
         pskConnect.secret = psk
@@ -325,6 +339,20 @@ Item {
     psk = ""
   }
 
+  // `iw phy`, once, the first time the panel opens: whether the radio can
+  // do SAE. Without iw (or until it answers) Quickshell connects as before.
+  Process {
+    id: saeProbe
+    command: ["iw", "phy"]
+    stdout: StdioCollector {
+      waitForEnd: true
+      onStreamFinished: {
+        root.phyHasSae = WifiModel.phyHasSae(text)
+        root.phyChecked = true
+      }
+    }
+  }
+
   // Fallback only. `--ask` makes nmcli prompt for the secret, which arrives on
   // stdin; argv carries the SSID and interface and nothing else.
   Process {
diff --git a/test/wifi-model.js b/test/wifi-model.js
index 2d39022..71a4322 100644
--- a/test/wifi-model.js
+++ b/test/wifi-model.js
@@ -143,6 +143,24 @@ test("the nmcli fallback never carries the password in argv", () => {
   assert.strictEqual(M.nmcliFailureMessage("boom"), "Couldn't connect")
 })
 
+test("SAE support comes from iw phy", () => {
+  assert.strictEqual(M.phyHasSae("\tSupported extended features:\n\t\t* [ SAE_OFFLOAD ]: SAE offload support"), true)
+  assert.strictEqual(M.phyHasSae("\tDevice supports SAE with AUTHENTICATE command"), true)
+  assert.strictEqual(M.phyHasSae("Wiphy phy0\n\t* [ 4WAY_HANDSHAKE_STA_PSK ]: 4-way handshake with PSK in station mode"), false)
+  assert.strictEqual(M.phyHasSae(""), false)
+})
+
+test("the WPA2 fallback pins wpa-psk and keeps the password and SSID out of the script", () => {
+  const argv = M.nmcliWpa2ConnectArgv("Home $(reboot)", "wlp1s0")
+  assert.strictEqual(M.nmcliWpa2ConnectArgv.length, 2, "takes no secret")
+  assert.deepStrictEqual(argv.slice(0, 2), ["sh", "-c"])
+  assert.deepStrictEqual(argv.slice(3), ["sh", "Home $(reboot)", "wlp1s0"])
+  assert.ok(/wifi-sec\.key-mgmt wpa-psk/.test(argv[2]))
+  assert.ok(/--ask connection up/.test(argv[2]))
+  assert.ok(!/Home/.test(argv[2]), "the SSID is a parameter, not code")
+  assert.deepStrictEqual(M.nmcliWpa2ConnectArgv("Home", "").slice(3), ["sh", "Home", ""])
+})
+
 test("list entries: sections in order, uniform fields", () => {
   const rows = M.buildRows([net("Home", 0.6, { connected: true, known: true }), net("Cafe", 0.4)], OPEN, OWE)
   const entries = M.listEntries(rows, [{ name: "Attic", uuid: "u3" }], true)
