  0016-tablet-android-tile.patch
)
source=(
  "${_tarball}::${url}/archive/${_commit}.tar.gz"
  omamobile-shell.install
  tablet-shell.json
  tablet-home.json
  "${_patches[@]}"
)
noextract=("${_tarball}")
sha256sums=(
