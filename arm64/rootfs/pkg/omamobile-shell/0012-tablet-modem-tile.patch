+# modem: the switch's state from t715-modem-power's JSON (no text probe, so no
+# locale to pin down), read with the shell's own patterns (no other process).
+if have t715-modem-power; then
+  json=$(t t715-modem-power status --json)
+  case $json in
+    *'"installed":true'*)
+      case $json in *'"modem":"on"'*) echo "modem=on" ;; *) echo "modem=off" ;; esac
+      cp=${json#*\"cp\":\"}
+      echo "modem_cp=${cp%%\"*}"
+      ;;
+    *) echo "modem=none" ;;
+  esac
+else
+  echo "modem=none"
+fi
+
 # data: the NetworkManager gsm connection on the modem (SM-T715: the modem is
 # served by shannond's ModemManager facade, not omamobile-sit). None without a
 # gsm device or connection. LC_ALL=C on every nmcli probe: the session runs in
