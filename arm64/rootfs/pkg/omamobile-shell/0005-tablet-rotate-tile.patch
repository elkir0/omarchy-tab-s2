+  // SM-T715 tablet: a quarter turn by hand, with or without the sensor
+  // (t715-rotate turn). It locks the rotation, or the sensor would turn the
+  // screen back. The sheet closes first, so the turn is not of the sheet.
+  QtObject {
+    id: rotate
+    readonly property bool available: true
+    readonly property bool enabled: false
+    readonly property string icon: "󰑧"
+    readonly property string status: "Turn"
+    function toggle() {
+      root.dismiss()
+      rotateLater.restart()
+    }
+  }
+
+  Timer {
+    id: rotateLater
+    interval: 450
+    onTriggered: {
+      Quickshell.execDetached(["t715-rotate", "turn"])
+      rotationRefresh.restart()
+    }
+  }
+
+  Timer {
+    id: rotationRefresh
+    interval: 600
+    onTriggered: rotationLock.refresh()
+  }
+
