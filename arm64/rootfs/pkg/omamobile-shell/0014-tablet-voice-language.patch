+// Voxtype's language when its config names none (and Omarchy's).
+var DEFAULT_LANGUAGE = "en"
+
+// A language as the settings use it: a code of two or three letters in
+// lower case, or "auto"; anything else Voxtype was told (a list of
+// languages, say) lets Whisper choose, so it counts as "auto".
+function normalLanguage(value) {
+  var v = String(value === undefined || value === null ? "" : value).trim().toLowerCase()
+  return /^(auto|[a-z]{2,3})$/.test(v) ? v : "auto"
+}
+
+// The daemon's language from the user's voxtype config.toml: [whisper]'s
+// `language = "..."`, or Voxtype's default (English).
+function configLanguage(text) {
+  var lines = String(text || "").split("\n")
+  var section = ""
+  for (var i = 0; i < lines.length; i++) {
+    var line = lines[i].trim()
+    var sec = line.match(/^\[([^\]]+)\]$/)
+    if (sec) { section = sec[1].trim(); continue }
+    if (section !== "whisper") continue
