+hl=$t/voice-lang-conf2; vhome "$hl"; rm -rf "$hl/.config/voxtype" "$hl/.local/share/voxtype"
+RUN_HOME=$hl RUN_VOICE_MODELS=$VB RUN_LOCALE_CONF=$t/locale.conf run
+[[ $(vl "$hl") == fr ]] || fail "locale.conf's LC_MESSAGES before its LANG"
+hl=$t/voice-lang-conf3; vhome "$hl"; rm -rf "$hl/.config/voxtype" "$hl/.local/share/voxtype"
