+# SM-T715 tablet build (0014): the tablet's omamobile-voice ships the
+# multilingual base (ggml-base.bin); either model sets Voxtype up, and the
+# new config hears the session's language (LC_ALL, then LC_MESSAGES, then
+# LANG; then /etc/locale.conf's; else English) with the model that hears it,
+# the rest of Omarchy's config kept as it is. A config the user has stays.
+VB=$t/voice-models-multi; mkdir -p "$VB"; echo model >"$VB/ggml-base.bin"
+VBOTH=$t/voice-models-both; mkdir -p "$VBOTH"; echo model >"$VBOTH/ggml-base.bin"; echo model >"$VBOTH/ggml-base.en.bin"
+printf '# Omarchy'"'"'s Voxtype config\nstate_file = "auto"\n\n[audio]\nmax_duration_secs = 60\n\n[whisper]\n# the model\nmodel = "base.en"\nlanguage = "en"\n\n[output]\nmode = "type"\n' \
+  >"$t/omarchy/default/voxtype/config.toml"
+vl() { vc "$1" | sed -n 's/^language = "\(.*\)"$/\1/p'; }
+vm() { vc "$1" | sed -n 's/^model = "\(.*\)"$/\1/p'; }
+# case: models, then the locale variables (LC_ALL LC_MESSAGES LANG), the
+# language and the model expected
+for case in \
+  "en|||fr_FR.UTF-8|en|base.en" \
+  "multi|||en_US.UTF-8|en|base" \
+  "multi|||C.UTF-8|en|base" \
+  "both|||de_DE.UTF-8|de|base" \
+  "both|||en_GB.UTF-8|en|base.en" \
+  "both|||ja_JP.UTF-8|en|base.en" \
+  "both||||en|base.en" \
+  "both|it_IT.UTF-8||fr_FR.UTF-8|it|base" \
+  "both||es_ES.UTF-8|fr_FR.UTF-8|es|base" \
+  "both||nl_NL.UTF-8||nl|base" \
+  "both|pt_BR.UTF-8|en_US.UTF-8|en_US.UTF-8|pt|base" \
+  "both|||fr_FR.UTF-8|fr|base" \
+  "multi|||fr_FR.UTF-8|fr|base"; do
+  IFS='|' read -r models lc_all lc_messages lang want_lang want_model <<<"$case"
+  case $models in multi) dir=$VB ;; both) dir=$VBOTH ;; en) dir=$VM ;; esac
+  hl=$t/voice-lang; rm -rf "$hl"; vhome "$hl"; rm -rf "$hl/.config/voxtype" "$hl/.local/share/voxtype"
+  RUN_HOME=$hl RUN_VOICE_MODELS=$dir RUN_LC_ALL=$lc_all RUN_LC_MESSAGES=$lc_messages RUN_LANG=$lang run
+  [[ $(vl "$hl") == "$want_lang" && $(vm "$hl") == "$want_model" ]] ||
+    fail "$case: Voxtype hears $want_lang with $want_model (got $(vl "$hl") with $(vm "$hl"))"
+  [[ $(vc "$hl" | grep -c '^language = ') == 1 && $(vc "$hl" | grep -c '^model = ') == 1 ]] || fail "$case: one language and one model line"
+  for f in "$dir"/ggml-*.bin; do
+    [[ $(readlink "$hl/.local/share/voxtype/models/${f##*/}") == "$f" ]] || fail "$case: the shipped ${f##*/} is linked"
+  done
+  [[ $(find "$hl/.local/share/voxtype/models" -name 'ggml-*.bin' | wc -l) == $(find "$dir" -name 'ggml-*.bin' | wc -l) ]] || fail "$case: only the shipped models are linked"
+  [[ $(grep -cx 'systemctl --user enable voxtype.service' "$hl/calls") == 1 ]] || fail "$case: voxtype.service is enabled"
+done
