+  [[ $(vc "$hl" | grep -v -e '^$' -e '^# Omamobile' -e '^context_window_optimization' | head -4 | tr '\n' '|') == '[whisper]|# the model|model = "base"|language = "fr"|' ]] &&
+  grep -cx '# the model' "$hl/.config/voxtype/config.toml" >/dev/null &&
+  sed -n '/^\[audio\]$/,/^\[/p' "$hl/.config/voxtype/config.toml" | grep -cx 'max_duration_secs = 60' >/dev/null &&
+  sed -n '/^\[output\]$/,/^\[/p' "$hl/.config/voxtype/config.toml" | grep -cx 'mode = "type"' >/dev/null ||
+  fail "the rest of Omarchy's Voxtype config stays"
+vc "$hl" | grep -cx 'context_window_optimization = true' >/dev/null || fail "the new config gets the context cut too"
+# No LC_ALL, LC_MESSAGES or LANG (a run before any session, such as the
