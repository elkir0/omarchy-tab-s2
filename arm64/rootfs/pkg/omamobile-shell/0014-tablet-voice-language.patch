+# Without Omarchy's config, the two lines alone
+hl=$t/voice-lang-nodefault; vhome "$hl"; rm -rf "$hl/.config/voxtype" "$hl/.local/share/voxtype"
+RUN_HOME=$hl RUN_VOICE_MODELS=$VB RUN_LANG=fr_FR.UTF-8 RUN_OMARCHY_PATH=$t/no-omarchy run
+[[ $(vl "$hl") == fr && $(vm "$hl") == base ]] || fail "without Omarchy's config, Voxtype still gets the language and the model"
+# A user's own config stays, language and all; the model is linked
+hl=$t/voice-lang-own; vhome "$hl"; rm -rf "$hl/.local/share/voxtype"
+printf '[whisper]\nmodel = "small.en"\nlanguage = "en"\n' >"$hl/.config/voxtype/config.toml"
+RUN_HOME=$hl RUN_VOICE_MODELS=$VB RUN_LANG=fr_FR.UTF-8 run
+[[ $(vl "$hl") == en && $(vm "$hl") == small.en ]] || fail "a user's own Voxtype config keeps its language and model"
+[[ -L $hl/.local/share/voxtype/models/ggml-base.bin ]] || fail "the shipped base is linked for a user with a config"
+# Set up once: a language the user changes later stays
+sed -i 's/^language = "en"$/language = "de"/' "$hl/.config/voxtype/config.toml"
+RUN_HOME=$hl RUN_VOICE_MODELS=$VB RUN_LANG=fr_FR.UTF-8 run
+[[ $(vl "$hl") == de ]] || fail "the language is chosen once; the user's later choice stays"
+rm "$F/voxtype"
+pass "tablet voice (0014): base or base.en sets Voxtype up, in the session's language, once; the rest of the config and a user's own stay"
