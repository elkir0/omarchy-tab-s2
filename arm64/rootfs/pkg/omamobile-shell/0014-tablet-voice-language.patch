+  { id: "en", name: "English", line: "English-only models" },
+  { id: "fr", name: "Français", line: "French · multilingual models" },
+  { id: "de", name: "Deutsch", line: "German · multilingual models" },
+  { id: "es", name: "Español", line: "Spanish · multilingual models" },
+  { id: "it", name: "Italiano", line: "Italian · multilingual models" },
+  { id: "pt", name: "Português", line: "Portuguese · multilingual models" },
+  { id: "nl", name: "Nederlands", line: "Dutch · multilingual models" }
