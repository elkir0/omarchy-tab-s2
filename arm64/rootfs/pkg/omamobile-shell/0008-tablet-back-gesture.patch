--- a/plugins/omamobile.back/BackModel.js
+++ b/plugins/omamobile.back/BackModel.js
@@ -40,6 +40,14 @@ var ESCAPE_ARGV = ["sh", "-c",
                    'hyprctl dispatch "$1" >/dev/null; sleep 0.05; hyprctl dispatch "$2" >/dev/null',
                    "sh", ESCAPE_DOWN, ESCAPE_UP, TERMINALS.join(" ")]
 
+// SM-T715 tablet: Back is the Back key's, in t715-keys (SIGHUP to its main
+// process): it closes a sheet or the drawer, is the previous page in a
+// browser and Escape elsewhere, so the swipe and the key do one thing. When
+// t715-keys is not running (systemctl kill fails), the Escape above runs.
+var BACK_ARGV = ["sh", "-c",
+                 'systemctl --user kill --kill-whom=main --signal=SIGHUP t715-keys.service 2>/dev/null || exec "$@"',
+                 "sh"].concat(ESCAPE_ARGV)
+
 // Home, for an app at its top level: Back is phone-wide, so an app goes back
