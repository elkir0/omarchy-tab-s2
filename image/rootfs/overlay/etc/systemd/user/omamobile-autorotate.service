# Rotates the screen and touch input with the tablet (docs/image/ROTATION.md).
# Named as omamobile.quicksettings expects: its Rotation tile starts and
# enables it, or stops and disables it. The image enables it for alarm
# (rootfs/omarchy-user-setup.sh), so the tablet rotates from the first boot.
[Unit]
Description=Rotate the screen with the tablet
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=/usr/local/bin/t715-rotate
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
