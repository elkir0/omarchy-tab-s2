# SM-T715: apply PPD's profile as real caps on the CPU clusters, the GPU
# and boost, which PPD's placeholder driver cannot do on this kernel.
# Runs once PPD is up at boot; t715-power-profile.path starts it again
# whenever PPD rewrites its state file, that is on every profile switch.
[Unit]
Description=Apply the power profile to the SM-T715's CPU and GPU (PPD)
After=power-profiles-daemon.service
Wants=power-profiles-daemon.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/t715-power-profile apply

# graphical.target, not multi-user.target: PPD 0.30's own unit starts
# after multi-user.target (and the display manager), so a multi-user.target
# want closed an ordering cycle that systemd broke by dropping this job at
# every boot (seen on 2026-11-07): the profile chosen before a reboot was
# not applied until the next switch.
[Install]
WantedBy=graphical.target
