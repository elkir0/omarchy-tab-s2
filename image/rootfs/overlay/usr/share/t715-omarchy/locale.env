# The image's language, time zone and first keyboard layout. These are the
# defaults; tools/build-rootfs --locale, --timezone and --keyboard write this
# file into the build context with other values. configure-system.sh,
# omarchy-user-setup.sh, smoke-check.sh and tests/verify-rootfs.sh read it.
T715_LANG=en_US.UTF-8
T715_TZ=UTC
T715_XKB=us
