#!/bin/sh
# t715-sudo-asks-password — sudo asks the wheel group for its password from now on.
# Run once by omamobile-set-pin (omarchy-tab-s2; docs/image/ROOTFS.md): until the
# owner chooses a password the image's sudo asks for nothing, since the only password
# there is is written in the documentation. root stays reachable by key over USB.
set -eu
f=/etc/sudoers.d/10-wheel
printf '%%wheel ALL=(ALL:ALL) ALL\n' > "$f.new"
chmod 0440 "$f.new"
visudo -qcf "$f.new"
mv -f "$f.new" "$f"
