+    #[test]
+    fn preview_fps_and_merge_threads_parse_and_reach_the_table() {
+        let base = "[[lens]]\nrole = \"main\"\nid = \"a\"\nzoom = 1.0\n";
+        let cams = vec![CameraInfo {
+            id: "a".into(),
+            ..CameraInfo::default()
+        }];
+        let t = TableSpec::parse(&format!("merge_threads = 2\n{base}preview_fps = 15.0\n"))
+            .unwrap()
+            .resolve(&cams);
+        assert_eq!(t.get(0).preview_fps, Some(15.0));
+        assert_eq!(t.merge_threads(), Some(2));
+        // Absent, both stay off.
+        let plain = TableSpec::parse(base).unwrap().resolve(&cams);
+        assert_eq!(plain.get(0).preview_fps, None);
+        assert_eq!(plain.merge_threads(), None);
+        // A camera the table doesn't know gets no cap.
+        let other = TableSpec::parse("merge_threads = 4\n")
+            .unwrap()
+            .resolve(&cams);
+        assert_eq!(other.get(0).preview_fps, None);
+        assert_eq!(other.merge_threads(), Some(4));
+    }
+
+    #[test]
+    fn preview_fps_and_merge_threads_are_validated() {
+        let base = "[[lens]]\nrole = \"main\"\nid = \"a\"\nzoom = 1.0\n";
+        assert!(TableSpec::parse(&format!("{base}preview_fps = 0\n")).is_err());
+        assert!(TableSpec::parse(&format!("{base}preview_fps = -5\n")).is_err());
+        assert!(TableSpec::parse(&format!("{base}preview_fps = 120.1\n")).is_err());
+        assert!(TableSpec::parse("merge_threads = 0\n").is_err());
+        assert!(TableSpec::parse(&format!("{base}answer = 42\n")).is_err());
+    }
 }
