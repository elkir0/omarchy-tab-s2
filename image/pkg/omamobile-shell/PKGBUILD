_plugins=(omamobile.bar omamobile.quicksettings omamobile.call omamobile.launcher omamobile.switcher
          omamobile.home omamobile.keyboard omamobile.back)
_bins=(omamobile-setup-user omamobile-launch omamobile-osk-watch omamobile-bt-agent
       omamobile-screenrecord omamobile-widget omamobile-call-watch omamobile-cell-watch
       omamobile-set-pin)

prepare() {
  bsdtar -xf "$srcdir/$_tarball" "$_dir"
  cd "$srcdir/$_dir"
  [[ $(cat version) == "$pkgver" ]] || { echo "upstream version is not $pkgver" >&2; return 1; }
  patch -Np1 -i "$srcdir/0001-tablet-quick-settings-tiles.patch"
  patch -Np1 -i "$srcdir/0002-wifi-wpa2-without-sae.patch"
  patch -Np1 -i "$srcdir/0003-tablet-drawer-opens-light.patch"
  patch -Np1 -i "$srcdir/0004-tablet-quiet-pollers.patch"
  patch -Np1 -i "$srcdir/0005-tablet-modem.patch"
  patch -Np1 -i "$srcdir/0006-tablet-rotation.patch"
  patch -Np1 -i "$srcdir/0007-tablet-mobile-settings.patch"
  patch -Np1 -i "$srcdir/0008-tablet-tiles-that-work.patch"
  patch -Np1 -i "$srcdir/0009-upstream-bottom-strip-keyboard-on-pill.patch"
  patch -Np1 -i "$srcdir/0010-upstream-app-names-in-recents.patch"
  patch -Np1 -i "$srcdir/0011-tablet-set-pin.patch"
  patch -Np1 -i "$srcdir/0012-tablet-back-gesture.patch"
  patch -Np1 -i "$srcdir/0013-tablet-location-tile.patch"
  cp "$srcdir/tablet-shell.json" profile/shell.json
  cp "$srcdir/tablet-home.json" profile/home.json
}

check() {
  cd "$srcdir/$_dir"
  local f p
  for f in "${_bins[@]}"; do
    case "$(head -n1 "bin/$f")" in
      *python3*) python3 -I -c 'import ast, sys; ast.parse(open(sys.argv[1]).read())' "bin/$f" ;;
      *bash*)    bash -n "bin/$f" ;;
      *)         echo "bin/$f: unknown interpreter" >&2; return 1 ;;
    esac
  done
  for f in plugins/omamobile.quicksettings/tile-state.sh plugins/omamobile.quicksettings/tile-action.sh \
           plugins/omamobile.home/locate.sh; do
    bash -n "$f"
  done
  for p in "${_plugins[@]}"; do
    python3 -c 'import json, sys; m = json.load(open(sys.argv[1])); assert m["id"] == sys.argv[2], m["id"]' \
      "plugins/$p/manifest.json" "$p"
  done
  # The tablet profile names only the plugins this package ships, and its
  # disabledPlugins are only Omarchy's bar-widget-only plugins (omamobile.bar
  # shows none of them): never omarchy.menu, omarchy.media or a service.
  python3 - profile/shell.json "${_plugins[@]}" <<'PY'
import json, sys
config = json.load(open(sys.argv[1]))
shipped = set(sys.argv[2:])
named = {config["bar"]["id"], config["bar"]["quickSettings"]} | {p["id"] for p in config["plugins"]}
assert named <= shipped, sorted(named - shipped)
assert [p.get("columns") for p in config["plugins"] if p["id"] == "omamobile.launcher"] == [6]
disabled = config["disabledPlugins"]
assert isinstance(disabled, list) and all(isinstance(d, str) for d in disabled), disabled
assert len(set(disabled)) == len(disabled), "disabledPlugins repeats an id"
kept = {"omarchy." + k for k in "menu media background lock notifications polkit idle battery "
        "nightlight clipboard image-picker osd".split()}
assert not set(disabled) & kept, sorted(set(disabled) & kept)
widgets = {"omarchy." + w for w in "agents active-window indicators keyboard-layout microphone spacer "
           "system-update tray workspaces audio bluetooth clock dropbox monitor network power "
           "tailscale weather".split()}
assert set(disabled) <= widgets, sorted(set(disabled) - widgets)
PY
  python3 -c 'import json, sys; h = json.load(open(sys.argv[1])); assert h["grid"] == {"columns": 6, "rows": 8}' profile/home.json
  # The Wi-Fi panel's WPA2 path without SAE (0002).
  grep -q 'nmcliWpa2ConnectArgv' plugins/omamobile.quicksettings/WifiPanel.qml
  grep -q 'wifi-sec.key-mgmt wpa-psk' plugins/omamobile.quicksettings/WifiModel.js
  # The drawer opens without an icon rescan or the keyboard (0003). (An
  # `if`, not `! grep`: set -e ignores a negated command.)
  if grep -nE 'refreshIcons\(\)|input\.forceActiveFocus' plugins/omamobile.launcher/Launcher.qml; then
    echo "Launcher.qml still rescans icons or focuses the search field on opening" >&2
    return 1
  fi
  # No do-not-disturb poll in the home toggles, which watch the notification
  # service's file; the bar's modem and call watchers off by default (0004).
  grep -q '"/.local/state/omarchy/notifications.json"' plugins/omamobile.home/TogglesWidget.qml
  if grep -nE 'dndState|interval: 30000' plugins/omamobile.home/TogglesWidget.qml; then
    echo "TogglesWidget.qml still polls do-not-disturb" >&2
    return 1
  fi
  grep -q 'readonly property bool cellWatchEnabled: setting("cellWatch", false) === true' plugins/omamobile.bar/Bar.qml
  grep -q 'readonly property bool callWatchEnabled: setting("callWatch", false) === true' plugins/omamobile.bar/Bar.qml
  grep -q 'running: root.cellWatchEnabled' plugins/omamobile.bar/Bar.qml
  grep -q 'running: root.callWatchEnabled' plugins/omamobile.bar/Bar.qml
  # The patched tile catalogue: none of the phone's tiles but mobile data (0005),
  # which goes through NetworkManager, not omamobile-sit, and Hotspot (0008).
  if grep -nE '"(torch|nfc|fingerprint)"' \
      plugins/omamobile.quicksettings/TilesModel.js; then
    echo "TilesModel.js still lists a phone tile" >&2
    return 1
  fi
  grep -q '"mobile-data"' plugins/omamobile.quicksettings/TilesModel.js
  grep -q '"rotation-lock"' plugins/omamobile.quicksettings/TilesModel.js
  grep -q '"hotspot"' plugins/omamobile.quicksettings/TilesModel.js
  # The Location tile over t715-gps (0013).
  grep -q '"location"' plugins/omamobile.quicksettings/TilesModel.js
  # The edge swipe goes through t715-keys (0012).
  grep -q 'signal=SIGHUP' plugins/omamobile.back/BackModel.js
  # Airplane mode reaches the modem (0008).
  grep -q 'nmcli radio wwan off' plugins/omamobile.quicksettings/tile-action.sh
  if grep -nE '(exec|have) omamobile-sit' plugins/omamobile.quicksettings/tile-action.sh plugins/omamobile.quicksettings/tile-state.sh; then
    echo "the mobile data tile still calls omamobile-sit" >&2
    return 1
  fi
  # The modem pieces are on: the call card and both watchers (0005, tablet-shell.json).
  python3 -c 'import json, sys; c = json.load(open(sys.argv[1])); assert c["bar"]["cellWatch"] and c["bar"]["callWatch"]; assert {"id": "omamobile.call"} in c["plugins"]' profile/shell.json
}

package() {
  cd "$srcdir/$_dir"
  local f p share="$pkgdir/usr/share/omamobile/shell"
  for f in "${_bins[@]}"; do
    install -Dm755 "bin/$f" "$pkgdir/usr/bin/$f"
  done
  for p in "${_plugins[@]}"; do
    while IFS= read -r -d '' f; do
      install -Dm644 "$f" "$share/$f"
    done < <(find "plugins/$p" -type f -print0)
  done
  # Upstream's plugins/README.md: the reference for the plugins' behaviour and IPC.
  install -Dm644 plugins/README.md "$share/plugins/README.md"
  while IFS= read -r -d '' f; do
    install -Dm644 "$f" "$share/$f"
  done < <(find profile branding -type f -print0)
  install -Dm644 widgets/WIDGETS.md "$share/WIDGETS.md"
  install -Dm644 widgets/OWL.md "$share/OWL.md"
  while IFS= read -r -d '' f; do
    install -Dm644 "$f" "$share/widget-${f#widgets/}"
  done < <(find widgets/template widgets/examples -type f -print0)
  install -Dm644 systemd/user/omamobile-setup-user.service "$pkgdir/usr/lib/systemd/user/omamobile-setup-user.service"
  install -d "$pkgdir/usr/lib/systemd/user/graphical-session-pre.target.wants"
  ln -sfn ../omamobile-setup-user.service \
    "$pkgdir/usr/lib/systemd/user/graphical-session-pre.target.wants/omamobile-setup-user.service"
  install -Dm644 polkit/49-omamobile-admin-self.rules "$pkgdir/usr/share/polkit-1/rules.d/49-omamobile-admin-self.rules"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 widgets/LICENSE-owl-guide "$pkgdir/usr/share/licenses/$pkgname/LICENSE-owl-guide"
  install -Dm644 version "$share/version"
}
