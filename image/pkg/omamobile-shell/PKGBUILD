        0006-tablet-rotation.patch
        0007-tablet-mobile-settings.patch
        0008-tablet-tiles-that-work.patch
        0009-upstream-bottom-strip-keyboard-on-pill.patch
        0010-upstream-app-names-in-recents.patch
        0011-tablet-set-pin.patch
        0012-tablet-back-gesture.patch
        0013-tablet-location-tile.patch
        tablet-shell.json
        tablet-home.json)
