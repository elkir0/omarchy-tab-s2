diff --git a/test/wifi-model.js b/test/wifi-model.js
index 2d39022..71a4322 100644
--- a/test/wifi-model.js
+++ b/test/wifi-model.js
@@ -143,6 +143,24 @@ test("the nmcli fallback never carries the password in argv", () => {
   assert.strictEqual(M.nmcliFailureMessage("boom"), "Couldn't connect")
 })
 
+test("SAE support comes from iw phy", () => {
+  assert.strictEqual(M.phyHasSae("\tSupported extended features:\n\t\t* [ SAE_OFFLOAD ]: SAE offload support"), true)
+  assert.strictEqual(M.phyHasSae("\tDevice supports SAE with AUTHENTICATE command"), true)
+  assert.strictEqual(M.phyHasSae("Wiphy phy0\n\t* [ 4WAY_HANDSHAKE_STA_PSK ]: 4-way handshake with PSK in station mode"), false)
+  assert.strictEqual(M.phyHasSae(""), false)
+})
+
+test("the WPA2 fallback pins wpa-psk and keeps the password and SSID out of the script", () => {
+  const argv = M.nmcliWpa2ConnectArgv("Home $(reboot)", "wlp1s0")
+  assert.strictEqual(M.nmcliWpa2ConnectArgv.length, 2, "takes no secret")
+  assert.deepStrictEqual(argv.slice(0, 2), ["sh", "-c"])
+  assert.deepStrictEqual(argv.slice(3), ["sh", "Home $(reboot)", "wlp1s0"])
+  assert.ok(/wifi-sec\.key-mgmt wpa-psk/.test(argv[2]))
+  assert.ok(/--ask connection up/.test(argv[2]))
+  assert.ok(!/Home/.test(argv[2]), "the SSID is a parameter, not code")
+  assert.deepStrictEqual(M.nmcliWpa2ConnectArgv("Home", "").slice(3), ["sh", "Home", ""])
+})
+
 test("list entries: sections in order, uniform fields", () => {
   const rows = M.buildRows([net("Home", 0.6, { connected: true, known: true }), net("Cafe", 0.4)], OPEN, OWE)
   const entries = M.listEntries(rows, [{ name: "Attic", uuid: "u3" }], true)
