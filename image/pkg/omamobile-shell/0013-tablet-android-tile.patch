diff --git a/plugins/omamobile.quicksettings/tile-state.sh b/plugins/omamobile.quicksettings/tile-state.sh
--- a/plugins/omamobile.quicksettings/tile-state.sh
+++ b/plugins/omamobile.quicksettings/tile-state.sh
@@ -35,6 +35,11 @@
 #   sdcard_card   a card in the slot: yes or no
 #   sdcard_fs     its file system, empty when none can be read
 #   sdcard_free   its free space while it is mounted, empty otherwise
+#   android       SM-T715: Waydroid's Android session (t715-android): on while
+#                 the session is running, off when stopped; no line without the
+#                 command or when Waydroid is not installed
+#   android_container  the container's state while installed: running, frozen or
+#                      stopped
 
 t() { timeout 3 "$@" 2>/dev/null; }
 have() { command -v "$1" >/dev/null 2>&1; }
@@ -155,6 +160,23 @@
   esac
 fi
 
+# android: Waydroid's Android session through t715-android's state, one call;
+# no key at all without the command or when not installed, so the tile stays
+# dimmed.
+if have t715-android; then
+  and=$(t t715-android state)
+  case $(printf '%s\n' "$and" | sed -n 's/^installed=//p') in
+    yes)
+      if [ "$(printf '%s\n' "$and" | sed -n 's/^session=//p')" = running ]; then
+        echo "android=on"
+      else
+        echo "android=off"
+      fi
+      echo "android_container=$(printf '%s\n' "$and" | sed -n 's/^container=//p')"
+      ;;
+  esac
+fi
+
 # data: the NetworkManager gsm connection on the modem (SM-T715: the modem is
 # served by shannond's ModemManager facade, not omamobile-sit). None without a
 # gsm device or connection.
