 #                 when idle; down when its user service isn't running, none
 #                 without voxtype (in the root image; Remove > Dictation
 #                 takes it out)
+#   modem         SM-T715: on while the modem's switch is on (t715-modem-power),
+#                 off when it is off; none without the command, or on a kernel
+#                 without the modem
+#   modem_cp      the CP's state while it is on: online, booting, waiting,
+#                 crashed, offline, stopping or off
 
 t() { timeout 3 "$@" 2>/dev/null; }
 have() { command -v "$1" >/dev/null 2>&1; }
@@ -105,6 +110,22 @@
   fi
 else
   echo "dictation=none"
+fi
+
+# modem: the switch's state from t715-modem-power's JSON, read with the
+# shell's own patterns (no other process).
+if have t715-modem-power; then
+  json=$(t t715-modem-power status --json)
+  case $json in
+    *'"installed":true'*)
+      case $json in *'"modem":"on"'*) echo "modem=on" ;; *) echo "modem=off" ;; esac
+      cp=${json#*\"cp\":\"}
+      echo "modem_cp=${cp%%\"*}"
+      ;;
+    *) echo "modem=none" ;;
+  esac
+else
+  echo "modem=none"
 fi
 
