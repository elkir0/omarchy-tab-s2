+// The Modem tile's status while it is on, from tile-state.sh's modem_cp (the
+// CP's state as t715-modem-power reads it): online, booting, waiting (the
+// battery gate before a boot), crashed or offline (the loader's silent reset),
+// stopping, off (the loader stopped: a refused boot, or the standby's cut).
+function modemStatus(cp) {
+  if (cp === "online") return "On"
+  if (cp === "booting" || cp === "waiting") return "Starting…"
+  if (cp === "crashed" || cp === "offline") return "Restarting…"
+  if (cp === "stopping") return "Stopping…"
+  if (cp === "off") return "Not running"
+  return "On"
+}
+
 function themeName(name) {
   return String(name || "").split("-").filter(function(part) { return part.length > 0 })
     .map(function(part) { return part.charAt(0).toUpperCase() + part.slice(1) }).join(" ")
@@ -264,6 +279,7 @@
