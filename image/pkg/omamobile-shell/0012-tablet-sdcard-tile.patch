     "night-light": nightLight, "stay-awake": stayAwake, "mic": mic, "screenshot": screenshot,
     "screen-record": screenRecord, "fingerprint": fingerprint, "keyboard": keyboard,
@@ -1047,6 +1047,46 @@ Item {
     onTriggered: root.refreshProbe()
   }
 
+  // SM-T715 tablet: the microSD slot (t715-sdcard, in the root image's
+  // overlay). The session's udiskie already mounts a card that goes in, so
+  // the tile shows and changes the state rather than owning it. A tap mounts
+  // a readable card that is not mounted, ejects one that is, and does
+  // nothing without a card; a long press opens the card in Files (Disks
+  // when it cannot be read). No "sdcard" key without the command or the
+  // slot: the tile stays dimmed, on a kernel or an image without it.
+  QtObject {
+    id: sdcard
+    readonly property bool available: root.probedHas("sdcard")
+    readonly property bool enabled: available && root.probedOn("sdcard", "sdcard")
+    readonly property bool hasCard: available && root.probed.sdcard_card === "yes"
+    // A full-size SD glyph while a card is in, the micro SD one without.
+    readonly property string icon: hasCard ? "󰑹" : "󰟜"
+    readonly property string status: {
+      if (!available) return "No slot"
+      if (root.optimistic["sdcard"] !== undefined)
+        return root.optimistic["sdcard"] ? "Mounting…" : "Ejecting…"
+      if (!hasCard) return "No card"
+      if (!enabled) return root.probed.sdcard_fs ? "Not mounted" : "Not readable"
+      return root.probed.sdcard_free ? root.probed.sdcard_free + " free" : "On"
+    }
+    readonly property bool longPress: true
+    function toggle() {
+      if (!available || !hasCard) return
+      root.runTileAction("sdcard", !enabled)
+      sdcardProbeLater.restart()
+    }
+    function openDetails() {
+      root.dismiss()
+      Quickshell.execDetached(["t715-sdcard", "open"])
+    }
+  }
+
+  Timer {
+    id: sdcardProbeLater
+    interval: 2000
+    onTriggered: root.refreshProbe()
+  }
