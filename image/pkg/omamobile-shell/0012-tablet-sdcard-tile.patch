diff --git a/plugins/omamobile.quicksettings/tile-action.sh b/plugins/omamobile.quicksettings/tile-action.sh
--- a/plugins/omamobile.quicksettings/tile-action.sh
+++ b/plugins/omamobile.quicksettings/tile-action.sh
@@ -106,6 +106,11 @@ case $tile in
     # powers the CP down and keeps it off across a reboot; on boots it again.
     exec t715-modem-power "$want"
     ;;
+  sdcard)
+    # SM-T715: the microSD card's mount (t715-sdcard). Mounting takes about a
+    # second; ejecting unmounts and says so.
+    if [ "$want" = on ]; then exec t715-sdcard mount; else exec t715-sdcard eject; fi
+    ;;
   mobile-data)
     # The first gsm connection (t715-mobile on the SM-T715).
     con=$(nmcli -t -f NAME,TYPE connection show | awk -F: '$2 == "gsm" { print $1; exit }')
diff --git a/plugins/omamobile.quicksettings/tile-state.sh b/plugins/omamobile.quicksettings/tile-state.sh
--- a/plugins/omamobile.quicksettings/tile-state.sh
+++ b/plugins/omamobile.quicksettings/tile-state.sh
@@ -28,6 +28,13 @@
 #                 without the modem
 #   modem_cp      the CP's state while it is on: online, booting, waiting,
 #                 crashed, offline, stopping or off
+#   sdcard        SM-T715: the microSD slot (t715-sdcard): on while the card
+#                 is mounted, off with a card in and not mounted or with no
+#                 card; no line without the command, or on a kernel without
+#                 the slot
+#   sdcard_card   a card in the slot: yes or no
+#   sdcard_fs     its file system, empty when none can be read
+#   sdcard_free   its free space while it is mounted, empty otherwise
 
 t() { timeout 3 "$@" 2>/dev/null; }
 have() { command -v "$1" >/dev/null 2>&1; }
@@ -128,6 +135,26 @@ else
   echo "modem=none"
 fi
 
+# sdcard: the microSD slot through t715-sdcard's state, one call; no key at
+# all without the command or the slot, so the tile stays dimmed ("no slot"
+# here is a kernel without the slot driver, not an empty slot).
+if have t715-sdcard; then
+  sdc=$(t t715-sdcard state)
+  case $(printf '%s\n' "$sdc" | sed -n 's/^slot=//p') in
+    yes)
+      card=$(printf '%s\n' "$sdc" | sed -n 's/^card=//p')
+      fs=$(printf '%s\n' "$sdc" | sed -n 's/^fs=//p')
+      printf 'sdcard_card=%s\nsdcard_fs=%s\n' "$card" "$fs"
+      if [ "$(printf '%s\n' "$sdc" | sed -n 's/^mounted=//p')" = yes ]; then
+        echo "sdcard=on"
+        echo "sdcard_free=$(printf '%s\n' "$sdc" | sed -n 's/^free=//p')"
+      else
+        echo "sdcard=off"
+      fi
+      ;;
+  esac
+fi
+
 # data: the NetworkManager gsm connection on the modem (SM-T715: the modem is
 # served by shannond's ModemManager facade, not omamobile-sit). None without a
 # gsm device or connection.
