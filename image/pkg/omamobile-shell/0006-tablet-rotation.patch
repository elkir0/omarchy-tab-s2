+  // A quarter turn by hand, with or without the sensor. It locks the rotation,
+  // or the sensor would turn the screen back.
+  QtObject {
+    id: rotate
+    readonly property bool available: true
+    readonly property bool enabled: false
+    readonly property string icon: "󰑧"
+    readonly property string status: "Turn"
+    function toggle() {
+      root.dismiss()
+      rotateLater.restart()
+    }
+  }
+
+  Timer {
+    id: rotateLater
+    interval: 450
+    onTriggered: {
+      Quickshell.execDetached(["t715-rotate", "turn"])
+      rotationRefresh.restart()
+    }
+  }
+
+  Timer {
+    id: rotationRefresh
+    interval: 600
+    onTriggered: rotationLock.refresh()
+  }
+
