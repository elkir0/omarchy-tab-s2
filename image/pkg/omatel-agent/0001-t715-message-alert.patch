+/// SM-T715: a new message sounds and wakes the screen, as a call does. What
+/// silences its notification silences this too, and so does Do Not Disturb.
+async fn alert(agent: &Arc<Agent>, conversation: i64) {
+    let conv = {
+        let store = agent.messages.lock().unwrap();
+        let Ok(Some(c)) = store.conversation(conversation) else {
+            return;
+        };
+        c
+    };
+    let raw = conv
+        .numbers
+        .first()
+        .cloned()
+        .unwrap_or(conv.address.clone());
+    let blocked = agent
+        .blocked
+        .lock()
+        .unwrap()
+        .is_blocked(&raw, &agent.region())
+        .unwrap_or(false);
+    if !agent.settings().message_notifications || conv.muted || blocked || agent.do_not_disturb() {
+        return;
+    }
+    crate::audio::message_alert(&agent.session).await;
 }
 
