+/// A new message: its sound, and the screen lit for a glance (t715-keys, SIGUSR2).
+pub async fn message_alert(session: &Connection) {
+    if has_owner(session, "org.sigxcpu.Feedback").await {
+        if let Ok(p) = FeedbackProxy::new(session).await {
+            let sound = p
+                .trigger_feedback(
+                    "org.omamobile.Messages",
+                    "message-new-sms",
+                    HashMap::new(),
+                    -1,
+                )
+                .await;
+            if let Err(e) = sound {
+                tracing::warn!(error = %e, "feedbackd refused the message sound");
+            }
+        }
+    }
+    let wake = tokio::task::spawn_blocking(|| {
+        std::process::Command::new("systemctl")
+            .args(["--user", "kill", "--kill-whom=main", "--signal=SIGUSR2"])
+            .arg("t715-keys.service")
+            .status()
+    })
+    .await;
+    if !matches!(wake, Ok(Ok(s)) if s.success()) {
+        tracing::warn!("the screen was not woken for the message");
+    }
+}
