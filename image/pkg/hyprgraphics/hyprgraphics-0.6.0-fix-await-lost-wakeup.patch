Subject: [PATCH] AsyncResourceGatherer: fix the lost wakeup in await()

await() installed its condition variable after the gather thread could
already have rendered the resource; the gather thread only flagged
awaitingEvent when a cv existed, so a caller doing enqueue() then await()
(Hyprland IHyprRenderer::renderText) could sleep forever. Set
awaitingEvent and check it under awaitingMtx, and set needsToProcess / exit
under requestMutex so the gather thread cannot miss them either.

Upstream: https://github.com/hyprwm/hyprgraphics/issues/53 (PR #52), still
open and unfixed in 0.6.0 (the file is unchanged from 0.5.1). Only
src/resource/AsyncResourceGatherer.cpp changes: same SONAME and ABI.
---
diff --git a/src/resource/AsyncResourceGatherer.cpp b/src/resource/AsyncResourceGatherer.cpp
index 7e3e7de..5444afe 100644
--- a/src/resource/AsyncResourceGatherer.cpp
+++ b/src/resource/AsyncResourceGatherer.cpp
@@ -8,7 +8,10 @@ CAsyncResourceGatherer::CAsyncResourceGatherer() {
 }

 CAsyncResourceGatherer::~CAsyncResourceGatherer() {
-    m_asyncLoopState.exit = true;
+    {
+        std::lock_guard<std::mutex> lg(m_asyncLoopState.requestMutex);
+        m_asyncLoopState.exit = true;
+    }
     wakeUpMainThread();

     if (m_gatherThread.joinable())
@@ -16,7 +19,12 @@ CAsyncResourceGatherer::~CAsyncResourceGatherer() {
 }

 void CAsyncResourceGatherer::wakeUpMainThread() {
-    m_asyncLoopState.needsToProcess = true;
+    {
+        // Set under requestMutex: a store that lands between the gather thread's predicate check and
+        // its wait is otherwise missed, and the request sits until the 5 s wait_for timeout.
+        std::lock_guard<std::mutex> lg(m_asyncLoopState.requestMutex);
+        m_asyncLoopState.needsToProcess = true;
+    }
     m_asyncLoopState.requestsCV.notify_all();
 }

@@ -30,8 +38,13 @@ void CAsyncResourceGatherer::enqueue(Hyprutils::Memory::CAtomicSharedPointer<IAs
 }

 void CAsyncResourceGatherer::await(Hyprutils::Memory::CAtomicSharedPointer<IAsyncResource> resource) {
-    resource->m_impl->awaitingCv = Hyprutils::Memory::makeUnique<std::condition_variable>();
+    // awaitingEvent and awaitingCv are only touched under awaitingMtx, and the gather thread sets
+    // awaitingEvent whether or not a waiter exists yet. Before, a resource that finished before
+    // await() installed its cv was never flagged, and the caller slept forever (lost wakeup).
     std::unique_lock<std::mutex> lk(resource->m_impl->awaitingMtx);
+    if (resource->m_impl->awaitingEvent)
+        return;
+    resource->m_impl->awaitingCv = Hyprutils::Memory::makeUnique<std::condition_variable>();
     resource->m_impl->awaitingCv->wait(lk, [&resource] { return resource->m_impl->awaitingEvent; });
     resource->m_impl->awaitingCv.reset();
 }
@@ -64,9 +77,11 @@ void CAsyncResourceGatherer::asyncAssetSpinLock() {
         for (auto& r : requests) {
             r->render();

-            if (r->m_impl->awaitingCv) {
+            {
+                std::lock_guard<std::mutex> lg(r->m_impl->awaitingMtx);
                 r->m_impl->awaitingEvent = true;
-                r->m_impl->awaitingCv->notify_all();
+                if (r->m_impl->awaitingCv)
+                    r->m_impl->awaitingCv->notify_all();
             }
             r->m_ready = true;
             r->m_events.finished.emit();
