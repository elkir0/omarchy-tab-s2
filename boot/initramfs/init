#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
#
# /init of the SM-T715 (Galaxy Tab S2 8.0 LTE) initramfs: busybox sh, PID 1.
#
# Boots the Arch Linux ARM image stored as a FILE on Android's USERDATA
# partition, without ever writing to that partition (image mode; for the
# persistent root, which does write to it, see "Persistent root" below):
#   1. mount devtmpfs, proc, sysfs, devpts and a /run tmpfs;
#   2. bring up the USB RNDIS debug link exactly like the rootfs does
#      (image/rootfs/overlay/usr/local/sbin/usb-rndis-setup: configfs
#      gadget g1, same IDs, 172.16.42.1/24) plus busybox udhcpd
#      (172.16.42.2-10); the root telnet shell (/bin/sh, that address
#      only) runs when t715.telnet=1 asks for it;
#   3. wait for the partition whose GPT name is USERDATA, make the block
#      device read-only (BLKROSET) and mount it ro,noload on /userdata;
#   4. losetup -r the image, mount it read-only and stack an overlayfs
#      with a tmpfs upper layer on /newroot; copy the packed module tree
#      (lib/modules/RELEASE) into that layer;
#   5. tear the debug link down (usb-rndis.service takes over in Arch),
#      move /run (USERDATA ends up at /run/t715/userdata), /dev, /proc and
#      /sys into the new root and exec switch_root /newroot /sbin/init.
# On any failure: log the reason, keep the debug shell up for
# t715.failwait seconds, then reboot -f (back to Android), or wait on
# screen instead with t715.failreboot=0.  This script never exits on
# purpose: PID 1 exiting would panic the kernel.
#
# Every progress/error line goes to /dev/kmsg prefixed "t715-initramfs:"
# (the kernel log is what survives the reboot) and to
# /run/t715/initramfs.log (kept in /run after the switch_root).  What an
# owner unplugging the tablet at a hotel must see (first-boot progress,
# failures, the space fallback) also goes to the screen through say (),
# which writes to /dev/tty0 whatever the console loglevel is.
#
# Knobs, from the kernel command line (they win) and from /etc/t715-knobs
# (same syntax, written by boot/build-initramfs.sh --knobs):
#   t715.rootimg=PATH    image path inside USERDATA
#                        (default media/0/linux/rootfs.img)
# Image choice without the kernel command line: a file rootfs.select next
# to the default image (Android: /sdcard/linux/rootfs.select) whose first
# line is the name of another image in the same directory, e.g.
# "rootfs-omarchy.img" (letters, digits, . _ -, ending in .img).  Missing
# or invalid names fall back to the default image; t715.rootimg= wins.
# An optional second line "persist=NAME" asks for the persistent root NAME
# (below), seeded from the image of the first line; t715.persist= wins.
#   t715.shell=1         prepare /newroot, then stay in the debug shell;
#                        "touch /tmp/t715-continue" there to switch_root
#   t715.failwait=SECS   debug-shell time before rebooting on failure (300)
#   t715.modules=0       do not insert /lib/t715-modules/*.ko (GPU modules)
#   t715.modblacklist=a,b  write "blacklist a", "blacklist b" into the root's
#                        /etc/modprobe.d (tmpfs layer): udev no longer
#                        autoloads them, modprobe by hand still works
#                        (bring-up tests, e.g. pci_exynos for Wi-Fi)
#   t715.wdtguard=0      boot even if the previous reset was the watchdog
#                        (default: restart to Android at once, see wdt_guard)
#   t715.crashlog=1      TEST IMAGES ONLY: after a watchdog reset, before the
#                        guard's restart, save the previous boot's pstore
#                        records (its console, a panic dump) to
#                        media/0/linux/t715-crash/ on USERDATA, without the
#                        kernel command line, init's environment and MAC
#                        addresses; USERDATA gets e2fsck -p and a read-write
#                        mount for that copy only (see save_crashlog)
#   t715.returnafter=SECS  unattended test boot: SECS seconds after the
#                        hand-over, restart the board (back to Android) through
#                        sysrq "b", and forward the systemd journal to the
#                        kernel log (0: off)
#   t715.rootwait=SECS   how long to wait for USERDATA to appear (20)
#   t715.autotest=1      TEST IMAGES ONLY: once Arch is up, run
#                        t715-autotest.sh from the root image's directory on
#                        USERDATA (Android: /sdcard/linux/) as root, through
#                        a t715-autotest.service written into the tmpfs
#                        layer, with the journal forwarded to the kernel log
#                        (read back from Android in /proc/last_kmsg).  Any
#                        Android app that can write /sdcard can plant that
#                        script, so never bake this knob into a daily image.
#   t715.usbfn=rndis|ecm USB network function (default rndis, as the rootfs)
#   t715.telnet=0|1      1: the root telnet shell on the USB network link
#                        (telnet NET_IP, no password; with 0, the default,
#                        the link still comes up with DHCP but no shell)
#   t715.persist=NAME    persistent root USERDATA/NAME (see below)
#   t715.persist=0       image mode even if rootfs.select asks for a
#                        persistent root (rescue boot)
#   t715.failreboot=0|1  0: after a failure, show the error on screen and
#                        wait (Power + Volume down restarts the board)
#                        instead of rebooting after t715.failwait (1)
#   t715.quiet=1         a quiet screen until the splash: console loglevel
#                        3 from here on (CONFIG_CMDLINE's loglevel=8 comes
#                        after anything sboot or the boot image could add),
#                        the VT cleared and its cursor hidden; say () still
#                        writes first-boot progress and errors to the VT
#   t715.paramrescue=1    a tablet whose only system is started by a loader
#                        in PARAM: PARAM holding neither the stock image nor
#                        the loader known to work (/lib/t715-paramrescue),
#                        that loader is written back and the board restarts
#                        (see param_rescue); default 0
#   t715.golden=1        the installer of the 64-bit system, and its rescue
#                        once it is installed (see "Golden" below; on by
#                        default in a build with --golden); default 0
#   t715.chargemin=N     in S-Boot's charger mode (androidboot.mode=charger:
#                        the tablet was started on a charger with an empty
#                        battery), with the loader in PARAM and the root
#                        installed: stay in the initramfs and charge up to
#                        N %, then restart into Omarchy (10; 0: off)
#   t715.chargepoll=SECS  seconds between two battery reads in the charger
#                        mode (30)
#
# Persistent root (a tablet that keeps no Android): instead of steps 3-4,
# USERDATA is checked (e2fsck -p, /sbin/e2fsck), mounted read-write
# (noatime, errors=remount-ro: its superblock says panic) and the
# directory NAME at its top is bind-mounted on /newroot; changes survive
# reboots.  On the first boot NAME does not exist: a checksum sidecar
# <image>.sha256 (sha256sum format) next to the selected image, when one
# is there, is verified first ("Checking the image..." on screen); a
# sidecar written on Windows (CR LF line endings, a UTF-8 byte order
# mark, an upper-case hash) reads the same and is accepted; then
# the image is attached read-only and its tree copied into
# USERDATA/.NAME.t715-seed by the image's own cp (GNU cp -a keeps owners,
# modes, hard links, xattrs and file capabilities) while the screen shows
# the progress (say ()), the marker .t715-persist is written, then the
# directory is renamed NAME.  A NAME that exists without the marker is
# never touched.  Knob-written files (modprobe blacklist, autotest unit)
# go to /run, not into the root.  If anything fails, the boot falls back to
# image mode with USERDATA read-only again, and the reason goes on screen.
# Host-side tests (boot/tests/test_initramfs.sh) set
# T715_INITRAMFS_TEST=host-test: log to stderr, read the knobs from
# $T715_TEST_CMDLINE, use the test's veth "usb0" instead of the USB
# gadget, keep the test's stdio, exit 99 instead of rebooting (97 with
# t715.failreboot=0: the on-screen wait replaces the exit), print say ()
# lines on stderr prefixed "t715-say:", and leave 1 MiB instead of 512 MiB
# free after a seed (the test's USERDATA is tiny).  Nothing else differs.

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 022

TAG=t715-initramfs
TEST=
if [ "${T715_INITRAMFS_TEST:-}" = host-test ]; then
    TEST=1
fi

# --- USB debug link: same values as the rootfs (usb-rndis-setup and
# --- /etc/usb-rndis/dnsmasq.conf), so the host sees one network.
GADGET_DIR=/sys/kernel/config/usb_gadget
GADGET=$GADGET_DIR/g1
USB_VID=0x05ac
USB_PID=0x0a14
USB_BCDDEVICE=0x0100
USB_BCDUSB=0x0200
USB_SERIAL=0123456789ABCDEF
USB_MANUFACTURER=Samsung
USB_PRODUCT="SM-T715 RNDIS"
NET_IP=172.16.42.1
NET_CIDR=$NET_IP/24
DHCP_START=172.16.42.2
DHCP_END=172.16.42.10
DHCP_LEASE=43200           # 12 h, as dnsmasq.conf
UDC_WAIT=10                # seconds to wait for the USB device controller
IFACE_WAIT=10              # seconds to wait for the gadget's net interface

# --- knob defaults
ROOTIMG=media/0/linux/rootfs.img
ROOTIMG_KNOB=0      # 1 once t715.rootimg= is given: rootfs.select is ignored
SHELL_MODE=0
FAILWAIT=300
ROOTWAIT=20
USBFN=rndis
RETURNAFTER=0
RETURN_TIMER_PID=
WDTGUARD=1
CRASHLOG=0
LOAD_MODULES=1
MODBLACKLIST=       # module names from t715.modblacklist, comma-separated
AUTOTEST=0
PERSIST=            # persistent root directory, or 0 (t715.persist=, rootfs.select)
QUIET=0
PERSIST_KNOB=0      # 1 once t715.persist= is given: rootfs.select's line 2 is ignored
SEED_MARGIN_KIB=524288  # free space a seed must leave on USERDATA (512 MiB)
[ -z "$TEST" ] || SEED_MARGIN_KIB=1024
TELNET=0            # 1: the root telnet shell on the USB network link
FAILREBOOT=1        # 0: wait on screen after a failure instead of rebooting
PARAMRESCUE=0       # 1: put the loader known to work back in PARAM when it is not there
GOLDEN=0            # 1: the installer of the 64-bit system (golden_main)
SBOOT_VERSION=      # androidboot.bootloader: the bootloader's version, from S-Boot's own command line
SBOOT_MODE=         # androidboot.mode: S-Boot's boot mode, "charger" when it started the tablet on a charger
CHARGEMIN=10        # t715.chargemin: the level the charger mode charges up to before starting Omarchy (0: off)
CHARGEPOLL=30       # t715.chargepoll: seconds between two battery reads in the charger mode

# --- paths
RUNDIR=/run/t715
LOGFILE=$RUNDIR/initramfs.log
KMSG=/dev/kmsg
PARAMRESCUE_DIR=/lib/t715-paramrescue   # the loader known to work and the two sha256 (param_rescue)
UD_MNT=/userdata            # USERDATA, read-only (read-write for a persistent root)
UD_FINAL=$RUNDIR/userdata   # where USERDATA lives after the switch_root
LOWER=$RUNDIR/lower         # the image, read-only
RWDIR=$RUNDIR/rw            # tmpfs: overlay upper + work dirs
NEWROOT=/newroot
NEW_INIT=/sbin/init
KNOBS_FILE=/etc/t715-knobs
PERSIST_MARK=.t715-persist  # marks a directory of USERDATA as a persistent root
CONTINUE_FLAG=/tmp/t715-continue
STAY_FLAG=/tmp/t715-stay
SCREEN=/dev/tty0        # the VT say () writes to (t715.quiet cannot mute it)
POWER_SUPPLY_DIR=/sys/class/power_supply
[ -z "$TEST" ] || POWER_SUPPLY_DIR=${T715_TEST_POWER_SUPPLY:-/sys/class/power_supply}   # host-test: the test's fake tree
CPU_SYSFS_DIR=/sys/devices/system/cpu
[ -z "$TEST" ] || CPU_SYSFS_DIR=${T715_TEST_CPU_DIR:-/nonexistent-cpu}   # host-test: never the host's cores

# --- state
NET_UP=
NET_IFACE=
GADGET_FN=
CONFIGFS_MOUNTED=
TELNETD_PID=
UDHCPD_PID=
UD_DEV=
LOOP_DEV=
PERSIST_ON=         # 1 once the persistent root is bind-mounted on /newroot
FAIL_REASON=        # one line for the screen when the boot fails

# ---------------------------------------------------------------------------
# logging

# _log LEVEL MSG...: one line to /dev/kmsg (console fallback) and the log file.
# Each line opens /dev/kmsg anew: the kernel rate-limits per open file.
_log() {
    _l_lvl=$1
    shift
    _l_msg="$TAG: $*"
    if [ -n "$TEST" ]; then
        printf '%s\n' "$_l_msg" >&2
    elif [ -c "$KMSG" ] && printf '<%s>%.900s\n' "$_l_lvl" "$_l_msg" 2>/dev/null >"$KMSG"; then
        :
    else
        printf '%s\n' "$_l_msg" >&2
    fi
    if [ -d "$RUNDIR" ]; then
        printf '%s\n' "$_l_msg" 2>/dev/null >>"$LOGFILE"
    fi
    return 0
}
log() { _log 5 "$@"; }
warn() { _log 4 "WARNING: $*"; }
err() { _log 3 "ERROR: $*"; }

# say MSG...: one line for the owner looking at the black screen, in plain
# words: first-boot progress and failures, which the kernel log (t715.quiet
# sets the console loglevel to 3) would keep invisible for hours.  It goes
# to the VT whatever the loglevel (no console ioctl needed: writing to
# /dev/tty0 cannot be muted) and is logged as usual.  Not for the steps
# that flash by: the screen stays otherwise as quiet as t715.quiet made
# it.  Host-test: stderr, prefixed "t715-say:".
say() {
    if [ -n "$TEST" ]; then
        printf 't715-say: %s\n' "$*" >&2
    elif [ -c "$SCREEN" ] && printf '%s\n' "$*" >"$SCREEN" 2>/dev/null; then
        :
    fi
    log "$@"
    return 0
}

# _log_lines LEVEL TEXT: log every non-empty line of TEXT, indented.
_log_lines() {
    _ll_lvl=$1
    printf '%s\n' "$2" | while IFS= read -r _ll; do
        if [ -n "$_ll" ]; then
            _log "$_ll_lvl" "  $_ll"
        fi
    done
}

# run CMD [ARG...]: run a command; on failure log it with its output.
run() {
    _r_out=$("$@" 2>&1)
    _r_rc=$?
    if [ "$_r_rc" -ne 0 ]; then
        err "'$*' failed (exit $_r_rc)"
        _log_lines 3 "$_r_out"
    fi
    return "$_r_rc"
}

# ---------------------------------------------------------------------------
# helpers

# uint VALUE: print VALUE without leading zeros if it is a small unsigned
# integer (ash arithmetic reads 010 as octal), fail otherwise.
uint() {
    case $1 in
    '' | *[!0-9]*) return 1 ;;
    esac
    [ "${#1}" -le 6 ] || return 1
    _u=${1#"${1%%[!0]*}"}
    printf '%s\n' "${_u:-0}"
}

# persist_name_ok NAME: a persistent root's directory at the top of
# USERDATA: letters, digits, . _ -, not starting with a dot.
persist_name_ok() {
    case $1 in
    '' | .* | *[!A-Za-z0-9._-]*) return 1 ;;
    esac
    [ "${#1}" -le 64 ]
}

# mount_opts MOUNTPOINT: print the options of its last /proc/mounts entry.
mount_opts() {
    _mo=
    [ -r /proc/mounts ] || return 1
    while read -r _ _mo_mp _ _mo_opts _; do
        if [ "$_mo_mp" = "$1" ]; then
            _mo=$_mo_opts
        fi
    done </proc/mounts
    [ -n "$_mo" ] && printf '%s\n' "$_mo"
}

is_mounted() { [ -n "$(mount_opts "$1")" ]; }

is_mounted_ro() {
    case ",$(mount_opts "$1")," in
    *,ro,*) return 0 ;;
    esac
    return 1
}

# ---------------------------------------------------------------------------
# early mounts and knobs

mount_early() {
    mkdir -p /dev /proc /sys /run /tmp
    # devtmpfs first: /dev/kmsg is the log.  (DEVTMPFS_MOUNT does not
    # apply to an initramfs.)
    mount -t devtmpfs -o mode=0755,nosuid devtmpfs /dev
    mount -t proc -o nosuid,nodev,noexec proc /proc
    mount -t sysfs -o nosuid,nodev,noexec sysfs /sys
    mkdir -p /dev/pts
    # Same options as systemd uses, which keeps these mounts.
    mount -t devpts -o nosuid,noexec,gid=5,mode=0620,ptmxmode=000 devpts /dev/pts
    mount -t tmpfs -o mode=0755,nosuid,nodev,size=20% tmpfs /run
    mkdir -p "$RUNDIR"
    for _m in /dev /proc /sys /dev/pts /run; do
        if ! is_mounted "$_m"; then
            err "early mount of $_m failed"
        fi
    done
}

# parse_knobs TEXT SOURCE: apply the t715.* words of TEXT.
parse_knobs() {
    _pk_src=$2
    set -f
    # shellcheck disable=SC2086  # word splitting of the command line is wanted
    set -- $1
    set +f
    for _pk in "$@"; do
        case $_pk in
        t715.rootimg=*)
            ROOTIMG=${_pk#*=}
            ROOTIMG_KNOB=1
            ;;
        t715.shell | t715.shell=1 | t715.shell=y | t715.shell=yes | t715.shell=on | t715.shell=true)
            SHELL_MODE=1
            ;;
        t715.shell=0 | t715.shell=n | t715.shell=no | t715.shell=off | t715.shell=false)
            SHELL_MODE=0
            ;;
        t715.failwait=* | t715.rootwait=* | t715.returnafter=*)
            if _pk_v=$(uint "${_pk#*=}"); then
                case $_pk in
                t715.failwait=*) FAILWAIT=$_pk_v ;;
                t715.returnafter=*) RETURNAFTER=$_pk_v ;;
                *) ROOTWAIT=$_pk_v ;;
                esac
            else
                warn "$_pk_src: ignoring invalid '$_pk' (seconds expected)"
            fi
            ;;
        t715.wdtguard=0 | t715.wdtguard=1)
            WDTGUARD=${_pk#*=}
            ;;
        t715.crashlog=0 | t715.crashlog=1)
            CRASHLOG=${_pk#*=}
            ;;
        t715.modules=0 | t715.modules=1)
            LOAD_MODULES=${_pk#*=}
            ;;
        t715.autotest=0 | t715.autotest=1)
            AUTOTEST=${_pk#*=}
            ;;
        t715.modblacklist=*)
            _pk_v=${_pk#*=}
            case $_pk_v in
            '' | ,* | *, | *,,* | *[!A-Za-z0-9_,-]*)
                warn "$_pk_src: ignoring invalid '$_pk' (module names, comma-separated)"
                ;;
            *) MODBLACKLIST=$_pk_v ;;
            esac
            ;;
        t715.usbfn=rndis | t715.usbfn=ecm)
            USBFN=${_pk#*=}
            ;;
        t715.telnet=0 | t715.telnet=1)
            TELNET=${_pk#*=}
            ;;
        t715.failreboot=0 | t715.failreboot=1)
            FAILREBOOT=${_pk#*=}
            ;;
        t715.quiet=0 | t715.quiet=1)
            QUIET=${_pk#*=}
            ;;
        t715.paramrescue=0 | t715.paramrescue=1)
            PARAMRESCUE=${_pk#*=}
            ;;
        t715.golden=0 | t715.golden=1)
            GOLDEN=${_pk#*=}
            ;;
        t715.chargemin=*)
            if _pk_v=$(uint "${_pk#*=}") && [ "$_pk_v" -le 100 ]; then
                CHARGEMIN=$_pk_v
            else
                warn "$_pk_src: ignoring invalid '$_pk' (a percentage, 0-100, expected)"
            fi
            ;;
        t715.chargepoll=*)
            if _pk_v=$(uint "${_pk#*=}") && [ "$_pk_v" -ge 1 ]; then
                CHARGEPOLL=$_pk_v
            else
                warn "$_pk_src: ignoring invalid '$_pk' (at least 1 second expected)"
            fi
            ;;
        androidboot.bootloader=*)
            # S-Boot's own word: the firmware version, no identifier
            SBOOT_VERSION=${_pk#*=}
            ;;
        androidboot.mode=*)
            # S-Boot's own word: "charger" when it started the tablet on a charger
            SBOOT_MODE=${_pk#*=}
            ;;
        t715.persist=*)
            _pk_v=${_pk#*=}
            if [ "$_pk_v" = 0 ] || persist_name_ok "$_pk_v"; then
                PERSIST=$_pk_v
                PERSIST_KNOB=1
            else
                warn "$_pk_src: ignoring invalid '$_pk' (directory name or 0)"
            fi
            ;;
        t715.*)
            warn "$_pk_src: ignoring unknown or invalid '$_pk'"
            ;;
        esac
    done
}

read_knobs() {
    if [ -r "$KNOBS_FILE" ]; then
        parse_knobs "$(cat "$KNOBS_FILE")" "$KNOBS_FILE"
    fi
    if [ -n "$TEST" ]; then
        _rk_cmdline=${T715_TEST_CMDLINE:-}
    else
        _rk_cmdline=$(cat /proc/cmdline 2>/dev/null)
    fi
    # sboot's own line is ~800 bytes and the kernel keeps 1023: knobs
    # appended at the end of CONFIG_CMDLINE are the first to be cut.
    if [ "${#_rk_cmdline}" -ge 1020 ]; then
        warn "kernel command line is ${#_rk_cmdline} bytes (limit 1023): t715.* knobs at its end may have been cut off"
    fi
    parse_knobs "$_rk_cmdline" "cmdline"
    log "knobs: rootimg=$ROOTIMG shell=$SHELL_MODE failwait=${FAILWAIT}s rootwait=${ROOTWAIT}s usbfn=$USBFN returnafter=${RETURNAFTER}s persist=${PERSIST:-none} quiet=$QUIET telnet=$TELNET failreboot=$FAILREBOOT crashlog=$CRASHLOG paramrescue=$PARAMRESCUE golden=$GOLDEN chargemin=$CHARGEMIN chargepoll=${CHARGEPOLL}s"
}

# ---------------------------------------------------------------------------
# USB debug link

first_udc() {
    for _fu in /sys/class/udc/*; do
        if [ -e "$_fu" ]; then
            printf '%s\n' "${_fu##*/}"
            return 0
        fi
    done
    return 1
}

# cfs_write VALUE FILE
cfs_write() {
    if ! printf '%s\n' "$1" 2>/dev/null >"$2"; then
        err "cannot write '$1' to $2"
        return 1
    fi
}

gadget_up() {
    if ! grep -q '^[^ ]* /sys/kernel/config configfs ' /proc/mounts; then
        run mount -t configfs configfs /sys/kernel/config || return 1
        CONFIGFS_MOUNTED=1
    fi
    if [ ! -d "$GADGET_DIR" ]; then
        err "no $GADGET_DIR: the kernel lacks USB_CONFIGFS/USB_LIBCOMPOSITE (they must be built in, this initramfs has no modules)"
        return 1
    fi
    _gu_waited=0
    while ! _gu_udc=$(first_udc); do
        if [ "$_gu_waited" -ge "$UDC_WAIT" ]; then
            err "no USB device controller in /sys/class/udc after ${UDC_WAIT}s (DWC3 not built in or not probed)"
            return 1
        fi
        sleep 1
        _gu_waited=$((_gu_waited + 1))
    done
    log "USB device controller $_gu_udc found after ${_gu_waited}s"

    GADGET_FN=$USBFN.0
    case $USBFN in
    ecm) _gu_cfgname=ECM ;;
    *) _gu_cfgname=RNDIS ;;
    esac
    run mkdir -p "$GADGET/strings/0x409" "$GADGET/functions/$GADGET_FN" \
        "$GADGET/configs/b.1/strings/0x409" || return 1
    cfs_write "$USB_VID" "$GADGET/idVendor" || return 1
    cfs_write "$USB_PID" "$GADGET/idProduct" || return 1
    cfs_write "$USB_BCDDEVICE" "$GADGET/bcdDevice" || return 1
    cfs_write "$USB_BCDUSB" "$GADGET/bcdUSB" || return 1
    cfs_write "$USB_SERIAL" "$GADGET/strings/0x409/serialnumber" || return 1
    cfs_write "$USB_MANUFACTURER" "$GADGET/strings/0x409/manufacturer" || return 1
    cfs_write "$USB_PRODUCT" "$GADGET/strings/0x409/product" || return 1
    cfs_write "$_gu_cfgname" "$GADGET/configs/b.1/strings/0x409/configuration" || return 1
    if [ ! -L "$GADGET/configs/b.1/$GADGET_FN" ]; then
        run ln -s "$GADGET/functions/$GADGET_FN" "$GADGET/configs/b.1/$GADGET_FN" || return 1
    fi
    cfs_write "$_gu_udc" "$GADGET/UDC" || return 1
    log "configfs gadget g1 ($GADGET_FN, $USB_VID:$USB_PID) bound to $_gu_udc"
}

gadget_iface() {
    _gi=$(cat "$GADGET/functions/$GADGET_FN/ifname" 2>/dev/null)
    if [ -n "$_gi" ] && [ -e "/sys/class/net/$_gi" ]; then
        printf '%s\n' "$_gi"
        return 0
    fi
    for _gi in usb0 rndis0; do
        if [ -e "/sys/class/net/$_gi" ]; then
            printf '%s\n' "$_gi"
            return 0
        fi
    done
    return 1
}

gadget_down() {
    [ -d "$GADGET" ] || return 0
    _gd_ok=1
    if [ -n "$(cat "$GADGET/UDC" 2>/dev/null)" ]; then
        cfs_write "" "$GADGET/UDC" || _gd_ok=
    fi
    for _gd_fn in "$GADGET"/configs/b.1/*.0; do
        if [ -L "$_gd_fn" ]; then
            run rm -f "$_gd_fn" || _gd_ok=
        fi
    done
    for _gd_d in "$GADGET/configs/b.1/strings/0x409" "$GADGET/configs/b.1" \
        "$GADGET"/functions/*.0 "$GADGET/strings/0x409" "$GADGET"; do
        if [ -d "$_gd_d" ]; then
            run rmdir "$_gd_d" || _gd_ok=
        fi
    done
    if [ -n "$_gd_ok" ]; then
        log "configfs gadget g1 removed"
    else
        warn "gadget g1 only partly removed; usb-rndis-setup in Arch reuses an existing g1"
    fi
    if [ -n "$CONFIGFS_MOUNTED" ]; then
        run umount /sys/kernel/config && CONFIGFS_MOUNTED=
    fi
}

# Host-side test only: there is no USB device controller in a container;
# the test creates a veth pair whose usb0 end stands in for the interface
# the gadget would create (and net_down deletes it, like removing the
# gadget function does).
test_link_up() {
    if [ ! -e /sys/class/net/usb0 ]; then
        err "test: no usb0 interface (the test harness creates it)"
        return 1
    fi
    GADGET_FN=veth
}

write_issue() {
    if [ "$TELNET" != 1 ]; then
        return 0
    fi
    cat >/etc/issue.net <<EOF

SM-T715 initramfs debug shell (busybox, t715.telnet=1). Log: $LOGFILE
  touch $CONTINUE_FLAG   switch_root to the prepared $NEWROOT
  touch $STAY_FLAG       cancel the reboot timer after a failure
  reboot -f                  reboot (back to Android)

EOF
}

start_udhcpd() {
    cat >"$RUNDIR/udhcpd.conf" <<EOF
start $DHCP_START
end $DHCP_END
interface $NET_IFACE
max_leases 9
lease_file $RUNDIR/udhcpd.leases
pidfile $RUNDIR/udhcpd.pid
option subnet 255.255.255.0
option lease $DHCP_LEASE
EOF
    # (not ": >file": a redirection error on a special builtin ends the shell)
    printf '' >"$RUNDIR/udhcpd.leases"
    udhcpd -f "$RUNDIR/udhcpd.conf" >>"$RUNDIR/udhcpd.log" 2>&1 &
    UDHCPD_PID=$!
}

start_telnetd() {
    telnetd -F -b "$NET_IP" -l /bin/sh >>"$RUNDIR/telnetd.log" 2>&1 &
    TELNETD_PID=$!
}

# check_daemon NAME PID LOGFILE: warn when a daemon died right away.
check_daemon() {
    if ! kill -0 "$2" 2>/dev/null; then
        err "$1 exited right after start"
        _log_lines 3 "$(cat "$3" 2>/dev/null)"
        return 1
    fi
}

net_up() {
    [ -n "$NET_UP" ] && return 0
    if [ -n "$TEST" ]; then
        test_link_up || return 1
        NET_IFACE=usb0
    else
        gadget_up || return 1
        _nu_waited=0
        while ! NET_IFACE=$(gadget_iface); do
            if [ "$_nu_waited" -ge "$IFACE_WAIT" ]; then
                err "no network interface for $GADGET_FN after ${IFACE_WAIT}s"
                return 1
            fi
            sleep 1
            _nu_waited=$((_nu_waited + 1))
        done
    fi
    run ip link set dev "$NET_IFACE" up || return 1
    if ! ip addr show dev "$NET_IFACE" 2>/dev/null | grep -q "inet $NET_CIDR "; then
        run ip addr add "$NET_CIDR" dev "$NET_IFACE" || return 1
    fi
    NET_UP=1
    write_issue
    start_udhcpd
    if [ "$TELNET" = 1 ]; then
        start_telnetd
    else
        # t715.telnet=0: the link and DHCP still come up (Arch's own
        # services use them after the hand-over), only the shell is off.
        log "telnet shell off (t715.telnet=1 turns it on)"
    fi
    sleep 1
    check_daemon udhcpd "$UDHCPD_PID" "$RUNDIR/udhcpd.log" || UDHCPD_PID=
    if [ "$TELNET" = 1 ]; then
        check_daemon telnetd "$TELNETD_PID" "$RUNDIR/telnetd.log" || TELNETD_PID=
        log "debug link up: $NET_IFACE $NET_CIDR, DHCP $DHCP_START-$DHCP_END, shell: telnet $NET_IP"
    else
        log "debug link up: $NET_IFACE $NET_CIDR, DHCP $DHCP_START-$DHCP_END, no shell (t715.telnet=0)"
    fi
}

# stop_daemon NAME PID: SIGTERM, then SIGKILL after 3 s, then reap.
stop_daemon() {
    [ -n "$2" ] || return 0
    kill "$2" 2>/dev/null
    _sd=0
    while kill -0 "$2" 2>/dev/null && [ "$_sd" -lt 6 ]; do
        sleep 0.5
        _sd=$((_sd + 1))
    done
    kill -s KILL "$2" 2>/dev/null
    wait "$2" 2>/dev/null
    log "$1 stopped"
}

# kill_others SIGNAL: signal every user-space process but PID 1 and the
# t715.returnafter timer; kernel threads (empty cmdline) are left alone,
# as killall5 does.
kill_others() {
    for _ko in /proc/[0-9]*; do
        _ko_pid=${_ko#/proc/}
        if [ "$_ko_pid" = 1 ] || [ "$_ko_pid" = "$RETURN_TIMER_PID" ] ||
            [ ! -r "$_ko/cmdline" ]; then
            continue
        fi
        if [ -n "$(tr -d '\000' <"$_ko/cmdline" 2>/dev/null)" ]; then
            kill -s "$1" "$_ko_pid" 2>/dev/null
        fi
    done
}

net_down() {
    stop_daemon telnetd "$TELNETD_PID"
    TELNETD_PID=
    stop_daemon udhcpd "$UDHCPD_PID"
    UDHCPD_PID=
    # Debug-shell sessions and anything started from them must not
    # survive into the new root.
    kill_others TERM
    sleep 1
    kill_others KILL
    if [ -n "$NET_IFACE" ] && [ -e "/sys/class/net/$NET_IFACE" ]; then
        run ip addr flush dev "$NET_IFACE"
        run ip link set dev "$NET_IFACE" down
    fi
    if [ -n "$TEST" ]; then
        if [ -e /sys/class/net/usb0 ]; then
            run ip link del usb0
        fi
    else
        gadget_down
    fi
    NET_UP=
    NET_IFACE=
    log "debug link down"
}

# ---------------------------------------------------------------------------
# USERDATA, image, overlay

check_rootimg() {
    _cr=$ROOTIMG
    while :; do
        case $_cr in
        /*) _cr=${_cr#/} ;;
        *) break ;;
        esac
    done
    case "/$_cr/" in
    // | */../* | */./* | *//*)
        err "invalid t715.rootimg '$ROOTIMG' (relative path inside USERDATA, no . or .. components)"
        FAIL_REASON="Omarchy could not start: the image setting is wrong. Hold Power and Volume down to restart."
        return 1
        ;;
    esac
    ROOTIMG=$_cr
}

# list_partnames: "DEVNAME PARTNAME" for the eMMC's partitions only, from
# the kernel's uevent files.  A microSD card can carry a copy of a tablet's
# eMMC (a card cloned from one): its USERDATA would stop the boot ("several
# partitions are named USERDATA") and its SYSTEM would feed
# import_device_files two names and copy nothing.  The card is told from
# the eMMC two ways, both from the device tree: the aliases fix the eMMC as
# mmcblk0 and any card as mmcblk1 or above, and the card's block devices
# sit under the SD host 15560000.mmc while the eMMC's sit under
# 15540000.mmc.  Either mark leaves a device out; anything without them
# (the test's loop devices, a disk on another SoC) is kept, as before.
list_partnames() {
    for _lp_ue in /sys/class/block/*/uevent; do
        [ -r "$_lp_ue" ] || continue
        _lp_dev=
        _lp_name=
        while IFS='=' read -r _lp_k _lp_v; do
            case $_lp_k in
            DEVNAME) _lp_dev=$_lp_v ;;
            PARTNAME) _lp_name=$_lp_v ;;
            esac
        done <"$_lp_ue"
        [ -n "$_lp_dev" ] || continue
        case $_lp_dev in
        mmcblk[1-9]*) continue ;; # the card: the eMMC is mmcblk0, by alias
        esac
        case $(readlink -f "/sys/class/block/$_lp_dev" 2>/dev/null) in
        *15560000.mmc*) continue ;; # the SD slot's host, not the eMMC's
        esac
        if [ -n "$_lp_name" ]; then
            printf '%s %s\n' "$_lp_dev" "$_lp_name"
        fi
    done
}

find_userdata() {
    log "waiting up to ${ROOTWAIT}s for the partition named USERDATA"
    _fu_waited=0
    while :; do
        _fu_hits=$(list_partnames | while read -r _fu_d _fu_n; do
            if [ "$_fu_n" = USERDATA ]; then
                printf '%s ' "$_fu_d"
            fi
        done)
        set -f
        # shellcheck disable=SC2086  # count the words
        set -- $_fu_hits
        set +f
        if [ "$#" -gt 1 ]; then
            err "several partitions are named USERDATA ($_fu_hits), refusing to guess"
            FAIL_REASON="Omarchy could not start: the tablet's storage looks unusual. Hold Power and Volume down to restart."
            return 1
        fi
        if [ "$#" -eq 1 ] && [ -b "/dev/$1" ]; then
            UD_DEV=/dev/$1
            log "USERDATA is $UD_DEV (found after ${_fu_waited}s)"
            return 0
        fi
        if [ "$_fu_waited" -ge "$ROOTWAIT" ]; then
            err "no partition named USERDATA after ${ROOTWAIT}s"
            FAIL_REASON="Omarchy could not start: the tablet's storage was not found. Hold Power and Volume down to restart."
            _fu_all=$(list_partnames | tr ' \n' '= ')
            log "named partitions seen: ${_fu_all:-none}"
            return 1
        fi
        sleep 1
        _fu_waited=$((_fu_waited + 1))
    done
}

# check_ext4 DEV: log what the ext4 superblock says before mounting
# (magic 0xEF53 at 1080; s_feature_incompat at 1120, bit 0x4 = RECOVER).
check_ext4() {
    _ce=$(dd if="$1" bs=1 skip=1080 count=44 2>/dev/null | od -An -tu1 -v) || return 0
    set -f
    # shellcheck disable=SC2086  # one byte per word
    set -- $_ce
    set +f
    if [ "$#" -lt 44 ]; then
        warn "could not read the superblock of $UD_DEV"
        return 0
    fi
    if [ "$1" != 83 ] || [ "$2" != 239 ]; then
        err "$UD_DEV has no ext4 superblock (encrypted or not ext4?)"
        return 1
    fi
    shift 40
    if [ $(($1 & 4)) -ne 0 ]; then
        warn "USERDATA journal was not replayed (Android did not unmount it cleanly): mounting without replay, recently written files may look stale"
    fi
}

mount_userdata() {
    # Defence in depth: the block device itself is made read-only before
    # anything mounts it.  Nothing (this script, a remount, a later
    # process in Arch) can then write to it until the next reboot.
    run blockdev --setro "$UD_DEV" || return 1
    if [ "$(blockdev --getro "$UD_DEV" 2>/dev/null)" != 1 ]; then
        err "$UD_DEV did not become read-only"
        FAIL_REASON="Omarchy could not start: the tablet's storage was not found. Hold Power and Volume down to restart."
        return 1
    fi
    log "$UD_DEV set read-only (BLKROSET)"
    check_ext4 "$UD_DEV" || return 1
    mkdir -p "$UD_MNT"
    if ! run mount -t ext4 -o ro,noload,nosuid,nodev,noexec "$UD_DEV" "$UD_MNT"; then
        FAIL_REASON="Omarchy could not start: the tablet's storage could not be read. Hold Power and Volume down to restart."
        return 1
    fi
    if ! is_mounted_ro "$UD_MNT"; then
        err "USERDATA is not mounted read-only ($(mount_opts "$UD_MNT")): unmounting"
        run umount "$UD_MNT"
        FAIL_REASON="Omarchy could not start: the tablet's storage could not be read. Hold Power and Volume down to restart."
        return 1
    fi
    log "USERDATA mounted ro,noload on $UD_MNT"
}

# select_rootimg: rootfs.select next to the default image picks another
# image of the same directory, and optionally a persistent root (see the
# header).  USERDATA is read-only here, so the choice stays until the file
# is changed (from Android, or from Arch on a persistent root).
select_rootimg() {
    [ "$ROOTIMG_KNOB" = 0 ] || return 0
    _sr_dir=${ROOTIMG%/*}
    _sr_file=$UD_MNT/$_sr_dir/rootfs.select
    [ -f "$_sr_file" ] || return 0
    _sr_name=
    _sr_line2=
    {
        IFS= read -r _sr_name || true
        IFS= read -r _sr_line2 || true
    } <"$_sr_file"
    _sr_name=$(printf '%s' "$_sr_name" | tr -d '\r \t')
    _sr_line2=$(printf '%s' "$_sr_line2" | tr -d '\r \t')
    if [ "$PERSIST_KNOB" = 0 ] && [ -n "$_sr_line2" ]; then
        case $_sr_line2 in
        persist=*)
            if persist_name_ok "${_sr_line2#persist=}"; then
                PERSIST=${_sr_line2#persist=}
                log "rootfs.select: persistent root $PERSIST"
            else
                warn "rootfs.select: invalid directory name on line 2, no persistent root"
            fi
            ;;
        *) warn "rootfs.select: line 2 is not persist=NAME, ignored" ;;
        esac
    fi
    case $_sr_name in
    '' | .* | *[!A-Za-z0-9._-]*)
        warn "rootfs.select: invalid image name, booting the default image"
        return 0
        ;;
    *.img) ;;
    *)
        warn "rootfs.select: '$_sr_name' does not end in .img, booting the default image"
        return 0
        ;;
    esac
    if [ ! -f "$UD_MNT/$_sr_dir/$_sr_name" ]; then
        warn "rootfs.select: $_sr_name not found, booting the default image"
        return 0
    fi
    ROOTIMG=$_sr_dir/$_sr_name
    log "rootfs.select: booting $_sr_name"
}

attach_image() {
    _ai_img=$UD_MNT/$ROOTIMG
    if [ ! -f "$_ai_img" ]; then
        err "root image '$ROOTIMG' not found in USERDATA"
        FAIL_REASON="Omarchy could not start: the Linux image file is missing. Hold Power and Volume down to restart."
        # Name the first missing component; never list the owner's files.
        _ai_p=$UD_MNT
        _ai_rest=$ROOTIMG
        while [ -n "$_ai_rest" ]; do
            _ai_c=${_ai_rest%%/*}
            case $_ai_rest in
            */*) _ai_rest=${_ai_rest#*/} ;;
            *) _ai_rest= ;;
            esac
            _ai_p=$_ai_p/$_ai_c
            if [ ! -e "$_ai_p" ]; then
                err "first missing path component: ${_ai_p#"$UD_MNT"/}"
                break
            fi
        done
        return 1
    fi
    _ai_size=$(stat -L -c %s "$_ai_img" 2>/dev/null)
    case $_ai_size in
    '' | *[!0-9]*) _ai_size=0 ;; # an arithmetic error would end the shell
    esac
    log "root image $ROOTIMG: $((_ai_size / 1048576)) MiB"
    if ! LOOP_DEV=$(losetup -f 2>/dev/null) || [ -z "$LOOP_DEV" ]; then
        err "no free loop device (BLK_DEV_LOOP missing?)"
        LOOP_DEV=
        FAIL_REASON="Omarchy could not start: a system limit was hit. Hold Power and Volume down to restart."
        return 1
    fi
    if ! run losetup -r "$LOOP_DEV" "$_ai_img"; then
        err "could not attach $ROOTIMG read-only"
        FAIL_REASON="Omarchy could not start: the Linux image file could not be read. Hold Power and Volume down to restart."
        LOOP_DEV=
        return 1
    fi
    if [ "$(cat "/sys/block/${LOOP_DEV##*/}/ro" 2>/dev/null)" != 1 ]; then
        err "$LOOP_DEV is not read-only: detaching"
        run losetup -d "$LOOP_DEV"
        LOOP_DEV=
        return 1
    fi
    log "image attached read-only on $LOOP_DEV"
}

mount_newroot() {
    mkdir -p "$LOWER" "$RWDIR" "$NEWROOT"
    if ! run mount -t ext4 -o ro,noload "$LOOP_DEV" "$LOWER"; then
        err "could not mount $LOOP_DEV read-only"
        FAIL_REASON="Omarchy could not start: the Linux image file is damaged. Copy it to the tablet again, then restart. Hold Power and Volume down to restart."
        return 1
    fi
    if ! is_mounted_ro "$LOWER"; then
        err "the image is not mounted read-only"
        FAIL_REASON="Omarchy could not start: the Linux image file is damaged. Copy it to the tablet again, then restart. Hold Power and Volume down to restart."
        return 1
    fi
    run mount -t tmpfs -o mode=0755 t715-rw "$RWDIR" || return 1
    mkdir -p "$RWDIR/upper" "$RWDIR/work"
    if ! run mount -t overlay -o "lowerdir=$LOWER,upperdir=$RWDIR/upper,workdir=$RWDIR/work" \
        t715-root "$NEWROOT"; then
        FAIL_REASON="Omarchy could not start: a system limit was hit. Hold Power and Volume down to restart."
        return 1
    fi
    log "overlay root on $NEWROOT: image read-only below, tmpfs above (changes are lost at reboot)"
}

# install_modules: the root images ship no kernel modules.  The tree packed
# by build-initramfs.sh --modules (lib/modules/RELEASE, built with this very
# kernel) is copied into the overlay's tmpfs layer, where udev finds it
# after the switch_root (Bluetooth, Wi-Fi...).  An image with its own tree
# for this release keeps it.  On a persistent root the copy carries a stamp
# (.t715-initramfs: this initramfs' build id, which names the modules'
# tarball) and is replaced when the stamp differs; a tree without the stamp
# is not ours and is kept.  Never fatal: without it, only the modules
# loaded here (GPU) are available.
install_modules() {
    _im_rel=$(uname -r)
    [ -d "/lib/modules/$_im_rel" ] || return 0
    _im_dst=$NEWROOT/lib/modules/$_im_rel
    _im_id=$(cat /etc/t715-initramfs.id 2>/dev/null)
    if [ -e "$_im_dst" ]; then
        if [ -z "$PERSIST_ON" ] || [ ! -f "$_im_dst/.t715-initramfs" ]; then
            log "modules: the root has its own lib/modules/$_im_rel, kept"
            return 0
        fi
        if [ "$(cat "$_im_dst/.t715-initramfs" 2>/dev/null)" = "$_im_id" ]; then
            log "modules: lib/modules/$_im_rel up to date in the persistent root"
            return 0
        fi
        log "modules: replacing lib/modules/$_im_rel (another initramfs build)"
        if ! run rm -rf "$_im_dst"; then
            warn "modules: could not remove the old lib/modules/$_im_rel"
            return 0
        fi
    fi
    if run mkdir -p "$NEWROOT/lib/modules" &&
        run cp -a "/lib/modules/$_im_rel" "$NEWROOT/lib/modules/"; then
        if [ -n "$PERSIST_ON" ]; then
            printf '%s\n' "$_im_id" >"$_im_dst/.t715-initramfs" ||
                warn "modules: could not write the stamp"
            log "modules: lib/modules/$_im_rel installed in the persistent root"
        else
            log "modules: lib/modules/$_im_rel installed in the root (tmpfs layer)"
        fi
    else
        warn "modules: could not install lib/modules/$_im_rel in the root"
    fi
}

# import_device_files: a public image carries neither the Wi-Fi NVRAM nor
# the Bluetooth patch RAM, which are Samsung's, and no SSH key.  The first two
# are copied here from this tablet's own SYSTEM partition, read-only, before
# anything asks for them; the same redaction as the dump script keeps the
# NVRAM's shared macaddr line out.  A key in media/0/linux/authorized_keys is
# installed if the root has none: without Android nothing else writes there,
# and ufw only lets SSH in on the USB cable.  Never fatal: without them there
# is no Wi-Fi, Bluetooth or SSH, and the session still starts.
import_device_files() {
    _if_fw=$NEWROOT/usr/lib/firmware/brcm
    if [ -d "$_if_fw" ] && { [ ! -f "$_if_fw/samsung-gts28/nvram_net.txt" ] || [ ! -f "$_if_fw/BCM4358A3.hcd" ]; }; then
        _if_dev=$(list_partnames | while read -r _if_d _if_n; do
            if [ "$_if_n" = SYSTEM ]; then
                printf '%s' "$_if_d"
            fi
        done)
        if [ -n "$_if_dev" ] && [ -b "/dev/$_if_dev" ]; then
            run blockdev --setro "/dev/$_if_dev"
            mkdir -p /system-ro
            if run mount -t ext4 -o ro,noload,nosuid,nodev,noexec "/dev/$_if_dev" /system-ro; then
                mkdir -p "$_if_fw/samsung-gts28"
                if [ -f /system-ro/etc/wifi/nvram_net.txt ]; then
                    sed 's/^macaddr=.*/macaddr=<REDACTED>/' /system-ro/etc/wifi/nvram_net.txt \
                        >"$_if_fw/samsung-gts28/nvram_net.txt" &&
                        chmod 0644 "$_if_fw/samsung-gts28/nvram_net.txt" &&
                        log "device files: Wi-Fi NVRAM copied from SYSTEM"
                else
                    warn "device files: no NVRAM on SYSTEM"
                fi
                if [ -f /system-ro/vendor/firmware/bcm4358A3_V0086.0144.hcd ]; then
                    cp /system-ro/vendor/firmware/bcm4358A3_V0086.0144.hcd "$_if_fw/BCM4358A3.hcd" &&
                        chmod 0644 "$_if_fw/BCM4358A3.hcd" &&
                        log "device files: Bluetooth patch RAM copied from SYSTEM"
                else
                    warn "device files: no Bluetooth patch RAM on SYSTEM"
                fi
                run umount /system-ro
            else
                warn "device files: could not mount SYSTEM"
            fi
        else
            warn "device files: no partition named SYSTEM"
        fi
    fi
    _if_key=$UD_MNT/media/0/linux/authorized_keys
    if [ -s "$_if_key" ] && [ ! -s "$NEWROOT/root/.ssh/authorized_keys" ]; then
        mkdir -p "$NEWROOT/root/.ssh" "$NEWROOT/home/alarm/.ssh"
        cp "$_if_key" "$NEWROOT/root/.ssh/authorized_keys"
        cp "$_if_key" "$NEWROOT/home/alarm/.ssh/authorized_keys"
        chmod 0700 "$NEWROOT/root/.ssh" "$NEWROOT/home/alarm/.ssh"
        chmod 0600 "$NEWROOT/root/.ssh/authorized_keys" "$NEWROOT/home/alarm/.ssh/authorized_keys"
        chown -R 1000:1000 "$NEWROOT/home/alarm/.ssh"
        log "device files: SSH key installed from media/0/linux/authorized_keys"
    fi
}

# write_modblacklist: t715.modblacklist, see the knob list at the top.
# Into /run/modprobe.d (moved into the new root with /run, read by kmod):
# a knob must not outlive its boot on a persistent root.
write_modblacklist() {
    [ -n "$MODBLACKLIST" ] || return 0
    _wb_f=/run/modprobe.d/t715-knob-blacklist.conf
    if ! run mkdir -p /run/modprobe.d; then
        warn "t715.modblacklist: could not create /run/modprobe.d"
        return 0
    fi
    {
        echo "# t715.modblacklist (initramfs knob): no autoload, modprobe still works"
        printf '%s\n' "$MODBLACKLIST" | tr ',' '\n' | sed 's/^/blacklist /'
    } >"$_wb_f" || warn "t715.modblacklist: could not write $_wb_f"
    log "t715.modblacklist: autoload disabled for $MODBLACKLIST"
}

# write_autotest: t715.autotest, see the knob list at the top.  The unit is
# Type=simple so that the boot transaction completes; the script itself
# waits for the system to settle.  Paths are the ones Arch sees once /run
# has been moved into the new root.  Unit and drop-in go to /run/systemd
# (runtime units), like the blacklist: nothing of a knob stays in the root.
write_autotest() {
    [ "$AUTOTEST" = 1 ] || return 0
    _wa_script=$RUNDIR/userdata/${ROOTIMG%/*}/t715-autotest.sh
    _wa_unit=/run/systemd/system/t715-autotest.service
    if ! run mkdir -p /run/systemd/system/multi-user.target.wants \
        /run/systemd/journald.conf.d; then
        warn "t715.autotest: could not create the systemd directories"
        return 0
    fi
    printf '[Journal]\nForwardToKMsg=yes\nMaxLevelKMsg=info\n' \
        >/run/systemd/journald.conf.d/90-t715-kmsg.conf ||
        warn "t715.autotest: could not enable journal forwarding to the kernel log"
    {
        echo "# t715.autotest (initramfs knob): test images only"
        echo "[Unit]"
        echo "Description=t715.autotest script from the Android storage"
        echo "ConditionPathExists=$_wa_script"
        echo "[Service]"
        echo "Type=simple"
        echo "ExecStart=/bin/sh $_wa_script"
        echo "StandardOutput=journal"
        echo "StandardError=journal"
        echo "SyslogIdentifier=t715-autotest"
    } >"$_wa_unit" || { warn "t715.autotest: could not write $_wa_unit"; return 0; }
    run ln -sfn ../t715-autotest.service \
        /run/systemd/system/multi-user.target.wants/t715-autotest.service ||
        warn "t715.autotest: could not enable t715-autotest.service"
    log "t715.autotest: t715-autotest.service runs $_wa_script once Arch is up"
}

# ---------------------------------------------------------------------------
# persistent root (see the header)

# fsck_userdata: e2fsck -p (preen) before the read-write mount.  Exit 0-3:
# clean or fixed (USERDATA is not mounted, so no reboot is needed); 4 and
# up: errors left, no read-write mount.  Its full output stays in
# /run/t715/e2fsck.log (file names can appear in it), the log gets the
# summary line.
fsck_userdata() {
    if [ ! -x /sbin/e2fsck ]; then
        warn "no /sbin/e2fsck in this initramfs: mounting USERDATA without a check"
        return 0
    fi
    log "checking USERDATA (e2fsck -p)"
    _fs_t0=$(date +%s)
    /sbin/e2fsck -p "$UD_DEV" >"$RUNDIR/e2fsck.log" 2>&1
    _fs_rc=$?
    _fs_sum=$(grep -m 1 -E ': (clean|[0-9]+/[0-9]+ files)' "$RUNDIR/e2fsck.log")
    log "e2fsck exit $_fs_rc after $(($(date +%s) - _fs_t0))s: ${_fs_sum:-$(wc -l <"$RUNDIR/e2fsck.log") lines, see $RUNDIR/e2fsck.log}"
    if [ "$_fs_rc" -ge 4 ]; then
        err "e2fsck left errors on USERDATA (exit $_fs_rc): no read-write mount"
        return 1
    fi
}

# seed_cleanup: undo what seed_persist attached and mounted.
seed_cleanup() {
    if is_mounted "$LOWER/mnt"; then
        run umount "$LOWER/mnt"
    fi
    if is_mounted "$LOWER"; then
        run umount "$LOWER"
    fi
    if [ -n "$LOOP_DEV" ]; then
        run losetup -d "$LOOP_DEV"
        LOOP_DEV=
    fi
}

# seed_persist: first boot of a persistent root.  Each top-level entry of
# the image (lost+found aside) is copied by the image's own /usr/bin/cp,
# chrooted into the image, onto /mnt, where USERDATA/.NAME.t715-seed is
# bind-mounted; /mnt itself is created empty.  The marker goes in last,
# then the directory is renamed NAME.  An interrupted seed leaves only the
# hidden directory, which the next attempt removes.  The owner watching
# the tablet sees the start, a percentage every 10 s and the end (say):
# the copy takes minutes, and the screen is the only feedback without a
# USB cable.
seed_persist() {
    _sp_tmp=$UD_MNT/.$PERSIST.t715-seed
    log "seeding USERDATA/$PERSIST from $ROOTIMG (first boot of this persistent root)"
    say "Setting up Omarchy (first boot), this takes a few minutes"
    attach_image || return 1
    mkdir -p "$LOWER"
    if ! run mount -t ext4 -o ro,noload "$LOOP_DEV" "$LOWER"; then
        seed_cleanup
        return 1
    fi
    if [ ! -d "$LOWER/mnt" ] || [ ! -x "$LOWER/usr/bin/cp" ]; then
        err "the image has no /mnt or no /usr/bin/cp: cannot seed from it"
        seed_cleanup
        return 1
    fi
    _sp_used=$(df -Pk "$LOWER" | awk 'NR == 2 { print $3 }')
    _sp_free=$(df -Pk "$UD_MNT" | awk 'NR == 2 { print $4 }')
    case $_sp_used$_sp_free in
    '' | *[!0-9]*)
        err "could not read the image's use or USERDATA's free space"
        seed_cleanup
        return 1
        ;;
    esac
    if [ -e "$_sp_tmp" ]; then
        log "removing an interrupted seed"
        if ! run rm -rf "$_sp_tmp"; then
            seed_cleanup
            return 1
        fi
        _sp_free=$(df -Pk "$UD_MNT" | awk 'NR == 2 { print $4 }')
    fi
    if [ "$_sp_free" -lt $((_sp_used + SEED_MARGIN_KIB)) ]; then
        err "USERDATA has $((_sp_free / 1024)) MiB free, the seed needs $(((_sp_used + SEED_MARGIN_KIB) / 1024)) MiB"
        # Not fatal for the boot: image mode still starts, but the owner
        # must know why their changes will not survive a reboot.
        _sp_short=$((_sp_used + SEED_MARGIN_KIB - _sp_free))
        [ "$_sp_short" -lt 1048576 ] && _sp_short=1048576
        say "Not enough free space: running from the image; changes are lost at reboot. Free about $((_sp_short / 1048576)) GB and restart"
        seed_cleanup
        return 1
    fi
    if ! run mkdir -m 0755 "$_sp_tmp" || ! run mount --bind "$_sp_tmp" "$LOWER/mnt"; then
        seed_cleanup
        return 1
    fi
    log "copying $((_sp_used / 1024)) MiB from the image (one-time, progress on screen)"
    _sp_t0=$(date +%s)
    # Progress monitor: bytes written to USERDATA since the seed began
    # (statfs of USERDATA; du on the growing tree would compete with the
    # copy for the disk) over the space the image's tree uses.  A say
    # every 10 s (a first one at once: a fast copy still shows something),
    # 1-second sleeps so at most one orphaned sleep outlives the kill
    # below.  Capped at 99 %: 100 % belongs to the final line.
    (
        _sp_b0=$(df -Pk "$UD_MNT" | awk 'NR == 2 { print $3 }')
        case $_sp_b0 in
        '' | *[!0-9]*) exit 0 ;;
        esac
        _sp_i=0
        while :; do
            if [ "$_sp_i" -gt 0 ]; then
                sleep 1
            fi
            _sp_i=$((_sp_i + 1))
            [ $((_sp_i % 10)) -eq 1 ] || continue
            _sp_b=$(df -Pk "$UD_MNT" | awk 'NR == 2 { print $3 }')
            case $_sp_b in
            '' | *[!0-9]*) continue ;;
            esac
            _sp_d=$((_sp_b - _sp_b0))
            [ "$_sp_d" -lt 0 ] && _sp_d=0
            _sp_p=$((_sp_d * 100 / _sp_used))
            [ "$_sp_p" -gt 99 ] && _sp_p=99
            [ "$_sp_p" -lt 1 ] && _sp_p=1
            say "Setting up Omarchy (first boot): $_sp_p%"
        done
    ) &
    _sp_prog=$!
    _sp_rc=0
    for _sp_e in "$LOWER"/* "$LOWER"/.[!.]* "$LOWER"/..?*; do
        [ -e "$_sp_e" ] || [ -L "$_sp_e" ] || continue
        _sp_n=${_sp_e##*/}
        case $_sp_n in
        lost+found) ;;
        mnt) run mkdir -m 0755 "$_sp_tmp/mnt" || _sp_rc=1 ;;
        *) run chroot "$LOWER" /usr/bin/cp -a "/$_sp_n" /mnt/ || _sp_rc=1 ;;
        esac
    done
    kill "$_sp_prog" 2>/dev/null
    wait "$_sp_prog" 2>/dev/null
    if [ "$_sp_rc" != 0 ]; then
        err "copying the image into USERDATA/.$PERSIST.t715-seed failed"
        seed_cleanup
        return 1
    fi
    run umount "$LOWER/mnt" || _sp_rc=1
    if [ "$_sp_rc" != 0 ]; then
        err "copying the image into USERDATA/.$PERSIST.t715-seed failed"
        seed_cleanup
        return 1
    fi
    {
        printf 'persistent root %s, seeded from %s\n' "$PERSIST" "$ROOTIMG"
        printf 'kernel %s, %s\n' "$(uname -r)" "$(cat /etc/t715-initramfs.id 2>/dev/null)"
        printf 'date %s\n' "$(date -u '+%Y-%m-%d %H:%M:%S UTC')"
    } >"$_sp_tmp/$PERSIST_MARK" || _sp_rc=1
    sync
    if [ "$_sp_rc" != 0 ] || ! run mv "$_sp_tmp" "$UD_MNT/$PERSIST"; then
        err "could not finish the seed of USERDATA/$PERSIST"
        seed_cleanup
        return 1
    fi
    sync
    seed_cleanup
    log "USERDATA/$PERSIST seeded in $(($(date +%s) - _sp_t0))s"
    say "Setup finished. Starting Omarchy."
}

# check_image_sum: before a seed (only then: an image-mode boot or an
# existing persistent root never verifies anything), if the selected image
# has a checksum sidecar next to it, <image>.sha256 (sha256sum format, one
# line naming the image's own file name), verify the image with sha256sum
# -c.  Its text is normalized first, so that a sidecar written on Windows
# passes: the CR bytes and one leading UTF-8 byte order mark are dropped
# and the hash is lower-cased; the sidecar itself is never rewritten.
# USERDATA is still mounted read-only here: a mismatch (a truncated
# copy on the tablet) or a malformed sidecar then leaves the tablet byte-
# identical, and the boot falls back to image mode.  A sidecar naming
# anything but the image's own file name is malformed: the sidecar travels
# with the image (same push, same rename), and letting it name another
# file would invite copy/paste mistakes to pass.  No sidecar: no check
# (older images never had one), the boot goes on as before.
check_image_sum() {
    _cs_img=${1:-$UD_MNT/$ROOTIMG}
    _cs_sum=$_cs_img.sha256
    if [ ! -f "$_cs_sum" ]; then
        log "no checksum file for ${_cs_img##*/}, copying without a check"
        return 0
    fi
    say "Checking the image..."
    _cs_dir=${_cs_img%/*}
    _cs_name=${_cs_img##*/}
    # Strip before parsing, never writing anything back: every CR (an
    # editor's CR LF pair) and one leading UTF-8 byte order mark, so the
    # same sidecar written on Linux or on Windows reads the same.
    _cs_txt=$(tr -d '\r' <"$_cs_sum" 2>/dev/null)
    _cs_bom=$(printf '\357\273\277')
    case $_cs_txt in
    "$_cs_bom"*) _cs_txt=${_cs_txt#"$_cs_bom"} ;;
    esac
    # One line: the hash, whitespace, the image's own file name.  Strict
    # on purpose: the sidecar travels with the image (same push, same
    # rename), so anything else is a copy/paste mistake, and a whole
    # SHA256SUMS pasted next to an image must not pass as this image's
    # checksum.
    _cs_nlines=$(printf '%s\n' "$_cs_txt" | grep -c .)
    _cs_line=$(printf '%s\n' "$_cs_txt" | head -n 1)
    _cs_hash=${_cs_line%%[!0-9a-fA-F]*}
    _cs_rest=${_cs_line#"$_cs_hash"}
    case ${_cs_rest} in
    [[:space:]]$_cs_name | [[:space:]]*[[:space:]]$_cs_name | [[:space:]]*"$_cs_name") ;;
    *)
        err "malformed checksum file $_cs_name.sha256 (expected: one line, the hash, the image's file name)"
        _log_lines 3 "$(cat "$_cs_sum" 2>/dev/null)"
        say "The image file is damaged (bad checksum). Copy it to the tablet again."
        return 1
        ;;
    esac
    if [ "${#_cs_hash}" != 64 ] || [ "${_cs_nlines:-0}" != 1 ]; then
        err "malformed checksum file $_cs_name.sha256 (expected: one line, the hash, the image's file name)"
        say "The image file is damaged (bad checksum). Copy it to the tablet again."
        return 1
    fi
    # sha256sum -c runs in the image's directory: sidecars written by
    # sha256sum NAME (GNU or busybox) carry the file name as given, and
    # busybox does not accept absolute paths in the check file.  It reads
    # the normalized line on stdin, never the sidecar's raw bytes: the
    # hash goes lower case, as sha256sum itself prints it.
    _cs_line=$(printf '%s  %s\n' "$(printf '%s' "$_cs_hash" | tr 'A-F' 'a-f')" "$_cs_name")
    _cs_out=$(cd "$_cs_dir" && printf '%s\n' "$_cs_line" | sha256sum -c - 2>&1)
    _cs_rc=$?
    if [ "$_cs_rc" -eq 0 ]; then
        log "image checksum verified ($_cs_name.sha256)"
        return 0
    fi
    err "image checksum check failed: checksum mismatch (exit $_cs_rc)"
    _log_lines 3 "$_cs_out"
    say "The image file is damaged (bad checksum). Copy it to the tablet again."
    return 1
}

# persist_root: USERDATA read-write, the persistent root on /newroot.
persist_root() {
    _pr_dir=$UD_MNT/$PERSIST
    log "persistent root $PERSIST: USERDATA goes read-write"
    if [ ! -e "$_pr_dir" ] && [ ! -L "$_pr_dir" ]; then
        # A first boot seeds: verify the image while USERDATA is still
        # read-only, so a bad sidecar changes nothing on the tablet.
        check_image_sum || return 1
    fi
    run umount "$UD_MNT" || return 1
    run blockdev --setrw "$UD_DEV" || return 1
    fsck_userdata || return 1
    mkdir -p "$UD_MNT"
    # No nosuid/nodev/noexec here: the bind mount of the root inherits the
    # flags of this mount (handoff restricts USERDATA's own view later).
    run mount -t ext4 -o rw,noatime,errors=remount-ro "$UD_DEV" "$UD_MNT" || return 1
    if is_mounted_ro "$UD_MNT"; then
        err "USERDATA came up read-only"
        return 1
    fi
    log "USERDATA mounted rw,noatime,errors=remount-ro on $UD_MNT"
    if [ ! -e "$_pr_dir" ] && [ ! -L "$_pr_dir" ]; then
        seed_persist || return 1
    fi
    if [ -L "$_pr_dir" ] || [ ! -d "$_pr_dir" ] || [ ! -f "$_pr_dir/$PERSIST_MARK" ]; then
        err "USERDATA/$PERSIST exists but is not a persistent root (no $PERSIST_MARK): left untouched"
        return 1
    fi
    mkdir -p "$NEWROOT"
    run mount --bind "$_pr_dir" "$NEWROOT" || return 1
    PERSIST_ON=1
    log "persistent root on $NEWROOT: USERDATA/$PERSIST, read-write ($(head -n 1 "$_pr_dir/$PERSIST_MARK" 2>/dev/null))"
}

# persist_fallback: the persistent root is unusable: back to image mode,
# USERDATA read-only again.
persist_fallback() {
    warn "persistent root $PERSIST unusable: booting the image read-only instead"
    PERSIST_ON=
    if is_mounted "$NEWROOT"; then
        run umount "$NEWROOT"
    fi
    seed_cleanup
    if is_mounted "$UD_MNT"; then
        run umount "$UD_MNT" || return 1
    fi
    mount_userdata
}

prepare_root() {
    check_rootimg || return 1
    find_userdata || return 1
    mount_userdata || return 1
    select_rootimg
    if [ "$PERSIST" = 0 ]; then
        log "t715.persist=0: image mode, USERDATA read-only"
    elif [ -n "$PERSIST" ]; then
        if persist_root; then
            install_modules
            import_device_files
            write_modblacklist
            write_autotest
            return 0
        fi
        persist_fallback || return 1
    fi
    attach_image || return 1
    mount_newroot || return 1
    install_modules
    import_device_files
    write_modblacklist
    write_autotest
}

# ---------------------------------------------------------------------------
# hand-over, failure path

# handoff: only returns on failure.
# t715.returnafter: unattended test boots.  Once switch_root has run, no
# file of the initramfs can be executed any more, so the timer is a
# subshell using only ash builtins (printf, read -t) on descriptors opened
# here: /proc/sysrq-trigger, a FIFO for the 5 s waits and /dev/kmsg.  When
# the time is up it writes "b" (immediate restart): the kernel resets the
# SoC through PMU SWRESET, which keeps INFORM3 = normal (set at boot by the
# kernel), so sboot boots Android.  Do NOT use a watchdog reset for this:
# it clears INFORM3 and sboot then boots RECOVERY again, i.e. this kernel,
# in an endless loop (seen on 2026-10-28).
return_timer_start() {
    [ "$RETURNAFTER" -gt 0 ] || return 0
    if [ ! -w /proc/sysrq-trigger ]; then
        warn "t715.returnafter: no /proc/sysrq-trigger (CONFIG_MAGIC_SYSRQ), no automatic return to Android"
        return 0
    fi
    if ! run mkdir -p "$NEWROOT/etc/systemd/journald.conf.d" ||
        ! printf '[Journal]\nForwardToKMsg=yes\nMaxLevelKMsg=info\n' \
            >"$NEWROOT/etc/systemd/journald.conf.d/90-t715-kmsg.conf"; then
        warn "t715.returnafter: could not enable journal forwarding to the kernel log"
    fi
    run mkfifo "$RUNDIR/return-tick" || return 0
    (
        exec 3>/proc/sysrq-trigger 4<>"$RUNDIR/return-tick" 5>/dev/kmsg || exit 1
        _rt=0
        while [ "$_rt" -lt "$RETURNAFTER" ]; do
            # shellcheck disable=SC3045  # busybox ash has read -t
            read -r -t 5 _rt_x <&4
            _rt=$((_rt + 5))
        done
        printf '<5>t715-initramfs: returnafter: %ss elapsed, restarting (back to Android)\n' "$RETURNAFTER" >&5
        printf b >&3
    ) </dev/null >/dev/null 2>&1 &
    RETURN_TIMER_PID=$!
    log "t715.returnafter: software restart (back to Android) ${RETURNAFTER}s after the hand-over; journal forwarded to the kernel log"
}

handoff() {
    if ! is_mounted "$NEWROOT"; then
        err "$NEWROOT is not mounted"
        FAIL_REASON="Omarchy could not start. Hold Power and Volume down to restart."
        return 1
    fi
    if [ ! -x "$NEWROOT$NEW_INIT" ]; then
        err "$NEW_INIT is missing or not executable in the image"
        FAIL_REASON="Omarchy could not start: the Linux image file is damaged. Copy it to the tablet again, then restart. Hold Power and Volume down to restart."
        return 1
    fi
    if [ "$$" != 1 ]; then
        err "not PID 1, switch_root would refuse"
        return 1
    fi
    if ! command -v switch_root >/dev/null 2>&1; then
        err "switch_root applet missing"
        return 1
    fi
    for _ho_d in dev proc sys run; do
        if [ ! -d "$NEWROOT/$_ho_d" ]; then
            run mkdir -p "$NEWROOT/$_ho_d" || return 1
        fi
    done

    log "handing over to $NEW_INIT"
    [ -n "$TEST" ] || return_timer_start
    net_down
    if is_mounted "$UD_MNT"; then
        mkdir -p "$UD_FINAL"
        run mount --move "$UD_MNT" "$UD_FINAL" || return 1
    fi
    if [ -n "$PERSIST_ON" ]; then
        # Per-mount flags: the root's bind mount keeps exec, suid and devices.
        run mount -o remount,bind,nosuid,nodev,noexec "$UD_FINAL" ||
            warn "could not restrict USERDATA's view at $UD_FINAL (nosuid,nodev,noexec)"
        log "USERDATA stays mounted read-write at $UD_FINAL in Arch; the root is USERDATA/$PERSIST"
    else
        log "USERDATA stays mounted read-only at $UD_FINAL in Arch"
    fi
    log "exec switch_root $NEWROOT $NEW_INIT"
    run mount --move /run "$NEWROOT/run" || return 1
    RUNDIR=$NEWROOT$RUNDIR
    LOGFILE=$RUNDIR/initramfs.log
    run mount --move /dev "$NEWROOT/dev" || return 1
    KMSG=$NEWROOT/dev/kmsg
    run mount --move /proc "$NEWROOT/proc" || return 1
    run mount --move /sys "$NEWROOT/sys" || return 1
    if [ -n "$TEST" ]; then
        exec switch_root "$NEWROOT" "$NEW_INIT"
    fi
    exec switch_root -c /dev/console "$NEWROOT" "$NEW_INIT"
}

# Shell mode: everything is ready, wait for the debug shell's go-ahead.
# Like fail_wait, it reboots after t715.failwait seconds unless the debug
# shell cancels the timer, so an unattended test still returns to Android.
shell_wait() {
    log "t715.shell=1: root ready on $NEWROOT, staying in the initramfs (telnet $NET_IP; touch $CONTINUE_FLAG to switch_root, $STAY_FLAG to cancel the ${FAILWAIT}s reboot timer)"
    _sw_left=$FAILWAIT
    _sw_stay=
    while [ ! -e "$CONTINUE_FLAG" ]; do
        if [ -z "$_sw_stay" ] && [ -e "$STAY_FLAG" ]; then
            _sw_stay=1
            log "reboot timer cancelled from the debug shell"
        fi
        sleep 1
        if [ -z "$_sw_stay" ]; then
            _sw_left=$((_sw_left - 1))
            [ "$_sw_left" -gt 0 ] || do_reboot
        fi
    done
    rm -f "$CONTINUE_FLAG"
    log "continue requested from the debug shell"
}

# fail_wait: returns 0 when the debug shell asks to retry the hand-over,
# 1 when the reboot timer expired.  The reason goes on screen first, then
# what happens next: "rebooting in N seconds", or, with t715.failreboot=0,
# an endless wait (the owner decides when to restart: hold Power and
# Volume down; a battery drained on an error screen is better than five
# minutes of reboot loop in a bag).  The touch flags still work when the
# shell is up (t715.telnet=1).
fail_wait() {
    if [ -z "$FAIL_REASON" ]; then
        FAIL_REASON="Omarchy could not start. Hold Power and Volume down to restart."
    fi
    say "$FAIL_REASON"
    if [ "$FAILREBOOT" = 0 ]; then
        say "waiting: hold Power and Volume down to restart"
        log "boot stopped: waiting on screen instead of rebooting (t715.failreboot=0; $CONTINUE_FLAG retries the switch_root)"
        # Host-test: exit 97 right after the message, so a test can see it.
        if [ -n "$TEST" ]; then
            exit 97
        fi
        while :; do
            if [ -e "$CONTINUE_FLAG" ]; then
                rm -f "$CONTINUE_FLAG"
                log "continue requested from the debug shell"
                return 0
            fi
            sleep 1
        done
    fi
    say "rebooting in ${FAILWAIT} seconds"
    if [ -z "$NET_UP" ]; then
        log "retrying the USB debug link"
        net_up || warn "no USB debug link"
    fi
    log "boot stopped: debug shell on telnet $NET_IP for ${FAILWAIT}s, then reboot (touch $STAY_FLAG to stay, $CONTINUE_FLAG to retry the switch_root)"
    _fw_left=$FAILWAIT
    _fw_stay=
    while [ "$_fw_left" -gt 0 ] || [ -n "$_fw_stay" ]; do
        if [ -e "$CONTINUE_FLAG" ]; then
            rm -f "$CONTINUE_FLAG"
            log "continue requested from the debug shell"
            return 0
        fi
        if [ -z "$_fw_stay" ] && [ -e "$STAY_FLAG" ]; then
            _fw_stay=1
            log "reboot timer cancelled from the debug shell"
        fi
        sleep 1
        if [ -z "$_fw_stay" ]; then
            _fw_left=$((_fw_left - 1))
            if [ "$_fw_left" -gt 0 ] && [ $((_fw_left % 60)) -eq 0 ]; then
                log "rebooting in ${_fw_left}s"
            fi
        fi
    done
    return 1
}

do_reboot() {
    log "rebooting (reboot -f)"
    if [ -n "$TEST" ]; then
        exit 99
    fi
    sync
    while :; do
        reboot -f
        sleep 5
    done
}

# do_poweroff: the charger mode's end when the charger is unplugged: log,
# sync, then poweroff -f in a loop like do_reboot.  Host-test: exit 96.
do_poweroff() {
    log "switching off (poweroff -f)"
    if [ -n "$TEST" ]; then
        exit 96
    fi
    sync
    while :; do
        poweroff -f
        sleep 5
    done
}

# param_rescue: t715.paramrescue, for a tablet whose only system is started
# by a loader in PARAM (bnuuyloader: it starts the arm64 kernel of a slot of
# CACHE) and that keeps no other.  S-Boot boots this kernel (BOOT) when the
# loader hands the boot back, because the arm64 system did not come up, and
# at once when no loader runs at all: one that fails to fire is never
# reached again, and nothing on the tablet could then be reached either.
# So PARAM is looked at first.  $PARAMRESCUE_DIR holds a loader known to
# work (param.img.gz, gzipped) with its sha256 (loader.sha256) and that of
# the tablet's stock PARAM (stock.sha256), written by
# boot/build-initramfs.sh --paramrescue, and the length of that part of
# PARAM (extent; without the file, the whole image).  Only those first
# bytes are compared and ever written: S-Boot keeps data of its own at the
# end of PARAM and writes it whenever it boots a kernel itself (seen
# 2026-11-25), so a loader followed by such data must still be the loader.
# That part of PARAM holding either image is left alone, and so is one
# holding any loader of also.sha256 (others that work, --paramrescue-also):
# the one the owner put there is respected.  Holding anything else, it is a
# loader that did not run: the known one is written over it and read back,
# and the board restarts, which brings the arm64 system back by itself.  With the knob
# off, a file of the directory missing, an image that is not the one its
# sha256 announces, no single partition named PARAM, nothing more happens
# here: the boot goes on to the root image, and so to the failure path and
# its debug shell, as after a write that does not read back.  A loader
# known here is one tablet's own PARAM: such an image is never published.
# Host-test: the write is real (the test's loop disk) and exit 98 replaces
# the restart.
param_rescue() {
    [ "$PARAMRESCUE" = 1 ] || return 0
    if [ ! -s "$PARAMRESCUE_DIR/param.img.gz" ] || [ ! -s "$PARAMRESCUE_DIR/loader.sha256" ] ||
        [ ! -s "$PARAMRESCUE_DIR/stock.sha256" ]; then
        warn "t715.paramrescue: $PARAMRESCUE_DIR lacks a file, nothing done"
        return 0
    fi
    _pr_known=$(cut -d' ' -f1 "$PARAMRESCUE_DIR/loader.sha256")
    _pr_stock=$(cut -d' ' -f1 "$PARAMRESCUE_DIR/stock.sha256")
    if [ "$(zcat "$PARAMRESCUE_DIR/param.img.gz" | sha256sum | cut -d' ' -f1)" != "$_pr_known" ]; then
        warn "t715.paramrescue: param.img.gz is not the image loader.sha256 announces, nothing done"
        return 0
    fi
    _pr_hits=$(list_partnames | while read -r _pr_d _pr_n; do
        if [ "$_pr_n" = PARAM ]; then printf '%s ' "$_pr_d"; fi
    done)
    set -f
    # shellcheck disable=SC2086  # count the words
    set -- $_pr_hits
    set +f
    if [ "$#" -ne 1 ] || [ ! -b "/dev/$1" ]; then
        warn "t715.paramrescue: no single partition named PARAM (${_pr_hits:-none}), nothing done"
        return 0
    fi
    _pr_dev=/dev/$1
    _pr_size=$(cat "$PARAMRESCUE_DIR/extent" 2>/dev/null)
    [ -n "$_pr_size" ] || _pr_size=$(zcat "$PARAMRESCUE_DIR/param.img.gz" | wc -c)
    case $_pr_size in
    '' | *[!0-9]*)
        warn "t715.paramrescue: the loader's length is not a number ('$_pr_size'), nothing done"
        return 0
        ;;
    esac
    _pr_sum=$(head -c "$_pr_size" "$_pr_dev" | sha256sum | cut -d' ' -f1)
    if [ "$_pr_sum" = "$_pr_known" ]; then
        log "t715.paramrescue: the first $_pr_size bytes of PARAM ($_pr_dev) hold the loader known to work, nothing to do"
        return 0
    fi
    if [ "$_pr_sum" = "$_pr_stock" ]; then
        log "t715.paramrescue: the first $_pr_size bytes of PARAM ($_pr_dev) hold the stock image, no loader: nothing to do"
        return 0
    fi
    if [ -s "$PARAMRESCUE_DIR/also.sha256" ] && grep -qx "$_pr_sum" "$PARAMRESCUE_DIR/also.sha256"; then
        log "t715.paramrescue: the first $_pr_size bytes of PARAM ($_pr_dev) hold another loader known to work, nothing to do"
        return 0
    fi
    say "Rescue: PARAM does not hold the loader known to work. Writing it back."
    log "t715.paramrescue: the first $_pr_size bytes of PARAM ($_pr_dev) read back $_pr_sum: neither the loader known to work nor the stock image, writing the loader"
    # Where it differs from the loader, for the record.
    _pr_diff=$(zcat "$PARAMRESCUE_DIR/param.img.gz" | cmp -l - "$_pr_dev" 2>/dev/null | head -n 4096)
    _pr_n=$(printf '%s\n' "$_pr_diff" | grep -c .)
    _pr_at=$(printf '%s\n' "$_pr_diff" | head -n 1 | cut -d' ' -f1)
    log "t715.paramrescue: at least $_pr_n byte(s) of PARAM differ from the loader, the first at byte ${_pr_at:-none} (what follows the loader is not compared)"
    if [ -n "$_pr_at" ]; then
        _pr_skip=$(( (_pr_at - 1) / 16 ))
        log "  PARAM there:      $(dd if="$_pr_dev" bs=16 skip=$_pr_skip count=4 2>/dev/null | od -An -tx1 | tr -s ' \n' ' ')"
        log "  the loader there: $(zcat "$PARAMRESCUE_DIR/param.img.gz" | dd bs=16 skip=$_pr_skip count=4 2>/dev/null | od -An -tx1 | tr -s ' \n' ' ')"
    fi
    # The system of every day keeps PARAM read-only by one of its own rules:
    # a partition's flag is cleared here, a whole disk's is not.
    if [ "$(cat "/sys/class/block/${_pr_dev#/dev/}/ro" 2>/dev/null)" = 1 ]; then
        if run blockdev --setrw "$_pr_dev"; then
            log "t715.paramrescue: PARAM was read-only, made writable"
        else
            err "t715.paramrescue: PARAM is read-only and could not be made writable"
        fi
    fi
    if ! zcat "$PARAMRESCUE_DIR/param.img.gz" | dd of="$_pr_dev" bs=1M conv=fsync 2>/dev/null; then
        err "t715.paramrescue: the write to $_pr_dev failed"
    fi
    sync
    _pr_sum=$(head -c "$_pr_size" "$_pr_dev" | sha256sum | cut -d' ' -f1)
    if [ "$_pr_sum" != "$_pr_known" ]; then
        say "Rescue: PARAM could not be restored. Hold Power and Volume down to restart."
        err "t715.paramrescue: PARAM reads back $_pr_sum after the write, not the loader known to work"
        return 1
    fi
    say "Rescue: the loader known to work is back in PARAM. Restarting."
    log "t715.paramrescue: PARAM reads back as the loader known to work: restarting"
    [ -n "$TEST" ] || sleep 5
    if [ -n "$TEST" ]; then
        exit 98
    fi
    do_reboot
}

# save_crashlog: t715.crashlog, see the knob list at the top.  Called by
# wdt_guard after a watchdog reset, just before its restart, whose own short
# boot would otherwise overwrite the pstore console of the boot that hung
# (2026-11-09).  On a test image USERDATA stayed read-only during that boot,
# so e2fsck -p is quick; it is mounted read-write for the copy only.  The
# kernel command line (and the kernel's list of unknown parameters), init's
# environment (sboot's parameters, identifiers among them) and MAC addresses
# never reach the copy.  Every failure is logged and skipped: the restart
# goes on regardless.
save_crashlog() {
    [ "$CRASHLOG" = 1 ] || return 0
    if [ ! -d /sys/fs/pstore ]; then
        warn "t715.crashlog: no /sys/fs/pstore in this kernel, nothing saved"
        return 0
    fi
    if ! is_mounted /sys/fs/pstore &&
        ! run mount -t pstore -o nosuid,nodev,noexec pstore /sys/fs/pstore; then
        warn "t715.crashlog: pstore not mounted, nothing saved"
        return 0
    fi
    set -- /sys/fs/pstore/*-ramoops-*
    if [ ! -e "$1" ]; then
        log "t715.crashlog: no pstore record of the previous boot"
        return 0
    fi
    find_userdata || return 0
    fsck_userdata || return 0
    mkdir -p "$UD_MNT"
    if ! run mount -t ext4 -o rw,noatime,nosuid,nodev,noexec "$UD_DEV" "$UD_MNT"; then
        warn "t715.crashlog: USERDATA not mounted read-write, nothing saved"
        return 0
    fi
    _sc_dir=$UD_MNT/media/0/linux/t715-crash
    if run mkdir -p "$_sc_dir"; then
        for _sc_f in "$@"; do
            grep -v -i -E 'kernel command line|androidboot\.' "$_sc_f" |
                grep -v -E '^\[ *[0-9.]+\] {4,}[A-Za-z_]+=' |
                sed -E 's/([0-9a-fA-F]{2}[:-]){5}[0-9a-fA-F]{2}/<addr>/g' \
                    >"$_sc_dir/${_sc_f##*/}.txt" ||
                warn "t715.crashlog: could not save ${_sc_f##*/}"
        done
        log "t715.crashlog: $# pstore record(s) of the previous boot saved in media/0/linux/t715-crash/"
    fi
    sync
    run umount "$UD_MNT" || warn "t715.crashlog: USERDATA still mounted"
}

# wdt_guard: a watchdog reset clears INFORM3, and sboot then boots the
# partition it booted last (here RECOVERY, i.e. this kernel) again: a test
# kernel that hangs would loop forever (seen on 2026-10-28).  If the
# watchdog driver reports that the last reset was its own
# (WDIOF_CARDRESET, from PMU RST_STAT), restart at once through a software
# reset: the kernel has set INFORM3 back to normal, so sboot boots Android.
wdt_guard() {
    [ "$WDTGUARD" = 1 ] || return 0
    _wg=/sys/class/watchdog/watchdog0/bootstatus
    if [ ! -r "$_wg" ]; then
        warn "no $_wg: cannot tell a watchdog reset from a normal boot"
        return 0
    fi
    _wg_v=$(cat "$_wg" 2>/dev/null)
    case $_wg_v in
    '' | *[!0-9]*) warn "unreadable watchdog bootstatus '$_wg_v'"; return 0 ;;
    esac
    if [ $((_wg_v & 32)) -ne 0 ]; then
        err "the previous reset was the watchdog (bootstatus $_wg_v): restarting to Android instead of booting (t715.wdtguard=0 to boot anyway)"
        [ -n "$TEST" ] && exit 98
        save_crashlog
        do_reboot
    fi
    log "watchdog bootstatus $_wg_v: not a watchdog reset"
}

# quiet_console: t715.quiet, see the knob list at the top.  Errors still
# reach the kernel log and /run/t715/initramfs.log.
quiet_console() {
    [ "$QUIET" = 1 ] || return 0
    log "t715.quiet: console loglevel 3, VT cleared"
    [ -n "$TEST" ] && return 0
    dmesg -n 3 2>/dev/null || warn "t715.quiet: could not set the console loglevel"
    if [ -c /dev/tty0 ]; then
        printf '\033[2J\033[H\033[?25l' >/dev/tty0 2>/dev/null || true
    fi
}

# load_modules: insert the kernel modules shipped in the initramfs (the GPU:
# gpu-sched, panfrost), in file-name order, after wdt_guard: if a probe
# hangs, the watchdog resets the board and the next boot's wdt_guard sends
# it back to Android instead of looping (2026-10-28: built-in panfrost
# looped).  The modules stay loaded after switch_root.
load_modules() {
    [ "$LOAD_MODULES" = 1 ] || return 0
    for _lm in /lib/t715-modules/*.ko; do
        [ -e "$_lm" ] || continue
        if insmod "$_lm"; then
            log "module ${_lm##*/} loaded"
        else
            warn "module ${_lm##*/} failed to load"
        fi
    done
}

# ---------------------------------------------------------------------------
# Golden: the installer of the 64-bit system (t715.golden=1)
#
# This initramfs, in BOOT and RECOVERY, installs the 64-bit Omarchy
# (omarchy-tab-s2's arm64/: an aarch64 root image that carries its kernel's
# slot) and is its rescue afterwards.  S-Boot starts it whenever PARAM holds
# no loader (a stock tablet: the first start after the flash), and whenever
# the loader hands a boot back (the 64-bit system did not mark itself up).
#
# With PARAM as the firmware ships it, and omarchy-arm64.img with its
# sidecar omarchy-arm64.img.sha256 in the folder "linux" of the internal
# storage (USERDATA/media/0/linux) or of a microSD card (linux/ or its top):
#   1. checks, before any write: S-Boot's version (the loader is made for
#      one bootloader's addresses), PARAM's first EXTENT bytes are the stock
#      image, one of those this installer knows (stock.sha256), the battery,
#      the image's checksum (the sidecar is required), the image (an aarch64
#      root carrying usr/lib/t715-golden/kernel.slot);
#   2. the image's tree into USERDATA/omarchy-arm64 (the arm64 kernel's
#      t715.persist), through USERDATA/.omarchy-arm64.t715-seed, by busybox
#      tar: owners, modes, links and hard links.  tar carries no extended
#      attribute: the image lists its file capabilities, which its own
#      t715-golden-caps.service sets again at the first boot, and its only
#      ACLs are set again by systemd-tmpfiles at every boot (arm64/release
#      makes the list and checks there is nothing else).  Then the Wi-Fi NVRAM and the
#      Bluetooth patch RAM from SYSTEM, and an SSH key when one lies next to
#      the image (import_device_files), so that the first start has both;
#   3. CACHE: when no slot of ours is there yet, Android's /cache, which
#      spans the partition, becomes a 64 MiB file system in front of the two
#      kernel slots (mke2fs); the kernel's slot is written to the slot not in
#      use, one generation above the other, and read back;
#   4. PARAM: the whole stock image saved (USERDATA/media/0/linux/
#      PARAM-stock-backup.img, the owner's way back through download mode,
#      and the root's /var/lib/t715/PARAM-stock.img, this rescue's), the
#      loader forged from it (golden_forge: Samsung's logo.jpg replaced by
#      the loader's, lib/t715-golden/logo.jpg), refused unless it is exactly
#      the loader of the same line of loader.sha256, written over those first EXTENT bytes
#      only (S-Boot keeps data of its own after them), read back;
#   5. the root's .t715-golden marker, the log next to the image, restart:
#      the loader starts the 64-bit kernel of the slot, which boots the root.
# Each step that is done already is skipped, so an interrupted install
# goes on where it stopped at the next start.  PARAM is the last write: until
# then every start comes back here, the stock way.
# With the loader in PARAM and the root installed, a start here is the
# loader's hand-back: the reason goes on screen and the board restarts after
# t715.failwait seconds, which gives the loader its next try.  In S-Boot's
# charger mode (androidboot.mode=charger: the tablet was started on a
# charger with an empty battery) the start is held here instead, to charge
# up to t715.chargemin % first (golden_charge), and restarts into Omarchy at
# that level -- unless a file
# linux/reinstall in the internal storage asks for a reinstall (an upgrade
# from an earlier release, reached through the loader's hand-back): then, once the image is
# found and checked, the installed root is renamed omarchy-arm64.previous
# (kept, never deleted here), the request file goes, and the root is installed
# again as above, with the loader left in PARAM.  With anything
# else in PARAM (another loader) and the root's saved stock image, the loader
# is forged again from it and written back (the rescue).  Every refusal
# writes nothing and waits on screen.
#
# The firmware T715XXU2CRH1 leaves PARAM in two states, and this installer
# knows two of them (stock.sha256, loader.sha256: one line per state, paired by line
# number; golden_sums_ok checks that).  A tablet updated over the air keeps
# the pictures of 2016; one flashed with Odin gets the firmware's own
# param.bin, pictures of 2018.  The two archives hold the same members in the
# same order and differ in logo.jpg's data and in the headers' dates, so the
# loaders forged from them differ too, in the same fields: the loader of
# stock line N is loader line N, never another line.
GOLDEN_DIR=/lib/t715-golden         # logo.jpg, stock.sha256, loader.sha256, extent, bootloader, release
GOLDEN_NAME=omarchy-arm64           # the root's directory on USERDATA
GOLDEN_IMG_NAME=omarchy-arm64.img   # the image, in a folder "linux"
GOLDEN_MARK=.t715-golden            # in the root: installed by this installer
GOLDEN_BACKUP=media/0/linux/PARAM-stock-backup.img
GOLDEN_EFS=media/0/linux/EFS-backup.img     # read only: EFS is never written
GOLDEN_LOG=media/0/linux/omarchy-arm64-install.log
GOLDEN_SAVED=var/lib/t715/PARAM-stock.img   # in the root
GOLDEN_REINSTALL=media/0/linux/reinstall   # asks a reinstall over an installed system
GOLDEN_PREVIOUS=omarchy-arm64.previous     # where that reinstall sets the installed system aside
GOLDEN_MIN_BATTERY=30
GOLDEN_IMG=                         # the image found (golden_find_image)
GOLDEN_SD=                          # 1 once a microSD card is mounted on $SD_MNT
SD_MNT=/sdcard
PARAM_DEV=
EXTENT=
# The kernel's slots in CACHE, in sectors of the partition (the loader's
# layout, elkir0/bnuuyloader t715/docs/PRODUCTION-LOADER.md): a file system
# in the first 64 MiB, slot A at 64 MiB, slot B at 128 MiB, 64 MiB each.  A
# slot: a 4 KiB header ("T7K1", version 1, generation, flags, the image's and
# the device tree's sizes and addresses and FNV-1a 64, then the FNV-1a 64 of
# those 0x30 bytes), the arm64 Image, the device tree.
SLOT_MAGIC=827012948                # 0x314B3754, "T7K1"
SLOT_A=131072
SLOT_B=262144
SLOT_SECTORS=131072
CACHE_FS_KIB=65536

# golden_val NAME: the first word of $GOLDEN_DIR/NAME.  For the files of one
# word (extent, bootloader, release).  stock.sha256 and loader.sha256 hold one
# line per stock PARAM this installer knows, paired by line number (the loader
# of line N is forged from the stock PARAM of line N); they are read by
# golden_stock_line, golden_is_loader and golden_loader_for, never by this one.
golden_val() {
    sed -n '1{s/[[:space:]].*//;p;}' "$GOLDEN_DIR/$1" 2>/dev/null
}

# golden_words NAME: the first word of every line of $GOLDEN_DIR/NAME that
# holds one, one per line, in the file's order.  Lines of blanks only are
# skipped, so that line N of stock.sha256 and line N of loader.sha256 are the
# pair they are written as, wherever a blank line stands: every reader of the
# two sha256 files counts the lines this way, and only this way.
golden_words() {
    # strip the leading blanks, drop what is then empty, keep the first word
    sed -n 's/^[[:space:]]*//;/^$/d;s/[[:space:]].*//;p' "$GOLDEN_DIR/$1" 2>/dev/null
}

# golden_sum_at NAME N: the first word of line N of $GOLDEN_DIR/NAME, nothing
# when there is no such line or its first word is not a lower-case sha256.
# N must be a number: anything else gives nothing (an empty N would else mean
# every line).  The shape of the sum is checked here, by the shell.
golden_sum_at() {
    case $2 in
    '' | *[!0-9]*) return 0 ;;
    esac
    _gsa_w=$(golden_words "$1" | sed -n "${2}p")
    # a lower-case sha256: 64 characters, none but 0-9a-f
    case $_gsa_w in
    *[!0-9a-f]*) return 0 ;;
    esac
    [ "${#_gsa_w}" = 64 ] || return 0
    printf '%s\n' "$_gsa_w"
}

# golden_line_of NAME SUM: N when SUM is the first word of line N of
# $GOLDEN_DIR/NAME (the same count as golden_sum_at), nothing when no line's is.
golden_line_of() {
    case $2 in
    *[!0-9a-f]* | '') return 0 ;;
    esac
    golden_words "$1" | awk -v s="$2" '$0 == s { print NR; exit }'
}

# golden_label_at NAME N: what follows the sum on line N of $GOLDEN_DIR/NAME
# (the same count again), nothing when there is none.  N as in golden_sum_at.
# The line is taken before its sum is cut: a line without a label still is a
# line, and gives nothing.
golden_label_at() {
    case $2 in
    '' | *[!0-9]*) return 0 ;;
    esac
    sed -n '/^[[:space:]]*$/d;s/^[[:space:]]*//;p' "$GOLDEN_DIR/$1" 2>/dev/null |
        sed -n "${2}{s/^[^[:space:]]*[[:space:]]*//;p;}"
}

# golden_named NAME N: how the log names line N of $GOLDEN_DIR/NAME: "line
# N (label)" when the line has a label, "line N" when it has none.
golden_named() {
    _gn_label=$(golden_label_at "$1" "$2")
    if [ -n "$_gn_label" ]; then
        printf 'line %s (%s)' "$2" "$_gn_label"
    else
        printf 'line %s' "$2"
    fi
}

# golden_stock_line SUM: N when SUM is the first word of line N of
# stock.sha256, nothing otherwise.
golden_stock_line() {
    golden_line_of stock.sha256 "$1"
}

# golden_is_loader SUM: true when SUM is the first word of a line of
# loader.sha256.
golden_is_loader() {
    [ -n "$(golden_line_of loader.sha256 "$1")" ]
}

# golden_loader_for N: the first word of line N of loader.sha256, the loader
# forged from the stock PARAM of line N of stock.sha256.
golden_loader_for() {
    golden_sum_at loader.sha256 "$1"
}

# golden_sum_file NAME: how many lines of $GOLDEN_DIR/NAME hold a word, when
# every one of them starts with a lower-case sha256 (a label may follow it,
# separated by blanks; empty lines are allowed and not counted); nothing when
# one does not, or the file cannot be read.  golden_sum_at reads the lines
# back the same way, first word by first word.
golden_sum_file() {
    _gsf_n=0
    {
        while IFS= read -r _gsf_l || [ -n "$_gsf_l" ]; do
            # the first word: what leads the line once its blanks are gone, up
            # to the next blank (the label, if any, follows it)
            _gsf_w=${_gsf_l#"${_gsf_l%%[![:space:]]*}"}
            _gsf_w=${_gsf_w%%[[:space:]]*}
            [ -n "$_gsf_w" ] || continue
            case $_gsf_w in
            *[!0-9a-f]*) return 0 ;;
            esac
            [ "${#_gsf_w}" = 64 ] || return 0
            _gsf_n=$((_gsf_n + 1))
        done
    } 2>/dev/null <"$GOLDEN_DIR/$1" || return 0
    printf '%s\n' "$_gsf_n"
}

# golden_sums_ok: stock.sha256 and loader.sha256 name stock PARAMs and loaders
# in pairs: both are such lists (golden_sum_file), with as many lines, at
# least one.  A file that is not such a list gives no number, which counts as
# no line.
golden_sums_ok() {
    _gso_n=$(golden_sum_file stock.sha256)
    [ "${_gso_n:-0}" -ge 1 ] && [ "$_gso_n" = "$(golden_sum_file loader.sha256)" ]
}

# part_dev NAME: /dev/X of the one partition of the eMMC named NAME.
part_dev() {
    _pd_want=$1
    _pd_hits=$(list_partnames | while read -r _pd_d _pd_n; do
        if [ "$_pd_n" = "$_pd_want" ]; then
            printf '%s ' "$_pd_d"
        fi
    done)
    set -f
    # shellcheck disable=SC2086  # count the words
    set -- $_pd_hits
    set +f
    if [ "$#" -ne 1 ] || [ ! -b "/dev/$1" ]; then
        return 1
    fi
    printf '/dev/%s\n' "$1"
}

# make_rw DEV: clear a partition's read-only flag (the 64-bit system keeps
# PARAM read-only by a rule of its own).
make_rw() {
    if [ "$(cat "/sys/class/block/${1#/dev/}/ro" 2>/dev/null)" = 1 ]; then
        run blockdev --setrw "$1" || return 1
    fi
}

# fnv1a64 FILE SKIP COUNT: "LOW HIGH", the FNV-1a 64 of COUNT bytes of FILE
# from byte SKIP, as two 32-bit words: the loader's hash.  busybox's 64-bit
# arithmetic wraps as the C code does (checked against Python by the tests).
fnv1a64() {
    _fn_h=-3750763034362895579 # 0xcbf29ce484222325
    for _fn_b in $(dd if="$1" bs=1 skip="$2" count="$3" 2>/dev/null | od -An -tu1 -v); do
        _fn_h=$(((_fn_h ^ _fn_b) * 1099511628211))
    done
    printf '%s %s\n' $((_fn_h & 0xFFFFFFFF)) $(((_fn_h >> 32) & 0xFFFFFFFF))
}

# le32 N: the four bytes of N, little-endian, as printf escapes.
le32() {
    printf '\\%03o\\%03o\\%03o\\%03o' $(($1 & 255)) $((($1 >> 8) & 255)) \
        $((($1 >> 16) & 255)) $((($1 >> 24) & 255))
}

# slot_gen FILE_OR_DEV SECTOR: the generation the slot's header there gives,
# nothing when that header is not one of ours (magic, version, its hash).
slot_gen() {
    _sg_f=$RUNDIR/slot-head
    dd if="$1" of="$_sg_f" bs=512 skip="$2" count=1 2>/dev/null || return 0
    set -f
    # shellcheck disable=SC2046  # one word per 32-bit word
    set -- $(od -An -tu4 -N 56 -v "$_sg_f")
    set +f
    [ "$#" -eq 14 ] || return 0
    [ "$1" = "$SLOT_MAGIC" ] && [ "$2" = 1 ] || return 0
    _sg_gen=$3
    _sg_want="${13} ${14}"
    [ "$(fnv1a64 "$_sg_f" 0 48)" = "$_sg_want" ] || return 0
    printf '%s\n' "$_sg_gen"
}

# golden_forge STOCK OUT: OUT = the first EXTENT bytes of the stock PARAM
# image STOCK with the loader's logo.jpg in place of Samsung's.  PARAM's
# first EXTENT bytes are a tar archive (the pictures S-Boot shows); each
# member before and after logo.jpg is copied as it is, logo.jpg's header gets
# the new size and checksum, the archive is padded with zeros to EXTENT
# (elkir0/bnuuyloader's build_calib.py replace_logo, the same bytes).  Only
# golden_param's sha256 check says whether OUT is the loader.
golden_forge() {
    _gf_in=$1
    _gf_out=$2
    _gf_logo=$GOLDEN_DIR/logo.jpg
    _gf_h=$RUNDIR/tar-head
    _gf_len=$(stat -c %s "$_gf_logo" 2>/dev/null)
    case $_gf_len in
    '' | *[!0-9]*) return 1 ;;
    esac
    : >"$_gf_out" || return 1
    _gf_off=0
    _gf_done=
    while [ $((_gf_off + 512)) -le "$EXTENT" ]; do
        dd if="$_gf_in" of="$_gf_h" bs=512 skip=$((_gf_off / 512)) count=1 2>/dev/null || return 1
        [ "$(head -c 1 "$_gf_h" | od -An -tu1 | tr -d ' ')" != 0 ] || break
        _gf_name=$(head -c 100 "$_gf_h" | tr -d '\000')
        _gf_size=$(dd if="$_gf_h" bs=1 skip=124 count=12 2>/dev/null | tr -d '\000 ')
        case $_gf_size in
        '' | *[!0-7]*)
            err "golden: PARAM's archive has a member whose size is not octal ('$_gf_name')"
            return 1
            ;;
        esac
        _gf_size=$((0$_gf_size))
        _gf_blocks=$(((_gf_size + 511) / 512))
        if [ "$_gf_name" = logo.jpg ]; then
            [ -z "$_gf_done" ] || return 1
            {
                head -c 124 "$_gf_h"
                printf '%011o\000' "$_gf_len"
                dd if="$_gf_h" bs=1 skip=136 count=12 2>/dev/null
                printf '        '
                dd if="$_gf_h" bs=1 skip=156 count=356 2>/dev/null
            } >"$_gf_h.new" || return 1
            _gf_sum=$(od -An -tu1 -v "$_gf_h.new" | awk '{ for (i = 1; i <= NF; i++) s += $i } END { print s }')
            {
                head -c 148 "$_gf_h.new"
                printf '%06o\000 ' $((_gf_sum & 2097151))
                tail -c 356 "$_gf_h.new"
                cat "$_gf_logo"
                head -c $(((512 - _gf_len % 512) % 512)) /dev/zero
            } >>"$_gf_out" || return 1
            _gf_done=1
        else
            dd if="$_gf_in" bs=512 skip=$((_gf_off / 512)) count=$((1 + _gf_blocks)) 2>/dev/null >>"$_gf_out" || return 1
        fi
        _gf_off=$((_gf_off + 512 + _gf_blocks * 512))
    done
    rm -f "$_gf_h" "$_gf_h.new"
    if [ -z "$_gf_done" ]; then
        err "golden: no logo.jpg in PARAM's archive"
        return 1
    fi
    _gf_end=$(stat -c %s "$_gf_out")
    if [ $((_gf_end + 1024)) -gt "$EXTENT" ]; then
        err "golden: the forged archive ($_gf_end bytes) does not leave room before byte $EXTENT"
        return 1
    fi
    truncate -s "$EXTENT" "$_gf_out"
}

# golden_param_sum: the sha256 of PARAM's first EXTENT bytes.
golden_param_sum() {
    head -c "$EXTENT" "$PARAM_DEV" 2>/dev/null | sha256sum | cut -d' ' -f1
}

# golden_members FILE: the members of the archive in FILE's first EXTENT
# bytes, read as golden_forge reads them, one line each, "SHA256 SIZE NAME"
# (the sha256 of the member's data; the name kept to letters, digits and
# ._-, others shown as ?), then "end OFFSET": where the archive ends, its
# first header block whose first byte is zero.  A size that is not octal, or
# a member that runs past EXTENT, ends the list with "bad OFFSET" instead.
golden_members() {
    _gl_h=$RUNDIR/tar-head-list
    _gl_off=0
    while [ $((_gl_off + 512)) -le "$EXTENT" ]; do
        if ! dd if="$1" of="$_gl_h" bs=512 skip=$((_gl_off / 512)) count=1 2>/dev/null; then
            echo "bad $_gl_off"
            return 0
        fi
        [ "$(head -c 1 "$_gl_h" | od -An -tu1 | tr -d ' ')" != 0 ] || break
        _gl_name=$(head -c 100 "$_gl_h" | tr -d '\000' | tr -c 'A-Za-z0-9._-' '?')
        _gl_size=$(dd if="$_gl_h" bs=1 skip=124 count=12 2>/dev/null | tr -d '\000 ')
        case $_gl_size in
        '' | *[!0-7]*)
            echo "bad $_gl_off"
            return 0
            ;;
        esac
        _gl_size=$((0$_gl_size))
        _gl_blocks=$(((_gl_size + 511) / 512))
        if [ $((_gl_off + 512 + _gl_blocks * 512)) -gt "$EXTENT" ]; then
            echo "bad $_gl_off"
            return 0
        fi
        _gl_sum=$(dd if="$1" bs=512 skip=$((_gl_off / 512 + 1)) count="$_gl_blocks" 2>/dev/null |
            head -c "$_gl_size" | sha256sum | cut -d' ' -f1)
        echo "$_gl_sum $_gl_size ${_gl_name:-?}"
        _gl_off=$((_gl_off + 512 + _gl_blocks * 512))
    done
    rm -f "$_gl_h"
    echo "end $_gl_off"
}

# golden_archive FILE: what the archive in FILE's first EXTENT bytes is, for
# a PARAM that is not, byte for byte, the stock image or the loader.
# $RUNDIR/param-members gets golden_members' lines; GA_END is where the
# archive ends, GA_SUM the sha256 of the first EXTENT bytes with those after
# that end taken as zeros (the archive alone: S-Boot reads nothing else
# there), GA_TAIL how many bytes after the end are not zero.  GA_END and
# GA_SUM are empty when the archive cannot be read.  A flash of the stock
# firmware writes its archive and may leave older bytes after it: the stock
# archive with such bytes is still a stock image (GA_SUM is a line of
# stock.sha256), and the loader, forged from the members alone, has zeros there.
golden_archive() {
    GA_END=
    GA_SUM=
    GA_TAIL=
    golden_members "$1" >"$RUNDIR/param-members"
    GA_END=$(sed -n 's/^end //p' "$RUNDIR/param-members")
    [ -n "$GA_END" ] || return 0
    GA_SUM=$({
        head -c "$GA_END" "$1"
        head -c $((EXTENT - GA_END)) /dev/zero
    } | sha256sum | cut -d' ' -f1)
    GA_TAIL=$(dd if="$1" bs=512 skip=$((GA_END / 512)) count=$(((EXTENT - GA_END) / 512)) 2>/dev/null |
        tr -d '\000' | wc -c | tr -d ' ')
}

# golden_param_report: after golden_archive "$PARAM_DEV", on screen and in
# the log, how PARAM's archive differs from a stock one (stock.members: the
# members of one of them, the firmware's own param.bin): the pictures that
# differ, are missing or are not in it, and the bytes after its end, so that a photo of
# the screen says what this tablet's PARAM holds.  Names and sizes of
# Samsung's pictures only: nothing of the tablet's own (S-Boot keeps that
# after EXTENT, never read here).
golden_param_report() {
    while read -r _rp_sum _rp_size _rp_name; do
        case $_rp_sum in
        end | bad) ;;
        *) log "golden: PARAM member $_rp_name, $_rp_size bytes, sha256 $_rp_sum" ;;
        esac
    done <"$RUNDIR/param-members"
    _rp_bad=$(sed -n 's/^bad //p' "$RUNDIR/param-members")
    if [ -n "$_rp_bad" ]; then
        say "PARAM: its first $EXTENT bytes are not an archive of pictures that can be read (at byte $_rp_bad)."
        return 0
    fi
    if [ -s "$GOLDEN_DIR/stock.members" ]; then
        # "missing NAME SIZE", "differs NAME SIZE STOCK_SIZE", "extra NAME
        # SIZE", "count N STOCK_N", in the stock archive's order, then this one's.
        awk 'NR == FNR {
                if ($1 != "end" && $1 != "bad") { s[$3] = $1; z[$3] = $2; o[++n] = $3 }
                next
             }
             { st[$3] = $1; sz[$3] = $2; so[++m] = $3 }
             END {
                for (i = 1; i <= m; i++) {
                    k = so[i]
                    if (!(k in s)) print "missing " k " " sz[k]
                    else if (s[k] != st[k]) print "differs " k " " z[k] " " sz[k]
                }
                for (i = 1; i <= n; i++) if (!(o[i] in st)) print "extra " o[i] " " z[o[i]]
                if (n != m) print "count " n " " m
             }' "$RUNDIR/param-members" "$GOLDEN_DIR/stock.members" >"$RUNDIR/param-diff"
        _rp_n=0
        while read -r _rp_what _rp_a _rp_b _rp_c; do
            _rp_n=$((_rp_n + 1))
            if [ "$_rp_n" -gt 8 ]; then
                continue
            fi
            case $_rp_what in
            missing) say "PARAM: $_rp_a is missing (stock: $_rp_b bytes)." ;;
            differs) say "PARAM: $_rp_a is not the stock one ($_rp_b bytes, stock: $_rp_c)." ;;
            extra) say "PARAM: $_rp_a ($_rp_b bytes) is not in the stock archive." ;;
            count) say "PARAM: $_rp_a pictures, stock: $_rp_b." ;;
            esac
        done <"$RUNDIR/param-diff"
        if [ "$_rp_n" -gt 8 ]; then
            say "PARAM: and $((_rp_n - 8)) other differences."
        elif [ "$_rp_n" = 0 ]; then
            say "PARAM: the stock pictures, but the archive's headers or their order differ."
        fi
    else
        say "PARAM: $(grep -c -v -E '^(end|bad) ' "$RUNDIR/param-members") pictures."
    fi
    if [ "${GA_TAIL:-0}" -gt 0 ]; then
        say "PARAM: $GA_TAIL bytes after the archive (bytes $GA_END to $EXTENT) are not zero."
    fi
}

# golden_write_param IMG: IMG (EXTENT bytes, checked by the caller) over
# PARAM's first EXTENT bytes, read back: they must be IMG's sha256, and that
# must be a line of loader.sha256 (any of them: which one is the caller's
# choice, golden_forge_checked's).
golden_write_param() {
    _gw_want=$(head -c "$EXTENT" "$1" 2>/dev/null | sha256sum | cut -d' ' -f1)
    # never write what is not a loader this installer knows, whatever the caller checked
    if ! golden_is_loader "$_gw_want"; then
        err "golden: $1 is $_gw_want, not a loader this installer knows: nothing written"
        return 1
    fi
    make_rw "$PARAM_DEV" || return 1
    if ! dd if="$1" of="$PARAM_DEV" bs=512 count=$((EXTENT / 512)) conv=notrunc,fsync 2>/dev/null; then
        err "golden: the write to PARAM ($PARAM_DEV) failed"
    fi
    sync
    _gw_sum=$(golden_param_sum)
    if [ "$_gw_sum" != "$_gw_want" ]; then
        err "golden: PARAM reads back $_gw_sum after the write, not the loader written ($_gw_want)"
        return 1
    fi
    _gw_line=$(golden_line_of loader.sha256 "$_gw_sum")
    if [ -z "$_gw_line" ]; then
        err "golden: PARAM reads back $_gw_sum after the write, which is not a loader this installer knows"
        return 1
    fi
    log "golden: PARAM holds the loader (sha256 ${_gw_sum%"${_gw_sum#????????????}"}...), $(golden_named loader.sha256 "$_gw_line")"
}

# golden_forge_checked STOCK: the loader forged from STOCK into
# $RUNDIR/param-loader.img, refused unless STOCK is a stock PARAM this
# installer knows and the forged image is the loader of the same line.
golden_forge_checked() {
    _gc_stock=$(head -c "$EXTENT" "$1" | sha256sum | cut -d' ' -f1)
    _gc_line=$(golden_stock_line "$_gc_stock")
    if [ -z "$_gc_line" ]; then
        golden_archive "$1"
        _gc_line=$(golden_stock_line "${GA_SUM:-}")
        if [ -z "$_gc_line" ]; then
            err "golden: $1 is not a stock PARAM this installer knows ($_gc_stock)"
            return 1
        fi
        log "golden: $1 is a stock archive this installer knows, $(golden_named stock.sha256 "$_gc_line")"
        log "golden: $1 holds the stock archive, and $GA_TAIL bytes after its end (byte $GA_END) that are not zero: the loader has zeros there"
    else
        log "golden: $1 is a stock PARAM this installer knows, $(golden_named stock.sha256 "$_gc_line")"
    fi
    golden_forge "$1" "$RUNDIR/param-loader.img" || return 1
    _gc_sum=$(sha256sum "$RUNDIR/param-loader.img" | cut -d' ' -f1)
    _gc_want=$(golden_loader_for "$_gc_line")
    if [ -z "$_gc_want" ]; then
        err "golden: $GOLDEN_DIR has no loader for line $_gc_line of stock.sha256: nothing written"
        return 1
    fi
    if [ "$_gc_sum" != "$_gc_want" ]; then
        if golden_is_loader "$_gc_sum"; then
            err "golden: the loader forged from the stock PARAM of $(golden_named stock.sha256 "$_gc_line") is the loader of another stock PARAM ($_gc_sum): nothing written"
        else
            err "golden: the loader forged from the stock PARAM is $_gc_sum, not the one this installer was built for: nothing written"
        fi
        return 1
    fi
    log "golden: the loader forged from the stock PARAM is the expected one, $(golden_named loader.sha256 "$_gc_line")"
}

# golden_battery: wait for GOLDEN_MIN_BATTERY % (an install takes about a
# quarter of an hour of eMMC writes); no battery level, no wait.
golden_battery() {
    [ -z "$TEST" ] || return 0
    _gb_f=
    for _gb in /sys/class/power_supply/*/capacity; do
        if [ -r "$_gb" ]; then
            _gb_f=$_gb
            break
        fi
    done
    if [ -z "$_gb_f" ]; then
        log "golden: no battery level in this kernel, not checked"
        return 0
    fi
    while :; do
        _gb_c=$(cat "$_gb_f" 2>/dev/null)
        case $_gb_c in
        '' | *[!0-9]*) return 0 ;;
        esac
        if [ "$_gb_c" -ge "$GOLDEN_MIN_BATTERY" ]; then
            log "golden: battery at $_gb_c %"
            return 0
        fi
        say "Battery at $_gb_c %. Plug the charger in: the install starts at $GOLDEN_MIN_BATTERY %."
        sleep 60
    done
}

# golden_battery_dir: the first supply of type Battery under
# $POWER_SUPPLY_DIR that has a readable numeric capacity, as a directory.
golden_battery_dir() {
    for _gch_s in "$POWER_SUPPLY_DIR"/*; do
        [ -r "$_gch_s/type" ] || continue
        [ "$(cat "$_gch_s/type" 2>/dev/null)" = Battery ] || continue
        case $(cat "$_gch_s/capacity" 2>/dev/null) in
        '' | *[!0-9]*) continue ;;
        esac
        printf '%s\n' "$_gch_s"
        return 0
    done
    return 1
}

# golden_capacity: the battery's capacity, digits only, or nothing.
golden_capacity() {
    _gch_b=$(golden_battery_dir) || return 1
    _gch_c=$(cat "$_gch_b/capacity" 2>/dev/null)
    _gch_c=$(uint "$_gch_c") || return 1
    printf '%s\n' "$_gch_c"
}

# golden_charger_online: true when any supply of type Mains or USB under
# $POWER_SUPPLY_DIR has online = 1.  The battery's own status is never read
# for this: it says "Not charging" while the charger is online
# (docs/hardware/BATTERY.md).
golden_charger_online() {
    for _gch_s in "$POWER_SUPPLY_DIR"/*; do
        [ -r "$_gch_s/type" ] || continue
        case $(cat "$_gch_s/type" 2>/dev/null) in
        Mains | USB) ;;
        *) continue ;;
        esac
        if [ "$(cat "$_gch_s/online" 2>/dev/null)" = 1 ]; then
            return 0
        fi
    done
    return 1
}

# golden_milli MICRO: a sysfs value in micro-units (uA, uV) as a whole
# number of milli-units, "?" when it is not a number.
golden_milli() {
    case $1 in
    '' | - | *[!0-9-]* | ?*-*) printf '?' ;;
    *) printf '%s' "$(($1 / 1000))" ;;
    esac
}

# golden_tenths TENTHS: a temperature in tenths of a degree as "31.5", "?"
# when it is not a number.
golden_tenths() {
    case $1 in
    '' | - | *[!0-9-]* | ?*-*) printf '?' ;;
    -*) printf '%s' "$1" ;;
    *) printf '%s.%s' "$(($1 / 10))" "$(($1 % 10))" ;;
    esac
}

# golden_charge_cpus: the charger mode runs on one core.  This kernel has
# no cpuidle and the initramfs loads no cpufreq driver, so eight idle cores
# at the frequency S-Boot left draw what the charger brings: cores 1 to 7
# go offline, as the 32-bit system's suspend takes them offline (CPU
# hotplug).  The restart at the end brings them back.  A core that will not
# go offline is logged and left as it is.
golden_charge_cpus() {
    _gcc_n=0
    for _gcc in 1 2 3 4 5 6 7; do
        _gcc_f=$CPU_SYSFS_DIR/cpu$_gcc/online
        [ -w "$_gcc_f" ] || continue
        [ "$(cat "$_gcc_f" 2>/dev/null)" = 1 ] || continue
        if echo 0 >"$_gcc_f" 2>/dev/null; then
            _gcc_n=$((_gcc_n + 1))
        else
            warn "golden: charger mode: cpu$_gcc would not go offline"
        fi
    done
    log "golden: charger mode: $_gcc_n core(s) taken offline, cpu0 charges alone"
}

# golden_charge: S-Boot's charger mode (androidboot.mode=charger: the tablet
# was started on a charger with an empty battery), with the loader in PARAM
# and the root installed: instead of handing the start back and rebooting
# into a system that drains the empty battery, stay in the initramfs and let
# this 32-bit kernel's charger driver charge.  It runs only when all of
# these hold: SBOOT_MODE is charger, CHARGEMIN is above 0, a battery capacity
# can be read, and a Mains/USB supply exists; otherwise the log says why and
# the hand-back follows unchanged.  When it runs: at CHARGEMIN % or above, it
# restarts into Omarchy at once; below, it reads the battery every
# CHARGEPOLL seconds and shows the level on screen, restarts into Omarchy at
# CHARGEMIN %, switches off when the charger has been offline on two
# consecutive reads, and falls back to the hand-back when the capacity cannot
# be read any more.  Nothing is written to any partition.
golden_charge() {
    if [ "$SBOOT_MODE" != charger ]; then
        log "golden: androidboot.mode is '${SBOOT_MODE:-not given}', not charger: no charging here"
        return 0
    fi
    if [ "$CHARGEMIN" -le 0 ]; then
        log "golden: t715.chargemin=0, the charger mode is off"
        return 0
    fi
    if ! _gch_c=$(golden_capacity); then
        log "golden: no battery capacity can be read in $POWER_SUPPLY_DIR: no charging here"
        return 0
    fi
    _gch_ac=
    for _gch_s in "$POWER_SUPPLY_DIR"/*; do
        [ -r "$_gch_s/type" ] || continue
        case $(cat "$_gch_s/type" 2>/dev/null) in
        Mains | USB) _gch_ac=$_gch_s; break ;;
        esac
    done
    if [ -z "$_gch_ac" ]; then
        log "golden: no Mains or USB supply in $POWER_SUPPLY_DIR: no charging here"
        return 0
    fi
    if [ "$_gch_c" -ge "$CHARGEMIN" ]; then
        say "Battery at $_gch_c %, charger connected: starting Omarchy."
        log "golden: charger mode: the battery is at $_gch_c %, at or above t715.chargemin=$CHARGEMIN: starting Omarchy"
        do_reboot
    fi
    log "golden: charger mode: charging from $_gch_c % up to $CHARGEMIN % (t715.chargemin), a read every $CHARGEPOLL s (t715.chargepoll)"
    golden_charge_cpus
    _gch_off=0
    # The first read is shown at once, then one every CHARGEPOLL seconds.
    while :; do
        if ! _gch_c=$(golden_capacity); then
            log "golden: charger mode: the battery capacity cannot be read any more, the hand-back follows"
            return 0
        fi
        _gch_b=$(golden_battery_dir)
        _gch_v=$(cat "$_gch_b/voltage_now" 2>/dev/null)
        _gch_i=$(cat "$_gch_b/current_now" 2>/dev/null)
        _gch_t=$(cat "$_gch_b/temp" 2>/dev/null)
        _gch_l=$(cat "$_gch_ac/input_current_limit" 2>/dev/null)
        if golden_charger_online; then
            _gch_on=1
            _gch_off=0
        else
            _gch_on=0
            _gch_off=$((_gch_off + 1))
        fi
        if [ -z "$TEST" ] && [ -c "$SCREEN" ]; then
            printf '\033[2J\033[H' >"$SCREEN" 2>/dev/null || true
        fi
        say "Charging: $_gch_c %. Omarchy starts at $CHARGEMIN %."
        say "Battery: $(golden_milli "$_gch_i") mA, $(golden_tenths "$_gch_t") C. Charger limit: $(golden_milli "$_gch_l") mA."
        say "Unplug the charger to switch off."
        log "golden: charger mode: capacity $_gch_c %, voltage ${_gch_v:-?} uV, current ${_gch_i:-?} uA, temp ${_gch_t:-?} tenths of a degree, input limit ${_gch_l:-?} uA, charger online $_gch_on"
        if [ "$_gch_c" -ge "$CHARGEMIN" ]; then
            say "Charged to $_gch_c %: starting Omarchy."
            log "golden: charger mode: charged to $_gch_c %, at or above t715.chargemin=$CHARGEMIN: starting Omarchy"
            do_reboot
        fi
        if [ "$_gch_off" -ge 2 ]; then
            say "Charger unplugged: switching off."
            log "golden: charger mode: the charger has been offline on two consecutive reads: switching off"
            do_poweroff
        fi
        sleep "$CHARGEPOLL"
    done
}

# golden_asv: the chip's ASV fuse word (table version, fused groups), read
# only and logged.  The 64-bit kernel's CPU voltage tables are the
# reference tablet's chip's (ASV table 8, group 1, fuse word 0x33010008), as
# in the 32-bit releases since 1.0.1: another word is said on screen, not
# refused.  Never the CHIPID words that identify the chip.
golden_asv() {
    [ -z "$TEST" ] || return 0
    _ga=$(devmem 0x1000400C 32 2>/dev/null)
    case $_ga in
    0x33010008 | 0X33010008)
        log "golden: ASV fuse word $_ga, as the reference tablet's chip"
        ;;
    0x* | 0X*)
        warn "golden: ASV fuse word $_ga, not the reference chip's 0x33010008"
        say "Note: this chip's voltage fuses differ from the reference tablet's (see the install guide)."
        ;;
    *) log "golden: the ASV fuse word could not be read" ;;
    esac
}

# golden_find_image: GOLDEN_IMG = the image in the folder linux of the
# internal storage, else of a microSD card (linux/, or its top), mounted
# read-only on $SD_MNT.
golden_find_image() {
    GOLDEN_IMG=
    if [ -f "$UD_MNT/media/0/linux/$GOLDEN_IMG_NAME" ]; then
        GOLDEN_IMG=$UD_MNT/media/0/linux/$GOLDEN_IMG_NAME
        log "golden: the image is in the internal storage (media/0/linux/$GOLDEN_IMG_NAME)"
        return 0
    fi
    [ -z "$TEST" ] || return 1
    # the card is found by the kernel a moment after the eMMC
    _gi_w=0
    while [ ! -b /dev/mmcblk1 ] && [ "$_gi_w" -lt 10 ]; do
        sleep 1
        _gi_w=$((_gi_w + 1))
    done
    for _gi_sd in /dev/mmcblk1p1 /dev/mmcblk1; do
        [ -b "$_gi_sd" ] || continue
        mkdir -p "$SD_MNT"
        if run mount -o ro,nosuid,nodev,noexec "$_gi_sd" "$SD_MNT"; then
            GOLDEN_SD=1
            for _gi_p in "$SD_MNT/linux/$GOLDEN_IMG_NAME" "$SD_MNT/$GOLDEN_IMG_NAME"; do
                if [ -f "$_gi_p" ]; then
                    GOLDEN_IMG=$_gi_p
                    log "golden: the image is on the microSD card (${_gi_p#"$SD_MNT"/})"
                    return 0
                fi
            done
            run umount "$SD_MNT"
            GOLDEN_SD=
        fi
    done
    return 1
}

# golden_cleanup: undo the mounts of an earlier attempt (the debug shell can
# ask for another one).
golden_cleanup() {
    seed_cleanup
    GOLDEN_CHECKED=
    if [ -n "$GOLDEN_SD" ] && is_mounted "$SD_MNT"; then
        run umount "$SD_MNT"
    fi
    GOLDEN_SD=
    if is_mounted "$UD_MNT"; then
        sync
        run umount "$UD_MNT"
    fi
}

# golden_userdata_rw: USERDATA read-write (e2fsck -p first), as for a
# persistent root.
golden_userdata_rw() {
    if is_mounted "$UD_MNT" && ! is_mounted_ro "$UD_MNT"; then
        return 0
    fi
    if is_mounted "$UD_MNT"; then
        run umount "$UD_MNT" || return 1
    fi
    run blockdev --setrw "$UD_DEV" || return 1
    fsck_userdata || return 1
    mkdir -p "$UD_MNT"
    run mount -t ext4 -o rw,noatime,nosuid,nodev,errors=remount-ro "$UD_DEV" "$UD_MNT" || return 1
    if is_mounted_ro "$UD_MNT"; then
        err "USERDATA came up read-only"
        return 1
    fi
    log "USERDATA mounted read-write"
}

# golden_mount_image: the image attached read-only and mounted on $LOWER;
# it must be an aarch64 root carrying the kernel's slot.
golden_mount_image() {
    if ! LOOP_DEV=$(losetup -f 2>/dev/null) || [ -z "$LOOP_DEV" ]; then
        LOOP_DEV=
        return 1
    fi
    if ! run losetup -r "$LOOP_DEV" "$GOLDEN_IMG"; then
        LOOP_DEV=
        return 1
    fi
    mkdir -p "$LOWER"
    if ! run mount -t ext4 -o ro,noload "$LOOP_DEV" "$LOWER"; then
        seed_cleanup
        return 1
    fi
    # e_machine of an ELF at byte 18: 0xb7 is AArch64
    _gm_m=$(dd if="$LOWER/usr/lib/systemd/systemd" bs=1 skip=18 count=1 2>/dev/null | od -An -tu1 | tr -d ' ')
    if [ "$_gm_m" != 183 ]; then
        err "golden: the image is not an aarch64 system"
        seed_cleanup
        return 1
    fi
    if [ ! -s "$LOWER/usr/lib/t715-golden/kernel.slot" ]; then
        err "golden: the image carries no usr/lib/t715-golden/kernel.slot"
        seed_cleanup
        return 1
    fi
}

# golden_seed: the image's tree into USERDATA/$GOLDEN_NAME (see the head of
# this part).  The progress on screen as seed_persist shows it.
golden_seed() {
    _gs_root=$UD_MNT/$GOLDEN_NAME
    _gs_tmp=$UD_MNT/.$GOLDEN_NAME.t715-seed
    _gs_used=$(df -Pk "$LOWER" | awk 'NR == 2 { print $3 }')
    _gs_free=$(df -Pk "$UD_MNT" | awk 'NR == 2 { print $4 }')
    case $_gs_used$_gs_free in
    '' | *[!0-9]*)
        err "golden: could not read the image's use or USERDATA's free space"
        return 1
        ;;
    esac
    if [ -e "$_gs_tmp" ]; then
        log "golden: removing an interrupted copy"
        run rm -rf "$_gs_tmp" || return 1
        _gs_free=$(df -Pk "$UD_MNT" | awk 'NR == 2 { print $4 }')
    fi
    if [ "$_gs_free" -lt $((_gs_used + SEED_MARGIN_KIB)) ]; then
        err "golden: USERDATA has $((_gs_free / 1024)) MiB free, the install needs $(((_gs_used + SEED_MARGIN_KIB) / 1024)) MiB"
        FAIL_REASON="Not enough free space in the internal storage: the install needs $(((_gs_used + SEED_MARGIN_KIB) / 1048576 + 1)) GB. Nothing was written. Free some space, then restart (hold Power and Volume down)."
        return 1
    fi
    run mkdir -m 0755 "$_gs_tmp" || return 1
    log "golden: copying $((_gs_used / 1024)) MiB from the image"
    say "Installing Omarchy, this takes about ten minutes"
    _gs_t0=$(date +%s)
    (
        _gs_b0=$(df -Pk "$UD_MNT" | awk 'NR == 2 { print $3 }')
        case $_gs_b0 in
        '' | *[!0-9]*) exit 0 ;;
        esac
        _gs_i=0
        while :; do
            if [ "$_gs_i" -gt 0 ]; then
                sleep 1
            fi
            _gs_i=$((_gs_i + 1))
            [ $((_gs_i % 10)) -eq 1 ] || continue
            _gs_b=$(df -Pk "$UD_MNT" | awk 'NR == 2 { print $3 }')
            case $_gs_b in
            '' | *[!0-9]*) continue ;;
            esac
            _gs_d=$((_gs_b - _gs_b0))
            [ "$_gs_d" -lt 0 ] && _gs_d=0
            _gs_p=$((_gs_d * 100 / _gs_used))
            [ "$_gs_p" -gt 99 ] && _gs_p=99
            [ "$_gs_p" -lt 1 ] && _gs_p=1
            say "Installing Omarchy: $_gs_p%"
        done
    ) &
    _gs_prog=$!
    _gs_rc=0
    _gs_list=
    for _gs_e in "$LOWER"/* "$LOWER"/.[!.]* "$LOWER"/..?*; do
        [ -e "$_gs_e" ] || [ -L "$_gs_e" ] || continue
        case ${_gs_e##*/} in
        lost+found) ;;
        *) _gs_list="$_gs_list ${_gs_e##*/}" ;;
        esac
    done
    # One archive for the whole tree: hard links across top-level
    # directories stay links.  The names have no blanks (checked by
    # arm64/release), so the list splits on spaces.
    set -f
    # shellcheck disable=SC2086  # the list of top-level names
    (cd "$LOWER" && tar -cf - $_gs_list) | (cd "$_gs_tmp" && tar -xpf -) || _gs_rc=1
    set +f
    kill "$_gs_prog" 2>/dev/null
    wait "$_gs_prog" 2>/dev/null
    # tar's own status reaches only the last command of the pipe: count the
    # entries on both sides as well.
    _gs_n1=$(cd "$LOWER" && find . -path ./lost+found -prune -o -print | wc -l)
    _gs_n2=$(cd "$_gs_tmp" && find . | wc -l)
    if [ "$_gs_rc" != 0 ] || [ "$_gs_n1" != "$_gs_n2" ]; then
        err "golden: copying the image failed (exit $_gs_rc; $_gs_n1 entries in the image, $_gs_n2 copied)"
        return 1
    fi
    # busybox tar leaves the symbolic links it makes to root: their owner
    # back, as in the image (the user's own links in their home)
    _gs_nl=0
    while IFS= read -r _gs_l; do
        _gs_o=$(stat -c '%u:%g' "$LOWER/$_gs_l" 2>/dev/null) || continue
        chown -h "$_gs_o" "$_gs_tmp/$_gs_l" 2>/dev/null && _gs_nl=$((_gs_nl + 1))
    done <<EOF_LINKS
$(cd "$LOWER" && find . -path ./lost+found -prune -o -type l ! -user 0 -print -o -type l ! -group 0 -print)
EOF_LINKS
    log "golden: $_gs_n2 entries copied in $(($(date +%s) - _gs_t0))s, the owner of $_gs_nl symbolic link(s) set back"
    _gs_nr=$NEWROOT
    NEWROOT=$_gs_tmp
    import_device_files
    NEWROOT=$_gs_nr
    {
        printf 'persistent root %s, installed from %s\n' "$GOLDEN_NAME" "$GOLDEN_IMG_NAME"
        printf 'installer %s, kernel %s\n' "$(golden_val release)" "$(uname -r)"
    } >"$_gs_tmp/$PERSIST_MARK" || return 1
    sync
    run mv "$_gs_tmp" "$_gs_root" || return 1
    sync
}

# golden_cache_fs DEV: no slot of ours in CACHE: when its file system
# covers the slots (Android's /cache, the whole partition), a new one of 64
# MiB takes its place.  The 64-bit system never mounts it.
golden_cache_fs() {
    # ext4 superblock at 1024: s_blocks_count_lo at 1028, s_log_block_size at
    # 1048, s_magic at 1080
    _gcf_sb=$RUNDIR/cache-sb
    dd if="$1" of="$_gcf_sb" bs=1024 skip=1 count=1 2>/dev/null || return 1
    _gcf_blocks=$(od -An -tu4 -j 4 -N 4 "$_gcf_sb" | tr -d ' ')
    _gcf_log=$(od -An -tu4 -j 24 -N 4 "$_gcf_sb" | tr -d ' ')
    _gcf_magic=$(od -An -tu2 -j 56 -N 2 "$_gcf_sb" | tr -d ' ')
    if [ "$_gcf_magic" = 61267 ] && [ "${_gcf_log:-9}" -le 6 ] &&
        [ $((_gcf_blocks * (1024 << _gcf_log))) -le $((CACHE_FS_KIB * 1024)) ]; then
        log "golden: CACHE's file system ends before the slots, kept"
        return 0
    fi
    log "golden: CACHE's file system covers the slots: a new one of $((CACHE_FS_KIB / 1024)) MiB"
    make_rw "$1" || return 1
    run mke2fs -b 4096 -L CACHE "$1" "$CACHE_FS_KIB" || return 1
}

# golden_slot SLOT_FILE: the kernel's slot (written with generation 0 by
# arm64/release) into the CACHE slot not in use, one generation above the
# one in use; the header's generation and hash are made here, the image's
# and the device tree's hashes come with it.  Written, then read back whole.
golden_slot() {
    _gk_src=$1
    _gk_dev=$(part_dev CACHE) || {
        err "golden: no single partition named CACHE"
        return 1
    }
    _gk_size=$(stat -c %s "$_gk_src")
    if [ $((_gk_size % 512)) -ne 0 ] || [ "$_gk_size" -gt $((SLOT_SECTORS * 512)) ] ||
        [ "$(slot_gen "$_gk_src" 0)" != 0 ]; then
        err "golden: $_gk_src is not a slot of generation 0 that fits"
        return 1
    fi
    if [ "$(blockdev --getsize64 "$_gk_dev")" -lt $(((SLOT_B + SLOT_SECTORS) * 512)) ]; then
        err "golden: CACHE is too small for the two slots"
        return 1
    fi
    _gk_a=$(slot_gen "$_gk_dev" "$SLOT_A")
    _gk_b=$(slot_gen "$_gk_dev" "$SLOT_B")
    if [ -z "$_gk_a$_gk_b" ]; then
        golden_cache_fs "$_gk_dev" || return 1
    fi
    if [ -z "$_gk_a" ] && [ -z "$_gk_b" ]; then
        _gk_at=$SLOT_A
        _gk_gen=1
    elif [ -z "$_gk_b" ] || { [ -n "$_gk_a" ] && [ "$_gk_a" -gt "$_gk_b" ]; }; then
        _gk_at=$SLOT_B
        _gk_gen=$((_gk_a + 1))
    else
        _gk_at=$SLOT_A
        _gk_gen=$((_gk_b + 1))
    fi
    _gk_new=$RUNDIR/kernel.slot
    {
        head -c 8 "$_gk_src"
        # shellcheck disable=SC2059  # the escapes are the bytes
        printf "$(le32 "$_gk_gen")"
        dd if="$_gk_src" bs=1 skip=12 count=36 2>/dev/null
    } >"$_gk_new.h" || return 1
    set -f
    # shellcheck disable=SC2046  # two words
    set -- $(fnv1a64 "$_gk_new.h" 0 48)
    set +f
    {
        cat "$_gk_new.h"
        # shellcheck disable=SC2059  # the escapes are the bytes
        printf "$(le32 "$1")$(le32 "$2")"
        dd if="$_gk_src" bs=1 skip=56 count=4040 2>/dev/null
        dd if="$_gk_src" bs=4096 skip=1 2>/dev/null
    } >"$_gk_new" || return 1
    rm -f "$_gk_new.h"
    if [ "$(slot_gen "$_gk_new" 0)" != "$_gk_gen" ] || [ "$(stat -c %s "$_gk_new")" != "$_gk_size" ]; then
        err "golden: the slot made here does not check"
        return 1
    fi
    _gk_sum=$(sha256sum "$_gk_new" | cut -d' ' -f1)
    log "golden: the kernel's slot, generation $_gk_gen, to sector $_gk_at of CACHE (the slots held: A ${_gk_a:-none}, B ${_gk_b:-none})"
    make_rw "$_gk_dev" || return 1
    if ! dd if="$_gk_new" of="$_gk_dev" bs=512 seek="$_gk_at" conv=notrunc,fsync 2>/dev/null; then
        err "golden: the write to CACHE failed"
    fi
    sync
    _gk_back=$(dd if="$_gk_dev" bs=512 skip="$_gk_at" count=$((_gk_size / 512)) 2>/dev/null | sha256sum | cut -d' ' -f1)
    rm -f "$_gk_new"
    if [ "$_gk_back" != "$_gk_sum" ]; then
        err "golden: the slot does not read back as written"
        return 1
    fi
    log "golden: the kernel's slot reads back as written"
}

# golden_efs_backup: EFS (the IMEI, the one partition no tool can rebuild)
# copied, read only, next to PARAM's copy, for the owner to keep on a
# computer.  Never fatal: EFS is not written by anything here.
golden_efs_backup() {
    [ ! -e "$UD_MNT/$GOLDEN_EFS" ] || return 0
    if ! _ge_dev=$(part_dev EFS); then
        warn "golden: no single partition named EFS: no copy of it"
        return 0
    fi
    if dd if="$_ge_dev" of="$UD_MNT/$GOLDEN_EFS.part" bs=1M 2>/dev/null &&
        [ "$(sha256sum "$UD_MNT/$GOLDEN_EFS.part" | cut -d' ' -f1)" = "$(sha256sum "$_ge_dev" | cut -d' ' -f1)" ] &&
        mv "$UD_MNT/$GOLDEN_EFS.part" "$UD_MNT/$GOLDEN_EFS"; then
        chmod 0600 "$UD_MNT/$GOLDEN_EFS"
        printf '%s  %s\n' "$(sha256sum "$UD_MNT/$GOLDEN_EFS" | cut -d' ' -f1)" "${GOLDEN_EFS##*/}" >"$UD_MNT/$GOLDEN_EFS.sha256"
        sync
        log "golden: EFS copied (read only) to $GOLDEN_EFS"
    else
        rm -f "$UD_MNT/$GOLDEN_EFS.part"
        warn "golden: EFS could not be copied"
    fi
}

# golden_param: save the stock PARAM (whole), forge the loader, write it.
golden_param() {
    _gp_copy=$RUNDIR/param-stock.img
    dd if="$PARAM_DEV" of="$_gp_copy" bs=1M 2>/dev/null || return 1
    _gp_sum=$(sha256sum "$_gp_copy" | cut -d' ' -f1)
    golden_forge_checked "$_gp_copy" || return 1
    for _gp_to in "$UD_MNT/$GOLDEN_BACKUP" "$UD_MNT/$GOLDEN_NAME/$GOLDEN_SAVED"; do
        mkdir -p "${_gp_to%/*}" || return 1
        cp "$_gp_copy" "$_gp_to.part" && sync && mv "$_gp_to.part" "$_gp_to" || return 1
        if [ "$(sha256sum "$_gp_to" | cut -d' ' -f1)" != "$_gp_sum" ]; then
            err "golden: the copy of the stock PARAM in ${_gp_to#"$UD_MNT"/} does not read back"
            return 1
        fi
    done
    chmod 0600 "$UD_MNT/$GOLDEN_NAME/$GOLDEN_SAVED" "$UD_MNT/$GOLDEN_BACKUP"
    printf '%s  %s\n' "$_gp_sum" "${GOLDEN_BACKUP##*/}" >"$UD_MNT/$GOLDEN_BACKUP.sha256"
    golden_efs_backup
    sync
    log "golden: the stock PARAM saved in ${GOLDEN_BACKUP} and the root's /$GOLDEN_SAVED"
    golden_write_param "$RUNDIR/param-loader.img"
}

# golden_finish: the marker, the log next to the image, the restart.
golden_finish() {
    {
        printf 'Omarchy for the Galaxy Tab S2, 64 bits: installer %s\n' "$(golden_val release)"
        printf 'installed %s\n' "$(date -u '+%Y-%m-%d')"
    } >"$UD_MNT/$GOLDEN_NAME/$GOLDEN_MARK" || return 1
    cp "$LOGFILE" "$UD_MNT/$GOLDEN_LOG" 2>/dev/null
    sync
    golden_cleanup
    say "Omarchy is installed. Restarting into it..."
    log "golden: installed, restarting"
    [ -n "$TEST" ] || sleep 5
    do_reboot
}

# golden_save_log: the log next to the image, when USERDATA is writable.
golden_save_log() {
    if is_mounted "$UD_MNT" && ! is_mounted_ro "$UD_MNT" && mkdir -p "$UD_MNT/media/0/linux"; then
        cp "$LOGFILE" "$UD_MNT/$GOLDEN_LOG" 2>/dev/null && sync
    fi
}

# golden_install PARAM_TOO: everything but the checks of golden_main; with
# PARAM_TOO = 1, the loader goes into PARAM last.
golden_install() {
    _gi_param=$1
    _gi_root=$UD_MNT/$GOLDEN_NAME
    FAIL_REASON="The install stopped (its log: linux/omarchy-arm64-install.log in the internal storage). PARAM was not changed: the next start tries again."
    if [ "$_gi_param" = 1 ] && [ "$SBOOT_VERSION" != "$(golden_val bootloader)" ]; then
        err "golden: the bootloader is '${SBOOT_VERSION:-unknown}', the loader is made for $(golden_val bootloader)"
        FAIL_REASON="This tablet's bootloader is ${SBOOT_VERSION:-unknown}; Omarchy needs $(golden_val bootloader). Nothing was written. Flash the stock $(golden_val bootloader) firmware with Odin, then this installer again."
        return 1
    fi
    golden_asv
    if [ ! -f "$_gi_root/$PERSIST_MARK" ]; then
        if [ -e "$_gi_root" ] || [ -L "$_gi_root" ]; then
            err "golden: USERDATA/$GOLDEN_NAME exists and was not made by this installer"
            FAIL_REASON="The internal storage already holds a folder $GOLDEN_NAME that this installer did not make. Nothing was written."
            return 1
        fi
        # golden_reinstall has found and checked the image already.
        if [ -z "$GOLDEN_CHECKED" ]; then
            if ! golden_find_image; then
                err "golden: no $GOLDEN_IMG_NAME in the folder linux of the internal storage or of a microSD card"
                FAIL_REASON="Omarchy's image was not found. Copy $GOLDEN_IMG_NAME and $GOLDEN_IMG_NAME.sha256 into a folder named linux on a microSD card, put the card in, then restart (hold Power and Volume down). Nothing was written."
                return 1
            fi
            if [ ! -f "$GOLDEN_IMG.sha256" ]; then
                err "golden: no $GOLDEN_IMG_NAME.sha256 next to the image"
                FAIL_REASON="$GOLDEN_IMG_NAME.sha256 is missing next to the image: copy it there too, then restart. Nothing was written."
                return 1
            fi
            golden_battery
            if ! check_image_sum "$GOLDEN_IMG"; then
                FAIL_REASON="The image file is damaged (bad checksum). Copy it again, then restart. Nothing was written."
                return 1
            fi
            # The image checked while USERDATA is still read-only, so a refusal
            # writes nothing; then detached, since an image attached from USERDATA
            # would keep it from being remounted read-write, and attached again.
            if ! golden_mount_image; then
                FAIL_REASON="The image file could not be read as Omarchy's 64-bit image. Nothing was written."
                return 1
            fi
            seed_cleanup
        fi
        golden_userdata_rw || return 1
        golden_mount_image || return 1
        golden_seed || return 1
        seed_cleanup
    else
        log "golden: USERDATA/$GOLDEN_NAME is there already (an earlier start copied it)"
        golden_userdata_rw || return 1
    fi
    if ! golden_slot "$_gi_root/usr/lib/t715-golden/kernel.slot"; then
        FAIL_REASON="The kernel could not be written to the CACHE partition. PARAM was not changed: the tablet comes back here."
        return 1
    fi
    if [ "$_gi_param" = 0 ] && [ ! -f "$_gi_root/$GOLDEN_SAVED" ] &&
        [ -f "$UD_MNT/$GOLDEN_PREVIOUS/$GOLDEN_SAVED" ]; then
        # a reinstall: the rescue's copy of the stock PARAM comes along
        if mkdir -p "${_gi_root}/${GOLDEN_SAVED%/*}" &&
            cp "$UD_MNT/$GOLDEN_PREVIOUS/$GOLDEN_SAVED" "$_gi_root/$GOLDEN_SAVED" &&
            chmod 600 "$_gi_root/$GOLDEN_SAVED"; then
            log "golden: the saved stock PARAM carried over from $GOLDEN_PREVIOUS"
        else
            err "golden: the saved stock PARAM could not be carried over from $GOLDEN_PREVIOUS"
        fi
    fi
    if [ "$_gi_param" = 1 ]; then
        say "Writing the loader..."
        if ! golden_param; then
            FAIL_REASON="The loader could not be written. If the tablet no longer starts, flash linux/PARAM-stock-backup.img back to PARAM in download mode (see the install guide)."
            return 1
        fi
    fi
    golden_finish
}

# golden_reinstall: the loader is in PARAM, the root is installed and
# linux/reinstall asks for a reinstall.  Everything is checked first, so that
# a refusal writes nothing; then the installed root is set aside as
# GOLDEN_PREVIOUS, the request file goes (from here on an interrupted install
# goes on as a plain one at the next start), and golden_install puts the new
# root in place, with the loader left as it is.
golden_reinstall() {
    _gr_root=$UD_MNT/$GOLDEN_NAME
    _gr_prev=$UD_MNT/$GOLDEN_PREVIOUS
    say "A reinstall is asked (linux/reinstall)."
    log "golden: the loader is in PARAM, USERDATA/$GOLDEN_NAME is installed and $GOLDEN_REINSTALL asks for a reinstall"
    if [ -e "$_gr_prev" ] || [ -L "$_gr_prev" ]; then
        err "golden: USERDATA/$GOLDEN_PREVIOUS is there already"
        FAIL_REASON="A reinstall is asked, but the system an earlier reinstall set aside, $GOLDEN_PREVIOUS, is still there. Delete it from Omarchy (sudo rm -rf /run/t715/userdata/$GOLDEN_PREVIOUS), or delete linux/reinstall. Nothing was written."
        return 1
    fi
    if ! golden_find_image; then
        err "golden: no $GOLDEN_IMG_NAME in the folder linux of the internal storage or of a microSD card"
        FAIL_REASON="A reinstall is asked, but Omarchy's image was not found. Copy $GOLDEN_IMG_NAME and $GOLDEN_IMG_NAME.sha256 into a folder named linux on a microSD card, put the card in, then restart. Nothing was written."
        return 1
    fi
    if [ ! -f "$GOLDEN_IMG.sha256" ]; then
        err "golden: no $GOLDEN_IMG_NAME.sha256 next to the image"
        FAIL_REASON="$GOLDEN_IMG_NAME.sha256 is missing next to the image: copy it there too, then restart. Nothing was written."
        return 1
    fi
    golden_battery
    if ! check_image_sum "$GOLDEN_IMG"; then
        FAIL_REASON="The image file is damaged (bad checksum). Copy it again, then restart. Nothing was written."
        return 1
    fi
    if ! golden_mount_image; then
        FAIL_REASON="The image file could not be read as Omarchy's 64-bit image. Nothing was written."
        return 1
    fi
    # The new root goes next to the one kept: the space is checked now, before
    # anything is set aside (golden_seed checks it again, too late for that).
    _gr_used=$(df -Pk "$LOWER" | awk 'NR == 2 { print $3 }')
    _gr_free=$(df -Pk "$UD_MNT" | awk 'NR == 2 { print $4 }')
    case $_gr_used$_gr_free in
    '' | *[!0-9]*)
        err "golden: could not read the image's use or USERDATA's free space"
        FAIL_REASON="The free space of the internal storage could not be read. Nothing was written."
        return 1
        ;;
    esac
    if [ "$_gr_free" -lt $((_gr_used + SEED_MARGIN_KIB)) ]; then
        err "golden: USERDATA has $((_gr_free / 1024)) MiB free, the reinstall needs $(((_gr_used + SEED_MARGIN_KIB) / 1024)) MiB next to the system it keeps"
        FAIL_REASON="A reinstall needs $(((_gr_used + SEED_MARGIN_KIB) / 1048576 + 1)) GB free in the internal storage, next to the installed system it keeps. Nothing was written. Free some space (or put the image on a microSD card), or delete linux/reinstall, then restart."
        return 1
    fi
    seed_cleanup
    golden_userdata_rw || return 1
    if ! run mv "$_gr_root" "$_gr_prev"; then
        err "golden: USERDATA/$GOLDEN_NAME could not be renamed $GOLDEN_PREVIOUS"
        FAIL_REASON="The installed system could not be set aside. It was left as it is; the tablet restarts into it."
        FAILREBOOT=1
        return 1
    fi
    rm -f "$UD_MNT/$GOLDEN_REINSTALL"
    sync
    log "golden: USERDATA/$GOLDEN_NAME set aside as $GOLDEN_PREVIOUS, $GOLDEN_REINSTALL removed"
    say "The installed system is kept as $GOLDEN_PREVIOUS. Installing the new one..."
    GOLDEN_CHECKED=1
    golden_install 0 && return 0
    # Stopped before the new root was in place (a failed copy): the system kept
    # aside goes back, so that the tablet still starts.  Once the new root is
    # there, the next start goes on with it instead (golden_install's steps).
    if [ ! -e "$_gr_root" ] && [ ! -L "$_gr_root" ] && [ -d "$_gr_prev" ] &&
        run mv "$_gr_prev" "$_gr_root"; then
        sync
        log "golden: the reinstall stopped before the new root was in place: $GOLDEN_PREVIOUS put back as $GOLDEN_NAME"
        FAIL_REASON="The reinstall stopped (its log: linux/omarchy-arm64-install.log in the internal storage). The installed system was put back as it was; the tablet restarts into it."
        FAILREBOOT=1
    fi
    return 1
}

# golden_main: what this start has to do (see the head of this part).
# Returns only when it stops.
golden_main() {
    golden_cleanup
    FAILREBOOT=0
    EXTENT=$(golden_val extent)
    case $EXTENT in
    '' | *[!0-9]*)
        err "golden: $GOLDEN_DIR is incomplete"
        FAIL_REASON="This installer is incomplete. Nothing was written."
        return 1
        ;;
    esac
    for _gm_f in logo.jpg stock.sha256 loader.sha256 bootloader release; do
        if [ ! -s "$GOLDEN_DIR/$_gm_f" ]; then
            err "golden: $GOLDEN_DIR/$_gm_f is missing"
            FAIL_REASON="This installer is incomplete. Nothing was written."
            return 1
        fi
    done
    if ! golden_sums_ok; then
        err "golden: stock.sha256 and loader.sha256 do not name stock PARAMs and loaders in pairs"
        FAIL_REASON="This installer is incomplete. Nothing was written."
        return 1
    fi
    say "Omarchy for the Galaxy Tab S2, 64 bits: installer $(golden_val release)"
    log "golden: installer $(golden_val release), bootloader ${SBOOT_VERSION:-not given}, mode ${SBOOT_MODE:-not given}"
    if ! PARAM_DEV=$(part_dev PARAM); then
        err "golden: no single partition named PARAM"
        FAIL_REASON="The tablet's partitions look unusual (no PARAM). Nothing was written."
        return 1
    fi
    _gm_sum=$(golden_param_sum)
    find_userdata || return 1
    mount_userdata || {
        FAIL_REASON="The internal storage could not be read: is it encrypted? Omarchy needs it unencrypted (see the install guide). Nothing was written."
        return 1
    }
    _gm_root=$UD_MNT/$GOLDEN_NAME
    _gm_line=$(golden_line_of loader.sha256 "$_gm_sum")
    if [ -n "$_gm_line" ]; then
        log "golden: PARAM's first $EXTENT bytes are a loader this installer knows, $(golden_named loader.sha256 "$_gm_line")"
        if [ -f "$_gm_root/$GOLDEN_MARK" ]; then
            if [ -f "$UD_MNT/$GOLDEN_REINSTALL" ]; then
                golden_reinstall || golden_save_log
                return 1
            fi
            # S-Boot's charger mode with the root installed: charge first,
            # the hand-back only when it does not run or gives up.
            golden_charge
            log "golden: the loader is in PARAM and USERDATA/$GOLDEN_NAME is installed: the loader handed this start back"
            FAILREBOOT=1
            FAIL_REASON="Omarchy did not finish starting last time. The tablet restarts and tries again."
            return 1
        fi
        log "golden: the loader is in PARAM, the system is not installed: installing it"
        golden_install 0 || golden_save_log
        return 1
    fi
    _gm_line=$(golden_stock_line "$_gm_sum")
    if [ -n "$_gm_line" ]; then
        log "golden: PARAM is a stock image this installer knows, $(golden_named stock.sha256 "$_gm_line")"
        log "golden: PARAM is the stock image: installing"
        golden_install 1 || golden_save_log
        return 1
    fi
    golden_archive "$PARAM_DEV"
    _gm_line=$(golden_stock_line "${GA_SUM:-}")
    if [ -n "$_gm_line" ]; then
        log "golden: PARAM holds a stock archive this installer knows, $(golden_named stock.sha256 "$_gm_line")"
        log "golden: PARAM holds the stock archive, and $GA_TAIL bytes after its end (byte $GA_END) that are not zero, left by an earlier write: the stock image all the same, installing"
        say "PARAM holds the stock pictures, then $GA_TAIL bytes S-Boot does not read: the loader puts zeros there."
        golden_install 1 || golden_save_log
        return 1
    fi
    log "golden: PARAM's first $EXTENT bytes are $_gm_sum: neither the stock image nor the loader"
    if [ -f "$_gm_root/$GOLDEN_MARK" ] && [ -f "$_gm_root/$GOLDEN_SAVED" ]; then
        say "Rescue: PARAM does not hold Omarchy's loader. Writing it back."
        if golden_forge_checked "$_gm_root/$GOLDEN_SAVED" && golden_write_param "$RUNDIR/param-loader.img"; then
            golden_cleanup
            say "Rescue: the loader is back in PARAM. Restarting."
            [ -n "$TEST" ] || sleep 5
            do_reboot
        fi
        FAIL_REASON="Rescue: the loader could not be written back. Flash linux/PARAM-stock-backup.img to PARAM in download mode (see the install guide)."
        return 1
    fi
    golden_param_report
    FAIL_REASON="PARAM does not hold the stock image of $(golden_val bootloader) that this installer knows. Nothing was written. Flash the stock $(golden_val bootloader) firmware with Odin (BL included), then this installer again. If it says this again, post a photo of this screen in the XDA thread."
    return 1
}

main() {
    mount_early
    # A failed redirection on "exec" would end the shell (= kernel panic
    # for PID 1): try it in a subshell first.
    if [ -z "$TEST" ] && (exec </dev/console >/dev/console) 2>/dev/null; then
        exec </dev/console >/dev/console 2>&1
    fi
    log "starting (pid $$, kernel $(uname -r 2>/dev/null), build $(cat /etc/t715-initramfs.id 2>/dev/null))"
    read_knobs
    quiet_console
    wdt_guard
    [ -n "$TEST" ] || load_modules
    # The debug link (DHCP with telnet off, telnetd with t715.telnet=1) is
    # up before the first seed: its progress takes minutes.
    net_up || warn "USB debug link not available, booting without it"
    # The loader first: when it has to be put back in PARAM, the restart that
    # follows needs nothing else.  The link is up, so the debug shell is there
    # should the write fail.
    param_rescue
    if [ "$GOLDEN" = 1 ]; then
        # Returns only when it stops; the debug shell can ask for another try.
        while :; do
            golden_main
            fail_wait || do_reboot
        done
    fi
    if prepare_root; then
        if [ "$SHELL_MODE" = 1 ]; then
            shell_wait
        fi
        handoff
        err "switch_root preparation failed"
    fi
    while :; do
        if fail_wait; then
            handoff
            err "switch_root preparation failed again"
        else
            do_reboot
        fi
    done
}

main "$@"
